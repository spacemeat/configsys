{
    // Shared, git-synced profile definitions. Per-machine selection + overrides live in
    // ~/configsys.hu, which overlays this file section-by-section (see docs/routing-model.md).
    configs: [ user, gaming, dev, electronics, graphics ]

    // OPTIONAL machine-wide install scope for scope-honoring drivers (appImage/flatpak/tarball/
    // font). Left UNSET by default: each such driver uses its own default (user-space by
    // nature — ~/apps, --user), and a source build (blender-build/kicad-build) stays under ~.
    // Nothing overrides an explicit choice automatically — set it here or in ~/.config/configsys/
    // configsys.hu ONLY to deliberately push those installs system-wide (e.g. an admin
    // provisioning for all users on one box):
    //     scope: system
    // (Fixed-scope drivers — apt/dnf/pacman = system, dotfiles/cargo = user — ignore this.)

    // A profile is a list of component names, each resolved through routes.hu (driver binding,
    // recursive deps, dedup). A `+other` term folds in another profile (union); `~name` removes.
    // A name with no route on the active OS surfaces as a resilient error row, not a hard stop.
    // The design is two-tier: small composable LEAF bundles (terminal, net-tools, cloud, …) with
    // no `+user`, and ROLE profiles that compose them. Pick-one catalogs (editors, shells, desktop
    // environments, individual languages, GPU SDKs) are deliberately left OUT of profiles — install
    // them by name or add them to your own profile. See docs/profiles-plan.md for the rationale.
    // Your ~/.config/configsys/configsys.hu may add profiles or shadow any of these by name.
profiles: {
    terminal: [ bash-dotfiles  configsys-dotfiles  git  curl  fastfetch  fzf  ripgrep  xclip  htop  btop  tmux  lazygit  kitty  ghostty  yazi  superfile  mononoki-nerd ]
    net-tools: [ iproute2  wireshark  wireshark-group  tshark  tcpdump  nmap  mtr  traceroute  iperf3  socat  ethtool  whois  netcat  dig  iftop  nethogs  nload  vnstat ]
    cloud: [ awscli  gcloud  azure-cli  opentofu  grpcurl ]
    containers: [ docker  docker-group  lazydocker ]
    k8s: [ kubectl  helm  k9s  k3s ]
    db-clients: [ pgcli  mycli  dbeaver  sqlitebrowser  lazysql ]
    db-servers: [ postgresql-service  mariadb-service  redis-service ]
    jvm: [ jdk  kotlin  maven  gradle ]
    latex: [ texlive ]
    go-dev: [ go  goimports ]
    ruby-dev: [ ruby  bundler ]
    haskell-dev: [ haskell  cabal  hlint ]
    ocaml-dev: [ ocaml  opam  dune ]
    lua-dev: [ lua  luarocks ]
    lisp-dev: [ sbcl  quicklisp ]
    user: [ +terminal  configsys-dotfiles codecs  firefox  chrome  neovim ]
    gaming: [ +user  vulkan-runtime  steam ]
    dev: [ +user  cpp-toolchain  make  rust  gcc-13  gcc-14  gcc-15  clang-18  clang-19  clang-20  gdb  analysis  cmake  ninja  meson  just  vscode ]
    web-dev: [ +user  node  typescript  prettier  pnpm  yarn  sass  brave  opera  vivaldi  edge  httpie  jq  yq  mitmproxy  xh  websocat  postman  insomnia  bruno ]
    backend: [ +user  +containers  +k8s  +cloud  +db-clients  +db-servers  protobuf  ansible ]
    electronics: [ +dev  arduino  kicad  gnuradio ]
    graphics: [ +user  vulkan-dev  blender ]
    artist: [ +user  blender  krita  gimp  inkscape  darktable  freecad  openscad  godot  scribus  digikam  obs-studio ]
    audio: [ +user  pipewire  ardour  lmms  tenacity  musescore  hydrogen  carla  sonic-pi  supercollider  qjackctl ]
    science: [ +user  +latex  julia  r  octave  jupyterlab  gnuplot  paraview  miniforge ]
    math: [ +user  +latex  julia  r  octave  maxima  wxmaxima  pari  gap  gnuplot  sagemath ]
    networking: [ +user  +net-tools ]
    ai: [ +terminal  claude-code  codex  llm  aider  ollama  analysis ]
    virt: [ +user  qemu  libvirt  libvirt-service  virt-manager ]
    devops: [ +terminal  +containers  +k8s  +cloud  ansible  opentofu ]
    desktop-apps: [ +user  libreoffice  vlc  discord  slack ]
}
}
