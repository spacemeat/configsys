{
    // The repo's base config layer: the browse profiles and the default TUI keybindings. What a
    // machine installs is its picks (`picks:` / `machine:`), kept in ~/.config/configsys/configsys.hu,
    // which overlays this file section by section along with your plugins (see docs/routing-model.md).

    // OPTIONAL machine-wide install scope for the drivers that can install either way (appImage,
    // flatpak, tarball, font, source, npm, gem, luarocks, and plugin build drivers like
    // blender-build/kicad-build). Left UNSET, each uses its user-space default (~/apps, --user).
    // Set it in ~/.config/configsys/configsys.hu (or `configsys config set scope system`) ONLY to
    // deliberately push those installs system-wide (e.g. an admin provisioning for all users on
    // one box):
    //     scope: system
    // (Fixed-scope drivers — apt/dnf/pacman = system, dotfiles/cargo = user — ignore this.)

    // OPTIONAL: turn a driver OFF on this machine. A disabled driver's bindings stop matching (like
    // a false `when:`), so a component's `suggests:` for something that only installs that way is
    // silently skipped — e.g. if you manage your own dotfiles, `disabled-drivers: [ dotfiles ]`
    // installs every app WITHOUT pulling its `<app>-dotfiles` (likewise `glue` for shell setup).
    // Generalizes ("no snaps here" -> add `snap`). Disabling a driver also turns off any driver
    // whose own requirements can only be installed through it. A HARD requires / an explicit pick
    // of a now-unroutable component still errors honestly (its row reads `unmet`). A machine
    // setting — set per box in ~/.config/configsys/configsys.hu.

    // OPTIONAL: the order that breaks the remaining tie when a component has several install
    // methods that work here (after a narrower `when:` and any `standing:` rank have had their say)
    // — e.g. `driver-preference: [ native  flatpak  appImage ]`. A pin overrides it. Drivers your
    // list doesn't name follow in the built-in order (native, aur, flatpak, snap, native-pkg-file,
    // appImage, brew, tarball, source, script); an OS block's own `driver-preference:` comes first
    // on that OS. A uniform setting — `configsys config set driver-preference …` keeps it in your
    // primary plugin when you have one, so it travels to your other machines.

    // A profile is a named, read-only list of components for BROWSING (the TUI Profiles screen,
    // `configsys profile list|show`). It never installs anything: you pick from it into this
    // machine's `picks:`. A `+other` term folds in another profile (union); `~name` removes a
    // component or a whole subprofile. A name with no install method on this OS shows as
    // unavailable (⊘), not an error. The design is two-tier: small composable LEAF bundles
    // (terminal, net-tools, cloud, …) and ROLE profiles that compose them. See
    // docs/done/profiles-plan.md for the rationale. Plugins, your primary plugin and your own
    // config may add profiles (your own browse categories) or redefine these by name; a term naming
    // the profile itself (`dev: [ +dev  valgrind ]`) amends it in place instead of replacing it.
profiles: {
    finders: [ fd  fzf  ripgrep  television ]
    terminal-emulators: [ alacritty  foot  ghostty  kitty  wezterm  mosh ]
    terminal-utils: [ tmux  xclip  zoxide  bat  xsel  wl-clipboard  sesh  gum  ueberzugpp  atuin  zellij  tuxedo  leaf  tree-sitter-cli  herdr  tuios ]
    system-utils: [ doas  dosfstools  fastfetch  gcompat  lsblk  needrestart ]
    native-package-tools: [ epel-release  rpmfusion-free  rpmfusion-nonfree  snapd  snapd-snap-link  snapd-socket  yay  software-properties-common ]
    packagers: [ flatpak  snapd ]
    system-monitors: [ btop  htop  bottom  atop  bmon  iotop  s-tui  glances  nvtop  wavemon  /*sysdig*/  dstat  lm-sensors  tmog ]
    disk-usage-utils: [ ncdu  duf  dysk ]
    file-browsers: [ mc  yazi  superfile  fff  tree  eza  rclone ]
    fish-shell: [ fish  bass ]
    shells: [ +fish-shell  nushell  zsh  elvish ]
    configuration-tools: [ puppet  ansible  salt  stow ]
    password-passkey: [ bitwarden  vaultwarden  doppler  pass  gnupg  openssh-server ]
    fonts: [ fontconfig  mononoki-nerd ]

    iso-image-tools: [ caligula  balena-etcher ]

    text-editors: [ asciidoc  android-studio  antigravity  emacs  helix  jetbrains-toolbox  micro  neovim  vscode
        vscodium  zed  fresh  jrnl  vis ]

    desktops-compositors: [ budgie  cinnamon  cosmic  fvwm2  gnome  hyprland  i3  kde  lxqt  mate  qtile  sway  xfce  xmonad  niri  mangowm  mutter  kwin ]
    desktop-tools: [ wmenu ]
    web-browsers: [ chrome  chromium  firefox  librewolf  brave  opera  vivaldi  edge  tor-browser  lynx ]
    audio-infra: [ pipewire  jack  wiremix ]
    gaming: [ vulkan-icd-loader  vulkan-intel  vulkan-loader  vulkan-radeon  vulkan-runtime  steam  wine  winetricks  protonup-qt  protontricks ]
    games: [ zork ]   // mostly a catalog plugins populate (configsys-source adds xpilot)

    virtual-machines: [ qemu  virt-manager  virtualbox  libvirt  libvirt-service  libvirt-clients ]
    containers: [ docker  docker-engine  docker-service  docker-group  lazydocker  podman  xephyr ]
    k8s: [ kubectl  helm  k9s  k3s ]

    db-clients: [ pgcli  mycli  dbeaver  sqlitebrowser  lazysql  dbx ]
    db-servers: [ postgresql  postgresql-service  mariadb  mariadb-service  redis  redis-service  mongodb  mongodb-service ]

    net-tools: [ iproute2  impala  bluetui  curl  wget  wireshark  wireshark-group  tshark  tcpdump  nmap  mtr  gping  traceroute  iperf3
        socat  ethtool  whois  netcat  dig  iftop  nethogs  nload  rsync  vnstat  dnspeep  bridge-utils  croc  wormhole  ttyd
        ghgrab  lazyrsync ]
    cloud-tools: [ awscli  gcloud  azure-cli  opentofu  grpcurl ]

    android-tools: [ jmtpfs  android-file-transfer ]

    // Debug/analysis kit (was a parts-component): pick the tools you want; each installs where it routes.
    analysis: [ valgrind  cppcheck  clang-tidy  lldb  strace  ltrace ]
    c-cpp-lang: [ bazelisk  c-toolchain  cpp-toolchain  gcc-10 gcc-11 gcc-12 gcc-13  gcc-14  gcc-15  clang-18  clang-19
        clang-20  gdb  make  +analysis  libc++  libc++abi  cmake  ninja  meson  clang  cmake-gui  doxygen  ccmake  clangd  conan  gettext  heaptrack  vcpkg ]
    dotnet-lang: [ dotnet ]
    go-lang: [ go  goimports ]
    haskell-lang: [ haskell  cabal  hlint ]
    java-lang: [ jdk  jdk-17  jdk-21  jdk-25 ]
    kotlin-lang: [ detekt  kotlin ]
    scala-lang: [ scala  sbt  scalacli ]
    clojure-lang: [ clojure  leiningen ]
    groovy-lang: [ groovy ]
    lisp-lang: [ sbcl  quicklisp ]
    lua-lang: [ lua  luarocks  dkjson ]
    objective-c-lang: [ gnustep  objective-c ]
    tcl-lang: [ tcl  tk ]
    ocaml-lang: [ ocaml  opam  dune ]
    php-lang: [ php  composer ]
    python-lang: [ python3.10  python3.11  python3.12  python3.13  python3.14  cython  pyenv  python-build-deps  uv  jupyterlab  python3-pip  pipx  pytest  python3-dev ]
    ruby-lang: [ ruby  bundler ]
    rust-lang: [ rust  miniforge ]
    scratch-lang: [ scratch ]
    web-lang: [ node  typescript  sass ]
    mojo-lang: [ mojo ]
    lean-lang: [ lean ]
    jvm-lang: [ +java-lang  +kotlin-lang  +scala-lang  +clojure-lang  +groovy-lang ]
    languages: [ +c-cpp-lang  +dotnet-lang  +go-lang  +haskell-lang  +jvm-lang  +lisp-lang  +lua-lang
        +objective-c-lang  +ocaml-lang  +php-lang  +python-lang  +ruby-lang  +rust-lang  +scratch-lang  +tcl-lang  +web-lang  +mojo-lang  +lean-lang
        elm  erlang  elixir  julia  nim  nasm  octave odin  perl  r  zig  gfortran  gnat  gnucobol  d  crystal
        dart  raku  v  gleam  fennel  swift  racket  guile  c3  deno  roc ]

    c-cpp-libs: [ abseil  boost  dbus-dev  swig  protobuf-dev ]
    c-cpp-dev-libs: [ pipewire-dev  ffmpeg-dev  libdrm-dev  fontconfig-dev  openal-dev  freealut-dev  libgit2  libsecret  nng  opencascade  unixodbc
        // consolidated from the configsys-source plugin into base routes (build deps useful in their own right):
        ncurses  libevent  libssl  zlib  asio  tinyxml2  snappy  bzip2  libzstd  liblz4  libsodium  liburing
        libaio  libunwind  libdwarf  libiberty  libcurl  libpng  expat  sdl2-ttf  sdl2-image  libpcap  sqlite  libmtp
        fuse  libusb  libmagic  libidn2  libfuse2  libjpeg  libstdc++  libvirt ]

    jvm-tools: [ mvnd  maven  graalvm  gradle  sdkman  ant  jbang  coursier  springboot  quarkus  micronaut
        jreleaser  visualvm  jmc ]

    jvm-dev: [ +jvm-lang  +jvm-tools ]

    dev-tools: [ debhelper  dh-make  gh  git  lazygit  jq  just  protobuf  yq  liquibase  perf  jenkins  po4a  source-highlight  obsidian  ghidra  radare2  faker  grex  raddebugger ]
    autotools: [ autoconf  automake  libtool  pkg-config  bison  flex ]   // the basic C-dev / GNU build toolchain (make/cmake are their own tools)
    version-control-tools: [ git  lazygit  mercurial  subversion  cvs  perforce  fossil  bazaar  git-lfs  patch ]
    compression-tools: [ zstd  lz4  p7zip  zip  unzip  unrar  rar ]
    benchmark-tools: [ iozone  fio  ioping  bonnie++  sysbench  stress-ng  hyperfine  mbw  glmark2  vkmark  phoronix-test-suite
        k6  hey  wrk  vegeta  geekbench  unigine-superposition  unigine-heaven  unigine-valley ]

    cuda-tools: [ cuda  cuda-toolkit-11  cuda-toolkit-12  cuda-repo ]
    compute-lang: [ +cuda-tools  rocm-hip  intel-oneapi-basekit ]
    deep-learning-lang: [ cudnn-8  cudnn-9  miopen  onednn ]

    ai-tools: [ claude-code  codex  llm  aider  ollama  impala ]

    web-tools: [ cockpit  prettier  httpie  mitmproxy  xh  websocat  postman  insomnia  bruno  jmeter  nginx  nginx-service  newsboat  headscale  headscale-service  wireguard ]
    web-package-managers: [ bun  pnpm  yarn ]

    graphics-runtime: [ vulkan-runtime  mesa-vulkan-drivers  libvulkan1  vulkan-loader  vulkan-icd-loader  vulkan-radeon  vulkan-intel  vulkan-swrast ]

    graphics-dev: [ vulkan-dev  vulkan-sdk  opengl  glfw  sdl  sfml  egl  glew  glm  libdecor ]
    game-dev: [ godot  godots  godl  unityhub ]
    ui-dev: [ flutter  gtk  gtk3  gtkmm  cairo  libinput  pixman  libdecor  libx11  libxcb  libxcb-cursor-dev  libxcb-devel libxcb-xinerama0  libxcb-xinput0  libxext  libxfixes  libxss  libxtst  libxcursor  libxft  libxi  libxinerama  libxkbcommon  libxrandr  libxxf86vm  ncurses  pango  qt  wayland  wayland-protocols  webkit2gtk  wlroots  wxpython  wxwidgets  xcb-util  xcb-util-cursor  xcb-util-cursor-devel ]

    web-dev: [ +web-lang  +web-browsers  +web-package-managers  +web-lang  +web-tools ]

    electronics-tools: [ arduino  kicad  gnuradio ]
    graphics-tools: [ blender  chafa  durdraw  krita  gimp  inkscape  darktable  freecad  openscad  cadcraft  scribus  digikam  photocraft  vectorcraft  lightcraft  designcraft  grim  slurp  pastel  webcamize  wl-screenrec  swaybg  figlet  pywal16  cbonsai  cmatrix  pipes  asciiquarium  lolcat ]
    video-editors: [ kdenlive  shotcut  openshot  flowblade  olive  filmcraft  effectcraft  asciinema ]
    audio-tools: [ audacity  espeak  ardour  lmms  tenacity  musescore  hydrogen  carla  sonic-pi  supercollider
        qjackctl  yabridge  pulseaudio-utils  kew  soundcraft  cliamp ]

    science: [ apod  astroterm  jupyterlab  gnuplot  paraview  opencv  opencv-python  foldingathome ]
    math: [ texlive  texlive-full  julia  r  octave  maxima  wxmaxima  pari  gap  gnuplot  sagemath  numpy ]

    communication: [ discord  discordo  slack  signal  signal-cli  obs-studio ]
    office: [ libreoffice  pdfcraft  wordcraft  gridcraft  deckcraft ]
    // digital-asset management: photo / media libraries and organizers
    dam-tools: [ digikam  lap  xnview-mp  kphotoalbum  gthumb  rawtherapee  shotwell  allusion  mediachips  video-hub-app ]
    creative-tools: [ +electronics-tools  +graphics-tools  +audio-tools  +office  +dam-tools  neo ]
    // ArtCraft's "Crafting Apps" — open-source rebuilds of the Adobe suite (+ Office, AutoCAD, Pro
    // Tools), as one suite lens (alpha).
    artcraft: [ photocraft  vectorcraft  lightcraft  designcraft  filmcraft  effectcraft  pdfcraft
        wordcraft  gridcraft  deckcraft  cadcraft  soundcraft ]

    // Codec bundles (were parts-components): pick the pieces you want. codecs = license-clean;
    // codecs-restricted = patent-encumbered nonfree, opt-in. Members install wherever they route.
    codecs: [ ffmpeg  gst-good  gst-bad ]
    codecs-restricted: [ gst-ugly  gst-libav  libavcodec-extra ]

    media-servers: [ emby  emby-service  jellyfin  jellyfin-service  plex  plex-service  navidrome  mpd ]
    media-players: [ +codecs  gst-libav  ffmpeg  vlc  spotify  kodi  stremio  mpc  strawberry  mpd-mpris  playerctl ]
    home-server: [ home-assistant  pi-hole  adguardhome  homebridge  mosquitto  mosquitto-service  syncthing
        tailscale-service  grafana  grafana-service  prometheus  cockpit-service  wireguard  nextcloud ]

    terminal: [ +finders  +terminal-emulators  +terminal-utils  +system-utils  +system-monitors
        +disk-usage-utils  +file-browsers  +shells  +configuration-tools  +password-passkey  +fonts ]
    backend-tools: [ +containers  +k8s  +cloud-tools  +net-tools  +db-clients  +db-servers  tailscale ]
    user: [ +terminal  git  shell-glue  configsys-glue  +codecs  firefox  chrome ]
}

    // TUI keybindings. Merged section-by-section up the layer stack (this repo base < plugins <
    // primary < your top config) — exactly like `theme:` — so a `keys:` block in any plugin's data
    // file (your primary plugin's, say) or in ~/.config/configsys/configsys.hu overlays these per
    // action. A value is one key or a list of alternates. Key names: a literal character
    // (case-SENSITIVE, so `g` != `G`), a named key (enter kpenter tab esc space up down left right
    // pgup pgdn home end del ins backspace shift-tab f1…f12), or `ctrl-<x>`. Dispatch is by ACTION,
    // and the on-screen legends and `?` help read this same map, so a rebind updates the hints too
    // (`configsys check` flags unknown actions and clashes). A key you bind in a higher layer is TAKEN from whatever
    // action a lower layer gave it in the same section (so your rebind wins; check names the action
    // that lost it). Override just what you want:
    //     keys: { global: { quit: [ q  ctrl-c ] }  screens: { theme: t } }
    keys: {
        // The number-key screen switcher (the chip bar). One key each.
        screens: { components: "1"  profiles: "2"  plugins: "3"  glue: "4"  dotfiles: "5"  config: "6"  theme: "7" }

        // Actions shared by every screen. A page section below shadows these for the same key on
        // that page, and may add extra keys for any of these actions just for itself. A page's own
        // section is read FIRST for every key: a key a page binds goes to that page even if it is a
        // quit/quit-force/issues/help or screen-switch key here, and a page may bind those four
        // actions itself (they then work on that page). None of the shipped page sections take them.
        global: {
            down: [ j  down ]
            up: [ k  up ]
            left: [ h  left ]
            right: [ l  right ]
            top: g
            bottom: G
            page-down: [ pgdn  ctrl-j ]   // move the cursor down a page (all panes + modals)
            page-up: [ pgup  ctrl-k ]     // move the cursor up a page
            select: space           // toggle / mark the current row
            confirm: [ enter  kpenter ]   // activate / open / apply (Return / keypad Enter — NOT ctrl-j)
            switch-pane: tab        // move focus between panes (screens with two panes)
            switch-pane-back: shift-tab
            find: "/"               // fuzzy-jump the cursor
            filter: F               // live substring filter (narrows the list)
            issues: "!"             // open the diagnostics (issues) overlay
            help: "?"               // this page's help (keys + description + glossary)
            quit: q                 // leave the TUI (asks to confirm)
            quit-force: Q           // leave immediately, no confirm prompt
        }

        // Components screen. down/up/left(collapse)/right(expand)/top/bottom/find/filter/select
        // (mark)/confirm(open) come from `global`; these are its own actions (a per-page key wins
        // over `global` for the same key — e.g. `expand-all` rebinds tab, which is switch-pane globally).
        components: {
            where: w                // explain the current component (source layer + resolution, like `configsys where`)
            lock: L                 // lock / unlock version — every SELECTED row, or the current row if none selected
            expand-all: tab         // expand / collapse the whole tree
            select-all: a
            clear: c                // unstage the cursor/selected rows (and drop them from !uninstall); clear the selection + errors
            method: v               // pick an install method / provider — writes a pin (matches Profiles)
            op-install: i           // stage: make the cursor/set current (install if missing, else upgrade; swaps out a `switch` install)
            op-upgrade: u           // stage: upgrade the cursor/set (outdated only)
            op-install-all: I       // stage: make EVERY tracked component current (install missing / upgrade outdated)
            op-upgrade-all: U       // stage: upgrade EVERY outdated component
            op-remove: x            // stage: remove
            execute: X              // run the staged ops (asks to confirm)
            refresh: R              // = `configsys refresh`: version sources + the package index
            mode: M                 // cycle the view: to-do / tracked / installed+tracked
        }

        // Config screen. down/up/top/bottom from `global`; confirm OR select edits the setting.
        config: {
            theme: t                // open the theme editor
            move: m                 // move this setting local <-> primary plugin
        }

        // Dotfiles screen. down/up/top/bottom + left/right (column scroll) from `global`. Managing a
        // config is ONE step (adopt any on-system file, then link). Unmanaging asks to confirm first.
        dotfiles: {
            manage: m               // manage the current row (capture + link); confirm does the same
            manage-all: M           // manage every UNMANAGED config at once
            unmanage: u             // unmanage the current row (unlink; confirms first)
            unmanage-all: U         // unmanage every MANAGED config at once (confirms first)
            move-store: s           // move this config between stores: local <-> primary plugin
            move-store-all: S       // move ALL configs to a store (chooser: plugin / local)
        }

        // Glue screen (snippets grouped per installed shell). down/up/top/bottom + left/right
        // (column scroll) from `global`. Ship->activate toggle — no capture; activation re-checks the
        // authoritative source (updates a stale store copy) and ensures the shell loader is wired.
        // Each row is one snippet for ONE shell; acting on it leaves the component's other shells alone.
        glue: {
            activate: a             // activate the current snippet for its row's shell
            activate-group: A       // (re)activate EVERY snippet in the cursor's shell group (also refreshes changed ones)
            deactivate: x           // deactivate the current snippet for its row's shell (unlink; leaves conf.d + content)
        }

        // Plugins screen. Focus-aware nav (down/up/left/right/top/bottom) + switch-pane (table ->
        // each diff file -> table) come from `global`; these are its git/trust actions.
        plugins: {
            add: a
            remove: x
            sync: s
            sync-all: S
            bless: b                // make the current plugin your primary (syncs it first)
            unbless: B              // clear the primary designation
            update: u               // update to the newest stable tag (else main/master) and re-sync
            update-all: U
            trust: t                // trust / untrust the current plugin's code or recipes
            trust-all: T            // trust every untrusted or changed plugin
            set-ref: v              // pin a tag / branch / sha and re-sync
        }

        // Profiles screen (two panes). Nav is focus-aware from `global` (left pane: up/down the tree,
        // left/right collapse/expand; right pane: table move, left/right scroll or fold a parts row);
        // switch-pane toggles panes; confirm drills/opens (left) or toggles tracking on the target
        // machines (right; drills a parts row open); select adds the row to the multi-select set (right).
        profiles: {
            track-all: T            // toggle TRACKING of the multi-select set / all in the selected profile
            track-one: t            // toggle TRACKING of just the highlighted component
            disp-seen: s            // toggle NEW <-> seen on the highlighted component
            disp-interesting: i     // toggle INTERESTING on the highlighted component
            disp-seen-all: S        // mark SEEN across the multi-select set / whole selected profile
            disp-interesting-all: I // mark INTERESTING across the set / whole selected profile
            select-all: a           // select every component currently in view (multi-select set)
            method: v               // pin the selected component's install method (via)
            comp-machines: m        // machines dialog for JUST the cursor component (toggle its tracking)
            machine-target: M       // choose the target machines to edit (plural; T/t fan out to them)
            attr-filter: f          // faceted kind filter over the catalog (F = live substring filter)
            toggle-install: O       // install overlay on/off (inst'd column + installed underline; default: install-overlay)
            stage-uninstall: x      // stage the selected component for uninstall (-> !uninstall)
            mark-all-seen: E        // mark every NEW component SEEN at once (confirms first)
            claim: C                // track every INSTALLED component (adopt an existing system; confirms)
            orphan-ignore: "."      // add / remove the cursor component in orphans-ignore
            where: w                // explain: the cursor component (table focused) or the current profile's provenance
        }

        // Theme editor. Nav (down/up/left/right/top/bottom, switch-pane) from `global`; confirm/select
        // edits the focused color or role; reset clears it. page-1..page-7 (F1-F7) select the sample
        // page being previewed. Effects o/u/v = bold/underline/reverse on a role.
        theme: {
            page-1: f1              // select the sample page (components/profiles/plugins/glue/dotfiles/config/theme)
            page-2: f2
            page-3: f3
            page-4: f4
            page-5: f5
            page-6: f6
            page-7: f7
            new: n                  // add a new color to the map
            reset: [ r  x ]         // reset the current color / role / gradient endpoint to default (a color you added is removed)
            edit-bg: B              // edit a role's background
            effect-bold: o
            effect-underline: u
            effect-reverse: v
            gradient-toggle: p      // toggle the page's background gradient
            copy-page: D            // copy this page's look onto another
            save: s                 // export a theme pack / promote to primary
            load: L                 // load a saved theme pack
        }
    }
}
