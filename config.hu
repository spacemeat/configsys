{
    // Shared, git-synced profile definitions. Per-machine selection + overrides live in
    // ~/configsys.hu, which overlays this file section-by-section (see docs/routing-model.md).
    configs: [ user, gaming, dev-tools, electronics-tools, graphics-tools ]

    // OPTIONAL machine-wide install scope for scope-honoring drivers (appImage/flatpak/tarball/
    // font). Left UNSET by default: each such driver uses its own default (user-space by
    // nature — ~/apps, --user), and a source build (blender-build/kicad-build) stays under ~.
    // Nothing overrides an explicit choice automatically — set it here or in ~/.config/configsys/
    // configsys.hu ONLY to deliberately push those installs system-wide (e.g. an admin
    // provisioning for all users on one box):
    //     scope: system
    // (Fixed-scope drivers — apt/dnf/pacman = system, dotfiles/cargo = user — ignore this.)

    // A profile is a list of component names, each resolved through routes.hu (driver binding,
    // recursive deps, dedup). A `+other` term folds in another profile (union); `~name` removes.
    // A name with no route on the active OS surfaces as a resilient error row, not a hard stop.
    // The design is two-tier: small composable LEAF bundles (terminal, net-tools, cloud, …) with
    // no `+user`, and ROLE profiles that compose them. Pick-one catalogs (editors, shells, desktop
    // environments, individual languages, GPU SDKs) are deliberately left OUT of profiles — install
    // them by name or add them to your own profile. See docs/profiles-plan.md for the rationale.
    // Your ~/.config/configsys/configsys.hu may add profiles or shadow any of these by name.
profiles: {
    terminal: [ +terminal-emulators  curl  fastfetch  fzf  ripgrep  xclip  xclip-dotfiles  htop  htop-dotfiles  btop  neovim  neovim-dotfiles  tmux  tmux-dotfiles  lazygit  yazi  yazi-dotfiles  superfile  superfile-dotfiles  mononoki-nerd ]
    terminal-emulators: [ ghostty  kitty ]
    shells: [ fish  nushell  zsh ]
    desktops-compositors: [ budgie  cosmic  fvwm2  gnome  i3  kde  lxqt  mate  qtile  sway  xfce  xmonad ]
    text-editors: [ android-studio  emacs  helix  jetbrains-toolbox  neovim  neovim-dotfiles  vscode  zed ]
    web-browsers: [ chrome  chromium  firefox  brave  opera  vivaldi  edge ]
    audio: [ pipewire  jack ]
    gaming: [ +user  vulkan-runtime  steam  wine  winetricks ]

    virtual-machines: [ qemu  libvirt  libvirt-service  virt-manager  virtualbox ]
    containers: [ docker  docker-group  lazydocker  podman podman-dotfiles ]
    k8s: [ kubectl  helm  k9s  k3s ]

    db-clients: [ pgcli  mycli  dbeaver  sqlitebrowser  lazysql ]
    db-servers: [ postgresql-service  mariadb-service  redis-service ]

    cloud-tools: [ awscli  gcloud  azure-cli  opentofu  grpcurl ]
    net-tools: [ iproute2  wireshark  wireshark-group  tshark  tcpdump  nmap  mtr  traceroute  iperf3  socat  ethtool  whois  netcat  dig  iftop  nethogs  nload  vnstat ]

    devops-tools: [ +backend-tools  ansible  opentofu ]

    backend-tools: [ +containers  +k8s  +cloud-tools  +net-tools  +db-clients  +db-servers  ansible ]

    c-cpp-lang: [ bazelisk  cpp-toolchain  gcc-10 gcc-11 gcc-12 gcc-13  gcc-14  gcc-15  clang-18  clang-19  clang-20  gdb  gdb-dotfiles  make  analysis  cmake  ninja  meson  ]
    go-lang: [ go  goimports ]
    haskell-lang: [ haskell  cabal  hlint ]
    java-lang: [ jdk  kotlin  maven  gradle  sdkman ]
    lisp-lang: [ sbcl  quicklisp ]
    lua-lang: [ lua  luarocks ]
    ocaml-lang: [ ocaml  opam  dune ]
    python-lang: [ python3.11  python3.12  python3.13  cython  pyenv  uv  jupyterlab ]
    ruby-lang: [ ruby  bundler ]
    rust-lang: [ rust  miniforge ]
    web-lang: [ node  typescript  sass ]
    php-lang: [ php  composer ]
    dotnet-lang: [ dotnet ]
    languages: [ +c-cpp-lang  +go-lang  +haskell-lang  +java-lang  +lisp-lang  +lua-lang  +ocaml-lang  +php-lang  +python-lang  +ruby-lang  +rust-lang  +web-lang  +dotnet-lang  erlang  elixir  julia  nim  nasm  octave odin  perl  r  zig ]

    dev-tools: [ git  jq  just  protobuf  yq ]
    version-control: [ git  mercurial  subversion  cvs  perforce  fossil  bazaar ]
    compression: [ zstd  lz4  p7zip  zip  unzip  unrar ]
    ai-tools: [ claude-code  codex  llm  aider  ollama ]

    graphics-dev: [ vulkan-dev  gtk  gtkmm  qt  opengl  glfw  sdl  sfml ]
    game-dev: [ +graphics-dev  godot  unityhub ]

    web-dev: [ +web-lang  +web-browsers  +web-package-managers  +web-lang  prettier  httpie  mitmproxy  xh  websocat  postman  insomnia  bruno ]
    web-package-managers: [ bun  pnpm  yarn ]

    electronics-tools: [ arduino  arduino-dotfiles  kicad  gnuradio ]
    graphics-tools: [ blender  krita  gimp  inkscape  darktable  freecad  openscad  scribus  digikam ]
    audio-tools: [ +audio  ardour  lmms  tenacity  musescore  hydrogen  carla  sonic-pi  supercollider  qjackctl  yabridge ]

    science: [ +math  jupyterlab  gnuplot  paraview  opencv  opencv-python ]
    math: [ +latex  julia  r  octave  maxima  wxmaxima  pari  gap  gnuplot  sagemath ]
    latex: [ texlive  texlive-full ]

    user: [ +terminal  git  bash-dotfiles  configsys-dotfiles  codecs  firefox  chrome ]
    desktop-apps: [ libreoffice  vlc  discord  slack  spotify  obs-studio  kodi  stremio ]
    media-servers: [ jellyfin-service  plex-service  emby-service  navidrome ]
    creative-tools: [ +electronics-tools  +graphics-tools  +audio-tools ]
}
}
