// routes.hu — the capability/component routing data (see docs/routing-model.md and the
// routing section of CLAUDE.md). Loaded by configsys/routes.py; resolution in resolve.py.
{
    // OS layer: lineage (`using`) + which package manager is `native` + version scales.
    // `provides:` lists capabilities baseline in that environment (satisfied for free).
    os: {
        // `provides: python3` — the configsys bootstrap guarantees a system python3 (>=3.10) on every
        // supported OS, so a bare `requires: python3` is satisfied for free (nothing installed). A
        // VERSIONED need (`requires: { python3: ">=3.11" }`) isn't met by this unversioned baseline and
        // pulls a python3.X interpreter component instead.
        linux:   { provides: python3 }

        // The C library is an axis orthogonal to distro family: mainstream distros are glibc,
        // Alpine (and musl-Void) are musl. Prebuilt glibc binaries (most AppImages, many
        // tarballs) can't run under musl's loader. `glibc_linux` carries a `glibc` capability
        // that the glibc families inherit; drivers/bindings that fetch glibc artifacts
        // `requires: glibc`, so they cleanly decline on Alpine instead of installing a corpse.
        glibc_linux: { using: linux  provides: glibc }

        // Debian family (apt). A scale-root owns a version numbering. Pop shares Ubuntu's exact
        // numbers (Pop 22.04 IS Ubuntu 22.04), so it borrows Ubuntu's scale — no scale-root.
        // Mint and LMDE use their OWN numbers (Mint 21 = Ubuntu 22.04, different digits), so
        // each is its own scale-root — a versioned `ubuntu`/`debian` atom must NOT misfire on
        // them. Bare `ubuntu`/`debian` still match all of them (route inheritance by identity).
        debian:    { using: glibc_linux  native: apt   scale-root: true }
        ubuntu:    { using: debian    scale-root: true }
        pop_os!:   { using: ubuntu }
        elementary:{ using: ubuntu    scale-root: true }            // elementary OS (own numbering: 6/7/8); ships the Pantheon desktop
        linuxmint: { using: ubuntu    scale-root: true }            // Mint main (own numbering)
        lmde:      { using: debian    scale-root: true }            // Mint Debian Edition (own numbering)
        kali:      { using: debian }                                // kali-rolling (Debian testing) — rolling, bare membership like tumbleweed
        pikaos:    { using: debian    scale-root: true }            // Debian-based gaming distro; own date numbering (26.MM.DD) so it's its own scale-root

        // RHEL family (dnf). The EL rebuilds share rhel's routes + version line; distinct
        // blocks (vs. one aliased `rhel`) buy them identity — `when: "rocky"`, correct display.
        redhat:    { using: glibc_linux  native: dnf }              // fedora + EL share dnf
        fedora:    { using: redhat    scale-root: true }            // fedora proper (YY release)
        nobara:    { using: fedora }                                // Fedora-based (Nobara N = Fedora N) — borrows fedora's scale, no own scale-root
        rhel:      { using: redhat    scale-root: true }            // EL scale-root (N release)
        rocky:     { using: rhel }
        almalinux: { using: rhel }
        centos:    { using: rhel }                                  // CentOS Stream

        // Fedora Atomic / uBlue (Silverblue, Kinoite, Sericea, Bazzite, Bluefin, Aurora …) —
        // immutable ostree desktops. Modeled as a distinct ENVIRONMENT, deliberately NOT under
        // `fedora`: brew is the CLI `native:` (uBlue ships it pre-configured), flatpak covers
        // apps (their existing bindings just work), and rpm-ostree is an explicit last-resort
        // layering driver (via: rpm-ostree). Hanging off glibc_linux — not redhat — keeps the
        // dnf-only bindings (EPEL / RPM Fusion / repo-component) from misfiring here; brew needs
        // none of them. `provides: flatpak` because flatpak is pre-installed, so an app's flatpak
        // dep is env-satisfied instead of trying to `brew install flatpak`. scale-root: it owns
        // its VERSION_ID (tracks Fedora) without inheriting fedora's dnf version line. osdetect
        // folds every variant (ID=fedora + atomic VARIANT_ID or the ostree marker) into this block.
        fedora_atomic: { using: glibc_linux  native: brew  provides: flatpak  scale-root: true }

        // Arch family (pacman). Rolling — no version scale; membership is by identity only.
        arch:        { using: glibc_linux  native: pacman }
        manjaro:     { using: arch }
        endeavouros: { using: arch }
        cachyos:     { using: arch }              // performance-tuned Arch (x86-64-v3/v4 repos); rolling
        garuda:      { using: arch }              // gaming-focused Arch; rolling

        // Alpine (apk). musl, NOT glibc — so it hangs off `linux`, not `glibc_linux`. glibc-only
        // fetch-a-binary bindings decline here (unroutable = a clean diagnostic); the optional
        // `gcompat` shim can re-enable them per-machine (see the gcompat component).
        alpine: { using: linux  native: apk }

        // openSUSE / SUSE (zypper). glibc. One synthetic parent declares the driver; Leap is a
        // scale-root (versioned, 15.x) while Tumbleweed is rolling (bare membership, like arch)
        // — a clean demo of identity-vs-scale being orthogonal. Block names use `_` (the `when:`
        // DSL has no `-`); os-release's `opensuse-leap`/`-tumbleweed` alias in.
        opensuse:             { using: glibc_linux  native: zypper }
        opensuse_leap:        { using: opensuse  scale-root: true }
        opensuse_tumbleweed:  { using: opensuse }
    }

    // Driver config: dependencies inherent to a driver (its prerequisite tooling).
    drivers: {
        snap:        { standing: never-auto  requires: [ snapd-socket, snapd-snap-link ] }   // candidate-only = valid + listed + pinnable, never the auto-default (native/flatpak win); a pin forces it. `requires` pulls in snapd + its socket + the /snap symlink, so a snap works on any distro where snapd is installable (a no-op on Ubuntu, which ships snapd). Snaps are now offered everywhere, not just Ubuntu. A user's primary plugin can add `flatpak: { standing: never-auto }` the same way.
        flatpak:     { requires: flatpak }
        appImage:    { requires: [ libfuse2, glibc ] }   // AppImages are glibc-built: decline on musl
        cargo:       { requires: cargo }              // a crate needs the cargo tool
        npm:         { requires: npm }                // a global CLI needs the npm tool (-> node)
        go-install:  { requires: go }                 // `go install` needs the go toolchain
        gem:         { requires: ruby }                // a gem needs ruby (gem ships with it)
        opam:        { requires: opam }                // an OCaml package needs the opam tool
        luarocks:    { requires: luarocks }            // a rock needs the luarocks tool (-> lua)
        cabal:       { requires: cabal }               // a hackage exe needs cabal (-> ghc)
        sdkman:      { requires: sdkman }              // a JVM SDK (scala/groovy/sbt/…) needs the sdkman tool
        font: { requires: [ fontconfig, unzip ] }
        // pip / pipx on musl (Alpine): pip prefers a `musllinux` wheel and pure-Python wheels
        // install fine, but a C-extension package that ships ONLY `manylinux` (glibc) wheels
        // falls back to building from its sdist — which needs a toolchain (gcc, musl-dev,
        // python3-dev) + the package's own C headers. configsys does NOT model those build deps
        // (they're per-package and usually unneeded), so such a build surfaces pip's own
        // compiler error; add the toolchain to a profile if you hit it. No base pip/pipx
        // component is affected — this only concerns C-extension tools a user adds on Alpine.
        pip:         { requires: python3-pip }        // `pip install --user` needs pip
        pipx:        { requires: pipx }               // a PyPI CLI needs the pipx tool
        pyenv:       { requires: [ pyenv, python-build-deps ] }   // compile CPython: the tool + C build libs
        tarball:     { requires: curl }               // fetch the archive with curl
        source:      { requires: git }                // clone + build from a git checkout
        aur:         { requires: [ base-devel, git ] } // makepkg -si builds from PKGBUILD
    }

    // Detected environment facts that `when:` can gate on (see docs/facets.md). General-purpose and
    // shared: a plugin that wants to gate a per-vendor variant on `when: "gpu:nvidia"` / `gpu:amd`
    // (e.g. the opencv plugin's CUDA-vs-HIP stacks) reuses this probe rather than redefining it.
    // Value precedence: a
    // `CONFIGSYS_FACET_gpu` env var, a `facets:` value in the user config, else this probe. Only
    // nvidia/amd are auto-detected (Intel iGPUs vs the compute-capable path are too ambiguous to
    // auto-pick — leave oneAPI opt-in). Override with `facets: { gpu: nvidia }` if the probe is wrong.
    facets: {
        gpu: { kind: categorical
               detect: 'lspci 2>/dev/null || { command -v nvidia-smi >/dev/null 2>&1 && echo NVIDIA; command -v rocminfo >/dev/null 2>&1 && echo "AMD/ATI"; }'
               match: { nvidia: "NVIDIA"  amd: "AMD/ATI" } }   // lspci (pciutils) preferred; falls back to the driver tools if absent (containers/minimal)
    }

    // Component layer: each is a capability + a list of context-selected bindings.
    components: {
        // --- core utilities (base tools; several are driver prerequisites) ---
        flatpak:    { description: "Flatpak — sandboxed app distribution and runtime." install: [ { via: native } ] }
        fontconfig: { description: "fontconfig — font discovery and configuration library." install: [ { via: native } ] }
        unzip:      { description: "Extract ZIP archives." install: [ { via: native } ] }
        zip:        { description: "Create and update ZIP archives." install: [ { via: native } ] }
        curl:       { description: "Transfer data over HTTP(S) and more — the ubiquitous `curl`." install: [ { via: native } ] }
        git:        { description: "Distributed version control — the `git` you already know." install: [ { via: native } ] }
        // Other version-control systems (git is above). Package name == component name except:
        // subversion's CLI is `svn`; bazaar is now Breezy (`brz`); perforce ships `helix-cli` (`p4`).
        mercurial: { description: "Mercurial — a fast distributed version control system (`hg`)."
            install: [ { via: native  when: "not rhel"  repo-component: universe }   // uniform pkg `mercurial`
                       { via: native  when: "rhel"  requires: epel }
                       { via: pipx  name: mercurial  standing: never-auto } ] }       // Python; pinnable alt
        subversion: { description: "Apache Subversion — centralized version control (the `svn` CLI)."
            install: [ { via: native  repo-component: universe } ] }                  // uniform pkg `subversion`
        cvs: { description: "CVS — the classic Concurrent Versions System."
            install: [ { via: native  when: "debian or fedora or arch or fedora_atomic"  repo-component: universe }
                       { via: native  when: "rhel"  requires: epel } ] }              // gone from stable-Alpine + openSUSE
        fossil: { description: "Fossil — a self-contained distributed SCM (wiki, tickets, web UI in one binary)."
            install: [ { via: native  when: "not opensuse and not rhel"  repo-component: universe }
                       { via: native  when: "rhel"  requires: epel }
                       { via: tarball  when: "opensuse"  installDir: "$CONFIGSYS_APP_DIR/fossil"  requires: glibc  // no openSUSE package; upstream static binary
                         version: { static: "2.28" }  url: "https://fossil-scm.org/home/uv/fossil-linux-x64-2.28.tar.gz"
                         latest-check: { url: "https://fossil-scm.org/home/uv/download.html"  regex: "x64-([0-9]+[.][0-9]+)[.]tar" } } ] }   // `refresh` flags a newer fossil release
        perforce: { description: "Perforce Helix Core — the `p4` client and `p4d` server." standing: never-auto
            install: [   // Perforce's own package repo (no distro-native packages); codenames bump as they add releases
                { via: native  when: "ubuntu"  name: helix-cli
                  pubkey-url: "https://package.perforce.com/perforce.pubkey"  pubkey-path: /usr/share/keyrings/perforce.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/perforce.gpg] https://package.perforce.com/apt/ubuntu noble release"
                  source-path: /etc/apt/sources.list.d/perforce.list }
                { via: native  when: "redhat"  name: helix-cli
                  pubkey-url: "https://package.perforce.com/perforce.pubkey"
                  repo-id: perforce  repo-name: "Perforce"  repo-url: "https://package.perforce.com/yum/rhel/9/x86_64" }
                { via: aur  when: "arch"  name: p4 } ] }
        bazaar: { description: "Breezy — the maintained fork of GNU Bazaar (the `brz` CLI); reads Bazaar & Git."
            install: [ { via: native  when: "debian"  name: brz  repo-component: universe }   // `bzr` is a transitional dummy -> brz
                       { via: native  when: "fedora or arch or alpine or opensuse or fedora_atomic"  name: breezy }
                       { via: pipx  when: "rhel"  name: breezy } ] }              // no rhel/EPEL package
        // FUSE2 runtime — the appImage driver requires it; native, name differs by manager.
        libfuse2: { description: "libfuse2 — the FUSE runtime many AppImages need."
            install: [ { via: native  repo-component: universe  name: { dnf: fuse-libs  pacman: fuse2  apk: fuse  default: libfuse2 } } ]
        }
        doas:       { description: "doas — a minimal, simpler sudo alternative." install: [ { via: apk  when: "alpine" } ] }                 // Alpine's sudo (apk-only; folded from the alpine plugin)

        // gcompat: Alpine's glibc-compat shim. It `provides: glibc`, so it can re-enable the
        // glibc-only bindings (AppImages, glibc tarballs) that otherwise decline on musl. It is
        // marked `opt-in` — NEVER auto-pulled to satisfy a `requires: glibc`, because the shim
        // is BEST-EFFORT: it maps many glibc binaries onto musl but not all (symbol-version
        // gaps, NSS, TLS quirks). Silently installing it, then maybe still failing to run the
        // binary, is exactly the surprise configsys avoids. So a musl box declines glibc
        // binaries by default; to gamble on the shim, opt in per-machine — either add `gcompat`
        // to a profile, or provider-pin it:  pins: { glibc: gcompat }.
        gcompat: { description: "gcompat — a glibc compatibility layer for musl (Alpine)."
            provides: glibc
            standing: never-auto
            install: [ { via: apk  when: "alpine" } ]
        }
        python3-pip: { description: "pip — the Python package installer." install: [ { via: native  name: { pacman: python-pip  zypper: python313-pip  apk: py3-pip } } ] }

        // Python interpreters as VERSION-SCOPED providers of the `python3` capability. Install specific
        // versions side-by-side — each is a distinct `/usr/bin/python3.X` (or a pyenv build), so they
        // coexist as normal residents — and let a tool floor its interpreter with
        // `requires: { python3: ">=3.11" }` (the constraint selects/enables the matching version;
        // 3.13 is the default when several qualify). Two methods each: `native` for a fast binary
        // (Ubuntu's non-default versions come from the deadsnakes PPA; Fedora ships them directly), and
        // `pyenv` to COMPILE any version user-scope (newest/RCs, per-project via `.python-version`) —
        // pick the method with a binding-pin. NEVER repoints the system `python3` default (apt and
        // distro tools depend on it): select a version by calling `python3.X` or a venv built from it.
        // 3.11 / 3.12 / 3.14 are `never-auto` (constraint- or explicitly-selected); 3.13 is the modern
        // default (3.14 is stable but opt-in until the package ecosystem fully catches up to it).
        python3.11: { description: "Python 3.11 interpreter (+ venv, dev headers)."
            standing: never-auto  provides: { python3: "3.11" }
            install: [
                { via: native  when: "debian"  packages: [ python3.11, python3.11-venv, python3.11-dev ]
                  ppa: deadsnakes/ppa  requires: software-properties-common }
                { via: native  when: "fedora or redhat"  packages: [ python3.11 ] }
                { via: pyenv  version: "3.11" }
            ]
        }
        python3.12: { description: "Python 3.12 interpreter (+ venv, dev headers)."
            standing: never-auto  provides: { python3: "3.12" }
            install: [
                { via: native  when: "debian"  packages: [ python3.12, python3.12-venv, python3.12-dev ]
                  ppa: deadsnakes/ppa  requires: software-properties-common }
                { via: native  when: "fedora or redhat"  packages: [ python3.12 ] }
                { via: pyenv  version: "3.12" }
            ]
        }
        python3.13: { description: "Python 3.13 interpreter (+ venv, dev headers) — the modern default."
            provides: { python3: "3.13" }
            install: [
                { via: native  when: "debian"  packages: [ python3.13, python3.13-venv, python3.13-dev ]
                  ppa: deadsnakes/ppa  requires: software-properties-common }
                { via: native  when: "fedora or redhat"  packages: [ python3.13 ] }
                { via: pyenv  version: "3.13" }
            ]
        }
        python3.14: { description: "Python 3.14 interpreter (+ venv, dev headers) — the newest stable line."
            standing: never-auto  provides: { python3: "3.14" }
            install: [
                { via: native  when: "debian"  packages: [ python3.14, python3.14-venv, python3.14-dev ]
                  ppa: deadsnakes/ppa  requires: software-properties-common }
                { via: native  when: "fedora or redhat"  packages: [ python3.14 ] }
                { via: pyenv  version: "3.14" }
            ]
        }
        cython: { description: "Cython — compile Python-like code to C extension modules."
            requires: [ python3, cpp-toolchain ]
            install: [ { via: native  name: { apt: cython3  dnf: python3-Cython  pacman: cython  zypper: python3-Cython  apk: py3-cython } } ] }

        // pyenv itself + the C libraries it needs to COMPILE CPython — the `via: pyenv` method's deps
        // (see drivers.pyenv). pyenv installs user-scope under ~/.pyenv via its official installer.
        pyenv: { description: "pyenv — build & switch Python versions from source, user-scope."
            requires: curl
            install: [ { via: script
                install-cmd:   'curl -fsSL https://pyenv.run | bash'
                version-cmd:   '"$HOME/.pyenv/bin/pyenv" --version 2>/dev/null'
                version-re:    '([0-9][0-9.]*)'
                uninstall-cmd: 'rm -rf "$HOME/.pyenv"' } ] }
        // uv — Astral's very fast Python package/project manager (a single Rust binary). Native
        // where packaged (arch; brew on atomic); pipx is the universal default elsewhere; the github
        // tarball and cargo are pinnable alternates. NOT in the debian/ubuntu repos.
        uv: { description: "uv — Astral's very fast Python package & project manager (Rust)."
            install: [
                { via: native   when: "arch" }                     // pacman: uv
                { via: native   when: "fedora_atomic" }            // brew formula `uv`
                { via: pipx     name: uv }                         // universal (prebuilt wheels)
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/uv"  requires: glibc  standing: never-auto
                  version: { github: astral-sh/uv  strip-v: true  asset: "uv-x86_64-unknown-linux-gnu.tar.gz" } } ]
        }
        python-build-deps: { description: "System libraries pyenv needs to compile CPython (ssl/zlib/ffi/…)."
            standing: never-auto
            install: [
                { via: native  when: "debian"  packages: [ build-essential, libssl-dev, zlib1g-dev, libbz2-dev,
                    libreadline-dev, libsqlite3-dev, libncursesw5-dev, xz-utils, tk-dev, libffi-dev, liblzma-dev ] }
                { via: native  when: "fedora or redhat"  packages: [ gcc, make, zlib-devel, bzip2-devel,
                    readline-devel, sqlite-devel, openssl-devel, tk-devel, libffi-devel, xz-devel ] }
                { via: native  when: "arch"  packages: [ base-devel, openssl, zlib, xz, tk ] }   // pyenv's documented Arch build env (Arch bundles headers, no -dev split). Keep `base-devel` — it's a META-package now (not a group, since 2023-02), so `pacman -Q` detects it exactly AND it tracks new build-tool members on upgrade; expanding it to concrete members would silently miss future additions.
            ] }
        // EL keeps these in EPEL, base repos everywhere else — same two-binding shape as btop.
        // `repo-component: universe` is the apt archive area (read only by apt; ignored on dnf/pacman).
        ripgrep: { description: "Fast recursive regex search (`rg`) — grep, but much quicker."
                   install: [ { via: native  when: "rhel"  requires: epel } { via: native  repo-component: universe }
                              { via: tarball  installDir: "$CONFIGSYS_APP_DIR/ripgrep"  version: { github: BurntSushi/ripgrep  asset: "ripgrep-*-x86_64-unknown-linux-musl.tar.gz" } } ] }   // prebuilt musl binary (rg in a versioned subdir)
        fzf:     { description: "Fuzzy finder — interactive filtering for files, history, anything piped in."
                   install: [ { via: native  when: "rhel"  requires: epel } { via: native  repo-component: universe }
                              { via: tarball  installDir: "$CONFIGSYS_APP_DIR/fzf"  version: { github: junegunn/fzf  strip-v: true  asset: "fzf-*-linux_amd64.tar.gz" } } ] }
        xclip:   { description: "xclip — command-line access to the X clipboard." suggests: xclip-dotfiles
                   install: [ { via: native  when: "rhel"  requires: epel } { via: native  repo-component: universe } ] }
        xclip-dotfiles: { description: "xclip helper config, linked into place." install: [ { via: dotfiles  requires: bash-dotfiles  src: bash.d/xclip.sh  dst: ~/.bash.d/xclip.sh } ] }

        // btop lives in EPEL on EL (needs epel enabled), base repos everywhere else.
        // Two native bindings: the EL one adds `requires: epel`; both are dnf\btop.
        btop: {
            description: "System-resource monitor — CPU/mem/net/disk in a colorful TUI."
            install: [
                { via: native  when: "rhel"  requires: epel }
                { via: native  repo-component: universe }
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/btop"  version: { github: aristocratos/btop  strip-v: true  asset: "btop-x86_64-unknown-linux-musl.tar.gz" } }   // prebuilt musl binary (btop/bin/btop)
            ]
        }
        htop: { description: "Interactive process viewer — a colorful, friendlier top."
            suggests: htop-dotfiles
            install: [
                { via: native  when: "rhel"  requires: epel }   // EL ships htop in EPEL, like btop
                { via: native  repo-component: universe }
            ]
        }
        htop-dotfiles: { description: "htop config, linked into place."
            install: [ { via: dotfiles  config: { src: htop  dst: $XDG_CONFIG_HOME/htop } } ]
        }

        // bottom (`btm`): Rust system monitor. Native `bottom` where packaged (Debian 12+/Ubuntu
        // universe, Fedora, Arch, openSUSE, Alpine, Homebrew); EL has no package, so cargo builds it.
        bottom: {
            description: "Cross-platform system monitor (`btm`) — CPU/mem/net/process/disk in a TUI."
            install: [
                { via: native  when: "not rhel"  repo-component: universe }
                { via: cargo  name: bottom }   // builds `btm`; covers EL + any older-distro gap
            ]
        }

        // ncdu: NCurses disk-usage analyzer. Packaged as `ncdu` in every base repo (EL via EPEL,
        // Ubuntu universe — the htop/btop pattern).
        ncdu: {
            description: "NCurses disk-usage analyzer — find what's eating your disk (`ncdu`)."
            install: [
                { via: native  when: "rhel"  requires: epel }
                { via: native  repo-component: universe }
            ]
        }

        // duf: a colorful, friendlier `df` (Go). Native where packaged (Debian 12+/Ubuntu universe,
        // Fedora, Arch, openSUSE, Alpine, Homebrew); EL has no package, so `go install` builds it.
        duf: {
            description: "Disk Usage/Free — a colorful, friendlier `df` (`duf`)."
            install: [
                { via: native  when: "not rhel"  repo-component: universe }
                { via: go-install  name: "github.com/muesli/duf" }   // builds `duf`; covers EL
            ]
        }

        configsys-dotfiles: { description: "configsys's own shell integration, linked into place."
            install: [
                // 00- prefix: the ~/.bash.d loader sources files in lexical order, so this runs
                // FIRST and its CONFIGSYS_*_DIR exports are available to every other snippet.
                { via: dotfiles  requires: bash-dotfiles  src: bash.d/00-configsys.sh  dst: ~/.bash.d/00-configsys.sh }
            ]
        }

        // --- shells & terminal multiplexers ---
        // tmux/zsh/fish are packaged under the same name in every distro's base repos.
        tmux: { description: "Terminal multiplexer — split panes and detachable sessions."
                suggests: tmux-dotfiles
                install: [ { via: native } ] }
        tmux-dotfiles: { description: "tmux config, linked into place."
                install: [ { via: dotfiles  config: { src: tmux  dst: $XDG_CONFIG_HOME/tmux } } ] }
        zsh:  { description: "Z shell — a powerful interactive shell." install: [ { via: native } ] }
        fish: { description: "Friendly interactive shell — smart autosuggestions out of the box." install: [ { via: native } ] }
        // nushell isn't in Debian/Ubuntu/Fedora base repos; native where it is (Arch, Homebrew),
        // else the upstream glibc release tarball (ships `nu` + its plugins).
        nushell: {
            description: "A shell whose pipelines carry structured data, not just text (`nu`)."
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }              // brew formula `nushell`
                { via: tarball  when: "not alpine"  installDir: "$CONFIGSYS_APP_DIR/nushell"  requires: glibc
                  version: { github: nushell/nushell  strip-v: true  asset: "nu-*-x86_64-unknown-linux-gnu.tar.gz" } }
                { via: tarball  when: "alpine"  installDir: "$CONFIGSYS_APP_DIR/nushell"   // musl build for Alpine (the gnu one needs glibc)
                  version: { github: nushell/nushell  strip-v: true  asset: "nu-*-x86_64-unknown-linux-musl.tar.gz" } }
            ]
        }

        // --- terminal emulators & TUI file managers ---
        // kitty: GPU-accelerated terminal emulator, packaged natively across every base repo
        // (apt/dnf/pacman/zypper/apk all carry `kitty`).
        kitty: { description: "Fast, GPU-accelerated terminal emulator." install: [ { via: native } ] }
        // ghostty: Zig terminal emulator. The only official native package among our managers is
        // Arch's (openSUSE dropped it over Zig-version churn, Fedora is COPR-only, Debian is
        // community-only, and it's absent from Alpine's community repo — name sweep confirmed) — so
        // native is gated to arch and everywhere else falls back to the community "universal"
        // AppImage (pkgforge-dev; glibc/fuse2, unpacked under ~/apps). Musl-only boxes (Alpine)
        // have no verified method, so ghostty simply declines there. The `asset` glob discovers the
        // real download URL from the GitHub API (no hand-templated url).
        ghostty: { description: "Fast, native GPU-accelerated terminal emulator."
            install: [
                { via: native  when: "arch" }
                { via: appImage  name: Ghostty  scope: user
                  version: { github: pkgforge-dev/ghostty-appimage  strip-v: true  asset: "Ghostty-*-$ARCH.AppImage" }
                  path: ~/apps/ghostty.appimage }
            ]
        }
        // yazi: Rust TUI file manager. Native on Arch + Homebrew; upstream ships a real .deb, so on
        // Debian/Ubuntu (not in-repo) install that via the OS package tool — clean and on PATH.
        // Elsewhere (Fedora is COPR-only; openSUSE/Alpine/EL absent) the release zip lands under
        // ~/apps and its companion snippet aliases `yazi`.
        yazi: {
            description: "Blazing-fast terminal file manager with image previews."
            suggests: yazi-dotfiles
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }              // brew formula `yazi`
                { via: native-pkg-file  when: "debian"
                  version: { github: sxyazi/yazi }
                  asset: { x86_64: yazi-x86_64-unknown-linux-gnu.deb  aarch64: yazi-aarch64-unknown-linux-gnu.deb } }
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/yazi"  requires: [ glibc, unzip ]
                  version: { github: sxyazi/yazi  asset: "yazi-$ARCH-unknown-linux-gnu.zip" } }
            ]
        }
        yazi-dotfiles: { description: "yazi config, linked into place."
            install: [ { via: dotfiles  requires: bash-dotfiles  src: bash.d/yazi.sh  dst: ~/.bash.d/yazi.sh } ]
        }
        // superfile (`spf`): Go TUI file manager. Native on Arch + Homebrew; elsewhere the GitHub
        // release tarball (its official install.sh sudo-installs and edits shell rc files — the
        // surprises configsys avoids — so we unpack userland under ~/apps and alias `spf`).
        superfile: {
            description: "Modern terminal file manager (`spf`) with a pretty TUI."
            suggests: superfile-dotfiles
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }              // brew formula `superfile`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/superfile"  requires: glibc
                  version: { github: yorukot/superfile  asset: "superfile-linux-*-amd64.tar.gz" } }
            ]
        }
        superfile-dotfiles: { description: "superfile config, linked into place."
            install: [ { via: dotfiles  requires: bash-dotfiles  src: bash.d/superfile.sh  dst: ~/.bash.d/superfile.sh } ]
        }

        // mc: Midnight Commander — packaged as `mc` in every base repo (EL via EPEL, like htop/btop).
        mc: {
            description: "Midnight Commander — a two-pane TUI file manager (`mc`)."
            install: [
                { via: native  when: "rhel"  requires: epel }
                { via: native  repo-component: universe }
            ]
        }

        // espeak: we install espeak-ng (the maintained fork; provides the `espeak` command),
        // packaged as `espeak-ng` everywhere (Debian/Ubuntu universe, Fedora, Arch, openSUSE,
        // Alpine, Homebrew; EL via EPEL).
        espeak: {
            description: "espeak-ng — compact software speech synthesizer (`espeak`)."
            install: [
                { via: native  when: "rhel"  requires: epel  name: espeak-ng }
                { via: native  repo-component: universe  name: espeak-ng }
            ]
        }

        // EPEL: a capability enabled by installing epel-release (only on EL). Anything
        // that `requires: epel` is a no-op off EL (nothing needs it) and pulls this in on EL.
        epel-release: { description: "EPEL — Extra Packages for Enterprise Linux (an extra RHEL repo)."
            provides: epel
            install: [ { via: native  when: "rhel" } ]
        }

        // pipx: the version-variant collapse. Native package where the repos have it;
        // a pip --user bootstrap on old Ubuntu/Debian; +EPEL on EL. Was a \pip family +
        // apt/dnf/pacman entries + two @version blocks + a rhel override — now three bindings.
        pipx: { description: "Install and run Python CLI apps in isolated environments."
            install: [
                { via: pip     when: "(ubuntu < 23.04) or (debian < 12)"  name: pipx  version: { pypi: pipx } }
                { via: native  when: "rhel"  requires: epel  name: { pacman: python-pipx } }
                { via: native  name: { pacman: python-pipx  zypper: python313-pipx } }
            ]
        }

        // The Rust toolchain, explicit and directly usable (rustc + cargo). It `provides: cargo`,
        // so the cargo DRIVER's `requires: cargo` (a crate needs the cargo tool) is satisfied by
        // installing rust — there is no separate `cargo` component. Package names bring the WHOLE
        // toolchain: apt `rust-all` (metapkg: rustc+cargo+gdb+doc), Arch/Homebrew `rust` (bundles
        // cargo), and elsewhere `cargo` transitively pulls rustc (dnf/apk/zypper).
        rust: { description: "The Rust toolchain (cargo, rustc) — safe systems programming."
            provides: cargo
            install: [
                { via: native  repo-component: universe  name: { apt: rust-all  pacman: rust  brew: rust  default: cargo } }
                // rustup: the official installer -> the LATEST STABLE toolchain, userland in
                // ~/.cargo (no sudo, on the standard ~/.cargo/bin PATH). For source builds that
                // need a newer cargo than the distro ships (the toolchain-floor case). Least-
                // preferred (via: script is last in driver-preference), so it NEVER wins by default
                // — native stays the default; pin `rust script` (or let a cargo>=X floor advise it).
                // Its available version is the current stable (read from the stable channel
                // manifest); `provides: { cargo }` is the floor it guarantees. `--no-modify-path`
                // keeps rustup from editing your shell rc (no surprises) — the SOURCE driver
                // prepends ~/.cargo/bin for builds, so a floor-pinned rust builds; for INTERACTIVE
                // use, put ~/.cargo/bin on PATH yourself (configsys ships no personal shell config).
                { via: script  requires: curl
                  provides: { cargo: ">=1.80" }
                  version: { url: "https://static.rust-lang.org/dist/channel-rust-stable.toml"
                             regex: '\[pkg\.rust\]\s*\n\s*version = "([0-9]+\.[0-9]+\.[0-9]+)' }
                  install-cmd:   "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path"
                  version-cmd:   "$HOME/.cargo/bin/cargo --version"
                  version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                  uninstall-cmd: "$HOME/.cargo/bin/rustup self uninstall -y"
                  location:      "~/.cargo/bin" }
            ]
        }

        // Node.js toolchain (node + npm), directly usable. It `provides: npm`, so the npm
        // DRIVER's `requires: npm` is met by installing node. One native binding brings both:
        // apt/Arch/Alpine `npm` transitively pulls nodejs; Fedora/openSUSE `nodejs` and
        // Homebrew `node` bundle npm.
        node: { description: "Node.js — JavaScript runtime built on V8."
            provides: npm
            install: [ { via: native  repo-component: universe  name: { apt: npm  pacman: npm  apk: npm  brew: node  zypper: nodejs-default  default: nodejs } }
                       { via: snap  name: node  classic: true } ]   // OpenJS-official snap (candidate-only)
        }
        // Sample global npm CLIs (installed userland by default; see the npm driver). More can
        // be added the same way, or pulled per-user via a plugin layer.
        typescript: { description: "TypeScript — typed JavaScript, compiles to JS (`tsc`)." install: [ { via: npm  name: typescript } ] }
        prettier:   { description: "Prettier — an opinionated code formatter for web languages." install: [ { via: npm  name: prettier } ] }
        // Front-end package managers + Dart Sass — npm globals (userland, like the above). NOTE:
        // recent pnpm/sass want a modern Node (pnpm >=22); the distro's apt node can be too old —
        // use a version-managed node (nvm/fnm) if you hit a "requires Node vXX" error.
        pnpm:       { description: "pnpm — fast, disk-efficient Node package manager." install: [ { via: npm  name: pnpm } ] }
        yarn:       { description: "Yarn — a Node package manager." install: [ { via: npm  name: yarn } ] }
        sass:       { description: "Sass — CSS with superpowers (the `sass` compiler)." install: [ { via: npm  name: sass } ] }

        // Deno & Bun — alternative JS/TS runtimes. Native on Arch/Homebrew where packaged; else
        // the upstream github release ZIP (glibc-linked; the tarball driver unzips it). Both have
        // STABLE asset names (no version in the filename), so they use github's API-free
        // `releases/latest/download` URL — robust even when api.github.com is unreachable.
        deno: { description: "Deno — secure JavaScript/TypeScript runtime with built-in tooling."
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }             // brew formula `deno`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/deno"  requires: [ glibc, unzip ]  version: { static: latest }
                  url: "https://github.com/denoland/deno/releases/latest/download/deno-x86_64-unknown-linux-gnu.zip" } ]
        }
        bun: { description: "Bun — fast all-in-one JavaScript runtime, bundler, and package manager."
            install: [
                { via: native  when: "fedora_atomic" }             // brew formula `bun`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/bun"  requires: [ glibc, unzip ]  version: { static: latest }
                  url: "https://github.com/oven-sh/bun/releases/latest/download/bun-linux-x64.zip" } ]
        }

        // Go toolchain, directly usable. Auto-provides the `go` capability the go-install
        // driver requires. Package names: apt `golang-go`, dnf `golang`, else `go`.
        go: { description: "The Go programming language toolchain."
            install: [
                { via: native  name: { apt: golang-go  dnf: golang  default: go } }
                // the official Go toolchain tarball — latest stable, userland under
                // $CONFIGSYS_SDK_DIR/go (~/sdks/go by default; `strip: 1` drops the archive's `go/`
                // wrapper so `go` lands at .../go/bin). For source builds that need a newer Go than
                // the distro ships (lazygit/superfile floors). Least-preferred (native stays the
                // default; pin `go tarball`, or let a go>=X floor advise it). The source driver puts
                // ~/sdks/go/bin on PATH for builds; `provides: { go }` is the floor it guarantees.
                { via: tarball  installDir: "$CONFIGSYS_SDK_DIR/go"  strip: 1  requires: [ glibc, curl ]
                  provides: { go: ">=1.21" }
                  version: { url: "https://go.dev/VERSION?m=text"  regex: "go([0-9.]+)" }
                  url: "https://go.dev/dl/go$VERSION.linux-amd64.tar.gz" }
            ]
        }
        // Sample `go install` tool (module path in `name:`; binary = its last segment).
        goimports: { description: "goimports — format Go code and fix imports." install: [ { via: go-install  name: "golang.org/x/tools/cmd/goimports" } ] }

        // Ruby toolchain (ships gem + irb). Auto-provides `ruby` for the gem driver. apt
        // `ruby-full` bundles the dev headers gems' native extensions need; else `ruby`.
        ruby: { description: "The Ruby programming language."
            install: [ { via: native  name: { apt: ruby-full  default: ruby } } ]
        }
        // Sample gem (userland by default; see the gem driver).
        bundler: { description: "Bundler — manage Ruby gem dependencies (`bundle`)." install: [ { via: gem  name: bundler } ] }

        // PHP toolchain — the CLI interpreter + Composer (its project dependency manager). The bare
        // `php` package is the Apache/mod_php web stack on apt AND dnf, so the CLI package is
        // `php-cli` there; Arch/brew ship a plain `php`; Alpine is versioned-only (`php84`);
        // openSUSE uses `php8-cli`. Third-party repos (Surý on Debian/Ubuntu, Remi on Fedora/RHEL)
        // add non-default PHP versions — not modeled here; the distro default is enough.
        php: { description: "PHP — the PHP command-line interpreter (`php`)."
            install: [ { via: native  repo-component: universe
                         name: { apt: php-cli  dnf: php-cli  pacman: php  apk: php84  zypper: php8-cli  brew: php } } ]
        }
        composer: { description: "Composer — PHP's per-project dependency manager." requires: php
            install: [ { via: native  when: "not rhel"  repo-component: universe  name: { zypper: php-composer2  default: composer } }
                       { via: native  when: "rhel"  requires: epel  name: composer } ]
        }

        // .NET SDK — build & run C#/F# apps. Native from the distro's OWN repos on arch (rolling),
        // ubuntu 22.04+, fedora, and alpine (no Microsoft feed needed). On debian/rhel/openSUSE the
        // upstream dotnet-install.sh lands a per-user SDK under ~/.dotnet (add it to PATH yourself);
        // the Canonical snap (classic) is a pinnable all-distro alternate. Distro packages are
        // per-major (8.0 = current LTS) — bump the channel/pkg as newer LTS lines land.
        dotnet: { description: ".NET SDK — build & run .NET (C#/F#) apps (`dotnet`)."
            install: [
                { via: native  when: "arch"    name: dotnet-sdk }              // rolling latest
                { via: native  when: "ubuntu"  name: dotnet-sdk-8.0 }          // Canonical feed (22.04+)
                { via: native  when: "fedora"  name: dotnet-sdk-8.0 }          // Fedora's own repo
                { via: native  when: "alpine"  name: dotnet8-sdk }             // community
                { via: script  when: "debian or rhel or opensuse"
                  install-cmd:   'curl -fsSL https://dot.net/v1/dotnet-install.sh | bash -s -- --channel 8.0'
                  version-cmd:   '"$HOME/.dotnet/dotnet" --version 2>/dev/null'
                  version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                  uninstall-cmd: 'rm -rf "$HOME/.dotnet"'
                  location:      '~/.dotnet' }
                { via: snap  name: dotnet-sdk  classic: true } ]               // Canonical; pinnable all-distro
        }

        // --- native language toolchains (directly usable; ecosystem module drivers deferred) ---
        // JDK — VERSION-SCOPED providers of the `jdk` capability (the python3.X pattern for Java).
        // `jdk` is the default (OpenJDK 21, the current LTS); jdk-17/jdk-25 are opt-in `never-auto`
        // LTS lines; graalvm is GraalVM CE (native-image) via SDKMAN. A consumer floors its runtime
        // with `requires: { jdk: ">=21" }` — the constraint selects/enables the matching line; a plain
        // `requires: jdk` takes the default. Bump `jdk` to the next LTS when it lands (like
        // python3.13-is-default). Native openjdk-N track the latest patch; the SDKMAN graalvm id ages.
        jdk: { description: "Java Development Kit — OpenJDK 21 (the current LTS default)."
            provides: { jdk: 21 }
            install: [ { via: native  name: { apt: openjdk-21-jdk  dnf: java-21-openjdk-devel  pacman: jdk21-openjdk  apk: openjdk21  zypper: java-21-openjdk-devel  brew: "openjdk@21" } } ]
        }
        jdk-17: { description: "OpenJDK 17 — the previous LTS Java line." standing: never-auto  provides: { jdk: 17 }
            install: [ { via: native  name: { apt: openjdk-17-jdk  dnf: java-17-openjdk-devel  pacman: jdk17-openjdk  apk: openjdk17  zypper: java-17-openjdk-devel  brew: "openjdk@17" } } ] }
        jdk-25: { description: "OpenJDK 25 — the newest LTS Java line." standing: never-auto  provides: { jdk: 25 }
            install: [ { via: native  name: { apt: openjdk-25-jdk  dnf: java-25-openjdk-devel  pacman: jdk25-openjdk  apk: openjdk25  zypper: java-25-openjdk-devel  brew: "openjdk@25" } } ] }
        graalvm: { description: "GraalVM CE 21 — a JDK with native-image (ahead-of-time compilation), via SDKMAN."
            standing: never-auto  provides: { jdk: 21 }
            install: [ { via: sdkman  name: java  version: "21.0.2-graalce"   // bump the SDKMAN id as releases roll
                         latest-check: { github: graalvm/graalvm-ce-builds  tag-re: "jdk-([0-9][0-9.]*)" } } ] }   // `refresh` flags when a newer GraalVM ships
        // SDKMAN — a JVM SDK manager installed by its own shell script (the demonstrator for the
        // `script` driver: lifecycle commands declared as data, incl. a clean uninstall). `sdk`
        // is a shell function, so version-cmd sources the init script in the same shell.
        sdkman: { description: "SDKMAN! — manage parallel versions of JVM SDKs and tools."
            suggests: sdkman-dotfiles
            install: [ { via: script
                         install-cmd: 'curl -s https://get.sdkman.io | bash'
                         version-cmd: 'source "$HOME/.sdkman/bin/sdkman-init.sh" && sdk version'
                         version-re: '([0-9]+\.[0-9]+\.[0-9]+)'
                         uninstall-cmd: 'rm -rf "$HOME/.sdkman"'
                         location: '~/.sdkman' } ]
        }
        sdkman-dotfiles: { description: "SDKMAN shell init — sources sdkman-init.sh from ~/.bash.d so `sdk` + the selected SDKs are on PATH."
            install: [ { via: dotfiles  requires: bash-dotfiles  src: bash.d/sdkman.sh  dst: ~/.bash.d/sdkman.sh } ] }

        // Kotlin compiler — native on Arch/Homebrew; else the github release ZIP. Needs a JVM to
        // run (requires jdk) and unzip to unpack. (SDKMAN is the other path — via the script driver.)
        kotlin: { description: "Kotlin — modern JVM language, Android's default."
            install: [
                { via: native  when: "arch" }                      // pacman: kotlin
                { via: native  when: "fedora_atomic" }             // brew formula `kotlin`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/kotlin"  requires: [ jdk, unzip ]
                  version: { github: JetBrains/kotlin  strip-v: true  asset: "kotlin-compiler-*.zip" }
                  url: "https://github.com/JetBrains/kotlin/releases/download/v$VERSION/kotlin-compiler-$VERSION.zip" } ]
        }
        // OCaml compiler (opam driver deferred).
        ocaml: { description: "OCaml — pragmatic functional language with a fast native compiler." install: [ { via: native  repo-component: universe } ] }
        // Lua interpreter (luarocks deferred). Some distros suffix the package with the version.
        lua:   { description: "The Lua programming language — small, embeddable scripting." install: [ { via: native  repo-component: universe  name: { apt: lua5.4  apk: lua5.4  zypper: lua54  default: lua } } ] }
        // Tcl/Tk — the Tool Command Language interpreter (`tclsh`) + its Tk GUI toolkit (`wish`).
        // Native everywhere (uniform `tcl`/`tk`); Homebrew ships both in one `tcl-tk` formula.
        tcl: { description: "Tcl — the Tool Command Language interpreter (`tclsh`)."
            install: [ { via: native  repo-component: universe  name: { brew: tcl-tk } } ] }
        tk:  { description: "Tk — the Tcl GUI toolkit (`wish`) and widget library." requires: tcl
            install: [ { via: native  repo-component: universe  name: { brew: tcl-tk } } ] }

        // --- more languages. GCC front-ends (gfortran/gnat/d-via-gdc) whose package name varies
        // per manager; niche/compiled langs via github release or an official repo. ---
        gfortran: { description: "GNU Fortran — the GCC Fortran compiler (`gfortran`)."
            install: [ { via: native  name: { dnf: gcc-gfortran  pacman: gcc-fortran  zypper: gcc-fortran  brew: gcc  default: gfortran } } ] }   // brew bundles gfortran in `gcc`
        gnat: { description: "GNAT — the GCC Ada compiler."
            install: [ { via: native  when: "not fedora_atomic"  name: { dnf: gcc-gnat  pacman: gcc-ada  apk: gcc-gnat  zypper: gcc-ada  default: gnat } } ] }   // no brew Ada front-end
        gnucobol: { description: "GnuCOBOL — a COBOL compiler (`cobc`)."
            install: [ { via: native  when: "not arch"  name: { zypper: gnu-cobol  default: gnucobol } }
                       { via: aur  when: "arch"  name: gnucobol } ] }   // AUR-only on Arch
        d: { description: "The D programming language (a D compiler — LDC / GDC / DMD per distro)."
            install: [ { via: native  when: "fedora or arch or alpine or fedora_atomic"  name: ldc }   // LLVM D compiler
                       { via: native  when: "debian"  name: gdc }        // GCC D front-end (ldc is sid-only on debian)
                       { via: native  when: "opensuse"  name: dmd } ] }
        crystal: { description: "Crystal — a Ruby-like, LLVM-backed compiled language."
            install: [ { via: native  when: "arch or alpine or fedora_atomic" }   // pacman/apk/brew `crystal`
                       { via: script  when: "debian or redhat"           // official installer: adds the crystal repo + installs the package
                         install-cmd:   'curl -fsSL https://crystal-lang.org/install.sh | sudo bash'
                         version-cmd:   'crystal --version 2>/dev/null'
                         version-re:    '([0-9][0-9.]*)'
                         uninstall-cmd: 'sudo apt-get remove -y crystal 2>/dev/null || sudo dnf remove -y crystal 2>/dev/null'
                         location:      'crystal (dist.crystal-lang.org repo)' } ] }
        dart: { description: "Dart — Google's language & SDK for apps and Flutter."
            install: [ { via: native  when: "arch" }                     // pacman: dart (extra)
                       { via: native  when: "fedora_atomic"  name: dart-sdk }   // brew dart-sdk
                       { via: native  when: "debian"  name: dart          // Google's official apt repo (single `stable` suite — codename-independent)
                         pubkey-url: "https://dl-ssl.google.com/linux/linux_signing_key.pub"  pubkey-path: /usr/share/keyrings/dart.gpg
                         source-line: "deb [signed-by=/usr/share/keyrings/dart.gpg arch=amd64] https://storage.googleapis.com/download.dartlang.org/linux/debian stable main"
                         source-path: /etc/apt/sources.list.d/dart.list } ] }
        raku: { description: "Raku (Rakudo) — the Raku language, formerly Perl 6."
            install: [ { via: native  when: "not arch"  repo-component: universe  name: { brew: rakudo-star  default: rakudo } }
                       { via: aur  when: "arch"  name: rakudo-star } ] }   // AUR-only on Arch
        v: { description: "V — a simple, fast-compiling language (the `v` compiler)." requires: cc
            install: [ { via: native  when: "fedora_atomic"  name: vlang }   // brew vlang
                       { via: aur  when: "arch"  name: vlang-bin }
                       { via: tarball  when: "not arch and not fedora_atomic"  installDir: "$CONFIGSYS_APP_DIR/v"  requires: [ glibc, unzip ]  version: { static: latest }
                         url: "https://github.com/vlang/v/releases/latest/download/v_linux.zip" } ] }   // prebuilt zip
        gleam: { description: "Gleam — a friendly, statically-typed language for the Erlang VM." requires: erlang
            install: [ { via: native  when: "arch or alpine or fedora_atomic" }   // pacman/apk/brew gleam
                       { via: tarball  when: "not arch and not alpine and not fedora_atomic"  installDir: "$CONFIGSYS_APP_DIR/gleam"  requires: glibc
                         version: { github: gleam-lang/gleam  strip-v: true  asset: "gleam-*-x86_64-unknown-linux-musl.tar.gz" } } ] }   // single static binary
        fennel: { description: "Fennel — a Lisp that compiles to Lua." requires: lua
            install: [ { via: native  when: "fedora or arch or alpine or fedora_atomic" }   // dnf/pacman/apk/brew fennel
                       { via: luarocks  when: "not fedora and not arch and not alpine and not fedora_atomic"  name: fennel } ] }
        // swift: no distro-native package (Linux install is swiftly/tarball, manual); Arch has an AUR
        // binary. Listed for arch; elsewhere it's an honest unroutable until we model swiftly.
        swift: { description: "Swift — the Swift language toolchain."
            install: [ { via: aur  when: "arch"  name: swift-bin } ] }

        // JVM + Scheme langs. scala/clojure/groovy need a JDK. (No `via: sdkman` driver exists — sdkman
        // is only a component — so these use native / official installer scripts / snap, not sdkman.)
        clojure: { description: "Clojure — a Lisp dialect on the JVM (`clj`)." requires: jdk
            install: [ { via: native  when: "debian or arch or alpine or fedora_atomic"  repo-component: universe }   // uniform `clojure`
                       { via: script  when: "fedora or rhel or opensuse"   // clojure.org's official linux-install.sh
                         install-cmd:   'curl -fsSL https://github.com/clojure/brew-install/releases/latest/download/linux-install.sh | sudo bash'
                         version-cmd:   'clojure --version 2>/dev/null'
                         version-re:    '([0-9][0-9.]*)'
                         uninstall-cmd: 'sudo rm -rf /usr/local/bin/clj /usr/local/bin/clojure /usr/local/lib/clojure'
                         location:      '/usr/local/lib/clojure' } ] }
        groovy: { description: "Apache Groovy — a dynamic language for the JVM." requires: jdk
            install: [ { via: sdkman }   // current Groovy 5, any distro (the clean default)
                       { via: native  when: "arch or debian or fedora_atomic"  standing: never-auto  repo-component: universe } ] }   // pacman/apt/brew (older); pinnable
        scala: { description: "Scala — an object-functional language on the JVM." requires: jdk
            install: [ { via: sdkman }   // current Scala 3, any distro (SDKMAN — native is ancient on debian, AUR-only on arch)
                       { via: native  when: "fedora_atomic"  standing: never-auto }   // brew scala (pinnable alt)
                       { via: aur  when: "arch"  name: scala  standing: never-auto } ] }
        sbt: { description: "sbt — the interactive build tool for Scala." requires: jdk
            install: [ { via: sdkman } ] }
        leiningen: { description: "Leiningen — build automation for Clojure (`lein`)." requires: jdk
            install: [ { via: sdkman } ] }
        // More JVM-ecosystem tools via SDKMAN (all need a JDK; `sdk install <name>`, any distro). Build
        // tools, framework CLIs, run/scripting, data engines, DB/quality/release, profiling. (SDKMAN
        // has more — grails/vertx/helidon/tomcat/jetty/hadoop/kscript/… — add the same way if wanted.)
        mvnd:       { description: "Maven Daemon (mvnd) — a faster Maven with a resident build daemon." requires: jdk  install: [ { via: sdkman } ] }
        ant:        { description: "Apache Ant — the classic XML-driven Java build tool." requires: jdk  install: [ { via: sdkman } ] }
        springboot: { description: "Spring Boot CLI — scaffold and run Spring Boot applications." requires: jdk  install: [ { via: sdkman } ] }
        quarkus:    { description: "Quarkus CLI — tooling for the Quarkus Java framework." requires: jdk  install: [ { via: sdkman } ] }
        micronaut:  { description: "Micronaut CLI (`mn`) — build Micronaut microservices." requires: jdk  install: [ { via: sdkman } ] }
        jbang:      { description: "JBang — run Java/JVM scripts with no project setup." requires: jdk  install: [ { via: sdkman } ] }
        scalacli:   { description: "Scala CLI — the modern all-in-one Scala runner and tooling." requires: jdk  install: [ { via: sdkman } ] }
        coursier:   { description: "Coursier (`cs`) — the JVM artifact fetcher and application installer." requires: jdk  install: [ { via: sdkman } ] }
        spark:      { description: "Apache Spark — a unified analytics engine for large-scale data." requires: jdk  install: [ { via: sdkman } ] }
        flink:      { description: "Apache Flink — stream and batch data processing." requires: jdk  install: [ { via: sdkman } ] }
        liquibase:  { description: "Liquibase — database schema change management and migrations." requires: jdk  install: [ { via: sdkman } ] }
        detekt:     { description: "detekt — static code analysis for Kotlin." requires: jdk  install: [ { via: sdkman } ] }
        jreleaser:  { description: "JReleaser — release automation for JVM (and other) projects." requires: jdk  install: [ { via: sdkman } ] }
        visualvm:   { description: "VisualVM — a visual JVM profiler and monitor." requires: jdk  install: [ { via: sdkman } ] }
        jmc:        { description: "JDK Mission Control — JVM profiling and diagnostics (JFR)." requires: jdk  install: [ { via: sdkman } ] }
        jmeter:     { description: "Apache JMeter — load and performance testing." requires: jdk  install: [ { via: sdkman } ] }
        racket: { description: "Racket — a full-spectrum Scheme/Lisp language (ships DrRacket)."
            install: [ { via: native  when: "debian or redhat or arch or alpine"  repo-component: universe } ] }   // uniform `racket` (brew ships a macOS cask, not a formula)
        guile: { description: "GNU Guile — the GNU Scheme interpreter."
            install: [ { via: native  repo-component: universe  name: { apt: guile-3.0  dnf: guile30  default: guile } } ] }   // versioned name on debian/fedora
        // Haskell — the GHC compiler (cabal driver deferred).
        haskell: { description: "Haskell toolchain (GHC) — pure functional programming." install: [ { via: native  repo-component: universe  name: { default: ghc } } ] }
        // Erlang/OTP + Elixir (elixir pulls erlang, but erlang is nameable on its own).
        erlang: { description: "Erlang/OTP — battle-tested concurrent, fault-tolerant runtime." install: [ { via: native  when: "debian or redhat or arch or opensuse"  repo-component: universe }  { via: native  when: "fedora_atomic" } ] }   // brew formula `erlang`
        elixir: { description: "Elixir — functional, concurrent language on the Erlang VM." install: [ { via: native  repo-component: universe } ] }
        // Nim compiler (nimble ships alongside).
        nim:   { description: "Nim — expressive, statically-typed compiled systems language." install: [ { via: native  when: "debian or arch or opensuse or alpine"  repo-component: universe }  { via: native  when: "fedora_atomic" } ] }   // not in Fedora repos; brew formula `nim`

        // R (statistics) and GNU Octave (numerical computing) — native everywhere.
        r:      { description: "R — language and environment for statistical computing." install: [ { via: native  repo-component: universe  name: { apt: r-base  dnf: R  pacman: r  zypper: R-base  apk: R  brew: r } } ] }
        octave: { description: "GNU Octave — numerical computing, largely MATLAB-compatible." install: [ { via: native  repo-component: universe }  { via: flatpak  hub: flathub  app: org.octave.Octave } ] }
        // Common Lisp: SBCL (the compiler) + Quicklisp (the library manager, bootstrapped by its
        // own lisp script and wired into the SBCL init file).
        sbcl: { description: "Steel Bank Common Lisp — a fast Common Lisp compiler." install: [ { via: native  repo-component: universe } ] }
        quicklisp: { description: "Quicklisp — a library manager for Common Lisp."
            requires: sbcl
            install: [ { via: script
                         install-cmd:   'curl -fsSL https://beta.quicklisp.org/quicklisp.lisp -o /tmp/quicklisp.lisp && printf "\n" | sbcl --non-interactive --load /tmp/quicklisp.lisp --eval "(quicklisp-quickstart:install)" --eval "(ql:add-to-init-file)" && rm -f /tmp/quicklisp.lisp'
                         version-cmd:   'test -d "$HOME/quicklisp" && echo present'
                         uninstall-cmd: 'rm -rf "$HOME/quicklisp"'
                         location:      '~/quicklisp' } ]
        }

        // --- ecosystem module tools + a sample module each (validated in a podman run) ---
        // opam (OCaml package manager). NOTE: `opam install` needs a one-time `opam init` on a
        // fresh system — the opam driver is validated against opam 2.1.5's CLI, but first use on
        // an uninitialized machine may need `opam init` (tracked; see docs/expansion-plan.md).
        opam:  { description: "opam — the OCaml package manager." install: [ { via: native  repo-component: universe } ] }
        dune:  { description: "Dune — the build system for OCaml projects." install: [ { via: opam  name: dune } ] }
        // luarocks (Lua package manager; the native package pulls lua) + a sample rock
        // (dkjson is pure-Lua with no C deps, so it installs without lua headers).
        luarocks: { description: "LuaRocks — package manager for Lua modules." install: [ { via: native  repo-component: universe  name: { zypper: lua54-luarocks  default: luarocks } } ] }
        dkjson:   { description: "dkjson — a pure-Lua JSON encode/decode library." install: [ { via: luarocks  name: dkjson } ] }
        // cabal (Haskell build tool; needs ghc to build) + a sample executable.
        cabal: { description: "Cabal — Haskell's build system and package manager." requires: haskell
                 install: [ { via: native  repo-component: universe  name: { apk: cabal  default: cabal-install } } ] }
        hlint: { description: "HLint — suggests improvements to Haskell code." install: [ { via: cabal  name: hlint } ] }

        // Zig — native on Arch/Homebrew; elsewhere the upstream tarball. zig's Linux build is
        // statically linked (runs on glibc AND musl), so no glibc requirement. Its prebuilt
        // binaries live on ziglang.org (not github assets), so github supplies only the VERSION
        // and a url template builds the download.
        zig: { description: "Zig — simple, fast systems language and C/C++ toolchain."
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }             // brew formula `zig`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/zig"
                  version: { github: ziglang/zig  strip-v: true }
                  url: "https://ziglang.org/download/$VERSION/zig-linux-$ARCH-$VERSION.tar.xz" }
            ]
        }
        // Julia — official binaries live on the julialang S3 (not github releases), so a pinned
        // version + the S3 tarball URL (glibc build; path carries both the X.Y dir and full
        // version, so bump both on update). Native on Arch/Homebrew where packaged.
        julia: { description: "Julia — high-performance language for scientific computing."
            install: [
                { via: native  when: "arch" }                      // pacman: julia
                { via: native  when: "fedora_atomic" }             // brew formula `julia`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/julia"  requires: glibc  version: { static: 1.12.6 }
                  url: "https://julialang-s3.julialang.org/bin/linux/x64/1.12/julia-1.12.6-linux-x86_64.tar.gz" } ]
        }
        // Odin — upstream github release tarball (glibc-linked, so it declines on musl).
        odin: { description: "Odin — data-oriented systems programming language."
            install: [
                { via: native  when: "fedora_atomic" }             // brew formula `odin`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/odin"  requires: glibc
                  version: { github: odin-lang/Odin  asset: "odin-linux-amd64-*.tar.gz" }
                  url: "https://github.com/odin-lang/Odin/releases/download/$VERSION/odin-linux-amd64-$VERSION.tar.gz" }
            ]
        }

        // --- web browsers ---
        // Firefox is native (in every base repo; openSUSE calls it MozillaFirefox) with the Flathub
        // Flatpak (org.mozilla.firefox) offered as a uniform alternative everywhere — native stays
        // the default where the distro packages it, flatpak wins on atomic (brew has no firefox).
        // Chrome/Brave/Opera/Vivaldi/Edge aren't in any base distro repo, so each wires in its
        // vendor's own apt + dnf repo (native, the default there) with the Flathub Flatpak kept as a
        // uniform candidate everywhere (and the default on openSUSE/atomic, which have no vendor repo
        // set up here). Arch: AUR (google-chrome/brave-bin/opera/microsoft-edge-stable-bin) except
        // vivaldi, which is in the official `extra` repo. Flathub Chrome/Edge are community-maintained.
        firefox: { description: "Mozilla Firefox — the open-source web browser." install: [ { via: flatpak  hub: flathub  app: org.mozilla.firefox }
                              { via: native  when: "not fedora_atomic"  repo-component: universe  name: { zypper: MozillaFirefox  default: firefox } }
                              { via: snap  name: firefox } ] }
        chromium: { description: "Chromium — the open-source browser upstream of Chrome." install: [ { via: native  when: "(debian or redhat or arch or opensuse) and not ubuntu"  name: { default: chromium } }  { via: snap  name: chromium }  { via: flatpak  hub: flathub  app: org.chromium.Chromium } ] }   // Ubuntu ships chromium ONLY as the (Canonical-official) snap — its apt `chromium-browser` is a snap shim; ubuntu excluded from native so the snap is the sole real method there. Flathub flatpak offered everywhere (+ the only method on atomic).
        chrome:  { description: "Google Chrome — Google's web browser."
            install: [
                { via: native  when: "debian"  name: google-chrome-stable   // Google's official apt repo
                  pubkey-url: "https://dl.google.com/linux/linux_signing_key.pub"
                  pubkey-path: /usr/share/keyrings/google-chrome.asc
                  source-line: "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.asc] https://dl.google.com/linux/chrome/deb/ stable main"
                  source-path: /etc/apt/sources.list.d/google-chrome.list }
                { via: native  when: "redhat"  name: google-chrome-stable   // Google's official dnf repo
                  pubkey-url: "https://dl.google.com/linux/linux_signing_key.pub"
                  repo-id: google-chrome  repo-name: "Google Chrome"
                  repo-url: "https://dl.google.com/linux/chrome/rpm/stable/x86_64" }
                { via: aur  when: "arch"  name: google-chrome }             // AUR
                { via: flatpak  hub: flathub  app: com.google.Chrome } ]    // Flathub — default on openSUSE/atomic, a candidate everywhere
        }
        brave:   { description: "Brave — a privacy-focused Chromium browser with built-in ad-blocking."
            install: [
                { via: native  when: "debian"  name: brave-browser   // Brave's official apt repo
                  pubkey-url: "https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg"
                  pubkey-path: /usr/share/keyrings/brave-browser-archive-keyring.gpg
                  source-line: "deb [arch=amd64 signed-by=/usr/share/keyrings/brave-browser-archive-keyring.gpg] https://brave-browser-apt-release.s3.brave.com/ stable main"
                  source-path: /etc/apt/sources.list.d/brave-browser-release.list }
                { via: native  when: "redhat"  name: brave-browser   // Brave's official dnf repo
                  pubkey-url: "https://brave-browser-rpm-release.s3.brave.com/brave-core.asc"
                  repo-id: brave-browser  repo-name: "Brave Browser"
                  repo-url: "https://brave-browser-rpm-release.s3.brave.com/x86_64/" }
                { via: aur  when: "arch"  name: brave-bin }
                { via: flatpak  hub: flathub  app: com.brave.Browser } ]
        }
        opera:   { description: "Opera — a feature-rich Chromium browser."
            install: [
                { via: native  when: "debian"  name: opera-stable   // Opera's official apt repo
                  pubkey-url: "https://deb.opera.com/archive.key"
                  pubkey-path: /usr/share/keyrings/opera.asc
                  source-line: "deb [signed-by=/usr/share/keyrings/opera.asc] https://deb.opera.com/opera-stable/ stable non-free"
                  source-path: /etc/apt/sources.list.d/opera-stable.list }
                { via: native  when: "redhat"  name: opera-stable   // Opera's official dnf repo
                  pubkey-url: "https://rpm.opera.com/rpmrepo.key"
                  repo-id: opera  repo-name: "Opera"
                  repo-url: "https://rpm.opera.com/rpm" }
                { via: aur  when: "arch"  name: opera }
                { via: flatpak  hub: flathub  app: com.opera.Opera } ]
        }
        vivaldi: { description: "Vivaldi — a highly customizable Chromium browser."
            install: [
                { via: native  when: "debian"  name: vivaldi-stable   // Vivaldi's official apt repo
                  pubkey-url: "https://repo.vivaldi.com/archive/linux_signing_key.pub"
                  pubkey-path: /usr/share/keyrings/vivaldi-browser.asc
                  source-line: "deb [signed-by=/usr/share/keyrings/vivaldi-browser.asc] https://repo.vivaldi.com/archive/deb/ stable main"
                  source-path: /etc/apt/sources.list.d/vivaldi.list }
                { via: native  when: "redhat"  name: vivaldi-stable   // Vivaldi's official dnf repo
                  pubkey-url: "https://repo.vivaldi.com/archive/linux_signing_key.pub"
                  repo-id: vivaldi  repo-name: "Vivaldi"
                  repo-url: "https://repo.vivaldi.com/archive/rpm/x86_64" }
                { via: native  when: "arch"  name: vivaldi }   // in Arch's official extra repo
                { via: flatpak  hub: flathub  app: com.vivaldi.Vivaldi } ]
        }
        edge:    { description: "Microsoft Edge — a Chromium-based browser."
            install: [
                { via: native  when: "debian"  name: microsoft-edge-stable   // Microsoft's official apt repo
                  pubkey-url: "https://packages.microsoft.com/keys/microsoft.asc"
                  pubkey-path: /usr/share/keyrings/microsoft-edge.asc
                  source-line: "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft-edge.asc] https://packages.microsoft.com/repos/edge stable main"
                  source-path: /etc/apt/sources.list.d/microsoft-edge.list }
                { via: native  when: "redhat"  name: microsoft-edge-stable   // Microsoft's official dnf repo
                  pubkey-url: "https://packages.microsoft.com/keys/microsoft.asc"
                  repo-id: microsoft-edge  repo-name: "Microsoft Edge"
                  repo-url: "https://packages.microsoft.com/yumrepos/edge" }
                { via: aur  when: "arch"  name: microsoft-edge-stable-bin }
                { via: flatpak  hub: flathub  app: com.microsoft.Edge } ]
        }
        // Tor Browser via torbrowser-launcher (the official downloader/verifier). Native where
        // packaged (Debian/Ubuntu universe, Fedora, openSUSE), AUR `tor-browser-bin` on Arch, and
        // Flathub everywhere (self-contained — the only method on atomic/musl).
        tor-browser: {
            description: "Tor Browser — anonymized browsing over the Tor network."
            install: [
                { via: native  when: "debian or fedora or opensuse"  repo-component: universe  name: torbrowser-launcher }
                { via: aur  when: "arch"  name: tor-browser-bin }
                { via: flatpak  hub: flathub  app: org.torproject.torbrowser-launcher } ]
        }

        // ===================== network + web-dev tooling =====================
        // iproute2 — `ip`/`ss`/`tc`. Native everywhere; EL's dnf calls the package `iproute`.
        iproute2:   { description: "iproute2 — modern Linux networking tools (`ip`, `ss`)." install: [ { via: native  name: { dnf: iproute  default: iproute2 } } ] }
        // Capture & probe — native CLI staples. Name maps only where distros diverge; the
        // rest carry the same package name everywhere.
        wireshark:  { description: "Wireshark — a GUI network protocol analyzer." install: [ { via: native  when: "not fedora_atomic"  name: { pacman: wireshark-qt }
                                   debconf: "wireshark-common wireshark-common/install-setuid boolean true" }
                                 { via: flatpak  hub: flathub  app: org.wireshark.Wireshark } ] }   // GUI analyzer; Arch splits the GUI into wireshark-qt. debconf preseed enables non-root capture on Debian (apt reads it; dnf/pacman ignore it & set dumpcap's caps in-package). Pair with wireshark-group. Flatpak offered everywhere (analyzing .pcap files is zero-config; LIVE capture needs its bundled setuid dumpcap + wireshark-group, like native) — and it's the ONLY GUI on atomic (Linux brew has no wireshark cask, just the CLI formula).
        wireshark-group: { description: "Add your user to the wireshark group (non-root capture)."   // opt-in: non-root capture. usermod -aG wireshark $YOU; needs the group the package creates (hence requires). On Fedora/Arch the package pre-sets dumpcap's file caps, so group membership alone enables capture. On Debian/Ubuntu dumpcap is NOT setcap'd by a non-interactive install — group membership is necessary but not sufficient there (see the wireshark story). Mirrors docker-group.
            requires: wireshark
            install: [ { via: group  name: wireshark } ]
        }
        tshark:     { description: "TShark — Wireshark's command-line capture/analysis." install: [ { via: native  name: { dnf: wireshark-cli  pacman: wireshark-cli  zypper: wireshark } } ] }   // CLI capture; ships as wireshark-cli on dnf/pacman, tshark on apt
        tcpdump:    { description: "tcpdump — command-line packet capture and analysis." install: [ { via: native } ] }
        nmap:       { description: "Nmap — a network scanner and security probe." install: [ { via: native } ] }
        mtr:        { description: "Live network diagnostic — ping + traceroute in one display."
                      install: [ { via: native } ] }
        traceroute: { description: "Trace the network path to a host, hop by hop." install: [ { via: native  when: "not fedora_atomic" } ] }   // no `traceroute` brew formula (Homebrew has mtr/tcptraceroute instead); macOS ships it in base — so decline on brew-native atomic rather than fail
        iperf3:     { description: "iperf3 — measure network throughput between two hosts." install: [ { via: native  name: { zypper: iperf  default: iperf3 } } ] }
        socat:      { description: "Multipurpose socket relay — bidirectional data between two endpoints." install: [ { via: native } ] }
        ethtool:    { description: "ethtool — query and control NIC driver/hardware settings." install: [ { via: native } ] }
        whois:      { description: "Domain/IP registration lookup (`whois`)." install: [ { via: native } ] }
        netcat:     { description: "TCP/UDP swiss-army knife (`nc`) — connect, listen, pipe raw sockets." install: [ { via: native  name: { dnf: nmap-ncat  pacman: openbsd-netcat  default: netcat-openbsd } } ] }   // the BSD nc; Fedora ships it as nmap-ncat, Arch as openbsd-netcat
        dig:        { description: "DNS lookup tool (`dig`) — query records and troubleshoot resolution." install: [ { via: native  name: { apt: dnsutils  dnf: bind-utils  pacman: bind  apk: bind-tools  zypper: bind-utils  brew: bind  default: bind-utils } } ] }   // dig/nslookup; apt `dnsutils` is the transitional metapkg (resolves on old + new), Arch/Homebrew ship the tools in `bind`

        // Traffic monitors — live per-interface/-process bandwidth. In EPEL on EL, base repos
        // elsewhere (the same two-binding shape as btop).
        iftop:   { description: "iftop — a live per-connection bandwidth monitor." install: [ { via: native  when: "rhel"  requires: epel } { via: native } ] }
        nethogs: { description: "NetHogs — a per-process network bandwidth monitor." install: [ { via: native  when: "rhel"  requires: epel } { via: native } ] }
        nload:   { description: "nload — a console real-time network traffic monitor." install: [ { via: native  when: "rhel"  requires: epel } { via: native } ] }
        // gping: ping with a live graph (Rust). Native where packaged (Arch, Alpine, Homebrew, and
        // Debian>=13/Ubuntu>=23.10); Fedora is COPR-only and older Debian/Ubuntu/openSUSE/EL lack
        // it, so cargo builds it there.
        gping:   { description: "Ping, but with a live graph (`gping`)."
                   install: [ { via: native  when: "arch or alpine or fedora_atomic or (ubuntu >= 23.10) or (debian >= 13)" }
                              { via: cargo  name: gping } ] }
        vnstat:  { description: "vnStat — a network traffic logger and stats tool." install: [ { via: native  when: "rhel"  requires: epel } { via: native } ] }

        // Web/HTTP dev — httpie + jq native (httpie via EPEL on EL); yq/mitmproxy isolated via
        // pipx; xh/websocat are Rust crates.
        httpie:    { description: "Human-friendly HTTP client (`http`) — a nicer curl for APIs." install: [ { via: native  when: "rhel"  requires: epel } { via: native } ] }   // the `http`/`https` CLI
        jq:        { description: "Command-line JSON processor — query and transform JSON."
                     install: [ { via: native }
                                { via: tarball  archive: none  binary: jq  installDir: "$CONFIGSYS_APP_DIR/jq"  version: { github: jqlang/jq  asset: "jq-linux-amd64" } } ] }   // upstream ships a raw static binary
        yq:        { description: "YAML/JSON/XML processor — jq, but for YAML." requires: jq                                                                    // the jq-family yq (yq/xq/tomlq) — shells out to jq at runtime; NOT mikefarah's Go yq
                     install: [ { via: pipx  name: yq  version: { pypi: yq } } ] }
        mitmproxy: { description: "Interactive HTTPS proxy — intercept, inspect, and replay traffic." install: [ { via: pipx  name: mitmproxy  standing: 1  version: { pypi: mitmproxy } }  { via: flatpak  hub: flathub  app: org.mitmproxy.mitmproxy } ] }   // pipx (official PyPI) stays the default; the Flathub build is an offered option
        xh:        { description: "Fast HTTPie-compatible HTTP client (`xh`), written in Rust." install: [ { via: cargo  name: xh  version: { crates: xh } }  { via: tarball  installDir: "$CONFIGSYS_APP_DIR/xh"  version: { github: ducaale/xh  asset: "xh-*-x86_64-unknown-linux-musl.tar.gz" } } ] }                // prebuilt musl binary is the default over building from source
        websocat:  { description: "netcat for WebSockets — connect, pipe, and script ws:// endpoints." install: [ { via: cargo  name: websocat  version: { crates: websocat } }  { via: tarball  archive: none  binary: websocat  installDir: "$CONFIGSYS_APP_DIR/websocat"  version: { github: vi/websocat  asset: "websocat.x86_64-unknown-linux-musl" } } ] }   // prebuilt musl binary default

        // GUI API clients — Flatpak from Flathub, like chrome (all community-maintained, current).
        postman:  { description: "Postman — a GUI for building and testing APIs." install: [ { via: flatpak  hub: flathub  app: com.getpostman.Postman }  { via: snap  name: postman } ] }
        insomnia: { description: "Insomnia — an open-source API client and design tool." install: [ { via: flatpak  hub: flathub  app: rest.insomnia.Insomnia }  { via: native-pkg-file  when: "debian or redhat"  version: { github: Kong/insomnia  tag-re: "([0-9][0-9.]*)" }  asset: { deb: { x86_64: "Insomnia.Core-*.deb" }  rpm: { x86_64: "Insomnia.Core-*.rpm" } } } ] }   // monorepo `core@` tags: the release scan finds the Core release; tag-re -> clean version
        bruno:    { description: "Bruno — a fast, git-friendly, offline-first API client." install: [ { via: flatpak  hub: flathub  app: com.usebruno.Bruno }  { via: native-pkg-file  when: "debian or redhat"  version: { github: usebruno/bruno  strip-v: true }  asset: { deb: { x86_64: "bruno_*_amd64_linux.deb" }  rpm: { x86_64: "bruno_*_x86_64_linux.rpm" } } } ] }   // upstream .deb (amd64)/.rpm (x86_64 token differs)
        tree-sitter-cli: { description: "tree-sitter CLI — build and test tree-sitter grammars."
            install: [ { via: cargo  name: tree-sitter-cli  standing: 1  version: { crates: tree-sitter-cli } }   // kept the default (some want it built from source, without the prebuilt-binary apparatus)
                       { via: tarball  archive: gz  binary: tree-sitter  installDir: "$CONFIGSYS_APP_DIR/tree-sitter"  version: { github: tree-sitter/tree-sitter  asset: "tree-sitter-linux-x64.gz" } } ]   // upstream ships a plain-gzipped single binary
        }
        mononoki-nerd: { description: "Mononoki Nerd Font — a clean monospace coding font with icons."
            install: [ { via: font  name: Mononoki          // -> requires fontconfig + unzip
                         version: { github: ryanoasis/nerd-fonts  asset: "Mononoki.zip" }
                         url: "https://github.com/ryanoasis/nerd-fonts/releases/download/$VERSION/Mononoki.zip" } ]
        }

        // when:-varying: native on Pop (the NVIDIA rig), flatpak elsewhere
        steam: { description: "Steam — Valve's game store and launcher."
            install: [
                { via: native   when: "pop_os!"  name: "steam:i386"  foreign-arch: i386 }
                { via: flatpak  hub: flathub  app: com.valvesoftware.Steam }
            ]
        }

        // Wine — Windows compatibility layer. Distro-native everywhere; debian/ubuntu need i386
        // multiarch (handled by foreign-arch), Arch needs the `multilib` repo enabled (user does that
        // once). WineHQ's own repo ships newer builds — not modeled (per-codename); the distro Wine
        // is a fine default. winetricks fetches runtime DLLs/fonts into a prefix.
        wine: { description: "Wine — run Windows applications on Linux."
            install: [ { via: native  when: "debian"  foreign-arch: i386 }
                       { via: native  when: "rhel"  requires: epel }   // wine ships in EPEL
                       { via: native  when: "fedora or arch or alpine or opensuse" } ] }
        winetricks: { description: "winetricks — fetch runtime DLLs/fonts and tweak Wine prefixes." requires: wine
            install: [ { via: native  when: "rhel"  requires: epel }   // EPEL8+
                       { via: native  when: "debian or fedora or arch or opensuse or alpine"  repo-component: universe } ] }
        // Proton tooling. Proton itself is SELF-CONTAINED (bundles its own Wine + DXVK/VKD3D + a Steam
        // runtime) and is installed BY Steam (Steam Play) — not a package, and independent of the
        // system `wine` above. What you install by hand is the community tooling: ProtonUp-Qt (the GUI
        // that fetches GE-Proton and other custom compat tools into ~/.steam/…/compatibilitytools.d)
        // and protontricks (winetricks for Proton game prefixes). No `requires: wine` — both are for
        // Steam's Proton stack, which carries its own Wine.
        protonup-qt: { description: "ProtonUp-Qt — a GUI to install & manage GE-Proton and other Steam/Wine compatibility tools."
            install: [ { via: flatpak  hub: flathub  app: net.davidotek.pupgui2 }
                       { via: aur  when: "arch"  name: protonup-qt } ] }
        protontricks: { description: "protontricks — winetricks for Steam Proton game prefixes."
            install: [ { via: flatpak  hub: flathub  app: com.github.Matoking.protontricks }
                       { via: aur  when: "arch"  name: protontricks }
                       { via: pipx  name: protontricks  standing: never-auto } ] }

        // --- apps: native everywhere. A clean-config tool manages its ~/.config as a
        // dir-dotfile (content in dotfiles/<name>/ symlinked to $XDG_CONFIG_HOME/<name>, like
        // neovim). The dotfiles are `suggests:` (soft) so the app installs before dotfiles/<name>/
        // has your content. Apps with a FAT ~/.config (profile + cache/state) only `suggests:`
        // their dotfiles for now — pending a dir-vs-specific-files call.
        podman: { description: "Podman — daemonless, rootless container engine (docker-compatible)."
            suggests: podman-dotfiles
            install: [ { via: native  repo-component: universe } ]   // apt universe / dnf (EL AppStream) / pacman
        }
        podman-dotfiles: { description: "Podman config, linked into place."   // ~/.config/containers — shared by podman / buildah / skopeo
            install: [ { via: dotfiles  config: { src: containers  dst: $XDG_CONFIG_HOME/containers } } ]
        }

        libreoffice: { description: "LibreOffice — the open-source office suite."   // fat ~/.config/libreoffice (profile + cache) — dotfiles pending
            suggests: libreoffice-dotfiles
            install: [ { via: flatpak  hub: flathub  app: org.libreoffice.LibreOffice }   // uniform option everywhere; the only method on atomic (brew's libreoffice is a mac-only cask)
                       { via: native  when: "not fedora_atomic"  repo-component: universe  name: { pacman: libreoffice-fresh } } ]
        }

        // kicad: native where it's packaged, Flathub (org.kicad.KiCad) where it isn't. It's in
        // NO EL9 repo (base/EPEL/CRB/RPM Fusion, verified on rockylinux:9), so native is guarded
        // `not rhel` and the flatpak binding catches EL (and is a per-machine `pin` away anywhere
        // the distro package is too old). A from-source build is the configsys-kicad plugin's
        // `kicad-build` override, the way blender-build overrides native blender.
        kicad: { description: "KiCad — electronics design (schematics and PCB layout)."   // fat-ish config — dotfiles pending
            suggests: kicad-dotfiles
            install: [ { via: flatpak  when: fedora_atomic  hub: flathub  app: org.kicad.KiCad }   // atomic: more specific than `not rhel` so flatpak wins over brew (mac-only cask)
                       { via: native   when: "not rhel"  repo-component: universe }
                       { via: flatpak  hub: flathub  app: org.kicad.KiCad } ]
        }

        // blender: the easy default is the native package (the editor). A from-source build
        // (to get a `bpy` module matching your editor) is a personal override that lives in a
        // user layer, the way a Pop-only native Steam does. Fat versioned config
        // (~/.config/blender/<ver>) — dotfiles deferred. On EL it's in EPEL; base repos elsewhere.
        blender: { description: "Blender — 3D modeling, animation, and rendering suite."
            suggests: blender-dotfiles
            install: [ { via: flatpak  hub: flathub  app: org.blender.Blender }   // uniform option everywhere; the only method on atomic (brew's blender is a mac-only cask)
                       { via: native  when: "rhel"  requires: epel }
                       { via: native  when: "not fedora_atomic"  repo-component: universe }
                       { via: snap  name: blender  classic: true } ]   // Blender-official snap (candidate-only)
        }

        // GPU compute toolchains + NVIDIA infra. General-purpose — used well beyond Blender/OpenCV —
        // so they live in base. NVIDIA CUDA is a VERSION-SCOPED capability: cuda-toolkit-11 and -12
        // each `provides: { cuda-toolkit: N }`, so a consumer can select by version —
        // `requires: { cuda-toolkit: ">=12" }` (cudnn-9) picks 12, `"<12"` (cudnn-8) picks 11 (the
        // constraint ENABLES the opt-in -11). A version-agnostic consumer (`requires: cuda-toolkit`,
        // e.g. a source-build Blender's Cycles backends) takes the DEFAULT — cuda-toolkit-12; -11 is
        // `opt-in` so it never becomes the generic default, but it's still adopted when it's the one
        // actually installed (the detection tier) or named/constrained. The -12 toolkit + versioned
        // cuDNNs ride NVIDIA's network repo (cuda-repo) — real GPU work wants the vendor repo, not the
        // lagging distro one; -11 stays the low-friction distro package for the older CUDA-11 line.
        cuda-toolkit-11: { description: "NVIDIA CUDA Toolkit 11 — GPU compute compiler and libraries (distro package)."
            standing: never-auto  provides: { cuda-toolkit: 11 }
            install: [ { via: native  name: { apt: nvidia-cuda-toolkit  dnf: cuda  pacman: cuda } } ]
        }
        cuda-toolkit-12: { description: "NVIDIA CUDA Toolkit 12 (from NVIDIA's CUDA repo)."
            provides: { cuda-toolkit: 12 }
            install: [
                { via: native  when: "arch"  name: cuda }              // Arch: rolling latest (12.x)
                { via: script  when: "debian"  requires: cuda-repo
                  install-cmd:   'sudo apt-get install -y cuda-toolkit-12-6 && sudo ldconfig'
                  version-cmd:   "dpkg-query -W -f='${Version}' cuda-toolkit-12-6 2>/dev/null"
                  latest-cmd:    'apt-cache policy cuda-toolkit-12-6 2>/dev/null | grep Candidate'
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo apt-get remove -y cuda-toolkit-12-6 && sudo ldconfig'
                  location:      'cuda-toolkit-12-6 (apt)' }
                { via: script  when: "redhat"  requires: cuda-repo
                  install-cmd:   'sudo dnf install -y cuda-toolkit-12-6 && sudo ldconfig'
                  version-cmd:   'rpm -q --qf %{VERSION} cuda-toolkit-12-6 2>/dev/null'
                  latest-cmd:    "dnf -q repoquery --qf '%{version}' cuda-toolkit-12-6 2>/dev/null | tail -1"
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo dnf remove -y cuda-toolkit-12-6'
                  location:      'cuda-toolkit-12-6 (dnf)' }
            ]
        }
        // cuda-repo — set up NVIDIA's CUDA network repo (the apt/dnf source cuDNN & CUDA come from).
        // `via: script` because the URL is distro-codename-specific; derived from /etc/os-release
        // (UBUNTU_CODENAME covers ubuntu derivatives). Not needed on Arch (official repos).
        cuda-repo: {
            description: "NVIDIA CUDA network repo (apt/dnf) — the source cuDNN & CUDA packages come from."
            install: [
                { via: script  when: "debian"
                  install-cmd:   'set -e; . /etc/os-release; if [ -n "${UBUNTU_CODENAME:-}" ]; then case "$UBUNTU_CODENAME" in focal) SEG=ubuntu2004;; jammy) SEG=ubuntu2204;; noble) SEG=ubuntu2404;; *) SEG=ubuntu2204;; esac; elif [ "$ID" = debian ]; then SEG="debian${VERSION_ID%%.*}"; else SEG="${ID}$(echo "$VERSION_ID" | tr -d .)"; fi; A="$(uname -m)"; if [ "$A" = aarch64 ]; then A=sbsa; else A=x86_64; fi; T="$(mktemp -d)"; curl -fSL "https://developer.download.nvidia.com/compute/cuda/repos/$SEG/$A/cuda-keyring_1.1-1_all.deb" -o "$T/k.deb"; sudo dpkg -i "$T/k.deb"; sudo apt-get update; rm -rf "$T"'
                  version-cmd:   "dpkg-query -W -f='${Version}' cuda-keyring 2>/dev/null"
                  latest-cmd:    'apt-cache policy cuda-keyring 2>/dev/null | grep Candidate'
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo apt-get remove -y cuda-keyring'
                  location:      '/etc/apt/sources.list.d/cuda-*.list (+ cuda-keyring)' }
                { via: script  when: "redhat"
                  install-cmd:   'set -e; . /etc/os-release; case "$ID" in fedora) SEG="fedora$VERSION_ID";; *) SEG="rhel${VERSION_ID%%.*}";; esac; A="$(uname -m)"; if [ "$A" = aarch64 ]; then A=sbsa; else A=x86_64; fi; sudo dnf config-manager --add-repo "https://developer.download.nvidia.com/compute/cuda/repos/$SEG/$A/cuda-$SEG.repo"; sudo dnf -q clean expire-cache'
                  version-cmd:   'ls /etc/yum.repos.d/cuda-*.repo >/dev/null 2>&1 && echo present'
                  version-re:    '(present)'
                  uninstall-cmd: 'sudo rm -f /etc/yum.repos.d/cuda-*.repo'
                  location:      '/etc/yum.repos.d/cuda-*.repo' }
            ]
        }
        // cuDNN, versioned — DNN primitives, useful well beyond OpenCV (any CUDA ML build). Each is an
        // EXPLICIT, self-consistent choice a stack requires (never auto-detected at install). debian/
        // redhat use `via: script` = install the dev package AND run ldconfig (NVIDIA's libcudnn
        // packages skip the ldconfig trigger, so the runtime .so isn't cached). `requires: cuda-repo`
        // adds NVIDIA's source. Arch ships one rolling `cudnn` (currently 9.x) — attached to cudnn-9.
        cudnn-8: {
            description: "NVIDIA cuDNN 8 — DNN primitives for the CUDA 11 line."
            requires: { cuda-toolkit: "<12" }
            install: [
                { via: script  when: "debian"  requires: cuda-repo
                  install-cmd:   'sudo apt-get install -y libcudnn8-dev && sudo ldconfig'
                  version-cmd:   "dpkg-query -W -f='${Version}' libcudnn8-dev 2>/dev/null"
                  latest-cmd:    'apt-cache policy libcudnn8-dev 2>/dev/null | grep Candidate'
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo apt-get remove -y libcudnn8-dev && sudo ldconfig'
                  location:      'libcudnn8-dev (apt) + ldconfig cache' }
                { via: script  when: "redhat"  requires: cuda-repo
                  install-cmd:   'sudo dnf install -y libcudnn8-devel && sudo ldconfig'
                  version-cmd:   'rpm -q --qf %{VERSION} libcudnn8-devel 2>/dev/null'
                  latest-cmd:    "dnf -q repoquery --qf '%{version}' libcudnn8-devel 2>/dev/null | tail -1"
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo dnf remove -y libcudnn8-devel && sudo ldconfig'
                  location:      'libcudnn8-devel (dnf) + ldconfig cache' }
            ]
        }
        cudnn-9: {
            description: "NVIDIA cuDNN 9 — DNN primitives for the CUDA 12 line."
            requires: { cuda-toolkit: ">=12" }
            install: [
                { via: native  when: "arch"  name: cudnn }             // Arch's rolling cudnn (9.x); pacman runs ldconfig
                { via: script  when: "debian"  requires: cuda-repo
                  install-cmd:   'sudo apt-get install -y libcudnn9-dev-cuda-12 && sudo ldconfig'
                  version-cmd:   "dpkg-query -W -f='${Version}' libcudnn9-dev-cuda-12 2>/dev/null"
                  latest-cmd:    'apt-cache policy libcudnn9-dev-cuda-12 2>/dev/null | grep Candidate'
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo apt-get remove -y libcudnn9-dev-cuda-12 && sudo ldconfig'
                  location:      'libcudnn9-dev-cuda-12 (apt) + ldconfig cache' }
                { via: script  when: "redhat"  requires: cuda-repo
                  install-cmd:   'sudo dnf install -y libcudnn9-devel-cuda-12 && sudo ldconfig'
                  version-cmd:   'rpm -q --qf %{VERSION} libcudnn9-devel-cuda-12 2>/dev/null'
                  latest-cmd:    "dnf -q repoquery --qf '%{version}' libcudnn9-devel-cuda-12 2>/dev/null | tail -1"
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo dnf remove -y libcudnn9-devel-cuda-12 && sudo ldconfig'
                  location:      'libcudnn9-devel-cuda-12 (dnf) + ldconfig cache' }
            ]
        }
        rocm-hip: { description: "AMD ROCm/HIP — GPU compute toolkit for AMD hardware."
            install: [ { via: native  name: { apt: rocm-hip-sdk  dnf: rocm-hip  pacman: rocm-hip-sdk } } ]
        }
        intel-oneapi-basekit: { description: "Intel oneAPI Base Toolkit — compute compilers and libraries."
            install: [ { via: native  name: { apt: intel-basekit  dnf: intel-basekit  pacman: intel-oneapi-basekit } } ]
        }

        // OpenCV — computer-vision library, split by face: the C++ dev library and the Python
        // (cv2) bindings. The distro packages here are CPU-only; a CUDA-accelerated build is an
        // opt-in `via: source` method (requires the `cuda-toolkit` capability) added by configsys-source
        // — `configsys pin set opencv source` to get it.
        opencv: { description: "OpenCV computer-vision library — C++ headers and libraries (dev)."
            install: [ { via: native  when: "debian or redhat or opensuse or arch or alpine"  repo-component: universe
                         name: { apt: libopencv-dev  dnf: opencv-devel  zypper: opencv-devel  pacman: opencv  apk: opencv-dev } }
                       { via: native  when: "fedora_atomic"  name: opencv } ]   // brew formula `opencv`
        }
        opencv-python: { description: "OpenCV Python bindings (the `cv2` module)."
            install: [ { via: native  when: "debian or redhat or opensuse or arch or alpine"  repo-component: universe
                         name: { apt: python3-opencv  dnf: python3-opencv  zypper: python3-opencv  pacman: opencv  apk: py3-opencv } } ]
        }

        // docker: "the engine, working" = the package + its daemon enabled. Post-install is just
        // composition — docker-service is an ordinary component ordered after docker-engine via
        // `requires:` (which also avoids the package<->service dependency cycle a single unit
        // would create). Passwordless docker (group membership) is a security opt-in: add
        // `docker-group` to your profile alongside `docker`. RHEL steers you to podman — use that
        // there. Config lives in ~/.docker, so no dotfiles.
        docker: { description: "Docker — build and run containers (`docker` CLI)."
            install: [ { via: parts  parts: [ docker-engine, docker-service ] } ]
        }
        docker-engine: { description: "Docker Engine — the container runtime daemon."
            install: [ { via: native  repo-component: universe  name: { dnf: moby-engine  pacman: docker  zypper: docker  apk: docker  default: docker.io } } ]
        }
        docker-service: { description: "Enable and start the Docker daemon (systemd)."
            requires: docker-engine
            install: [ { via: service  unit: docker } ]
        }
        docker-group: { description: "Add your user to the `docker` group (non-root docker access)."   // opt-in: passwordless docker (usermod -aG docker $YOU). Needs the group the engine creates.
            requires: docker-engine
            install: [ { via: group  name: docker } ]
        }

        // --- snapd: the daemon behind `via: snap`. The snap DRIVER `requires` the two setup
        // components below (see drivers:), so pinning a snap on a non-Ubuntu distro installs snapd,
        // enables its socket, and creates the /snap symlink classic snaps need. On Ubuntu it's all
        // preinstalled, so these resolve as already-satisfied (no action). openSUSE/Alpine have no
        // snapd binding here (snapd needs a community repo / isn't supported) — a snap pin there is
        // an honest resolve error; flatpak/native cover those apps.
        snapd: { description: "snapd — the daemon that installs and runs snap packages."
            install: [ { via: native  when: "debian or redhat"  name: snapd }   // apt / dnf snapd
                       { via: aur     when: "arch"  name: snapd } ]              // Arch: AUR
        }
        snapd-socket: { description: "Enable snapd's systemd socket (so snaps can install/run)."
            requires: snapd
            install: [ { via: service  unit: snapd.socket } ]
        }
        snapd-snap-link: { description: "The /snap symlink classic-confinement snaps need (snapd stores snaps under /var/lib/snapd/snap)."
            requires: snapd
            install: [ { via: script
              install-cmd:   "test -e /snap || sudo ln -s /var/lib/snapd/snap /snap"   // Ubuntu already has /snap -> no-op; Fedora/Arch need the link
              version-cmd:   "test -e /snap && echo present"
              version-re:    "(present)"
              uninstall-cmd: "test -L /snap && sudo rm -f /snap || true"
              location:      "/snap" } ]
        }

        // --- virtualization: QEMU/KVM + libvirt + virt-manager, and VirtualBox ---
        qemu:    { description: "QEMU — machine emulator and virtualizer." install: [ { via: native  name: { apt: qemu-system-x86  dnf: qemu-kvm  pacman: qemu-base  default: qemu } } ] }
        libvirt: { description: "libvirt — virtualization management API and daemon." install: [ { via: native  name: { apt: libvirt-daemon-system  default: libvirt } } ] }
        libvirt-service: { description: "Enable and start the libvirt daemon (systemd)." requires: libvirt  install: [ { via: service  unit: libvirtd } ] }
        // virt-manager pulls the whole stack (hypervisor + daemon) so it's usable out of the box.
        virt-manager: { description: "Virtual Machine Manager — a GUI for libvirt/KVM."
            requires: [ qemu, libvirt, libvirt-service ]
            install: [ { via: native }
                       { via: flatpak  hub: flathub  app: org.virt_manager.virt-manager } ]   // talks to the host libvirt socket (requires: still pull the host stack)
        }
        // VirtualBox needs a kernel module (vboxdrv, built via DKMS; Secure Boot requires signing
        // it — configsys can't do that part). apt: multiverse; Fedora: RPM Fusion; Arch/openSUSE: base.
        virtualbox: { description: "VirtualBox — Oracle's desktop virtualizer."
            install: [
                { via: native  when: "redhat"  requires: rpmfusion  name: VirtualBox }
                { via: native  when: "debian or arch or opensuse"  repo-component: multiverse } ]
        }

        // --- compression suites ---
        // gzip/bzip2/xz are on every base system already; these are the ones worth adding.
        zstd:  { description: "Zstandard — fast, high-ratio compression (`zstd`)." install: [ { via: native } ] }
        lz4:   { description: "LZ4 — extremely fast compression (`lz4`)." install: [ { via: native } ] }
        p7zip: { description: "7-Zip for Unix (`7z`) — high-ratio archiver, many formats." install: [ { via: native  name: { apt: p7zip-full  pacman: 7zip  zypper: 7zip  apk: 7zip  default: p7zip } }  { via: native  when: "fedora_atomic"  name: sevenzip } ] }   // brew's current formula is `sevenzip` (p7zip is the legacy 17.06 fork)
        // unrar is nonfree (patent-encumbered): apt multiverse, Fedora RPM Fusion, Arch base.
        unrar: { description: "Extract RAR archives."
            install: [
                { via: native  when: "redhat"  requires: rpmfusion }
                { via: native  when: "debian"  repo-component: multiverse }
                { via: native  when: "arch" } ]
        }
        // (The `compression` grouping is a PROFILE, not a parts component: nothing depends on it and
        // it's not OS-conditional, so the profile degrades gracefully — a part that's unroutable here,
        // e.g. unrar on musl/atomic, is skipped rather than failing the whole set. See config.hu.)

        // --- audio/video codecs (gstreamer names verified across all five families) ---
        // Free bundle: ffmpeg (already a component) + gstreamer good/bad plugins. The patent-
        // encumbered "ugly"/libav set is a SEPARATE opt-in (codecs-restricted), off by default.
        gst-good: { description: "GStreamer good plugins — well-supported, license-clean codecs." install: [ { via: native  when: "debian or redhat or arch or opensuse or alpine"  name: { apt: gstreamer1.0-plugins-good  dnf: gstreamer1-plugins-good      pacman: gst-plugins-good  zypper: gstreamer-plugins-good  apk: gst-plugins-good } } ] }
        gst-bad:  { description: "GStreamer bad plugins — less-mature but useful codecs." install: [ { via: native  when: "debian or redhat or arch or opensuse or alpine"  name: { apt: gstreamer1.0-plugins-bad   dnf: gstreamer1-plugins-bad-free  pacman: gst-plugins-bad   zypper: gstreamer-plugins-bad   apk: gst-plugins-bad } } ] }
        codecs:   { description: "Free multimedia codecs bundle — ffmpeg + gstreamer good/bad plugins." install: [ { via: parts  when: "debian or redhat or arch or opensuse or alpine"  parts: [ ffmpeg, gst-good, gst-bad ] } ] }
        // Restricted/nonfree codecs — patent-encumbered, opt-in. Fedora needs RPM Fusion; openSUSE's
        // full ugly/libav codecs come from Packman (the name resolves in OSS; Packman isn't modeled).
        gst-ugly:  { description: "GStreamer ugly plugins — good code, patent-encumbered codecs." install: [
                       { via: native  when: "redhat"  requires: rpmfusion  name: gstreamer1-plugins-ugly }
                       { via: native  when: "debian"  repo-component: multiverse  name: gstreamer1.0-plugins-ugly }
                       { via: native  when: "arch or opensuse or alpine"  name: { pacman: gst-plugins-ugly  zypper: gstreamer-plugins-ugly  apk: gst-plugins-ugly } } ] }
        gst-libav: { description: "GStreamer libav plugin — FFmpeg-backed codecs." install: [
                       { via: native  when: "redhat"  requires: rpmfusion  name: gstreamer1-plugin-libav }
                       { via: native  when: "debian"  repo-component: universe  name: gstreamer1.0-libav }
                       { via: native  when: "arch or opensuse or alpine"  name: { pacman: gst-libav  zypper: gstreamer-plugins-libav  apk: gst-libav } } ] }
        libavcodec-extra: { description: "Extra (nonfree) FFmpeg codecs." install: [ { via: native  when: "debian"  repo-component: universe } ] }
        codecs-restricted: { description: "Restricted/patented codecs — opt-in nonfree multimedia support." install: [
                               { via: parts  when: "debian"  parts: [ gst-ugly, gst-libav, libavcodec-extra ] }
                               { via: parts  when: "redhat or arch or opensuse or alpine"  parts: [ gst-ugly, gst-libav ] } ] }

        // discord / slack: flatpak everywhere (no uniform native path — Fedora has none), and
        // their config is sandboxed under ~/.var/app and holds auth tokens, so no dotfiles.
        discord: { description: "Discord — voice, video, and text chat." install: [ { via: flatpak  hub: flathub  app: com.discordapp.Discord }  { via: snap  name: discord }
                             { via: native-pkg-file  when: "debian"  name: discord  standing: never-auto  url: "https://discord.com/api/download?platform=linux&format=deb" } ] }   // Discord's official .deb (rolling; the URL 302-redirects to the latest — no version API, so latest reads as unknown, never a false "outdated"). `candidate-only` so the debian gate doesn't make it beat the universal flatpak by specificity — the sandboxed flatpak stays the default; the .deb is a pinnable option.
        slack:   { description: "Slack — team messaging and collaboration."
            install: [
                { via: native  when: "debian"  name: slack-desktop   // Slack's official packagecloud apt repo (jessie-pinned upstream; serves current builds)
                  pubkey-url: "https://packagecloud.io/slacktechnologies/slack/gpgkey"
                  pubkey-path: /usr/share/keyrings/slack.asc
                  source-line: "deb [signed-by=/usr/share/keyrings/slack.asc] https://packagecloud.io/slacktechnologies/slack/debian/ jessie main"
                  source-path: /etc/apt/sources.list.d/slack.list }
                { via: native  when: "redhat"  name: slack   // Slack's official packagecloud dnf repo (rpm package is `slack`)
                  pubkey-url: "https://packagecloud.io/slacktechnologies/slack/gpgkey"
                  repo-id: slack  repo-name: "Slack"
                  repo-url: "https://packagecloud.io/slacktechnologies/slack/fedora/21/x86_64" }
                { via: aur  when: "arch"  name: slack-desktop }
                { via: flatpak  hub: flathub  app: com.slack.Slack }
                { via: snap  name: slack } ]
        }

        // --- media & creative apps -------------------------------------------------
        // Flatpak-preferred: the Flathub builds are current and not hobbled by the sandbox for
        // these. gimp/krita also take a native binding on Alpine — musl, where a native apk
        // package beats pulling a glibc flatpak runtime (and both are in Alpine's community
        // repo). Elsewhere, and for the others, a native default is a per-machine `pin` away.
        gimp: { description: "GIMP — a raster image editor."
            install: [ { via: native   when: "alpine" }
                       { via: flatpak  hub: flathub  app: org.gimp.GIMP } ]
        }
        krita: { description: "Krita — a digital painting studio."
            install: [ { via: native   when: "alpine" }
                       { via: flatpak  hub: flathub  app: org.kde.krita } ]
        }
        ardour: { description: "Ardour — a professional digital audio workstation (DAW)." install: [ { via: flatpak  hub: flathub  app: org.ardour.Ardour } ] }
        lmms:   { description: "LMMS — a music production studio (synths, sequencing, loops)." install: [ { via: flatpak  hub: flathub  app: io.lmms.LMMS } ] }

        // --- digital-art tools (Flathub, matching gimp/krita/ardour above — uniform across distros) ---
        inkscape:   { description: "Inkscape — a vector graphics editor (SVG)." install: [ { via: flatpak  hub: flathub  app: org.inkscape.Inkscape } ] }
        darktable:  { description: "darktable — RAW photo workflow and non-destructive editing." install: [ { via: flatpak  hub: flathub  app: org.darktable.Darktable } ] }
        freecad:    { description: "FreeCAD — a parametric 3D CAD modeler." install: [ { via: flatpak  hub: flathub  app: org.freecad.FreeCAD }  { via: appImage  name: FreeCAD  scope: user  version: { github: FreeCAD/FreeCAD  asset: "FreeCAD_*-Linux-x86_64-*.AppImage" }  path: ~/apps/freecad.appimage } ] }   // asset glob absorbs the bundled-python (pyXYZ) token
        openscad:   { description: "OpenSCAD — the programmer's solid 3D CAD modeller." install: [ { via: flatpak  hub: flathub  app: org.openscad.OpenSCAD } ] }
        godot:      { description: "Godot — an open-source 2D/3D game engine." install: [ { via: flatpak  hub: flathub  app: org.godotengine.Godot }  { via: tarball  installDir: "$CONFIGSYS_APP_DIR/godot"  requires: unzip  version: { github: godotengine/godot  tag-re: "([0-9][0-9.]*)"  asset: "Godot_v*-stable_linux.x86_64.zip" } } ] }   // flatpak stays default; the zip holds a single `Godot_v<ver>_linux.x86_64` exe (no clean rename for zip)
        scribus:    { description: "Scribus — open-source desktop publishing (DTP)." install: [ { via: flatpak  hub: flathub  app: net.scribus.Scribus } ] }
        digikam:    { description: "digiKam — photo management and RAW editing." install: [ { via: flatpak  hub: flathub  app: org.kde.digikam } ] }

        // --- media servers (self-hosted; each runs a systemd service — the <name>-service pulls the
        // install AND starts it, like the db-servers) + media players (kodi/stremio, flatpak-first) ---
        // No server ships a Flathub build; the only Jellyfin flatpak is the CLIENT, not the server.
        jellyfin: { description: "Jellyfin — a free, self-hosted media server (movies, TV, music)."
            install: [
                { via: native  when: "ubuntu"  name: jellyfin       // official repo (codename bumps as they add releases)
                  pubkey-url: "https://repo.jellyfin.org/ubuntu/jellyfin_team.gpg.key"  pubkey-path: /usr/share/keyrings/jellyfin.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/jellyfin.gpg] https://repo.jellyfin.org/ubuntu noble main"
                  source-path: /etc/apt/sources.list.d/jellyfin.list }
                { via: native  when: "debian"  name: jellyfin
                  pubkey-url: "https://repo.jellyfin.org/debian/jellyfin_team.gpg.key"  pubkey-path: /usr/share/keyrings/jellyfin.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/jellyfin.gpg] https://repo.jellyfin.org/debian bookworm main"
                  source-path: /etc/apt/sources.list.d/jellyfin.list }
                { via: native  when: "fedora"  name: jellyfin  requires: rpmfusion   // pulls ffmpeg from RPM Fusion
                  pubkey-url: "https://repo.jellyfin.org/fedora/jellyfin_team.gpg.key"
                  repo-id: jellyfin  repo-name: "Jellyfin"  repo-url: "https://repo.jellyfin.org/fedora/$releasever/$basearch" }
                { via: native  when: "arch"  packages: [ jellyfin-server, jellyfin-web ] } ] }   // Arch `extra`
        jellyfin-service: { description: "Enable and start the Jellyfin server (systemd)." requires: jellyfin  install: [ { via: service  unit: jellyfin } ] }
        plex: { description: "Plex Media Server — a media server with the Plex client ecosystem."
            install: [
                { via: native  when: "debian"  name: plexmediaserver   // official repo (single `public` suite — codename-independent)
                  pubkey-url: "https://downloads.plex.tv/plex-keys/PlexSign.key"  pubkey-path: /usr/share/keyrings/plex.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/plex.gpg] https://downloads.plex.tv/repo/deb public main"
                  source-path: /etc/apt/sources.list.d/plexmediaserver.list }
                { via: native  when: "redhat"  name: plexmediaserver
                  pubkey-url: "https://downloads.plex.tv/plex-keys/PlexSign.key"
                  repo-id: plex  repo-name: "Plex"  repo-url: "https://downloads.plex.tv/repo/rpm/$basearch/" }
                { via: aur  when: "arch"  name: plex-media-server } ] }
        plex-service: { description: "Enable and start Plex Media Server (systemd)." requires: plex  install: [ { via: service  unit: plexmediaserver } ] }
        emby: { description: "Emby Server — a media server (open-core; some features are premium)."
            install: [   // no official repo: Arch `extra`, else the upstream .deb/.rpm on GitHub
                { via: native  when: "arch"  name: emby-server }
                { via: native-pkg-file  when: "debian"  name: emby-server
                  version: { github: MediaBrowser/Emby.Releases  strip-v: true }  asset: "emby-server-deb_*_amd64.deb" }
                { via: native-pkg-file  when: "redhat or opensuse"  name: emby-server
                  version: { github: MediaBrowser/Emby.Releases  strip-v: true }  asset: "emby-server-rpm_*_x86_64.rpm" } ] }
        emby-service: { description: "Enable and start Emby Server (systemd)." requires: emby  install: [ { via: service  unit: emby-server } ] }
        navidrome: { description: "Navidrome — a self-hosted music streaming server (Subsonic/OpenSubsonic-compatible)." requires: ffmpeg
            install: [   // Arch `extra`; else the upstream .deb/.rpm, or the prebuilt tarball (hand-write a unit)
                { via: native  when: "arch"  name: navidrome }
                { via: native-pkg-file  when: "debian"  name: navidrome
                  version: { github: navidrome/navidrome  strip-v: true }  asset: "navidrome_*_linux_amd64.deb" }
                { via: native-pkg-file  when: "redhat"  name: navidrome
                  version: { github: navidrome/navidrome  strip-v: true }  asset: "navidrome_*_linux_amd64.rpm" }
                { via: tarball  when: "not arch and not debian and not redhat"  installDir: "$CONFIGSYS_APP_DIR/navidrome"  requires: glibc
                  version: { github: navidrome/navidrome  strip-v: true  asset: "navidrome_*_linux_amd64.tar.gz" } } ] }
        kodi: { description: "Kodi — an open-source home-theater / media-center app."
            install: [ { via: flatpak  hub: flathub  app: tv.kodi.Kodi }   // upstream-recommended; native alternates below
                       { via: native  when: "ubuntu"  repo-component: universe }
                       { via: native  when: "fedora"  requires: rpmfusion }   // RPM Fusion free, not base Fedora
                       { via: native  when: "arch" } ] }
        stremio: { description: "Stremio — a media-center streaming/aggregator client." install: [ { via: flatpak  hub: flathub  app: com.stremio.Stremio }  { via: aur  when: "arch"  name: stremio } ] }

        // --- self-hosted / home-server apps. Clean daemons get a matching -service (a plain
        // `systemctl enable`); pi-hole/adguardhome self-install their service; config-dependent ones
        // (wireguard tunnels, prometheus units) you wire up yourself. ---
        // Home Assistant CORE in a pipx-managed venv on python3.14 (its runtime floor, now stable) —
        // NOT Home Assistant OS/Supervised, which are Docker/appliance images (no docker driver here).
        // requires python3.14 BY NAME so /usr/bin/python3.14 exists for pipx's `--python`, plus a C
        // toolchain + ffmpeg for building/running deps. Some integrations pip-install extra system
        // libs at runtime — add those to a profile if one you use needs it.
        home-assistant: { description: "Home Assistant Core — a Python home-automation hub (venv install)."
            requires: [ python3.14, cpp-toolchain, ffmpeg ]
            install: [ { via: pipx  name: homeassistant  python: python3.14 } ] }
        pi-hole: { description: "Pi-hole — a network-wide DNS ad-blocker (FTL/dnsmasq + web admin)."
            install: [ { via: script   // the upstream installer sets up the service + `pihole` CLI (interactive)
                install-cmd:   'curl -sSL https://install.pi-hole.net | bash'
                version-cmd:   'pihole -v 2>/dev/null'
                version-re:    'v?([0-9][0-9.]*)'
                uninstall-cmd: 'pihole uninstall'
                location:      '/etc/pihole' } ] }
        adguardhome: { description: "AdGuard Home — a network-wide DNS ad/tracker blocker (single Go binary)."
            install: [
                { via: native   when: "arch" }                     // pacman: adguardhome (extra)
                { via: tarball  when: "not arch"  installDir: "$CONFIGSYS_APP_DIR/adguardhome"  requires: glibc   // then `AdGuardHome -s install` registers the service; first-run web setup on :3000
                  version: { github: AdguardTeam/AdGuardHome  strip-v: true  asset: "AdGuardHome_linux_amd64.tar.gz" } }
                { via: snap  name: adguard-home } ]                // self-contained alternate (pinnable)
        }
        homebridge: { description: "Homebridge — bridge non-HomeKit devices to Apple HomeKit (Node.js)."
            install: [
                { via: native  when: "debian"  name: homebridge   // official repo (bundles its own Node + a service user); single `stable` suite, codename-independent
                  pubkey-url: "https://repo.homebridge.io/KEY.gpg"  pubkey-path: /usr/share/keyrings/homebridge.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/homebridge.gpg] https://repo.homebridge.io stable main"
                  source-path: /etc/apt/sources.list.d/homebridge.list }
                { via: npm  when: "not debian"  name: homebridge } ]   // needs node; then `hb-service install`
        }
        mosquitto: { description: "Eclipse Mosquitto — a lightweight MQTT broker (the common Home Assistant companion)." install: [ { via: native } ] }
        mosquitto-service: { description: "Enable and start the Mosquitto MQTT broker (systemd)." requires: mosquitto  install: [ { via: service  unit: mosquitto } ] }
        syncthing: { description: "Syncthing — continuous peer-to-peer file synchronization."
            install: [ { via: native }                             // uniform pkg `syncthing`
                       { via: tarball  standing: never-auto  installDir: "$CONFIGSYS_APP_DIR/syncthing"  requires: glibc   // newest upstream build (pinnable)
                         version: { github: syncthing/syncthing  strip-v: true  asset: "syncthing-linux-amd64-*.tar.gz" } } ] }
        tailscale: { description: "Tailscale — a WireGuard-based mesh VPN (`tailscale` CLI + `tailscaled`)."
            install: [   // official repo; the apt codename bumps as they add releases, dnf is $basearch-templated
                { via: native  when: "ubuntu"
                  pubkey-url: "https://pkgs.tailscale.com/stable/ubuntu/noble.noarmor.gpg"  pubkey-path: /usr/share/keyrings/tailscale-archive-keyring.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/tailscale-archive-keyring.gpg] https://pkgs.tailscale.com/stable/ubuntu noble main"
                  source-path: /etc/apt/sources.list.d/tailscale.list }
                { via: native  when: "debian"
                  pubkey-url: "https://pkgs.tailscale.com/stable/debian/bookworm.noarmor.gpg"  pubkey-path: /usr/share/keyrings/tailscale-archive-keyring.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/tailscale-archive-keyring.gpg] https://pkgs.tailscale.com/stable/debian bookworm main"
                  source-path: /etc/apt/sources.list.d/tailscale.list }
                { via: native  when: "redhat"
                  pubkey-url: "https://pkgs.tailscale.com/stable/fedora/repo.gpg"
                  repo-id: tailscale  repo-name: "Tailscale"  repo-url: "https://pkgs.tailscale.com/stable/fedora/$basearch" }
                { via: native  when: "arch" } ] }
        tailscale-service: { description: "Enable and start the Tailscale daemon (systemd)." requires: tailscale  install: [ { via: service  unit: tailscaled } ] }
        grafana: { description: "Grafana — analytics & observability dashboards (OSS)."
            install: [
                { via: native  when: "debian"  name: grafana   // official repo (single `stable` suite — codename-independent)
                  pubkey-url: "https://apt.grafana.com/gpg.key"  pubkey-path: /etc/apt/keyrings/grafana.gpg
                  source-line: "deb [signed-by=/etc/apt/keyrings/grafana.gpg] https://apt.grafana.com stable main"
                  source-path: /etc/apt/sources.list.d/grafana.list }
                { via: native  when: "redhat"  name: grafana
                  pubkey-url: "https://rpm.grafana.com/gpg.key"
                  repo-id: grafana  repo-name: "Grafana"  repo-url: "https://rpm.grafana.com" }
                { via: native  when: "arch"  name: grafana } ] }
        grafana-service: { description: "Enable and start Grafana (systemd)." requires: grafana  install: [ { via: service  unit: grafana-server } ] }
        prometheus: { description: "Prometheus — a time-series metrics & alerting server."
            install: [
                { via: native  when: "arch or debian"  repo-component: universe }   // pacman/apt `prometheus` (debian lags upstream)
                { via: tarball  when: "not arch and not debian"  installDir: "$CONFIGSYS_APP_DIR/prometheus"  requires: glibc   // upstream static binaries; self-author the unit
                  version: { github: prometheus/prometheus  strip-v: true  asset: "prometheus-*.linux-amd64.tar.gz" } } ] }
        cockpit: { description: "Cockpit — a web-based server administration UI (socket-activated)."
            install: [ { via: native  when: "debian or redhat or arch or opensuse" } ] }   // uniform pkg `cockpit`
        cockpit-service: { description: "Enable Cockpit's web UI (systemd socket)." requires: cockpit  install: [ { via: service  unit: cockpit.socket } ] }
        wireguard: { description: "WireGuard — fast, modern VPN tunneling (`wg`/`wg-quick`)."
            install: [ { via: native  name: { apt: wireguard  default: wireguard-tools } } ] }   // debian `wireguard` metapkg; else `wireguard-tools`
        nextcloud: { description: "Nextcloud — a self-hosted file-sync & collaboration server (all-in-one snap)."
            install: [ { via: snap  name: nextcloud } ] }         // snap-or-Docker in practice; no native server package
        obs-studio: { description: "OBS Studio — live streaming and screen recording." install: [ { via: flatpak  hub: flathub  app: com.obsproject.Studio }  { via: snap  name: obs-studio } ] }
        spotify:    { description: "Spotify — music streaming client." install: [ { via: flatpak  hub: flathub  app: com.spotify.Client }  { via: snap  name: spotify } ] }   // not in distro repos; Flathub + official snap

        // --- digital-music tools --- (GUI apps via Flathub; audio-system bits native)
        musescore:     { description: "MuseScore — music notation and composition." install: [ { via: flatpak  hub: flathub  app: org.musescore.MuseScore }  { via: appImage  name: MuseScore  scope: user  version: { github: musescore/MuseScore  strip-v: true  asset: "MuseScore-Studio-*-x86_64.AppImage" }  path: ~/apps/musescore.appimage } ] }   // asset glob absorbs the build-number suffix
        hydrogen:      { description: "Hydrogen — a pattern-based drum machine." install: [ { via: flatpak  hub: flathub  app: org.hydrogenmusic.Hydrogen } ] }
        carla:         { description: "Carla — an audio plugin host (LV2/VST/…)." install: [ { via: flatpak  hub: flathub  app: studio.kx.carla } ] }
        sonic-pi:      { description: "Sonic Pi — a live-coding music synth for everyone." install: [ { via: flatpak  hub: flathub  app: net.sonic_pi.SonicPi } ] }
        supercollider: { description: "SuperCollider — audio synthesis and algorithmic composition." install: [ { via: native  when: "debian or redhat or arch or opensuse"  repo-component: universe }  { via: native  when: "fedora_atomic" } ] }   // brew formula `supercollider`
        qjackctl:      { description: "QjackCtl — a GUI controller for the JACK audio server." install: [ { via: native  repo-component: universe } ] }
        // PipeWire — the modern audio/video server. Native; already the default on most current
        // distros (where installing it is a harmless no-op).
        pipewire:      { description: "PipeWire — modern audio/video server (PulseAudio/JACK replacement)." install: [ { via: native } ] }
        // JACK — low-latency audio server (jack2 is the current implementation). NOTE: conflicts with
        // pipewire's JACK shim (both provide the client libs) — install one JACK provider or the other.
        jack: { description: "JACK Audio Connection Kit — low-latency audio server & routing."
            install: [ { via: native  when: "debian"  name: jackd2 }
                       { via: native  when: "fedora"  name: jack-audio-connection-kit }
                       { via: native  when: "rhel"  requires: epel  name: jack-audio-connection-kit }   // EPEL
                       { via: native  when: "arch or opensuse"  name: jack2 }
                       { via: native  when: "fedora_atomic"  name: jack } ] }   // brew formula `jack`
        // yabridge — bridge Windows VST2/VST3/CLAP plugins into Linux audio hosts. Needs Wine; x86_64
        // only. Native on Arch (`extra`); elsewhere the upstream github release tarball.
        yabridge: { description: "yabridge — bridge Windows VST/VST3/CLAP plugins into Linux audio hosts." requires: wine
            install: [ { via: native   when: "arch" }
                       { via: tarball  when: "not arch"  installDir: "$CONFIGSYS_APP_DIR/yabridge"  requires: glibc
                         version: { github: robbert-vdh/yabridge  strip-v: true  asset: "yabridge-*.tar.gz" } } ] }
        // tenacity: the telemetry-free Audacity fork. No reliable native package anywhere, so
        // flatpak-only (unroutable on Alpine -> surfaces as a diagnostic, never a crash).
        tenacity: { description: "Tenacity — an open-source multi-track audio editor (Audacity fork)." install: [ { via: flatpak  hub: flathub  app: org.tenacityaudio.Tenacity } ] }

        // gnuradio: an SDR *framework* (Python bindings, out-of-tree modules) — flatpak is
        // impractical, so native everywhere (package name `gnuradio`).
        gnuradio: { description: "GNU Radio — a software-defined radio toolkit." install: [ { via: native } ] }

        // ffmpeg: native, but neither Fedora nor EL ships it in base repos — the full build
        // lives in RPM Fusion on both (Fedora and EL alike). `when: "redhat"` covers both;
        // rpmfusion-free (below) does the per-distro repo setup. Everywhere else it's in base.
        ffmpeg: { description: "FFmpeg — record, convert, and stream audio and video."
            install: [ { via: native  when: "redhat"  requires: rpmfusion }
                       { via: native  name: { zypper: ffmpeg-7  default: ffmpeg } } ]
        }
        // vlc: RPM Fusion on Fedora, but EL carries it in EPEL (not RPM Fusion) — so the two
        // rpm families take different capability edges. Base repos everywhere else.
        vlc: { description: "VLC — plays virtually any media file or stream."
            install: [ { via: flatpak  hub: flathub  app: org.videolan.VLC }   // uniform option everywhere; the only method on atomic (brew's vlc is a mac-only cask)
                       { via: native  when: "fedora"  requires: rpmfusion }
                       { via: native  when: "rhel"    requires: epel }
                       { via: native  when: "not fedora_atomic" } ]
        }
        // RPM Fusion Free: enabling it = (EL only) turn on EPEL + CRB, then drop the free
        // .repo (dnf expands $releasever/$basearch and auto-imports the per-release key on the
        // first -y install) and pull the release package that formalizes the config. Fedora and
        // EL differ only in the repo path + key + those EL prereqs, so it's two bindings.
        // Provides the `rpmfusion` capability ffmpeg (both families) and vlc (Fedora) pull in.
        // Validated end to end on fedora:41 and rockylinux:9 (ffmpeg deps resolve). NOTE: EL
        // support targets the free rebuilds (Rocky/Alma/CentOS, CRB via config-manager); RHEL
        // proper enables CodeReady via subscription-manager, which the user does once by hand.
        rpmfusion-free: { description: "RPM Fusion (free) — an extra Fedora/RHEL packages repo."
            provides: rpmfusion
            install: [
                { via: native  when: "rhel"  requires: epel  name: rpmfusion-free-release
                  enable-repo: crb
                  repo-id: rpmfusion-free  repo-name: "RPM Fusion for EL - Free"
                  repo-url: "https://download1.rpmfusion.org/free/el/updates/$releasever/$basearch/"
                  pubkey-url: "https://rpmfusion.org/keys?action=AttachFile&do=get&target=RPM-GPG-KEY-rpmfusion-free-el-$releasever" }
                { via: native  when: "fedora"  name: rpmfusion-free-release
                  repo-id: rpmfusion-free  repo-name: "RPM Fusion Free"
                  repo-url: "https://download1.rpmfusion.org/free/fedora/releases/$releasever/Everything/$basearch/os/"
                  pubkey-url: "https://rpmfusion.org/keys?action=AttachFile&do=get&target=RPM-GPG-KEY-rpmfusion-free-fedora-$releasever" }
            ]
        }

        // unityhub: the Unity Hub AppImage. Unity Editor(s) are installed THROUGH the Hub at
        // runtime — there's no `unity3d` package to route. Config in ~/.config/UnityHub (deferred).
        unityhub: { description: "Unity Hub — manage Unity game-engine installs and projects."
            suggests: unityhub-dotfiles
            install: [ { via: appImage  name: "Unity Hub"  standing: 1  version: { static: latest }   // Unity's official AppImage stays the default
                         url: "https://public-cdn.cloud.unity3d.com/hub/prod/UnityHub.AppImage"
                         path: ~/apps/UnityHub.AppImage }
                       { via: flatpak  hub: flathub  app: com.unity.UnityHub } ]   // offered as an alternative
        }

        // --- desktop environments (metapackage names verified per-distro in a podman sweep of
        // apt/dnf/pacman/zypper/apk, plus this Pop host for cosmic) ---
        // Native metapackages. Installing a DE where the OS already ships it is a harmless no-op
        // (inspect reads it as installed). `when:`-gated to the traditional package families
        // (excludes atomic / brew-native desktops, which are image-based). Arch installs some as
        // package GROUPS (xfce4/mate) — the pacman driver detects group membership for get_version.
        gnome:    { description: "GNOME — the polished, mainstream GNOME desktop." install: [ { via: native  when: "debian or redhat or arch or opensuse or alpine"  name: { default: gnome-shell } } ] }
        kde:      { description: "KDE Plasma — a feature-rich, highly customizable desktop." install: [ { via: native  when: "debian or redhat or arch or opensuse or alpine"  name: { apt: kde-plasma-desktop  dnf: plasma-desktop  pacman: plasma-meta  zypper: plasma6-session  apk: plasma-desktop } } ] }
        xfce:     { description: "Xfce — a lightweight, traditional desktop environment." install: [ { via: native  when: "debian or redhat or arch or opensuse or alpine"  name: { apt: xfce4  dnf: xfce4-session  pacman: xfce4  zypper: xfce4-session  apk: xfce4 } } ] }
        lxqt:     { description: "LXQt — a lightweight Qt desktop." install: [ { via: native  when: "debian or redhat or arch or opensuse or alpine"  name: { apt: lxqt  dnf: lxqt-session  pacman: lxqt  zypper: lxqt-session  apk: lxqt-desktop } } ] }
        mate:     { description: "MATE — a classic GNOME 2-style desktop." install: [ { via: native  when: "debian or redhat or arch or opensuse or alpine"  name: { apt: mate-desktop-environment  dnf: mate-desktop  pacman: mate  zypper: mate-session-manager  apk: mate-desktop-environment } } ] }
        sway:     { description: "Sway — an i3-compatible tiling Wayland compositor." install: [ { via: native  when: "debian or redhat or arch or opensuse or alpine" } ] }   // same package name in every family
        cinnamon: { description: "Cinnamon — a modern desktop with a traditional layout." install: [ { via: native  when: "debian or redhat or arch or opensuse"  name: { apt: cinnamon-desktop-environment  dnf: cinnamon  pacman: cinnamon  zypper: cinnamon } } ] }   // not packaged for Alpine
        budgie:   { description: "Budgie — an elegant, modern desktop environment." install: [ { via: native  when: "debian or redhat or arch or opensuse"  name: { default: budgie-desktop } } ] }                                                                    // not packaged for Alpine
        hyprland: { description: "Hyprland — a dynamic tiling Wayland compositor with eye candy." install: [ { via: native  when: "redhat or arch or opensuse or alpine"  name: { default: hyprland } } ] }                                                                          // not in stock Ubuntu
        cosmic:   { description: "COSMIC — System76's Rust-based desktop environment." install: [ { via: native  when: "pop_os! or redhat or arch or opensuse or alpine"  name: { default: cosmic-session } } ] }                                                          // stock Debian/Ubuntu lack it; Pop + others ship cosmic-session
        // Window managers (X11/Wayland tilers + a classic). Gated to the families that package them.
        i3:       { description: "i3 — a keyboard-driven tiling window manager (X11)." install: [ { via: native  when: "debian or redhat or arch or opensuse or alpine"  name: { pacman: i3-wm  apk: i3wm  default: i3 } } ] }
        qtile:    { description: "Qtile — a tiling window manager written and configured in Python." install: [ { via: native  when: "debian or redhat or arch"  name: { default: qtile } } ] }
        xmonad:   { description: "xmonad — a tiling window manager written and configured in Haskell." install: [ { via: native  when: "debian or redhat or arch or opensuse"  name: { default: xmonad } } ] }
        fvwm2:    { description: "FVWM2 — the classic, highly configurable X11 window manager." install: [ { via: native  when: "debian or arch"  name: { default: fvwm } } ] }   // fvwm2 packaging varies (many distros ship the 3.x line as `fvwm3`); debian/arch `fvwm` is the 2.x classic

        // lazygit: native on fedora/arch; elsewhere (debian/EL) a static Go binary from the
        // GitHub release, unpacked under ~/apps/lazygit (scope-honoring). Its bash.d snippet
        // aliases `lazygit` to that binary when present (a no-op where it's native on PATH).
        lazygit: {
            description: "Terminal UI for git — stage, commit, branch, rebase visually."
            suggests: lazygit-dotfiles
            install: [
                { via: native  when: "arch" }                        // not in Fedora repos -> tarball there
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/lazygit"
                  version: { github: jesseduffield/lazygit  strip-v: true  asset: "lazygit_*_Linux_x86_64.tar.gz" } }
            ]
        }
        lazygit-dotfiles: { description: "lazygit config, linked into place."
            install: [ { via: dotfiles  requires: bash-dotfiles  src: bash.d/lazygit.sh  dst: ~/.bash.d/lazygit.sh } ]
        }

        // --- dotfiles ---
        bash-dotfiles: { description: "Bash config (.bashrc + ~/.bash.d), linked into place."
            // absorb-into: a pre-existing ~/.bash_aliases is MOVED into the ~/.bash.d loader
            // dir (and made executable) instead of just backed up, so the user's own aliases
            // keep running — the new ~/.bash_aliases sources every ~/.bash.d/*.sh.
            install: [ { via: dotfiles  aliases: { src: bash_aliases  dst: ~/.bash_aliases
                         absorb-into: ~/.bash.d/pre-configsys-aliases.sh } } ]
        }

        // --- editors / IDEs ---
        neovim: { description: "Hyperextensible Vim-based editor (`nvim`)."
            requires: [ ripgrep, tree-sitter-cli ]
            suggests: neovim-dotfiles
            install: [ { via: native  when: fedora_atomic }   // atomic: brew has neovim directly — cleaner than an AppImage needing fuse2
                       { via: appImage  name: Neovim  scope: user   // -> requires libfuse2; keep it in ~/apps
                         version: { github: neovim/neovim  asset: "nvim-linux-$ARCH.appimage" }
                         url: "https://github.com/neovim/neovim/releases/download/$VERSION/nvim-linux-$ARCH.appimage"
                         path: ~/apps/nvim.appimage } ]
        }
        neovim-dotfiles: { description: "Neovim config, linked into place."
            install: [ { via: dotfiles  requires: bash-dotfiles
                         // configsys ships NO neovim config — it's a deeply personal thing. This
                         // only declares WHERE it lives, so `configsys dotfiles capture` can adopt
                         // your existing ~/.config/nvim into your config (your plugin, else the
                         // local store) and manage/sync it from there. Until you capture, this
                         // spec is unpopulated and install leaves ~/.config/nvim untouched.
                         config:  { src: neovim  dst: $XDG_CONFIG_HOME/nvim }
                         aliases: { src: bash.d/neovim.sh  dst: ~/.bash.d/neovim.sh } } ]
        }
        // Emacs — native under `emacs` in every family.
        emacs: { description: "The extensible, self-documenting text editor." install: [ { via: native  repo-component: universe }  { via: flatpak  hub: flathub  app: org.gnu.emacs } ] }
        // Helix — native on dnf/pacman/zypper/apk/brew; NOT in the Ubuntu base repos, so the github
        // release tarball on the Debian family (ships `hx` alongside its runtime/ dir).
        helix: { description: "Post-modern modal editor (`hx`) — batteries included."
            install: [
                { via: native  when: "redhat or arch or opensuse or alpine or fedora_atomic" }
                { via: tarball  when: "not alpine"  installDir: "$CONFIGSYS_APP_DIR/helix"  requires: glibc
                  version: { github: helix-editor/helix  strip-v: true  asset: "helix-*-x86_64-linux.tar.xz" } } ]   // glibc build — offered everywhere except musl (alpine has the native pkg)
        }
        // micro (`micro`): Go terminal editor. Native almost everywhere (Debian/Ubuntu universe,
        // Fedora, Arch, openSUSE, Alpine, Homebrew); the upstream release tarball (ships `micro`)
        // covers EL and anything missed.
        micro: {
            description: "Modern, intuitive terminal text editor (`micro`)."
            install: [
                { via: native  when: "not rhel"  repo-component: universe }
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/micro"  requires: glibc
                  version: { github: zyedidia/micro  strip-v: true  asset: "micro-*-linux64.tar.gz" } }
            ]
        }
        // Zed — native on Arch; elsewhere its own install script (installs into ~/.local).
        zed: { description: "High-performance, multiplayer code editor from the Atom team."
            install: [
                { via: native  when: "arch" }
                { via: flatpak  hub: flathub  app: dev.zed.Zed }
                { via: script
                  install-cmd:   'curl -f https://zed.dev/install.sh | sh'
                  version-cmd:   '"$HOME/.local/bin/zed" --version'
                  version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                  uninstall-cmd: 'rm -rf "$HOME/.local/zed.app" "$HOME/.local/bin/zed"'
                  location:      '~/.local/bin/zed' }
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/zed"  version: { github: zed-industries/zed  strip-v: true  asset: "zed-linux-x86_64.tar.gz" } } ]   // upstream release tarball (zed.app bundle) — cleaner than the curl|sh script
        }
        // vscode: native from Microsoft's vendor repos. Debian/Ubuntu/Pop use the MS apt
        // repo (key + an inline `deb` source-line -> package `code`); Fedora/EL use the MS
        // dnf repo (key + a .repo file); Arch builds `visual-studio-code-bin` from the AUR
        // (the OSS `code` in the Arch repos is a different, unbranded build).
        vscode: { description: "Visual Studio Code — Microsoft's extensible code editor."
            install: [
                { via: flatpak  hub: flathub  app: com.visualstudio.code }   // community Flathub build — offered everywhere; the only method on atomic (no MS vendor repo to wire in)
                { via: native  when: "debian"  name: code
                  pubkey-url: "https://packages.microsoft.com/keys/microsoft.asc"
                  pubkey-path: /usr/share/keyrings/packages.microsoft.asc
                  source-line: "deb [arch=amd64,arm64,armhf signed-by=/usr/share/keyrings/packages.microsoft.asc] https://packages.microsoft.com/repos/code stable main"
                  source-path: /etc/apt/sources.list.d/vscode.list }
                { via: native  when: "redhat"  name: code
                  pubkey-url: "https://packages.microsoft.com/keys/microsoft.asc"
                  repo-id: code  repo-name: "Visual Studio Code"
                  repo-url: "https://packages.microsoft.com/yumrepos/vscode" }
                { via: aur  when: "arch"  name: visual-studio-code-bin }
                { via: snap  name: code  classic: true }   // Microsoft-official snap (candidate-only: the MS apt repo stays the Ubuntu default)
            ]
        }
        // vscodium: the fully-open build of Code — no Microsoft telemetry/branding, and the OSS
        // (non-proprietary) marketplace. Its own apt/dnf repos (download.vscodium.com), Flathub, snap,
        // Arch AUR; package/CLI is `codium`. The telemetry-free sibling of `vscode` (which IS MS's build).
        vscodium: { description: "VSCodium — the community, telemetry-free open-source build of VS Code (`codium`)."
            install: [
                { via: flatpak  hub: flathub  app: com.vscodium.codium }   // universal; the only method on atomic
                { via: native  when: "debian"  name: codium
                  pubkey-url: "https://gitlab.com/paulcarroty/vscodium-deb-rpm-repo/raw/master/pub.gpg"
                  pubkey-path: /usr/share/keyrings/vscodium.asc
                  source-line: "deb [signed-by=/usr/share/keyrings/vscodium.asc] https://download.vscodium.com/debs vscodium main"
                  source-path: /etc/apt/sources.list.d/vscodium.list }
                { via: native  when: "redhat"  name: codium
                  pubkey-url: "https://gitlab.com/paulcarroty/vscodium-deb-rpm-repo/raw/master/pub.gpg"
                  repo-id: vscodium  repo-name: "VSCodium"
                  repo-url: "https://download.vscodium.com/rpms/" }
                { via: aur  when: "arch"  name: vscodium-bin }
                { via: snap  name: codium  classic: true }
            ]
        }
        // antigravity: Google's agent-first AI IDE (a VS Code fork — imports VS Code settings/exts;
        // "Manager view" orchestrates parallel agents across Gemini/Claude/GPT-OSS). Free PREVIEW.
        // Google ships auto-updating GAR apt/dnf repos (us-central1-apt/yum.pkg.dev, package
        // `antigravity`) — the ideal binding, but its exact key + apt suite are behind a JS page we
        // couldn't pin, so those are a TODO (a good target for a refresh version/preview hook). Here:
        // Arch AUR, and the upstream tarball elsewhere (a manual VERSION pin — bump the url; the app
        // self-updates after first launch, so a stale pin only affects the initial install).
        antigravity: { description: "Google Antigravity — Google's agent-first AI IDE (a VS Code fork; Gemini/Claude/GPT-OSS)."
            install: [
                { via: aur  when: "arch"  name: antigravity-bin }
                { via: tarball  when: "not arch"  installDir: "$CONFIGSYS_APP_DIR/antigravity"  requires: glibc  version: { static: "1.23.2" }
                  url: "https://edgedl.me.gvt1.com/edgedl/release2/j0qc3/antigravity/stable/1.23.2-4781536860569600/linux-x64/Antigravity.tar.gz" } ]
        }
        // android-studio: Google's official tarball, unpacked scope-honoring (~/android-studio
        // for user, /opt/android-studio for system). No clean version API, so the version is a
        // manual pin — bump it from developer.android.com/studio. Fat IDE config deferred.
        android-studio: { description: "Android Studio — the official Android IDE."
            suggests: android-studio-dotfiles
            install: [ { via: tarball  version: { static: 2024.2.1.11 }  standing: 1  requires: glibc   // Google's official tarball stays the default (glibc-linked JVM/launchers). No plain version endpoint for a `latest-check:` (the studio page is JS) — bump from developer.android.com/studio.
                         url: "https://redirector.gvt1.com/edgedl/android/studio/ide-zips/$VERSION/android-studio-$VERSION-linux.tar.gz" }
                       { via: flatpak  hub: flathub  app: com.google.AndroidStudio } ]   // community Flathub build offered as an alternative
        }
        // jmtpfs: FUSE filesystem to mount an MTP device (an Android phone over USB) as a
        // directory. Native on the debian + redhat families (apt universe, Fedora); AUR on Arch.
        // NOT in openSUSE/Alpine repos (name sweep confirmed), so the native binding is gated to
        // where it exists. The package pulls its FUSE + libmtp deps transitively (no `requires:`).
        jmtpfs: { description: "jmtpfs — mount MTP devices (Android phones) via FUSE."
            install: [
                { via: aur     when: "arch" }
                { via: native  when: "debian or redhat"  repo-component: universe }
            ]
        }
        // JetBrains Toolbox — the launcher that installs/updates IDEA, CLion, PyCharm, etc.
        // (cleaner than one-off IDE components). The version-less URL 302-redirects to the
        // latest tarball, which `curl -fSL` follows — so `static: latest`, no version to chase.
        jetbrains-toolbox: { description: "JetBrains Toolbox — install and manage JetBrains IDEs."
            install: [ { via: tarball  installDir: "$CONFIGSYS_APP_DIR/jetbrains-toolbox"  requires: glibc   // glibc-linked launcher
                         version: { static: latest }
                         url: "https://download.jetbrains.com/product?code=TBA&latest&distribution=linux" } ]
        }

        // --- AI / LLM command-line tools ---
        // Claude Code and Codex are npm globals (userland via the npm driver). llm and aider are
        // Python CLIs (pipx). Ollama is a LOCAL INFERENCE SERVER: native on Arch/Homebrew, else its
        // own install script (which also sets up the systemd service); a best-effort uninstall is
        // declared so the script driver can remove it cleanly.
        claude-code: { description: "Claude Code — Anthropic's agentic coding CLI." install: [ { via: npm  name: "@anthropic-ai/claude-code" } ] }
        codex:       { description: "OpenAI Codex CLI — agentic coding in the terminal." install: [ { via: npm  name: "@openai/codex" } ] }
        llm:         { description: "`llm` — a CLI to access LLMs from the shell and scripts." install: [ { via: pipx  name: llm } ] }
        aider:       { description: "Aider — AI pair-programming in your terminal, over your git repo." install: [ { via: pipx  name: aider-chat } ] }        // PyPI dist is aider-chat
        ollama: { description: "Ollama — run large language models locally."
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }             // brew formula `ollama`
                { via: script
                  install-cmd:   'curl -fsSL https://ollama.com/install.sh | sh'
                  version-cmd:   'ollama --version'
                  version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                  uninstall-cmd: 'sudo systemctl stop ollama 2>/dev/null; sudo rm -f /usr/local/bin/ollama /etc/systemd/system/ollama.service; sudo rm -rf /usr/share/ollama'
                  location:      '/usr/local/bin/ollama' }
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/ollama"  requires: zstd  version: { github: ollama/ollama  strip-v: true  asset: "ollama-linux-amd64.tar.zst" } } ]   // upstream tarball (zstd; bin/ + lib/) — a no-daemon userland alt to the install script
        }

        // --- container / k8s / dev TUIs & C++ package managers ---
        // lazydocker's asset embeds the version (github asset discovery, like lazygit); lazysql
        // and k9s have stable asset names, so they use github's API-free latest/download URL.
        lazydocker: {
            description: "Terminal UI for Docker/Compose — containers, logs, stats."
            install: [ { via: tarball  installDir: "$CONFIGSYS_APP_DIR/lazydocker"  requires: glibc
                         version: { github: jesseduffield/lazydocker  strip-v: true  asset: "lazydocker_*_Linux_x86_64.tar.gz" } } ]
        }
        lazysql: { description: "Terminal UI for SQL databases (`lazysql`)."
            install: [ { via: tarball  installDir: "$CONFIGSYS_APP_DIR/lazysql"  requires: glibc  version: { static: latest }
                         url: "https://github.com/jorgerojas26/lazysql/releases/latest/download/lazysql_Linux_x86_64.tar.gz" } ]
        }
        k9s: {
            description: "Terminal UI to navigate and manage Kubernetes clusters."
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }             // brew formula `k9s`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/k9s"  requires: glibc  version: { static: latest }
                  url: "https://github.com/derailed/k9s/releases/latest/download/k9s_Linux_amd64.tar.gz" } ]
        }
        // kubectl isn't in the Debian/Fedora base repos; native on Arch/Homebrew, else the upstream
        // static binary from dl.k8s.io (bare-binary tarball mode; `stable.txt` gives the version).
        // The Go binary runs anywhere, so no glibc gate.
        kubectl: { description: "kubectl — the Kubernetes command-line client."
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/kubectl"  archive: none   // static Go binary from dl.k8s.io — runs anywhere; a uniform option (native stays default on arch/atomic)
                  version: { url: "https://dl.k8s.io/release/stable.txt" }
                  url: "https://dl.k8s.io/release/v$VERSION/bin/linux/amd64/kubectl" }
                { via: snap  name: kubectl  classic: true } ]   // Canonical-official snap (candidate-only)
        }
        // helm & k3s install via their upstream scripts (script driver) where not native.
        helm: { description: "Helm — the package manager for Kubernetes."
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }
                { via: script
                  install-cmd:   'curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash'
                  version-cmd:   'helm version --short'
                  version-re:    '(v?[0-9]+\.[0-9]+\.[0-9]+)'
                  uninstall-cmd: 'sudo rm -f /usr/local/bin/helm'
                  location:      '/usr/local/bin/helm' }
                { via: snap  name: helm  classic: true } ]   // community (Snapcrafters) snap (candidate-only)
        }
        k3s: { description: "k3s — lightweight, single-binary Kubernetes."
            install: [ { via: script  standing: 1                              // keep the get.k3s.io script the default: it sets up the systemd SERVICE (the point of a k8s server); the tarball is just the bare binary
                         install-cmd:   'curl -sfL https://get.k3s.io | sh'
                         version-cmd:   'k3s --version'
                         version-re:    '(v[0-9]+\.[0-9]+\.[0-9]+)'
                         uninstall-cmd: '/usr/local/bin/k3s-uninstall.sh'
                         location:      '/usr/local/bin/k3s' }
                       { via: tarball  archive: none  binary: k3s  installDir: "$CONFIGSYS_APP_DIR/k3s"  version: { github: k3s-io/k3s  asset: "k3s" } } ]   // raw static binary (the API gives the +k3s1-tagged download URL); an option for "just the binary"
        }
        // conan is a Python CLI (pipx). vcpkg is a git clone + bootstrap (script driver; needs git).
        conan: { description: "Conan — a C/C++ package manager." install: [ { via: pipx  name: conan } ] }
        vcpkg: { description: "vcpkg — Microsoft's C/C++ library manager."
            requires: [ git, curl, zip, unzip ]     // bootstrap-vcpkg fetches + unpacks its tool
            install: [ { via: script
                         install-cmd:   'git clone https://github.com/microsoft/vcpkg "$HOME/.vcpkg" && "$HOME/.vcpkg/bootstrap-vcpkg.sh" -disableMetrics'
                         version-cmd:   '"$HOME/.vcpkg/vcpkg" version'
                         version-re:    '([0-9]{4}-[0-9]{2}-[0-9]{2})'
                         uninstall-cmd: 'rm -rf "$HOME/.vcpkg"'
                         location:      '~/.vcpkg' } ]
        }

        // --- build systems ---
        make:  { description: "GNU Make — build automation via Makefiles." install: [ { via: native } ] }
        cmake: { description: "CMake — cross-platform build-system generator." install: [ { via: native } ] }
        ninja: { description: "Ninja — a small, fast build backend." install: [ { via: native  name: { apt: ninja-build  dnf: ninja-build  apk: samurai  default: ninja } } ] }
        meson: { description: "Meson — a fast, modern build system." install: [ { via: native } ] }
        // just: native on rpm/Arch/openSUSE/brew; the upstream musl tarball (statically linked,
        // runs anywhere) is offered as a uniform option everywhere — it's the default on the Debian
        // family (no repo package; works on older apt too, e.g. Ubuntu/Pop 22.04) and a candidate
        // elsewhere (native stays the default where the distro packages it).
        just: { description: "just — a handy command runner (Makefile-like `justfile`)."
            install: [
                { via: native  when: "redhat or arch or opensuse or fedora_atomic" }
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/just"
                  version: { github: casey/just  strip-v: true  asset: "just-*-x86_64-unknown-linux-musl.tar.gz" } } ]
        }
        // Bazelisk (the official launcher that manages bazel versions) — a bare static binary.
        bazelisk: { description: "Bazelisk — a launcher that manages Bazel versions."
            install: [
                { via: native  when: "fedora_atomic" }             // brew formula `bazelisk`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/bazelisk"  archive: none  binary: bazelisk  version: { static: latest }
                  url: "https://github.com/bazelbuild/bazelisk/releases/latest/download/bazelisk-linux-amd64" } ]
        }
        // Maven (native everywhere) and Gradle (native except Fedora base — use SDKMAN there). Both
        // need a JVM.
        maven:  { description: "Apache Maven — Java build and dependency management." requires: jdk
                  install: [ { via: native }  { via: sdkman  standing: never-auto } ] }   // native default; SDKMAN for a pinned version
        gradle: { description: "Gradle — JVM build automation." requires: jdk
                  install: [ { via: native  when: "debian or arch or fedora_atomic" }   // native where packaged
                             { via: sdkman  when: "not debian and not arch and not fedora_atomic" } ] }   // SDKMAN elsewhere (fedora/alpine/opensuse) + any pinned version

        // --- debugging / static analysis / profiling (NB: ASan/UBSan/TSan are gcc/clang FLAGS,
        // not packages — nothing to install for those). ---
        valgrind:  { description: "Valgrind — memory-error and leak detector." install: [ { via: native } ] }
        cppcheck:  { description: "Cppcheck — static analysis for C/C++." install: [ { via: native } ] }
        strace:    { description: "strace — trace the system calls of a running program." install: [ { via: native } ] }
        ltrace:    { description: "ltrace — trace the library calls of a running program." install: [ { via: native } ] }
        lldb:      { description: "LLDB — the LLVM project's debugger." install: [ { via: native } ] }
        heaptrack: { description: "heaptrack — a heap-memory profiler for C/C++." install: [ { via: native  when: "debian or redhat or arch or opensuse" } ] }
        clang-tidy: { description: "clang-tidy — C/C++ linter and static analyzer." install: [ { via: native  when: "debian or redhat or arch"  name: { apt: clang-tidy  dnf: clang-tools-extra  pacman: clang } } ] }
        // perf is kernel-coupled and named per-distro: Ubuntu's linux-tools track, Debian's
        // linux-perf (also Proxmox); plain `perf` on redhat/arch/opensuse/alpine.
        perf: { description: "Linux `perf` — sampling profiler and performance counters." install: [ { via: native  name: { default: perf } }
                           { via: native  when: debian  name: { apt: linux-perf } }
                           { via: native  when: ubuntu  name: { apt: linux-tools-generic } } ] }
        // A one-shot bundle of the core analysis kit. This one IS a parts aggregator (not a profile)
        // because it's OS-conditional — the `when:` gates the whole kit out where some parts are absent.
        analysis: { description: "Debug & analysis kit — valgrind, cppcheck, clang-tidy, lldb, strace, ltrace." install: [ { via: parts  when: "debian or redhat or arch"  parts: [ valgrind, cppcheck, clang-tidy, lldb, strace, ltrace ] } ] }

        // --- configuration management ---
        // ansible is native everywhere (robust, CLI on PATH — pipx would hide it, since the
        // `ansible` command actually ships in the ansible-core dependency, which pipx won't link).
        // salt is Python with self-contained scripts (pipx). puppet is Ruby (gem). No chef (heavy
        // enterprise tool that also overlaps configsys itself).
        ansible: { description: "Ansible — agentless IT automation and configuration management." install: [ { via: native  repo-component: universe } ] }
        salt:    { description: "Salt — event-driven automation and configuration management." install: [ { via: pipx  name: salt } ] }
        puppet:  { description: "Puppet — declarative configuration management." install: [ { via: gem   name: puppet } ] }

        // --- back-end: cloud CLIs, IaC, protobuf, DB clients + servers ---
        // Cloud CLIs via their official installers (script driver, userland).
        awscli: { description: "AWS CLI — the command-line interface for Amazon Web Services."
            requires: [ curl, unzip ]
            install: [ { via: script
                         install-cmd:   'curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o /tmp/awscliv2.zip && unzip -q -o /tmp/awscliv2.zip -d /tmp/awscli-inst && /tmp/awscli-inst/aws/install --update -i "$HOME/.local/aws-cli" -b "$HOME/.local/bin" && rm -rf /tmp/awscliv2.zip /tmp/awscli-inst'
                         version-cmd:   '"$HOME/.local/bin/aws" --version'
                         version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                         uninstall-cmd: 'rm -rf "$HOME/.local/aws-cli" "$HOME/.local/bin/aws" "$HOME/.local/bin/aws_completer"'
                         location:      '~/.local/bin/aws' } ]
        }
        gcloud: { description: "Google Cloud CLI (`gcloud`) — manage GCP resources."
            requires: curl
            install: [ { via: script
                         install-cmd:   'curl -fsSL https://sdk.cloud.google.com | bash -s -- --disable-prompts --install-dir="$HOME"'
                         version-cmd:   '"$HOME/google-cloud-sdk/bin/gcloud" version'
                         version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                         uninstall-cmd: 'rm -rf "$HOME/google-cloud-sdk"'
                         location:      '~/google-cloud-sdk/bin' } ]
        }
        azure-cli: { description: "Azure CLI (`az`) — manage Microsoft Azure resources." install: [ { via: pipx  name: azure-cli } ] }
        // IaC + gRPC — Go static binaries from github release tarballs.
        opentofu: { description: "OpenTofu — open-source, Terraform-compatible infrastructure as code." install: [ { via: tarball  installDir: "$CONFIGSYS_APP_DIR/opentofu"  version: { github: opentofu/opentofu  strip-v: true  asset: "tofu_*_linux_amd64.tar.gz" } } ] }
        grpcurl:  { description: "curl for gRPC — call and inspect gRPC services from the shell." install: [ { via: tarball  installDir: "$CONFIGSYS_APP_DIR/grpcurl"   version: { github: fullstorydev/grpcurl  strip-v: true  asset: "grpcurl_*_linux_x86_64.tar.gz" } } ] }
        protobuf: { description: "Protocol Buffers compiler (`protoc`)." install: [ { via: native  repo-component: universe  name: { apt: protobuf-compiler  dnf: protobuf-compiler  zypper: protobuf-devel  default: protobuf } }  { via: tarball  installDir: "$CONFIGSYS_APP_DIR/protobuf"  requires: unzip  version: { github: protocolbuffers/protobuf  strip-v: true  asset: "protoc-*-linux-x86_64.zip" } } ] }   // prebuilt protoc + well-known-types include/
        // DB clients: dbeaver (GUI, Flathub), pgcli/mycli (pipx), sqlitebrowser (Flathub).
        dbeaver:       { description: "Universal database GUI — browse and query many DB engines." install: [ { via: flatpak  hub: flathub  app: io.dbeaver.DBeaverCommunity }  { via: native-pkg-file  when: "debian or redhat"  version: { github: dbeaver/dbeaver }  asset: { deb: { x86_64: "dbeaver-ce-*-linux-x86_64.deb" }  rpm: { x86_64: "dbeaver-ce-*-linux-x86_64.rpm" } } } ] }   // upstream .deb/.rpm (CE)
        pgcli:         { description: "Postgres CLI with autocompletion and syntax highlighting." install: [ { via: pipx  name: pgcli } ] }
        mycli:         { description: "MySQL/MariaDB CLI with autocompletion and highlighting." install: [ { via: pipx  name: mycli } ] }
        sqlitebrowser: { description: "GUI to create, design, and edit SQLite databases." install: [ { via: flatpak  hub: flathub  app: org.sqlitebrowser.sqlitebrowser } ] }
        // DB servers: native package + a systemd service (verified on apt/dnf/pacman). NOTE:
        // first-run init differs per distro (Fedora postgres needs `postgresql-setup --initdb`).
        postgresql:         { description: "PostgreSQL — advanced open-source relational database." install: [ { via: native  when: "debian or redhat or arch"  name: { dnf: postgresql-server  default: postgresql } } ] }
        postgresql-service: { description: "Enable and start the PostgreSQL server (systemd)." requires: postgresql  install: [ { via: service  unit: postgresql } ] }
        mariadb:            { description: "MariaDB — MySQL-compatible relational database." install: [ { via: native  when: "debian or redhat or arch"  name: { pacman: mariadb  default: mariadb-server } }  { via: native  when: "fedora_atomic"  name: mariadb } ] }   // brew formula `mariadb` (not the distro `-server` split)
        mariadb-service:    { description: "Enable and start the MariaDB server (systemd)." requires: mariadb  install: [ { via: service  unit: mariadb } ] }
        // redis is being replaced by its FOSS fork valkey on Fedora/Arch (drop-in compatible).
        redis:              { description: "Redis — in-memory data store and cache." install: [ { via: native  when: "debian or redhat or arch"  name: { apt: redis-server  dnf: valkey  pacman: valkey } }  { via: native  when: "fedora_atomic"  name: redis } ] }   // brew formula `redis` (distro repos lean valkey post-relicense; brew keeps redis)
        redis-service:      { description: "Enable and start the Redis server (systemd)." requires: redis  install: [ { via: service  when: "debian"  unit: redis-server }
                                                          { via: service  when: "redhat or arch"  unit: valkey } ] }

        // --- science & math ---
        gnuplot:    { description: "gnuplot — command-driven plotting for data and functions." install: [ { via: native  repo-component: universe } ] }
        jupyterlab: { description: "JupyterLab — notebooks and IDE for data science." install: [ { via: pipx  name: jupyterlab } ] }        // `jupyter-lab` on PATH
        paraview:   { description: "ParaView — large-scale scientific data visualization." install: [ { via: native  when: "debian or redhat or arch or opensuse"  repo-component: universe }  { via: flatpak  hub: flathub  app: org.paraview.ParaView } ] }
        maxima:     { description: "Maxima — a computer algebra system for symbolic math." install: [ { via: native  when: "debian or redhat or arch or opensuse"  repo-component: universe }  { via: native  when: "fedora_atomic" } ] }   // brew formula `maxima`
        wxmaxima:   { description: "wxMaxima — a GUI front end for the Maxima CAS." install: [ { via: native  when: "debian or redhat"  repo-component: universe }  { via: flatpak  hub: flathub  app: io.github.wxmaxima_developers.wxMaxima } ] }   // native: debian/redhat (Arch AUR only); flatpak covers the rest
        pari:       { description: "PARI/GP — computer algebra for number theory." install: [ { via: native  repo-component: universe  name: { apt: pari-gp  dnf: pari-gp  pacman: pari  zypper: pari-gp  default: pari } } ] }
        gap:        { description: "GAP — a system for computational discrete algebra (group theory)." install: [ { via: native  when: "debian or redhat or arch or opensuse"  repo-component: universe }  { via: native  when: "fedora_atomic" } ] }   // brew formula `gap`
        sagemath:   { description: "SageMath — an open-source mathematics software system." install: [ { via: native  when: "debian or arch"  repo-component: universe } ] }      // Fedora: COPR/conda only

        // LaTeX (TeX Live) — the recommended subset vs the full multi-GB distribution.
        texlive:      { description: "TeX Live — the TeX/LaTeX typesetting distribution." install: [ { via: native  when: "debian or redhat or arch"  name: { apt: texlive-latex-recommended  dnf: texlive-scheme-medium  pacman: texlive-latexrecommended }  }  { via: native  when: "fedora_atomic"  name: texlive } ] }   // brew formula `texlive`
        texlive-full: { description: "TeX Live (full) — the complete TeX/LaTeX distribution." install: [ { via: native  when: "debian or redhat or arch"  name: { apt: texlive-full  dnf: texlive-scheme-full  pacman: texlive-meta } } ] }

        // Miniforge — a conda env manager (the right home for the numpy/scipy/pandas stack).
        miniforge: { description: "Miniforge — a minimal conda installer (conda-forge default)."
            requires: curl
            install: [ { via: script
                         install-cmd:   'curl -fsSL "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh" -o /tmp/mf.sh && bash /tmp/mf.sh -b -p "$HOME/miniforge3" && rm -f /tmp/mf.sh'
                         version-cmd:   '"$HOME/miniforge3/bin/conda" --version'
                         version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                         uninstall-cmd: 'rm -rf "$HOME/miniforge3"'
                         location:      '~/miniforge3/bin' } ]
        }

        arduino: { description: "Arduino IDE — program Arduino microcontrollers."
            suggests: arduino-dotfiles
            install: [ { via: appImage  name: "Arduino IDE"
                         version: { github: arduino/arduino-ide  asset: "arduino-ide_*_Linux_64bit.AppImage" }
                         url: "https://github.com/arduino/arduino-ide/releases/download/$VERSION/arduino-ide_$VERSION_Linux_64bit.AppImage"
                         path: ~/apps/arduino-ide.appimage }
                       { via: flatpak  hub: flathub  app: cc.arduino.IDE2 } ]
        }
        arduino-dotfiles: { description: "Arduino config, linked into place."
            install: [ { via: dotfiles  requires: bash-dotfiles  src: bash.d/arduino.sh  dst: ~/.bash.d/arduino.sh } ]
        }

        // --- parts: composition (a component that IS several others, no unit of its own) ---
        // Distro-specific vulkan building blocks — only pulled as `parts` of vulkan-runtime on
        // their own family, so `when:`-gated (installing one directly on the wrong distro fails).
        libvulkan1:            { description: "Vulkan loader runtime (libvulkan)." install: [ { via: native  when: "debian" } ] }
        vulkan-loader:         { description: "Vulkan loader — the Vulkan ICD loader runtime." install: [ { via: native  when: "redhat" } ] }
        vulkan-icd-loader:     { description: "Vulkan ICD loader (Arch's libvulkan)." install: [ { via: native  when: "arch" } ] }
        vulkan-radeon:         { description: "Mesa Vulkan driver for AMD GPUs (RADV)." install: [ { via: native  when: "arch" } ] }
        vulkan-intel:          { description: "Mesa Vulkan driver for Intel GPUs (ANV)." install: [ { via: native  when: "arch" } ] }
        vulkan-swrast:         { description: "Mesa software (CPU) Vulkan rasterizer (lavapipe)." install: [ { via: native  when: "arch" } ] }
        mesa-vulkan-drivers:   { description: "Mesa Vulkan drivers — open-source Vulkan for Intel/AMD." install: [ { via: native  when: "debian or redhat" } ] }
        vulkan-runtime: { description: "Vulkan runtime libraries."
            install: [
                { via: parts  when: "debian"  parts: [ libvulkan1, mesa-vulkan-drivers ] }
                { via: parts  when: "redhat"  parts: [ vulkan-loader, mesa-vulkan-drivers ] }  // fedora + EL
                { via: parts  when: "arch"    parts: [ vulkan-icd-loader, vulkan-radeon, vulkan-intel, vulkan-swrast ] }
            ]
        }

        // --- tarball + composition: the vulkan SDK and the vulkan-dev bundle ---
        // vulkan-sdk is ONE component that is both a tarball unit AND an inline config
        // dotfile (dotfiles\vulkan-sdk), keyed by the component; the tarball driver
        // pulls curl. (Old: a [tarball\vulkan-sdk, dotfiles\vulkan-sdk] list bundle.)
        vulkan-sdk: { description: "Vulkan SDK — headers, tools, and validation layers."
            suggests: vulkan-sdk-dotfiles
            install: [ { via: tarball  version: { static: 1.4.350.1 }  installDir: "$CONFIGSYS_SDK_DIR/vulkan"  requires: glibc   // glibc-linked SDK
                         url: "https://sdk.lunarg.com/sdk/download/$VERSION/linux/vulkansdk-linux-$ARCH-$VERSION.tar.xz" } ]
        }
        vulkan-sdk-dotfiles: { description: "Vulkan SDK env config, linked into place."
            install: [ { via: dotfiles  requires: bash-dotfiles
                         aliases: { src: bash.d/vulkan-sdk.sh  dst: ~/.bash.d/vulkan-sdk.sh } } ]
        }
        // vulkan-dev X libs, per OS: Debian ships three; Fedora's libxcb-devel bundles
        // xinput+xinerama (+ xcb-util-cursor-devel); Arch's libxcb does likewise (+ xcb-util-cursor).
        libxcb-xinput0:        { description: "libxcb XInput extension runtime library." install: [ { via: native  when: "debian"  repo-component: universe } ] }
        libxcb-xinerama0:      { description: "libxcb Xinerama extension runtime library." install: [ { via: native  when: "debian"  repo-component: universe } ] }
        libxcb-cursor-dev:     { description: "libxcb-cursor development headers." install: [ { via: native  when: "debian"  repo-component: universe } ] }
        libxcb-devel:          { description: "libxcb development headers." install: [ { via: native  when: "redhat" } ] }   // fedora + EL
        xcb-util-cursor-devel: { description: "xcb-util-cursor development headers." install: [ { via: native  when: "redhat" } ] }   // fedora + EL
        libxcb:                { description: "libxcb — the X protocol C-language binding." install: [ { via: native  when: "arch" } ] }   // arch
        xcb-util-cursor:       { description: "xcb-util-cursor — XCB cursor management library." install: [ { via: native  when: "arch" } ] }   // arch
        // vulkan-dev: a parts bundle composing the X libs, build tools, the SDK tarball,
        // and the vulkan runtime (itself a parts aggregator). One binding per OS family;
        // cpp-toolchain pulls the C/C++ compiler (portable across families).
        vulkan-dev: { description: "Vulkan development headers and validation layers."
            install: [
                { via: parts  when: "debian"
                  parts: [ libxcb-xinput0, libxcb-xinerama0, libxcb-cursor-dev,
                           cpp-toolchain, make, vulkan-sdk, vulkan-runtime ] }
                { via: parts  when: "redhat"
                  parts: [ libxcb-devel, xcb-util-cursor-devel,
                           cpp-toolchain, make, vulkan-sdk, vulkan-runtime ] }
                { via: parts  when: "arch"
                  parts: [ libxcb, xcb-util-cursor,
                           cpp-toolchain, make, vulkan-sdk, vulkan-runtime ] }
            ]
        }

        // --- github .deb where no repo has it, native package elsewhere (cpu-keyed asset) ---
        fastfetch: {
            description: "System info fetcher — the logo + specs banner (neofetch-style)."
            install: [
                // Debian/Ubuntu don't carry fastfetch in-repo (absent through 22.04/24.04/bookworm),
                // but upstream ships an official .deb — install THAT via the OS package tool. It's a
                // distinct, opt-in method from `native` (it doesn't ride `apt upgrade`); here it's the
                // debian-family default because there is no repo package to prefer. (Relax the bare
                // `native` gate below to a version bound once debian-family broadly ships it in-repo.)
                { via: native-pkg-file  when: "debian"
                  version: { github: fastfetch-cli/fastfetch }
                  asset: { x86_64: fastfetch-linux-amd64.deb  aarch64: fastfetch-linux-aarch64.deb } }
                { via: native  when: "rhel"  requires: epel }   // EL ships fastfetch in EPEL
                { via: native  when: "not debian" }             // arch/fedora/suse/... carry it in-repo
            ]
        }

        // --- toolchain (portable, descriptive capabilities) ---
        // `cc` = a C compiler, `cxx` = a C++ compiler. Source-build components COMPOSE these
        // (requires: cxx, cmake, ninja, ...); `cxx requires: cc`, so C++ reuses the C toolchain.
        // One definition across every family — this replaces the old apt-named `build-essential`,
        // which was Debian-*package*-building essentials (it pulls dpkg-dev), not an app toolchain.
        // Alpine bundles the whole kit in `build-base` (pulls musl-dev headers); on Arch/Void the
        // `gcc` package bundles g++. `make`/`cmake`/`ninja` stay separate, composable build tools.
        // (Versioned/standard selection — requires: C++20, or gcc-15 by name — is a later layer;
        // for now cc/cxx are the system default compiler, which handles modern C++ on any current
        // distro.)
        c-toolchain: { description: "C toolchain (cc) — compiler and make for building C."
            provides: cc
            install: [
                { via: native  when: "alpine"  name: build-base }   // gcc + g++ + make + musl-dev
                { via: native  name: gcc }                          // else: gcc (pulls libc dev headers)
            ]
        }
        cpp-toolchain: { description: "C++ toolchain — compiler and make for building C++."
            provides: cxx
            requires: cc
            install: [
                { via: native  when: "alpine"  name: build-base }
                { via: native  when: "redhat or opensuse"  name: "gcc-c++" }
                { via: native  when: "debian"  name: "g++" }
                { via: native  name: gcc }   // default: gcc bundles g++ (arch, brew, and plugin OSes like Void)
            ]
        }

        // --- C++ standard library (a separate capability from the compiler) ---
        // g++ BUNDLES its stdlib (libstdc++), so cpp-toolchain needs nothing extra. clang does NOT
        // ship a stdlib: on Linux it defaults to GCC's libstdc++, and can opt into LLVM's libc++ with
        // `-stdlib=libc++`. So clang `requires: [ cc, cxx-stdlib ]` — the gcc C toolchain (clang uses
        // gcc's crt*.o + libgcc on Linux regardless of stdlib) plus *a* C++ standard library, but NOT
        // the g++ compiler (EXCEPT on Debian — see the libstdc++ component: its default C++ dev
        // headers are only installable via g++). `cxx-stdlib` defaults to libstdc++ (below, non-opt-in); to build with
        // libc++ instead, install `libc++` and provider-pin `cxx-stdlib: libc++` (then pass
        // -stdlib=libc++ — configsys installs the library, your build selects it). The two stdlibs are
        // NOT ABI-compatible with each other; g++ can only use libstdc++, clang can use either.
        //
        // Compiler VERSION and library VERSION are chosen INDEPENDENTLY, and this is capability-
        // based (nothing here assumes apt or update-alternatives). Every versioned compiler
        // resolves `cxx-stdlib` to the SAME provider — the system's default libstdc++ unless you
        // pin otherwise — so e.g. clang-18 and clang-20 SHARE one standard library; installing a
        // newer clang does NOT bring a newer library. A compiler's `C++NN` labels (on the
        // gcc-NN/clang-NN components below) describe its FRONT-END language mode, not a guarantee
        // of library features — those track whatever `cxx-stdlib` resolved to. Sharing is
        // order-independent: the compiler and the stdlib pull the same library, whichever is
        // installed first. To move the LIBRARY forward, change that provider, not the compiler:
        // install/prefer a newer libstdc++ (whatever your package manager names it), or
        // provider-pin `cxx-stdlib: libc++`, whose version DOES track clang. (clang also pulls the
        // gcc C toolchain — `c-toolchain`, for crt/libgcc — but not the g++ compiler; that split is
        // the whole point of requiring `cxx-stdlib` rather than `cxx`. The one exception is Debian,
        // whose default libstdc++ dev headers ship only with g++ — pin cxx-stdlib: libc++ to skip it.)
        libstdc++: { description: "GNU libstdc++ — the GCC C++ standard library runtime."                                  // GNU C++ stdlib (clang's default on Linux)
            provides: [ cxx-stdlib, libstdc++ ]
            install: [
                // On Debian `libstdc++-dev` is a VIRTUAL package — many libstdc++-N-dev providers,
                // no default candidate, so apt refuses to install it. The default C++ stdlib dev
                // headers ship WITH g++ (g++ -> g++-N -> libstdc++-N-dev, tracking the system's
                // default gcc), and there is no standalone "default libstdc++ dev" package. So here
                // (only on distros without a concrete package) satisfying `cxx-stdlib` DOES pull
                // g++. To keep clang off g++ on Debian, provider-pin `cxx-stdlib: libc++` (LLVM's
                // stdlib — no libstdc++/g++ at all).
                { via: native  when: "debian"  name: "g++" }
                { via: native  when: "alpine"  name: "g++" }        // Alpine also ships C++ headers via g++
                { via: native  when: "redhat or opensuse"  name: "libstdc++-devel" }   // concrete package
                { via: native  name: gcc }            // arch etc.: the C++ headers ship in the gcc package
            ]
        }
        libc++: { description: "LLVM libc++ — the Clang C++ standard library runtime."                                     // LLVM C++ stdlib — opt-in; build with -stdlib=libc++
            provides: [ cxx-stdlib, libc++ ]
            standing: never-auto
            suggests: libc++abi                       // soft: the split ABI dev package (bundled on Alpine)
            install: [ { via: native  name: { apt: libc++-dev  dnf: libcxx-devel  zypper: libc++-devel
                                              pacman: libc++  apk: libc++-dev } } ]
        }
        libc++abi: { description: "LLVM libc++abi — libc++'s low-level ABI support."                                  // LLVM libc++abi dev — a separate package except on Alpine
            install: [ { via: native  when: "not alpine"  name: { apt: libc++abi-dev  dnf: libcxxabi-devel
                                                                  zypper: libc++abi-devel  pacman: libc++abi } } ]
        }

        // software-properties-common is a software package in Ubuntu and Debian that provides
        // the add-apt-repository script. It allows users to easily manage independent software
        // sources and PPAs (Personal Package Archives) without manually editing the
        // /etc/apt/sources.list file.
        software-properties-common: { description: "add-apt-repository and friends — manage APT repos." install: [ { via: native when: debian } ] }

        // gdb: base-repo native everywhere (apt main / dnf base / pacman extra; EL base, no
        // EPEL), plus its shell-startup dotfile.
        gdb: { description: "GNU Debugger — the standard C/C++/… debugger."
            suggests: gdb-dotfiles
            install: [ { via: native } ]
        }
        gdb-dotfiles: { description: "GDB config (.gdbinit), linked into place."   // gdb reads ~/.gdbinit natively (no bash-dotfiles loader needed)
            install: [ { via: dotfiles  src: gdbinit  dst: ~/.gdbinit } ]
        }

        // --- AUR: packages built from PKGBUILD via makepkg -si (Arch only). The `aur`
        // driver pulls base-devel + git (the build toolchain); yay is the AUR helper
        // itself, prebuilt (-bin). Guarded to arch — the driver has no meaning elsewhere.
        base-devel: { description: "Arch base-devel group — build tools for compiling packages." install: [ { via: native when: "arch" } ] }
        yay: { description: "yay — an AUR helper for Arch (pacman-like AUR installs)."
            install: [ { via: aur  when: "arch"  name: yay-bin  version: { aur: yay-bin } } ]
        }

        // gcc-select: the `update-alternatives --config gcc` alias dotfile (Debian only) —
        // required by the versioned gcc-NN toolchains so `gcc` points at the chosen one. (The plain
        // C/C++ compiler is now `c-toolchain`/`cpp-toolchain` above, which supersede the old `gcc`
        // and `gcc-cpp` components that only existed to feed `build-essential`.)
        gcc-select: { description: "Shell alias to switch the default gcc version (update-alternatives)."
            install: [ { via: dotfiles  when: "debian"  requires: bash-dotfiles
                         src: bash.d/gcc.sh  dst: ~/.bash.d/gcc.sh } ]
        }

        // --- versioned gcc. Three drivers, selected by OS/version:
        //   debian -> `gcc` (apt PPA + update-alternatives; needs cxx, s-p-c, the alias)
        //   fedora -> `gcc` (dnf compat packages gccNN; availability is per-release)
        //   EL     -> `gcc-toolset` (SCL under /opt/rh)
        // --- versioned gcc. Each also `provides:` the language-standard capabilities its compiler
        // supports (`cc`/`cxx` = a C/C++ compiler; C11/C17/C23 and "C++17"/"C++20"/... = a compiler
        // that accepts that `-std=`), so a build can `requires: "C++20"` (or `cc`, or pin `gcc-15`)
        // and get a compiler that satisfies it. All are `standing: never-auto`: they satisfy a plain
        // `requires: cxx` ONLY when explicitly wanted / provider-pinned — otherwise the unversioned
        // `cpp-toolchain` (the system default compiler) wins and there's no ambiguity. The provides
        // are capability LABELS (the `-std` mode exists + is substantially usable), easy to hand-tune
        // per real support; the newest standards (C++26) are the most likely to want adjusting.
        // Older lines (10/11/12) are useful as pinned HOST compilers for toolchains that reject a
        // too-new gcc — notably CUDA's nvcc (points nvcc at gcc-10), and OpenCV's CUDA-11 build
        // (requires: gcc-10) and Blender 4.3 (requires: gcc-11), both in their plugins. Availability
        // of a DOWNLEVEL (older-than-default) gcc, the shared story those consumers refer back to:
        //   debian/ubuntu -> parallel apt packages (ubuntu-toolchain-r PPA); additive, no rollback.
        //   rhel/EL       -> the gcc-toolset-NN SCL under /opt/rh; isolated from the system gcc.
        //   fedora/arch   -> NOT carried: their repos ship only the latest gcc, and no clean COPR/AUR
        //                    parallel gccNN lands at /usr/bin/gcc-NN. So a downlevel pin there is an
        //                    honest unmet-require at resolve/check time — not a rollback, not a
        //                    mid-build failure — until it's built from source. (fedora DOES carry the
        //                    near-default compat gccNN used by the `when: "fedora = NN"` bindings
        //                    below; that's a native package, not a downlevel side-install.)
        gcc-10: { description: "GCC 10 — the GNU Compiler Collection, version 10."
            provides: [ cc, cxx, C11, C17, "C++17", "C++20" ]
            standing: never-auto
            install: [
                { via: gcc  when: "debian"  packages: [ gcc-10, g++-10 ]  slaves: [ g++ ]  ppa: ubuntu-toolchain-r/test
                  requires: [ cxx, software-properties-common ]  suggests: gcc-select }
                { via: gcc-toolset  when: "rhel" }
            ]
        }
        gcc-11: { description: "GCC 11 — the GNU Compiler Collection, version 11."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23" ]
            standing: never-auto
            install: [
                { via: gcc  when: "debian"  packages: [ gcc-11, g++-11 ]  slaves: [ g++ ]  ppa: ubuntu-toolchain-r/test
                  requires: [ cxx, software-properties-common ]  suggests: gcc-select }
                { via: gcc-toolset  when: "rhel" }
            ]
        }
        gcc-12: { description: "GCC 12 — the GNU Compiler Collection, version 12."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23" ]
            standing: never-auto
            install: [
                { via: gcc  when: "debian"  packages: [ gcc-12, g++-12 ]  slaves: [ g++ ]  ppa: ubuntu-toolchain-r/test
                  requires: [ cxx, software-properties-common ]  suggests: gcc-select }
                { via: gcc-toolset  when: "rhel" }
            ]
        }
        gcc-13: { description: "GCC 13 — the GNU Compiler Collection, version 13."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23" ]
            standing: never-auto
            install: [
                { via: gcc  when: "debian"  packages: [ gcc-13, g++-13 ]  slaves: [ g++ ]  ppa: ubuntu-toolchain-r/test
                  requires: [ cxx, software-properties-common ]  suggests: gcc-select }
                { via: gcc  when: "fedora = 41"  packages: [ gcc13, gcc13-c++ ] }
                { via: gcc-toolset  when: "rhel" }
            ]
        }
        gcc-14: { description: "GCC 14 — the GNU Compiler Collection, version 14."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23" ]
            standing: never-auto
            install: [
                { via: gcc  when: "debian"  packages: [ gcc-14, g++-14 ]  slaves: [ g++ ]  ppa: ubuntu-toolchain-r/test
                  requires: [ cxx, software-properties-common ]  suggests: gcc-select }
                { via: gcc  when: "fedora = 42"  packages: [ gcc14, gcc14-c++ ] }
                { via: gcc-toolset  when: "rhel" }
            ]
        }
        gcc-15: { description: "GCC 15 — the GNU Compiler Collection, version 15."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23", "C++26" ]
            standing: never-auto
            install: [
                { via: gcc  when: "debian"  packages: [ gcc-15, g++-15 ]  slaves: [ g++ ]  ppa: ubuntu-toolchain-r/test
                  requires: [ cxx, software-properties-common ]  suggests: gcc-select }
                { via: gcc-toolset  when: "rhel" }
            ]
        }

        // --- versioned clang. `clang` driver = native PM + update-alternatives:
        //   debian -> apt.llvm.org + alternatives (curl for the key; + the alias)
        //   fedora -> dnf compat clangNN (per-release; the system clang covers the newest)
        //   EL     -> dnf compat clangNN from EPEL (requires epel)
        clang-select: { description: "Shell alias to switch the default clang version (update-alternatives)."             // the `update-alternatives --config clang` alias dotfile
            requires: bash-dotfiles
            install: [ { via: dotfiles  when: "debian"  src: bash.d/clang.sh  dst: ~/.bash.d/clang.sh } ]
        }
        // clang ships no C++ stdlib and, on Linux, no C runtime of its own: it uses GCC's crt*.o +
        // libgcc (hence `requires: c-toolchain` — the gcc toolchain COMPONENT, not the g++ compiler)
        // and defaults to GCC's libstdc++ (hence `requires: cxx-stdlib`, which resolves to the
        // libstdc++ component; provider-pin it to libc++ to build with -stdlib=libc++). It requires
        // the c-toolchain *component* rather than the `cc` capability on purpose: clang itself
        // `provides: cc` (opt-in), so requiring the capability would let it self-satisfy and never
        // pull gcc. It provides a C/C++ compiler + the standard labels (opt-in, same rule as gcc-NN).
        clang-18: { description: "Clang/LLVM 18 — C/C++/Obj-C compiler, version 18."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23" ]
            standing: never-auto
            requires: [ c-toolchain, cxx-stdlib ]
            install: [
                { via: clang  when: "debian"  packages: [ clang-18 ]
                  requires: curl  suggests: clang-select }
                { via: clang  when: "fedora"  packages: [ clang18 ] }
            ]
        }
        clang-19: { description: "Clang/LLVM 19 — C/C++/Obj-C compiler, version 19."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23" ]
            standing: never-auto
            requires: [ c-toolchain, cxx-stdlib ]
            install: [
                { via: clang  when: "debian"  packages: [ clang-19 ]
                  requires: curl  suggests: clang-select }
                { via: clang  when: "fedora = 41"  packages: [ clang ] }      // system clang -> /usr/bin/clang-19
                { via: clang  when: "fedora = 42"  packages: [ clang19 ] }
                { via: clang  when: "rhel"  packages: [ clang19 ]  requires: epel }
            ]
        }
        clang-20: { description: "Clang/LLVM 20 — C/C++/Obj-C compiler, version 20."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23", "C++26" ]
            standing: never-auto
            requires: [ c-toolchain, cxx-stdlib ]
            install: [
                { via: clang  when: "debian"  packages: [ clang-20 ]
                  requires: curl  suggests: clang-select }
                { via: clang  when: "fedora = 42"  packages: [ clang ] }      // system clang -> /usr/bin/clang-20
                { via: clang  when: "rhel"  packages: [ clang20 ]  requires: epel }
            ]
        }

        // ===================== C/C++ libraries + GUI toolkits =====================
        // Dev packages (headers + libs). Native names are gated to the distros whose package name
        // is known-good; openSUSE / brew / others are extendable later (their split/renamed packages
        // need a per-manager name). folly + EASTL aren't packaged in the mainstream repos — they get
        // what IS available (Fedora / the AUR) and decline elsewhere (build from source there).
        boost: { description: "Boost — peer-reviewed, portable C++ source libraries (dev)."
            install: [ { via: native  when: "debian or redhat or arch or alpine"  repo-component: universe
                         name: { apt: libboost-all-dev  dnf: boost-devel  pacman: boost  apk: boost-dev } } ]
        }
        abseil: { description: "Abseil — Google's C++ common libraries (dev)."
            install: [ { via: native  when: "debian or redhat or arch or alpine"  repo-component: universe
                         name: { apt: libabsl-dev  dnf: abseil-cpp-devel  pacman: abseil-cpp  apk: abseil-cpp-dev } } ]
        }
        folly: { description: "Folly — Facebook's C++ utility library (dev)."
            install: [ { via: native  when: "fedora"  name: folly-devel }        // Fedora repos (not EL)
                       { via: aur     when: "arch"    name: folly } ]             // Arch: AUR
        }
        eastl: { description: "EASTL — Electronic Arts' STL implementation (dev)."
            install: [ { via: aur  when: "arch"  name: eastl } ]                  // AUR only; vendor/source elsewhere
        }
        qt: { description: "Qt 6 — cross-platform C++ application framework (Qt Base, dev)."
            install: [ { via: native  when: "debian or redhat or arch or alpine"  repo-component: universe
                         name: { apt: qt6-base-dev  dnf: qt6-qtbase-devel  pacman: qt6-base  apk: qt6-qtbase-dev } } ]
        }
        gtk: { description: "GTK 4 — the GTK GUI toolkit (dev)."
            install: [ { via: native  when: "debian or redhat or arch or alpine"  repo-component: universe
                         name: { apt: libgtk-4-dev  dnf: gtk4-devel  pacman: gtk4  apk: gtk4.0-dev } } ]
        }
        gtkmm: { description: "gtkmm — the C++ bindings for GTK 4 (dev)."
            requires: gtk
            install: [ { via: native  when: "debian or redhat or arch"  repo-component: universe
                         name: { apt: libgtkmm-4.0-dev  dnf: gtkmm4.0-devel  pacman: gtkmm-4.0 } } ]
        }

        // --- graphics dev SDKs (dev headers + libs) ---
        // OpenGL is a per-distro parts bundle (GL + GLU) — no single `opengl` package. No brew (macOS
        // ships GL as a deprecated system framework).
        opengl: { description: "OpenGL development environment — GL + GLU headers and libraries."
            install: [ { via: native  when: "debian"    packages: [ libgl-dev, libglu1-mesa-dev ] }
                       { via: native  when: "redhat"    packages: [ mesa-libGL-devel, mesa-libGLU-devel ] }
                       { via: native  when: "arch"      packages: [ mesa, glu ] }
                       { via: native  when: "alpine"    packages: [ mesa-dev, glu-dev ] }
                       { via: native  when: "opensuse"  packages: [ Mesa-libGL-devel, glu-devel ] } ]
        }
        glfw: { description: "GLFW — multi-platform OpenGL/Vulkan window & input library (dev)."
            install: [ { via: native  when: "debian or redhat or arch or alpine or opensuse or fedora_atomic"  repo-component: universe
                         name: { apt: libglfw3-dev  dnf: glfw-devel  pacman: glfw  apk: glfw-dev  zypper: libglfw-devel  brew: glfw } } ]
        }
        // SDL2 (the common target). Arch dropped classic `sdl2` → `sdl2-compat` (SDL2 API on SDL3).
        sdl: { description: "SDL2 — Simple DirectMedia Layer (video/audio/input), dev headers + libs."
            install: [ { via: native  when: "debian or redhat or arch or alpine or opensuse or fedora_atomic"  repo-component: universe
                         name: { apt: libsdl2-dev  dnf: SDL2-devel  pacman: sdl2-compat  apk: sdl2-dev  zypper: libSDL2-devel  brew: sdl2 } } ]
        }
        // SFML — note the major-version skew: 2.x on debian/fedora/alpine, 3.x on arch/brew (a
        // breaking API change). openSUSE package unconfirmed → omitted there.
        sfml: { description: "SFML — Simple and Fast Multimedia Library (C++), dev headers + libs."
            install: [ { via: native  when: "debian or redhat or arch or alpine or fedora_atomic"  repo-component: universe
                         name: { apt: libsfml-dev  dnf: SFML-devel  pacman: sfml  apk: sfml-dev  brew: sfml } } ]
        }

    }
}
