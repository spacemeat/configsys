        mercurial-dotfiles: { description: "mercurial config, linked into place." install: [ { via: dotfiles  config: { src: hgrc  dst: ~/.hgrc } } ] }
        // micro keeps runtime state in its config dir (backups/, buffers/ = undo/cursor history), so
        // link the user-authored configuration only, file by file — never the whole dir.
        micro-dotfiles: { description: "micro settings (settings.json, bindings.json, init.lua, colorschemes/), linked into place."
            install: [ { via: dotfiles  settings: { src: micro-settings.json  dst: $XDG_CONFIG_HOME/micro/settings.json }
                                       bindings: { src: micro-bindings.json  dst: $XDG_CONFIG_HOME/micro/bindings.json }
                                       init:     { src: micro-init.lua       dst: $XDG_CONFIG_HOME/micro/init.lua }
                                       colorschemes: { src: micro-colorschemes  dst: $XDG_CONFIG_HOME/micro/colorschemes } } ] }
        micro-glue: { description: "micro shell setup, linked into place." install: [ { via: glue  requires: shell-glue  glue: micro } ] }
