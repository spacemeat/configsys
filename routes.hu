// routes.hu — the capability/component routing data (see docs/routing-model.md and the
// routing section of CLAUDE.md). Loaded by configsys/routes.py; resolution in resolve.py.
{
    // OS layer: lineage (`using`) + which package manager is `native` + version scales.
    // `provides:` lists capabilities baseline in that environment (satisfied for free).
    os: {
        // `provides: python3` — the configsys bootstrap guarantees a system python3 (>=3.10) on every
        // supported OS, so a bare `requires: python3` is satisfied for free (nothing installed). A
        // VERSIONED need (`requires: { python3: ">=3.11" }`) isn't met by this unversioned baseline and
        // pulls a python3.X interpreter component instead.
        linux:   { provides: python3 }

        // The C library is an axis orthogonal to distro family: mainstream distros are glibc,
        // Alpine (and musl-Void) are musl. Prebuilt glibc binaries (most AppImages, many
        // tarballs) can't run under musl's loader. `glibc_linux` carries a `glibc` capability
        // that the glibc families inherit; drivers/bindings that fetch glibc artifacts
        // `requires: glibc`, so they cleanly decline on Alpine instead of installing a corpse.
        glibc_linux: { using: linux  provides: glibc }

        // Debian family (apt). A scale-root owns a version numbering. Pop shares Ubuntu's exact
        // numbers (Pop 22.04 IS Ubuntu 22.04), so it borrows Ubuntu's scale — no scale-root.
        // Mint and LMDE use their OWN numbers (Mint 21 = Ubuntu 22.04, different digits), so
        // each is its own scale-root — a versioned `ubuntu`/`debian` atom must NOT misfire on
        // them. Bare `ubuntu`/`debian` still match all of them (route inheritance by identity).
        debian:    { using: glibc_linux  native: apt   scale-root: true }
        ubuntu:    { using: debian    scale-root: true }
        pop_os!:   { using: ubuntu }
        elementary:{ using: ubuntu    scale-root: true }            // elementary OS (own numbering: 6/7/8); ships the Pantheon desktop
        linuxmint: { using: ubuntu    scale-root: true }            // Mint main (own numbering)
        lmde:      { using: debian    scale-root: true }            // Mint Debian Edition (own numbering)
        kali:      { using: debian }                                // kali-rolling (Debian testing) — rolling, bare membership like tumbleweed
        pikaos:    { using: debian    scale-root: true }            // Debian-based gaming distro; own date numbering (26.MM.DD) so it's its own scale-root
        mx:        { using: debian    scale-root: true }            // MX Linux (ID=mx, ID_LIKE=debian); own numbering (MX-19/21/23/25 tracking Debian)
        avlinux:   { using: mx }                                    // AV Linux MX Edition — MX-based multimedia distro; tracks MX (if it keeps ID=mx the `mx` block already covers it)

        // RHEL family (dnf). The EL rebuilds share rhel's routes + version line; distinct
        // blocks (vs. one aliased `rhel`) buy them identity — `when: "rocky"`, correct display.
        redhat:    { using: glibc_linux  native: dnf }              // fedora + EL share dnf
        fedora:    { using: redhat    scale-root: true }            // fedora proper (YY release)
        nobara:    { using: fedora }                                // Fedora-based (Nobara N = Fedora N) — borrows fedora's scale, no own scale-root
        rhel:      { using: redhat    scale-root: true }            // EL scale-root (N release)
        rocky:     { using: rhel }
        almalinux: { using: rhel }
        centos:    { using: rhel }                                  // CentOS Stream
        ol:        { using: rhel }                                  // Oracle Linux (os-release ID=ol) — EL rebuild, full dnf + its own EPEL pkg name
        amzn:      { using: redhat   scale-root: true }              // Amazon Linux 2023 (ID=amzn): Fedora-derived, own repos+version, NO EPEL

        // Fedora Atomic / uBlue (Silverblue, Kinoite, Sericea, Bazzite, Bluefin, Aurora …) —
        // immutable ostree desktops. Modeled as a distinct ENVIRONMENT, deliberately NOT under
        // `fedora`: brew is the CLI `native:` (uBlue ships it pre-configured), flatpak covers
        // apps (their existing bindings just work), and rpm-ostree is an explicit last-resort
        // layering driver (via: rpm-ostree). Hanging off glibc_linux — not redhat — keeps the
        // dnf-only bindings (EPEL / RPM Fusion / repo-component) from misfiring here; brew needs
        // none of them. `provides: flatpak` because flatpak is pre-installed, so an app's flatpak
        // dep is env-satisfied instead of trying to `brew install flatpak`. scale-root: it owns
        // its VERSION_ID (tracks Fedora) without inheriting fedora's dnf version line. osdetect
        // folds every variant (ID=fedora + atomic VARIANT_ID or the ostree marker) into this block.
        fedora_atomic: { using: glibc_linux  native: brew  provides: flatpak  scale-root: true }

        // Arch family (pacman). Rolling — no version scale; membership is by identity only.
        arch:        { using: glibc_linux  native: pacman }
        manjaro:     { using: arch }
        endeavouros: { using: arch }
        cachyos:     { using: arch }              // performance-tuned Arch (x86-64-v3/v4 repos); rolling
        garuda:      { using: arch }              // gaming-focused Arch; rolling
        omarchy:     { using: arch }              // DHH's opinionated Arch+Hyprland; rolling (inert if it keeps ID=arch, active if it rebrands ID=omarchy)

        // Alpine (apk). musl, NOT glibc — so it hangs off `linux`, not `glibc_linux`. glibc-only
        // fetch-a-binary bindings decline here (unroutable = a clean diagnostic); the optional
        // `gcompat` shim can re-enable them per-machine (see the gcompat component).
        alpine: { using: linux  native: apk }

        // openSUSE / SUSE (zypper). glibc. One synthetic parent declares the driver; Leap is a
        // scale-root (versioned, 15.x) while Tumbleweed is rolling (bare membership, like arch)
        // — a clean demo of identity-vs-scale being orthogonal. Block names use `_` (the `when:`
        // DSL has no `-`); os-release's `opensuse-leap`/`-tumbleweed` alias in.
        opensuse:             { using: glibc_linux  native: zypper }
        opensuse_leap:        { using: opensuse  scale-root: true }
        opensuse_tumbleweed:  { using: opensuse }
    }

    // Driver config: dependencies inherent to a driver (its prerequisite tooling).
    drivers: {
        snap:        { standing: never-auto  requires: [ snapd-socket, snapd-snap-link ] }   // candidate-only = valid + listed + pinnable, never the auto-default (native/flatpak win); a pin forces it. `requires` pulls in snapd + its socket + the /snap symlink, so a snap works on any distro where snapd is installable (a no-op on Ubuntu, which ships snapd). Snaps are now offered everywhere, not just Ubuntu. A user's primary plugin can add `flatpak: { standing: never-auto }` the same way.
        flatpak:     { requires: flatpak }
        appImage:    { requires: [ libfuse2, glibc ] }   // AppImages are glibc-built: decline on musl
        cargo:       { requires: cargo }              // a crate needs the cargo tool
        npm:         { requires: npm }                // a global CLI needs the npm tool (-> node)
        go-install:  { requires: go }                 // `go install` needs the go toolchain
        gem:         { requires: ruby }                // a gem needs ruby (gem ships with it)
        opam:        { requires: opam }                // an OCaml package needs the opam tool
        luarocks:    { requires: luarocks }            // a rock needs the luarocks tool (-> lua)
        cabal:       { requires: cabal }               // a hackage exe needs cabal (-> ghc)
        sdkman:      { requires: sdkman }              // a JVM SDK (scala/groovy/sbt/…) needs the sdkman tool
        font: { requires: [ fontconfig, unzip ] }
        // pip / pipx on musl (Alpine): pip prefers a `musllinux` wheel and pure-Python wheels
        // install fine, but a C-extension package that ships ONLY `manylinux` (glibc) wheels
        // falls back to building from its sdist — which needs a toolchain (gcc, musl-dev,
        // python3-dev) + the package's own C headers. configsys does NOT model those build deps
        // (they're per-package and usually unneeded), so such a build surfaces pip's own
        // compiler error; add the toolchain to a profile if you hit it. No base pip/pipx
        // component is affected — this only concerns C-extension tools a user adds on Alpine.
        pip:         { requires: python3-pip }        // `pip install --user` needs pip
        pipx:        { requires: pipx }               // a PyPI CLI needs the pipx tool
        pyenv:       { requires: [ pyenv, python-build-deps ] }   // compile CPython: the tool + C build libs
        tarball:     { requires: curl }               // fetch the archive with curl
        source:      { requires: git }                // clone + build from a git checkout
        aur:         { requires: [ base-devel, git ] } // makepkg -si builds from PKGBUILD
    }

    // Detected environment facts that `when:` can gate on (see docs/facets.md). General-purpose and
    // shared: a plugin that wants to gate a per-vendor variant on `when: "gpu:nvidia"` / `gpu:amd`
    // (e.g. the opencv plugin's CUDA-vs-HIP stacks) reuses this probe rather than redefining it.
    // Value precedence: a
    // `CONFIGSYS_FACET_gpu` env var, a `facets:` value in the user config, else this probe. Only
    // nvidia/amd are auto-detected (Intel iGPUs vs the compute-capable path are too ambiguous to
    // auto-pick — leave oneAPI opt-in). Override with `facets: { gpu: nvidia }` if the probe is wrong.
    facets: {
        gpu: { kind: categorical
               detect: 'lspci 2>/dev/null || { command -v nvidia-smi >/dev/null 2>&1 && echo NVIDIA; command -v rocminfo >/dev/null 2>&1 && echo "AMD/ATI"; }'
               match: { nvidia: "NVIDIA"  amd: "AMD/ATI" } }   // lspci (pciutils) preferred; falls back to the driver tools if absent (containers/minimal)
    }

    // Component layer: each is a capability + a list of context-selected bindings.
    components: {
        // --- core utilities (base tools; several are driver prerequisites) ---
        flatpak:    { attrs: [ CLI daemon FOSS copyleft ] description: "Flatpak — sandboxed app distribution and runtime." install: [ { via: native } ] }
        fontconfig: { attrs: [ lib FOSS permissive ] description: "fontconfig — font discovery and configuration library." install: [ { via: native } ] }
        unzip:      { attrs: [ CLI FOSS permissive ] description: "Extract ZIP archives." install: [ { via: native } ] }
        zip:        { attrs: [ CLI FOSS permissive ] description: "Create and update ZIP archives." install: [ { via: native } ] }
        curl:       { attrs: [ CLI FOSS permissive ] description: "Transfer data over HTTP(S) and more — the ubiquitous `curl`." install: [ { via: native } ] }
        git:        { attrs: [ CLI FOSS copyleft ] suggests: git-dotfiles  description: "Distributed version control — the `git` you already know." install: [ { via: native } ] }
        git-lfs:    { attrs: [ CLI FOSS permissive ] requires: git  description: "Git Large File Storage (`git lfs`) — version large files via lightweight pointers." install: [ { via: native } ] }   // `git-lfs` on every family
        // Other version-control systems (git is above). Package name == component name except:
        // subversion's CLI is `svn`; bazaar is now Breezy (`brz`); perforce ships `helix-cli` (`p4`).
        mercurial: { attrs: [ CLI FOSS copyleft ] suggests: mercurial-dotfiles  description: "Mercurial — a fast distributed version control system (`hg`)."
            install: [ { via: native  when: "not rhel"  repo-component: universe }   // uniform pkg `mercurial`
                       { via: native  when: "rhel"  requires: epel }
                       { via: pipx  name: mercurial  standing: never-auto } ] }       // Python; pinnable alt
        subversion: { attrs: [ CLI FOSS permissive ] description: "Apache Subversion — centralized version control (the `svn` CLI)."
            install: [ { via: native  repo-component: universe } ] }                  // uniform pkg `subversion`
        cvs: { attrs: [ CLI FOSS GNU copyleft ] suggests: cvs-dotfiles  description: "CVS — the classic Concurrent Versions System."
            install: [ { via: native  when: "debian or fedora or arch or fedora_atomic"  repo-component: universe }
                       { via: native  when: "rhel"  requires: epel } ] }              // gone from stable-Alpine + openSUSE
        fossil: { attrs: [ CLI web FOSS permissive ] suggests: fossil-dotfiles  description: "Fossil — a self-contained distributed SCM (wiki, tickets, web UI in one binary)."
            install: [ { via: native  when: "(not opensuse and not rhel) and not amzn"  repo-component: universe }
                       { via: native  when: "rhel"  requires: epel }
                       { via: tarball  when: "opensuse"  installDir: "$CONFIGSYS_APP_DIR/fossil"  requires: glibc  // no openSUSE package; upstream static binary
                         version: { static: "2.28" }  url: "https://fossil-scm.org/home/uv/fossil-linux-x64-2.28.tar.gz"
                         latest-check: { url: "https://fossil-scm.org/home/uv/download.html"  regex: "x64-([0-9]+[.][0-9]+)[.]tar" } } ] }   // `refresh` flags a newer fossil release
        perforce: { attrs: [ CLI daemon app proprietary freemium ] description: "Perforce Helix Core — the `p4` client and `p4d` server." standing: never-auto
            install: [   // Perforce's own package repo (no distro-native packages); codenames bump as they add releases
                { via: native  when: "ubuntu"  name: helix-cli
                  pubkey-url: "https://package.perforce.com/perforce.pubkey"  pubkey-path: /usr/share/keyrings/perforce.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/perforce.gpg] https://package.perforce.com/apt/ubuntu noble release"
                  source-path: /etc/apt/sources.list.d/perforce.list }
                { via: native  when: "redhat"  name: helix-cli
                  pubkey-url: "https://package.perforce.com/perforce.pubkey"
                  repo-id: perforce  repo-name: "Perforce"  repo-url: "https://package.perforce.com/yum/rhel/9/x86_64" }
                { via: aur  when: "arch"  name: p4 } ] }
        bazaar: { attrs: [ CLI FOSS copyleft ] description: "Breezy — the maintained fork of GNU Bazaar (the `brz` CLI); reads Bazaar & Git."
            install: [ { via: native  when: "debian"  name: brz  repo-component: universe }   // `bzr` is a transitional dummy -> brz
                       { via: native  when: "fedora or arch or alpine or fedora_atomic"  name: breezy }
                       { via: pipx  when: "rhel or opensuse"  name: breezy } ] }   // no breezy in EL/EPEL or openSUSE
        // FUSE2 runtime — the appImage driver requires it; native, name differs by manager.
        libfuse2: { attrs: [ lib FOSS copyleft ] description: "libfuse2 — the FUSE runtime many AppImages need."
            install: [ { via: native  repo-component: universe  name: { dnf: fuse-libs  pacman: fuse2  apk: fuse  default: libfuse2 } } ]
        }
        doas:       { attrs: [ CLI FOSS permissive ] description: "doas — a minimal, simpler sudo alternative." install: [ { via: apk  when: "alpine" } ] }                 // Alpine's sudo (apk-only; folded from the alpine plugin)

        // gcompat: Alpine's glibc-compat shim. It `provides: glibc`, so it can re-enable the
        // glibc-only bindings (AppImages, glibc tarballs) that otherwise decline on musl. It is
        // marked `opt-in` — NEVER auto-pulled to satisfy a `requires: glibc`, because the shim
        // is BEST-EFFORT: it maps many glibc binaries onto musl but not all (symbol-version
        // gaps, NSS, TLS quirks). Silently installing it, then maybe still failing to run the
        // binary, is exactly the surprise configsys avoids. So a musl box declines glibc
        // binaries by default; to gamble on the shim, opt in per-machine — either add `gcompat`
        // to a profile, or provider-pin it:  pins: { glibc: gcompat }.
        gcompat: { attrs: [ lib FOSS permissive ] description: "gcompat — a glibc compatibility layer for musl (Alpine)."
            provides: glibc
            standing: never-auto
            install: [ { via: apk  when: "alpine" } ]
        }
        python3-pip: { attrs: [ CLI FOSS permissive ] suggests: python3-pip-dotfiles  description: "pip — the Python package installer." install: [ { via: native  name: { pacman: python-pip  zypper: python313-pip  apk: py3-pip } } ] }

        // Python interpreters as VERSION-SCOPED providers of the `python3` capability. Install specific
        // versions side-by-side — each is a distinct `/usr/bin/python3.X` (or a pyenv build), so they
        // coexist as normal residents — and let a tool floor its interpreter with
        // `requires: { python3: ">=3.11" }` (the constraint selects/enables the matching version;
        // 3.13 is the default when several qualify). Two methods each: `native` for a fast binary
        // (Ubuntu's non-default versions come from the deadsnakes PPA; Fedora ships them directly), and
        // `pyenv` to COMPILE any version user-scope (newest/RCs, per-project via `.python-version`) —
        // pick the method with a binding-pin. NEVER repoints the system `python3` default (apt and
        // distro tools depend on it): select a version by calling `python3.X` or a venv built from it.
        // 3.11 / 3.12 / 3.14 are `never-auto` (constraint- or explicitly-selected); 3.13 is the modern
        // default (3.14 is stable but opt-in until the package ecosystem fully catches up to it).
        python3.11: { attrs: [ CLI runtime toolchain FOSS permissive ] description: "Python 3.11 interpreter (+ venv, dev headers)."
            standing: never-auto  provides: { python3: "3.11" }
            install: [
                { via: native  when: "debian"  packages: [ python3.11, python3.11-venv, python3.11-dev ]
                  ppa: deadsnakes/ppa  requires: software-properties-common }
                { via: native  when: "fedora or redhat"  packages: [ python3.11 ] }
                { via: pyenv  version: "3.11" }
            ]
        }
        python3.12: { attrs: [ CLI runtime toolchain FOSS permissive ] description: "Python 3.12 interpreter (+ venv, dev headers)."
            standing: never-auto  provides: { python3: "3.12" }
            install: [
                { via: native  when: "debian"  packages: [ python3.12, python3.12-venv, python3.12-dev ]
                  ppa: deadsnakes/ppa  requires: software-properties-common }
                { via: native  when: "fedora or redhat"  packages: [ python3.12 ] }
                { via: pyenv  version: "3.12" }
            ]
        }
        python3.13: { attrs: [ CLI runtime toolchain FOSS permissive ] description: "Python 3.13 interpreter (+ venv, dev headers) — the modern default."
            provides: { python3: "3.13" }
            install: [
                { via: native  when: "debian"  packages: [ python3.13, python3.13-venv, python3.13-dev ]
                  ppa: deadsnakes/ppa  requires: software-properties-common }
                { via: native  when: "fedora or redhat"  packages: [ python3.13 ] }
                { via: pyenv  version: "3.13" }
            ]
        }
        python3.14: { attrs: [ CLI runtime toolchain FOSS permissive ] description: "Python 3.14 interpreter (+ venv, dev headers) — the newest stable line."
            standing: never-auto  provides: { python3: "3.14" }
            install: [
                { via: native  when: "debian"  packages: [ python3.14, python3.14-venv, python3.14-dev ]
                  ppa: deadsnakes/ppa  requires: software-properties-common }
                { via: native  when: "fedora or redhat"  packages: [ python3.14 ] }
                { via: pyenv  version: "3.14" }
            ]
        }
        cython: { attrs: [ CLI toolchain FOSS permissive ] description: "Cython — compile Python-like code to C extension modules."
            requires: [ python3, cpp-toolchain ]
            install: [ { via: native  name: { apt: cython3  dnf: python3-Cython  pacman: cython  zypper: python313-Cython  apk: cython } } ] }

        // pyenv itself + the C libraries it needs to COMPILE CPython — the `via: pyenv` method's deps
        // (see drivers.pyenv). pyenv installs user-scope under ~/.pyenv via its official installer.
        pyenv: { attrs: [ CLI FOSS permissive ] suggests: pyenv-dotfiles  description: "pyenv — build & switch Python versions from source, user-scope."
            requires: curl
            install: [ { via: script
                install-cmd:   'curl -fsSL https://pyenv.run | bash'
                version-cmd:   '"$HOME/.pyenv/bin/pyenv" --version 2>/dev/null'
                version-re:    '([0-9][0-9.]*)'
                uninstall-cmd: 'rm -rf "$HOME/.pyenv"' } ] }
        // uv — Astral's very fast Python package/project manager (a single Rust binary). Native
        // where packaged (arch; brew on atomic); pipx is the universal default elsewhere; the github
        // tarball and cargo are pinnable alternates. NOT in the debian/ubuntu repos.
        uv: { attrs: [ CLI FOSS permissive ] suggests: uv-dotfiles  description: "uv — Astral's very fast Python package & project manager (Rust)."
            install: [
                { via: native   when: "arch" }                     // pacman: uv
                { via: native   when: "fedora_atomic" }            // brew formula `uv`
                { via: pipx     name: uv }                         // universal (prebuilt wheels)
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/uv"  requires: glibc  standing: never-auto
                  version: { github: astral-sh/uv  strip-v: true  asset: "uv-x86_64-unknown-linux-gnu.tar.gz" } } ]
        }
        python-build-deps: { attrs: [ lib FOSS ] description: "System libraries pyenv needs to compile CPython (ssl/zlib/ffi/…)."
            standing: never-auto
            install: [
                { via: native  when: "debian"  packages: [ build-essential, libssl-dev, zlib1g-dev, libbz2-dev,
                    libreadline-dev, libsqlite3-dev, libncursesw5-dev, xz-utils, tk-dev, libffi-dev, liblzma-dev ] }
                { via: native  when: "(fedora or redhat) and not amzn"  packages: [ gcc, make, zlib-devel, bzip2-devel,
                    readline-devel, sqlite-devel, openssl-devel, tk-devel, libffi-devel, xz-devel ] }
                { via: native  when: "arch"  packages: [ base-devel, openssl, zlib, xz, tk ] }   // pyenv's documented Arch build env (Arch bundles headers, no -dev split). Keep `base-devel` — it's a META-package now (not a group, since 2023-02), so `pacman -Q` detects it exactly AND it tracks new build-tool members on upgrade; expanding it to concrete members would silently miss future additions.
            ] }
        // EL keeps these in EPEL, base repos everywhere else — same two-binding shape as btop.
        // `repo-component: universe` is the apt archive area (read only by apt; ignored on dnf/pacman).
        ripgrep: { suggests: ripgrep-dotfiles  attrs: [ CLI  FOSS  permissive ]  description: "Fast recursive regex search (`rg`) — grep, but much quicker."
                   install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"   repo-component: universe }
                              { via: tarball  installDir: "$CONFIGSYS_APP_DIR/ripgrep"  version: { github: BurntSushi/ripgrep  asset: "ripgrep-*-x86_64-unknown-linux-musl.tar.gz" } } ] }   // prebuilt musl binary (rg in a versioned subdir)
        fzf:     { attrs: [ CLI FOSS permissive ] suggests: fzf-dotfiles  description: "Fuzzy finder — interactive filtering for files, history, anything piped in."
                   install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"   repo-component: universe }
                              { via: tarball  installDir: "$CONFIGSYS_APP_DIR/fzf"  version: { github: junegunn/fzf  strip-v: true  asset: "fzf-*-linux_amd64.tar.gz" } } ] }
        xclip:   { attrs: [ CLI FOSS copyleft ] description: "xclip — command-line access to the X clipboard." suggests: xclip-dotfiles
                   install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"   repo-component: universe } ] }
        xclip-dotfiles: { description: "xclip helper config, linked into place." install: [ { via: dotfiles  requires: bash-dotfiles  glue: xclip } ] }
        xsel:    { attrs: [ CLI FOSS permissive ] description: "xsel — command-line access to the X11 clipboard/PRIMARY selection."
                   install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"  repo-component: universe } ] }   // EL via EPEL
        // wl-clipboard: Wayland clipboard; the binaries are `wl-copy`/`wl-paste` (no `wl-clipboard`).
        wl-clipboard: { attrs: [ CLI FOSS copyleft ] description: "wl-clipboard — copy/paste for Wayland (`wl-copy`/`wl-paste`)."
                   install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"  repo-component: universe } ] }   // EL via EPEL
        // Xephyr — a nested X server (5 different package names; binary is always `Xephyr`;
        // openSUSE bundles it in xorg-x11-server-extra).
        xephyr: { attrs: [ GUI FOSS permissive ] description: "Xephyr — a nested X server (run an X session inside a window; `Xephyr`)."
                  install: [ { via: native  repo-component: universe  when: "not (fedora_atomic or amzn)"
                              name: { apt: xserver-xephyr  dnf: xorg-x11-server-Xephyr  pacman: xorg-server-xephyr  apk: xorg-server-xephyr  zypper: xorg-x11-server-extra } } ] }

        // --- more CLI utilities (modern + classic) ---
        zoxide: { attrs: [ CLI FOSS permissive ] suggests: zoxide-dotfiles  description: "zoxide — a smarter `cd` that jumps by frecency to your most-used dirs (`z`)."
                  install: [ { via: native  repo-component: universe  when: "not (rhel or amzn)" }
                             { via: native  when: "rhel"  requires: epel }
                             { via: cargo   when: "amzn"  name: zoxide } ] }   // ubiquitous native (incl. brew); EL via EPEL; Amazon (no EPEL) via cargo
        zoxide-dotfiles: { description: "zoxide shell init (adds the `z`/`zi` commands), linked into place." install: [ { via: dotfiles  requires: bash-dotfiles  glue: zoxide } ] }
        fd: { attrs: [ CLI FOSS permissive ] suggests: fd-dotfiles  description: "fd — a fast, friendly `find` alternative (`fd`; Debian/Ubuntu install it as `fdfind`)."
              install: [ { via: native  repo-component: universe  when: "not (rhel or amzn)"  name: { apt: fd-find  dnf: fd-find  default: fd } }
                         { via: native  when: "rhel"  requires: epel  name: fd-find }
                         { via: cargo   when: "amzn"  name: fd-find } ] }   // cargo crate is `fd-find`; the Debian/Ubuntu pkg installs `fdfind` -> the glue aliases it to `fd`
        fd-dotfiles: { description: "fd alias (fdfind->fd on Debian/Ubuntu), linked into place." install: [ { via: dotfiles  requires: bash-dotfiles  glue: fd } ] }
        pastel: { attrs: [ CLI FOSS permissive ] description: "pastel — generate, analyze, convert and manipulate colors from the command line."
                  install: [ { via: native  when: "arch or alpine or opensuse or fedora_atomic" }
                             { via: cargo   when: "not (arch or alpine or opensuse or fedora_atomic)"  name: pastel } ] }   // only arch/alpine/openSUSE(+brew) carry it in-repo (Debian/Fedora are sid/rawhide-only); cargo elsewhere
        dysk: { attrs: [ CLI FOSS permissive ] description: "dysk — a `df` alternative: mounted filesystems + usage in a clear table (formerly `lfs`)."
                install: [ { via: native  when: "arch or alpine or opensuse or fedora_atomic" }
                           { via: cargo   when: "not (arch or alpine or opensuse or fedora_atomic)"  name: dysk } ] }   // Debian only has it in sid, Fedora/EL not at all -> cargo there
        stow: { attrs: [ CLI FOSS GNU copyleft ] description: "GNU Stow — a symlink farm manager for keeping dotfiles/packages tidy (`stow`)."
                install: [ { via: native  repo-component: universe  when: "not (rhel or amzn)" }
                           { via: native  when: "rhel"  requires: epel } ] }   // EL: EPEL-only; Alpine: community repo
        rsync: { attrs: [ CLI FOSS copyleft ] description: "rsync — fast incremental file transfer and synchronization." install: [ { via: native } ] }   // core package on every family
        tree:  { attrs: [ CLI FOSS GNU copyleft ] description: "tree — list a directory as an indented tree." install: [ { via: native } ] }   // `tree` on every family
        figlet: { attrs: [ CLI FOSS permissive ] description: "FIGlet — render text as large ASCII-art banners (`figlet`)."
                  install: [ { via: native  when: "not (rhel or amzn)" }
                             { via: native  when: "rhel"  requires: epel } ] }   // EL via EPEL
        lynx:  { attrs: [ CLI app FOSS copyleft ] description: "Lynx — the classic text-mode web browser."
                 install: [ { via: native  repo-component: universe  when: "not (rhel or amzn)" }
                            { via: native  when: "rhel"  requires: epel } ] }   // EL: EPEL
        pass:  { attrs: [ CLI FOSS copyleft ] description: "pass — the standard unix password manager (a GPG-encrypted store, `pass`)."
                 install: [ { via: native  repo-component: universe  when: "not (rhel or amzn)"  name: { zypper: password-store  default: pass } }
                            { via: native  when: "rhel"  requires: epel } ] }   // openSUSE pkg is `password-store` (binary still `pass`); EL via EPEL
        gnupg: { attrs: [ CLI FOSS GNU copyleft ] description: "GnuPG (`gpg`) — OpenPGP encryption and signing." install: [ { via: native  name: { dnf: gnupg2  zypper: gpg2  default: gnupg } } ] }   // dnf=gnupg2, zypper=gpg2, else gnupg; binary `gpg`
        gh:    { attrs: [ CLI FOSS permissive account cloud ] description: "GitHub CLI — drive GitHub from the terminal (`gh`)."
                 install: [ { via: native  repo-component: universe  when: "not (rhel or opensuse or amzn)"  name: { pacman: github-cli  apk: github-cli  default: gh } }
                            { via: native-pkg-file  when: "rhel or opensuse or amzn"  version: { github: cli/cli }  asset: { rpm: { x86_64: "gh_*_linux_amd64.rpm" } } } ] }   // in-repo on debian/ubuntu(universe)/fedora/arch(github-cli)/alpine(github-cli)/brew; upstream .rpm for EL/openSUSE
        doppler: { attrs: [ CLI FOSS permissive account cloud ] description: "Doppler CLI — sync secrets and config across environments (`doppler`)."
                   install: [ { via: native-pkg-file  when: "debian"  version: { github: DopplerHQ/cli }  asset: { deb: { x86_64: "doppler_*_linux_amd64.deb" } } }
                              { via: native-pkg-file  when: "redhat or opensuse"  version: { github: DopplerHQ/cli }  asset: { rpm: { x86_64: "doppler_*_linux_amd64.rpm" } } }
                              { via: aur  when: "arch"  name: doppler-cli-bin } ] }   // not in distro repos; upstream ships .deb/.rpm; AUR pkg is `doppler-cli-bin`
        // bat: `cat` clone w/ highlighting. Debian/Ubuntu install the binary as `batcat` (name clash) ->
        // the glue aliases it to `bat`. EL via EPEL; amzn has neither -> cargo (crate is `bat`).
        bat: { attrs: [ CLI FOSS permissive ] suggests: bat-dotfiles  description: "bat — a `cat` clone with syntax highlighting and git integration (Debian/Ubuntu install it as `batcat`)."
               install: [ { via: native  repo-component: universe  when: "not (rhel or amzn)" }
                          { via: native  when: "rhel"  requires: epel }
                          { via: cargo   when: "amzn"  name: bat } ] }
        bat-dotfiles: { description: "bat alias (batcat->bat on Debian/Ubuntu), linked into place." install: [ { via: dotfiles  requires: bash-dotfiles  glue: bat } ] }
        // lm-sensors: hardware health (temps/voltages/fans). Package name drifts three ways; the binary
        // is always `sensors` (+ `sensors-detect`). In EL/Fedora base (no EPEL needed).
        lm-sensors: { attrs: [ CLI FOSS copyleft ] description: "lm-sensors — read hardware health sensors: temps, voltages, fans (`sensors`, `sensors-detect`)."
                      install: [ { via: native  when: "not fedora_atomic"  name: { dnf: lm_sensors  pacman: lm_sensors  zypper: sensors  default: lm-sensors } } ] }   // no brew formula (Linux-kernel tool)
        // lsblk: lists block devices; part of util-linux (essential/preinstalled on glibc distros).
        // Alpine splits it out as its own `lsblk` package (over busybox's limited applet).
        lsblk: { attrs: [ CLI FOSS copyleft ] description: "lsblk — list block devices as a tree (part of util-linux)."
                 install: [ { via: native  name: { apk: lsblk  default: util-linux } } ] }
        // chafa: render images/animations in the terminal (ANSI/sixel/kitty). EL via EPEL.
        chafa: { attrs: [ CLI FOSS copyleft ] description: "chafa — display images (and gifs) in the terminal as ANSI/sixel/kitty graphics."
                 install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"  repo-component: universe } ] }
        // fff: minimal Bash file manager. Upstream archived (dylanaraps) -> Debian/Ubuntu ship an old
        // 1.1 and Arch's AUR has 2.2; a `via: source` build (pure Bash `make install`) in the
        // configsys-source plugin covers Fedora/openSUSE/Alpine/EL.
        // fff is a single self-contained bash script; upstream is archived and it isn't packaged in
        // any apt/dnf/zypper repo — fetch the script straight from GitHub to ~/.local/bin (on PATH).
        fff: { attrs: [ TUI FOSS permissive legacy ] description: "fff — a fast, minimal terminal file manager written in Bash (`fff`)."
               install: [ { via: script  when: "not arch"  requires: curl
                            install-cmd:   'mkdir -p "$HOME/.local/bin" && curl -fsSL https://raw.githubusercontent.com/dylanaraps/fff/master/fff -o "$HOME/.local/bin/fff" && chmod +x "$HOME/.local/bin/fff"'
                            version-cmd:   '"$HOME/.local/bin/fff" -v 2>/dev/null'
                            version-re:    '([0-9][0-9.]*)'
                            uninstall-cmd: 'rm -f "$HOME/.local/bin/fff"'
                            location:      '~/.local/bin/fff' }
                          { via: aur  when: "arch"  name: fff } ] }

        // btop lives in EPEL on EL (needs epel enabled), base repos everywhere else.
        // Two native bindings: the EL one adds `requires: epel`; both are dnf\btop.
        btop: { attrs: [ TUI app FOSS permissive ] suggests: btop-dotfiles 
            description: "System-resource monitor — CPU/mem/net/disk in a colorful TUI."
            install: [
                { via: native  when: "rhel"  requires: epel }
                { via: native  when: "not amzn"   repo-component: universe }
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/btop"  version: { github: aristocratos/btop  strip-v: true  asset: "btop-x86_64-unknown-linux-musl.tar.gz" } }   // prebuilt musl binary (btop/bin/btop)
            ]
        }
        htop: { attrs: [ TUI app FOSS copyleft ] description: "Interactive process viewer — a colorful, friendlier top."
            suggests: htop-dotfiles
            install: [
                { via: native  when: "rhel"  requires: epel }   // EL ships htop in EPEL, like btop
                { via: native  repo-component: universe }
            ]
        }
        htop-dotfiles: { description: "htop config, linked into place."
            install: [ { via: dotfiles  config: { src: htop  dst: $XDG_CONFIG_HOME/htop } } ]
        }

        // bottom (`btm`): Rust system monitor. Native `bottom` only where packaged (Arch, openSUSE,
        // Alpine, Homebrew); NOT in Debian/Ubuntu (upstream ships a .deb) nor Fedora/EL — name-sweep
        // confirmed the apt+dnf gaps — so cargo builds it on the whole debian + redhat families.
        bottom: { attrs: [ TUI app FOSS permissive ] suggests: bottom-dotfiles 
            description: "Cross-platform system monitor (`btm`) — CPU/mem/net/process/disk in a TUI."
            install: [
                { via: native  when: "not (redhat or debian)" }
                { via: cargo  name: bottom }   // builds `btm`; covers Debian/Ubuntu + Fedora/EL
            ]
        }

        // --- extra system/process monitors ---
        atop: { attrs: [ TUI FOSS copyleft ] description: "atop — advanced system and process monitor with logging."
            install: [ { via: native  when: "debian or fedora or arch or opensuse or alpine or amzn" }
                       { via: native  when: "rhel"  requires: epel } ] }   // EPEL on EL
        iotop: { attrs: [ TUI FOSS copyleft ] description: "iotop — a per-process disk I/O monitor."
            install: [ { via: native  when: "fedora"  name: iotop-c }   // Fedora dropped the Python `iotop` for the C rewrite `iotop-c`
                       { via: native  when: "debian or rhel or arch or opensuse or alpine or amzn"  name: iotop } ] }
        s-tui: { attrs: [ TUI app FOSS copyleft ] description: "s-tui — a terminal UI for CPU frequency/temperature/power and stress testing."
            install: [ { via: native  when: "debian or fedora or arch or opensuse or alpine" }
                       { via: pipx  name: s-tui } ] }   // Python app; pipx covers EL/Amazon/atomic (not in EPEL)
        glances: { attrs: [ TUI FOSS copyleft ] suggests: glances-dotfiles  description: "Glances — a cross-platform curses system monitor (`glances`)."
            install: [ { via: native  when: "debian or fedora or arch or alpine" }
                       { via: native  when: "rhel"  requires: epel }
                       { via: pipx  name: glances } ] }   // Python; pipx covers openSUSE/Amazon/atomic
        glances-dotfiles: { description: "glances config, linked into place." install: [ { via: dotfiles  config: { src: glances  dst: $XDG_CONFIG_HOME/glances } } ] }
        nvtop: { attrs: [ TUI FOSS copyleft ] description: "nvtop — a GPU process monitor for NVIDIA/AMD/Intel (an `htop` for GPUs)."
            install: [ { via: native  when: "debian or fedora or arch or opensuse"  repo-component: universe }
                       { via: native  when: "rhel"  requires: epel } ] }   // not in Alpine/Amazon base
        /* sysdig is not bheaving with my kernel--need to investigate
        sysdig: { description: "sysdig — system exploration and troubleshooting (ships `sysdig` + the `csysdig` curses UI)."
            install: [ { via: native  when: "debian or arch or opensuse"  repo-component: universe } ] }   // Fedora/EL only via the upstream Falco repo (not modeled); absent from Alpine/Amazon
        */
        dstat: { attrs: [ CLI FOSS copyleft ] description: "dstat — versatile system resource statistics (deprecated upstream; Arch/openSUSE ship the `dool` fork, binary `dool`)."
            install: [ { via: native  when: "debian"  name: dstat }
                       { via: native  when: "arch or opensuse"  name: dool } ] }   // dropped from Fedora/EL/Alpine; the dool fork replaces it on Arch/openSUSE

        // ncdu: NCurses disk-usage analyzer. Packaged as `ncdu` in every base repo (EL via EPEL,
        // Ubuntu universe — the htop/btop pattern).
        ncdu: { attrs: [ TUI FOSS permissive ]
            description: "NCurses disk-usage analyzer — find what's eating your disk (`ncdu`)."
            install: [
                { via: native  when: "rhel"  requires: epel }
                { via: native  when: "not amzn"   repo-component: universe }
            ]
        }

        // duf: a colorful, friendlier `df` (Go). Native where packaged (Debian 12+/Ubuntu universe,
        // Fedora, Arch, openSUSE, Homebrew); NOT in Alpine's repos and no EL package, so `go install`
        // builds it there (name-sweep confirmed the apk gap).
        duf: { attrs: [ CLI FOSS permissive ]
            description: "Disk Usage/Free — a colorful, friendlier `df` (`duf`)."
            install: [
                { via: native  when: "(not (rhel or alpine)) and not amzn"  repo-component: universe }
                { via: go-install  name: "github.com/muesli/duf" }   // builds `duf`; covers EL + Alpine
            ]
        }

        configsys-dotfiles: { description: "configsys's own shell integration, linked into place."
            install: [
                // 00- prefix: the ~/.bash.d loader sources files in lexical order, so this runs
                // FIRST and its CONFIGSYS_*_DIR exports are available to every other snippet.
                { via: dotfiles  requires: bash-dotfiles  glue: 00-configsys }
            ]
        }

        // --- shells & terminal multiplexers ---
        // tmux/zsh/fish are packaged under the same name in every distro's base repos.
        tmux: { attrs: [ CLI FOSS permissive ] description: "Terminal multiplexer — split panes and detachable sessions."
                suggests: tmux-dotfiles
                install: [ { via: native } ] }
        tmux-dotfiles: { description: "tmux config, linked into place."
                install: [ { via: dotfiles  config: { src: tmux  dst: $XDG_CONFIG_HOME/tmux } } ] }
        zsh:  { attrs: [ CLI FOSS permissive ] suggests: [ zsh-dotfiles, zsh-glue ]  description: "Z shell — a powerful interactive shell." install: [ { via: native } ] }
        fish: { attrs: [ CLI FOSS copyleft ] suggests: [ fish-dotfiles, fish-glue ]  description: "Friendly interactive shell — smart autosuggestions out of the box." install: [ { via: native  when: "not amzn"  } ] }
        // nushell isn't in Debian/Ubuntu/Fedora base repos; native where it is (Arch, Homebrew),
        // else the upstream glibc release tarball (ships `nu` + its plugins).
        nushell: { attrs: [ CLI FOSS permissive ] suggests: nushell-dotfiles 
            description: "A shell whose pipelines carry structured data, not just text (`nu`)."
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }              // brew formula `nushell`
                { via: tarball  when: "not alpine"  installDir: "$CONFIGSYS_APP_DIR/nushell"  requires: glibc
                  version: { github: nushell/nushell  strip-v: true  asset: "nu-*-x86_64-unknown-linux-gnu.tar.gz" } }
                { via: tarball  when: "alpine"  installDir: "$CONFIGSYS_APP_DIR/nushell"   // musl build for Alpine (the gnu one needs glibc)
                  version: { github: nushell/nushell  strip-v: true  asset: "nu-*-x86_64-unknown-linux-musl.tar.gz" } }
            ]
        }

        // --- terminal emulators & TUI file managers ---
        // kitty: GPU-accelerated terminal emulator, packaged natively across every base repo
        // (apt/dnf/pacman/zypper/apk all carry `kitty`).
        kitty: { attrs: [ GUI app FOSS copyleft ] suggests: kitty-dotfiles  description: "Fast, GPU-accelerated terminal emulator." install: [ { via: native  when: "not amzn"  } ] }
        // ghostty: Zig terminal emulator. The only official native package among our managers is
        // Arch's (openSUSE dropped it over Zig-version churn, Fedora is COPR-only, Debian is
        // community-only, and it's absent from Alpine's community repo — name sweep confirmed) — so
        // native is gated to arch and everywhere else falls back to the community "universal"
        // AppImage (pkgforge-dev; glibc/fuse2, unpacked under ~/apps). Musl-only boxes (Alpine)
        // have no verified method, so ghostty simply declines there. The `asset` glob discovers the
        // real download URL from the GitHub API (no hand-templated url).
        ghostty: { attrs: [ GUI FOSS permissive ] suggests: ghostty-dotfiles  description: "Fast, native GPU-accelerated terminal emulator."
            install: [
                { via: native  when: "arch" }
                { via: appImage  name: Ghostty  scope: user
                  version: { github: pkgforge-dev/ghostty-appimage  strip-v: true  asset: "Ghostty-*-$ARCH.AppImage" }
                  path: ~/apps/ghostty.appimage }
            ]
        }
        // alacritty: Rust GPU terminal. Native in the big-four repo families (Ubuntu universe /
        // Fedora / Arch / openSUSE); it's NOT in EPEL and has no Flathub app, so EL / Amazon /
        // atomic / musl-Alpine fall back to a crates.io build (needs the usual freetype/fontconfig
        // -dev libs + a windowing stack — best-effort).
        alacritty: { attrs: [ GUI app FOSS permissive ] suggests: alacritty-dotfiles  description: "Alacritty — a fast, GPU-accelerated terminal emulator."
            install: [
                { via: native  when: "debian or fedora or arch or opensuse"  repo-component: universe }
                { via: cargo   when: "not (debian or fedora or arch or opensuse)"  name: alacritty } ]
        }
        alacritty-dotfiles: { description: "alacritty config, linked into place." install: [ { via: dotfiles  config: { src: alacritty  dst: $XDG_CONFIG_HOME/alacritty } } ] }
        // wezterm: GPU terminal + multiplexer. Official native on Arch + openSUSE; everywhere else
        // the Flathub flatpak (upstream marks no GitHub "latest" release — date-tagged pre-releases
        // only — so there's no clean .deb/.rpm pin to track).
        wezterm: { attrs: [ GUI app FOSS permissive ] suggests: wezterm-dotfiles  description: "WezTerm — a GPU-accelerated cross-platform terminal emulator + multiplexer (`wezterm`)."
            install: [
                { via: native   when: "arch or opensuse" }
                { via: flatpak  hub: flathub  app: org.wezfurlong.wezterm } ]
        }
        wezterm-dotfiles: { description: "wezterm config, linked into place." install: [ { via: dotfiles  config: { src: wezterm  dst: $XDG_CONFIG_HOME/wezterm } } ] }
        // foot: a fast, lightweight Wayland-only terminal. Native across debian/ubuntu/fedora/arch/
        // alpine/openSUSE; no brew/EL package (and it needs a Wayland compositor at runtime).
        foot: { attrs: [ GUI FOSS permissive ] suggests: foot-dotfiles  description: "foot — a fast, lightweight Wayland terminal emulator (`foot`)."
            install: [ { via: native  repo-component: universe  when: "not (rhel or amzn or fedora_atomic)" } ] }
        foot-dotfiles: { description: "foot terminal config, linked into place." install: [ { via: dotfiles  config: { src: foot  dst: $XDG_CONFIG_HOME/foot } } ] }
        // grim/slurp/swaybg/wmenu — wlroots-only Wayland tools (won't run on X11 or GNOME/KDE Wayland).
        // Native on debian/ubuntu/fedora/arch/alpine/openSUSE; no EL/amzn/atomic (like `foot`).
        grim: { attrs: [ CLI FOSS permissive ] description: "grim — take screenshots on wlroots-based Wayland compositors."
                install: [ { via: native  repo-component: universe  when: "not (rhel or amzn or fedora_atomic)" } ] }
        slurp: { attrs: [ CLI FOSS permissive ] description: "slurp — select a region or point on a Wayland compositor (pipe into grim to crop a screenshot)."
                install: [ { via: native  repo-component: universe  when: "not (rhel or amzn or fedora_atomic)" } ] }
        swaybg: { attrs: [ CLI FOSS permissive ] description: "swaybg — set the wallpaper/background on wlroots Wayland compositors."
                install: [ { via: native  repo-component: universe  when: "not (rhel or amzn or fedora_atomic)" } ] }
        // wmenu: dmenu for Wayland (`wmenu`/`wmenu-run`) — broadly packaged (extra/community/main).
        wmenu: { attrs: [ GUI FOSS permissive ] description: "wmenu — a dmenu-style menu for Wayland (`wmenu`/`wmenu-run`)."
                install: [ { via: native  repo-component: universe  when: "not (rhel or amzn or fedora_atomic)" } ] }
        // wl-screenrec: GPU-accelerated (VAAPI) wlroots screen recorder. Real packaging only on
        // openSUSE Tumbleweed + Arch AUR; else a cargo build (needs recent Rust [edition 2024] and,
        // at build time, FFmpeg >=6 + libva + clang dev libs present).
        wl-screenrec: { attrs: [ CLI FOSS permissive ] description: "wl-screenrec — GPU-accelerated screen recorder for wlroots Wayland compositors."
                install: [ { via: native  when: "opensuse_tumbleweed" }
                           { via: aur  when: "arch" }
                           // cargo builds ffmpeg-sys-next + drm bindings from source -> needs the FFmpeg/libdrm
                           // dev headers + pkg-config. It also requires FFmpeg >= 6 (uses the 5.1+ channel-layout
                           // + AVFrame.time_base + VAAPI APIs), so decline on releases that ship an older FFmpeg
                           // (Ubuntu/Pop < 24.04 = 4.4, Debian < 13 = 5.1) rather than attempt a build that
                           // fails on missing symbols. openSUSE Leap's ffmpeg dev libs come from Packman (not
                           // modeled) -> decline there too; Tumbleweed/Arch are covered natively/AUR above.
                           { via: cargo  when: "not (arch or opensuse or fedora_atomic) and not ((ubuntu < 24.04) or (debian < 13))"  name: wl-screenrec  requires: [ cargo, ffmpeg-dev, libdrm-dev, pkg-config ] } ] }
        // yazi: Rust TUI file manager. Native on Arch + Homebrew; upstream ships a real .deb, so on
        // Debian/Ubuntu (not in-repo) install that via the OS package tool — clean and on PATH.
        // Elsewhere (Fedora is COPR-only; openSUSE/Alpine/EL absent) the release zip lands under
        // ~/apps and its companion snippet aliases `yazi`.
        yazi: { attrs: [ TUI app FOSS permissive ]
            description: "Blazing-fast terminal file manager with image previews."
            suggests: yazi-dotfiles
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }              // brew formula `yazi`
                // upstream's .deb is a glibc build needing libc6 >= 2.39, so it's gated to the OS
                // versions that ship it (Ubuntu 24.04 / Debian 13); older glibc (e.g. Pop/Ubuntu
                // 22.04) can't install OR run it -> fall through to the musl tarball below.
                { via: native-pkg-file  when: "(ubuntu >= 24.04) or (debian >= 13)"
                  version: { github: sxyazi/yazi }
                  asset: { x86_64: yazi-x86_64-unknown-linux-gnu.deb  aarch64: yazi-aarch64-unknown-linux-gnu.deb } }
                // the MUSL zip is a static binary — no libc6 floor — so it runs on any glibc (old
                // Debian/Ubuntu/Pop) AND on musl Alpine. The universal fallback (aliased by yazi.sh).
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/yazi"  requires: unzip
                  version: { github: sxyazi/yazi  asset: "yazi-$ARCH-unknown-linux-musl.zip" } }
            ]
        }
        yazi-dotfiles: { description: "yazi config, linked into place."
            install: [ { via: dotfiles  requires: bash-dotfiles  glue: yazi } ]
        }
        // superfile (`spf`): Go TUI file manager. Native on Arch + Homebrew; elsewhere the GitHub
        // release tarball (its official install.sh sudo-installs and edits shell rc files — the
        // surprises configsys avoids — so we unpack userland under ~/apps and alias `spf`).
        superfile: { attrs: [ TUI app FOSS permissive ]
            description: "Modern terminal file manager (`spf`) with a pretty TUI."
            suggests: superfile-dotfiles
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }              // brew formula `superfile`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/superfile"  requires: glibc
                  version: { github: yorukot/superfile  asset: "superfile-linux-*-amd64.tar.gz" } }
            ]
        }
        superfile-dotfiles: { description: "superfile config, linked into place."
            install: [ { via: dotfiles  requires: bash-dotfiles  glue: superfile } ]
        }
        // ueberzugpp — draws images in the terminal (X11/Wayland/Sixel) so file managers like yazi
        // can show image previews. The maintained C++ fork of the archived Python `ueberzug`;
        // installs the `ueberzug` command. Only Arch packages it natively (extra); a `via: source`
        // build for the other distros lives in the configsys-source plugin.
        ueberzugpp: { attrs: [ CLI FOSS copyleft ] description: "ueberzugpp — display images inline in the terminal for previews (`ueberzug`); the maintained ueberzug fork."
            install: [ { via: native  when: "arch"  name: ueberzugpp } ] }

        // mc: Midnight Commander — packaged as `mc` in every base repo (EL via EPEL, like htop/btop).
        mc: { attrs: [ TUI app FOSS GNU copyleft ]
            description: "Midnight Commander — a two-pane TUI file manager (`mc`)."
            install: [
                { via: native  when: "rhel"  requires: epel }
                { via: native  repo-component: universe }
            ]
        }

        // espeak: we install espeak-ng (the maintained fork; provides the `espeak` command),
        // packaged as `espeak-ng` everywhere (Debian/Ubuntu universe, Fedora, Arch, openSUSE,
        // Alpine, Homebrew; EL via EPEL).
        espeak: { attrs: [ CLI FOSS copyleft ]
            description: "espeak-ng — compact software speech synthesizer (`espeak`)."
            install: [
                { via: native  when: "rhel"  requires: epel  name: espeak-ng }
                { via: native  when: "amzn"  name: espeak }
                { via: native  repo-component: universe  name: espeak-ng }
            ]
        }

        // EPEL: a capability enabled by installing epel-release (only on EL). Anything
        // that `requires: epel` is a no-op off EL (nothing needs it) and pulls this in on EL.
        epel-release: { attrs: [ headless FOSS permissive ] description: "EPEL — Extra Packages for Enterprise Linux (an extra RHEL repo)."
            provides: epel
            // Oracle Linux ships EPEL under its own package name (oracle-epel-release-elN); the
            // narrower `when: ol` wins over the generic rhel binding by specificity. (el9 name —
            // an OL8 target would want oracle-epel-release-el8.)
            install: [ { via: native  when: "rhel" }
                       { via: native  when: "ol"  name: oracle-epel-release-el9 } ]
        }

        // pipx: the version-variant collapse. Native package where the repos have it;
        // a pip --user bootstrap on old Ubuntu/Debian; +EPEL on EL. Was a \pip family +
        // apt/dnf/pacman entries + two @version blocks + a rhel override — now three bindings.
        pipx: { attrs: [ CLI FOSS permissive ] suggests: pipx-dotfiles  description: "Install and run Python CLI apps in isolated environments."
            install: [
                { via: pip     when: "(ubuntu < 23.04) or (debian < 12) or amzn"  name: pipx  version: { pypi: pipx } }
                { via: native  when: "rhel"  requires: epel  name: { pacman: python-pipx } }
                { via: native  name: { pacman: python-pipx  zypper: python313-pipx } }
            ]
        }

        // The Rust toolchain, explicit and directly usable (rustc + cargo). It `provides: cargo`,
        // so the cargo DRIVER's `requires: cargo` (a crate needs the cargo tool) is satisfied by
        // installing rust — there is no separate `cargo` component. Package names bring the WHOLE
        // toolchain: apt `rust-all` (metapkg: rustc+cargo+gdb+doc), Arch/Homebrew `rust` (bundles
        // cargo), and elsewhere `cargo` transitively pulls rustc (dnf/apk/zypper).
        rust: { attrs: [ CLI toolchain FOSS permissive ] suggests: rust-dotfiles  description: "The Rust toolchain (cargo, rustc) — safe systems programming."
            provides: cargo
            install: [
                { via: native  repo-component: universe  name: { apt: rust-all  pacman: rust  brew: rust  default: cargo }  installed-name: cargo }   // Ubuntu splits the toolchain: `rust-all` is a meta over cargo/rustc — read state from `cargo`
                // rustup: the official installer -> the LATEST STABLE toolchain, userland in
                // ~/.cargo (no sudo, on the standard ~/.cargo/bin PATH). For source builds that
                // need a newer cargo than the distro ships (the toolchain-floor case). Least-
                // preferred (via: script is last in driver-preference), so it NEVER wins by default
                // — native stays the default; pin `rust script` (or let a cargo>=X floor advise it).
                // Its available version is the current stable (read from the stable channel
                // manifest); `provides: { cargo }` is the floor it guarantees. `--no-modify-path`
                // keeps rustup from editing your shell rc (no surprises) — the SOURCE driver
                // prepends ~/.cargo/bin for builds, so a floor-pinned rust builds; for INTERACTIVE
                // use, put ~/.cargo/bin on PATH yourself (configsys ships no personal shell config).
                { via: script  requires: curl
                  provides: { cargo: ">=1.80" }
                  version: { url: "https://static.rust-lang.org/dist/channel-rust-stable.toml"
                             regex: '\[pkg\.rust\]\s*\n\s*version = "([0-9]+\.[0-9]+\.[0-9]+)' }
                  install-cmd:   "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path"
                  version-cmd:   "$HOME/.cargo/bin/cargo --version"
                  version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                  uninstall-cmd: "$HOME/.cargo/bin/rustup self uninstall -y"
                  location:      "~/.cargo/bin" }
            ]
        }

        // Node.js toolchain (node + npm), directly usable. It `provides: npm`, so the npm
        // DRIVER's `requires: npm` is met by installing node. One native binding brings both:
        // apt/Arch/Alpine `npm` transitively pulls nodejs; Fedora/openSUSE `nodejs` and
        // Homebrew `node` bundle npm.
        node: { attrs: [ runtime FOSS permissive ] suggests: node-dotfiles  description: "Node.js — JavaScript runtime built on V8."
            provides: npm
            install: [ { via: native  repo-component: universe  name: { apt: npm  pacman: npm  apk: npm  brew: node  zypper: nodejs-default  default: nodejs } }
                       { via: snap  name: node  classic: true } ]   // OpenJS-official snap (candidate-only)
        }
        // Sample global npm CLIs (installed userland by default; see the npm driver). More can
        // be added the same way, or pulled per-user via a plugin layer.
        typescript: { attrs: [ CLI toolchain FOSS permissive ] description: "TypeScript — typed JavaScript, compiles to JS (`tsc`)." install: [ { via: npm  name: typescript } ] }
        prettier:   { attrs: [ CLI FOSS permissive ] description: "Prettier — an opinionated code formatter for web languages." install: [ { via: npm  name: prettier } ] }
        // Front-end package managers + Dart Sass — npm globals (userland, like the above). NOTE:
        // recent pnpm/sass want a modern Node (pnpm >=22); the distro's apt node can be too old —
        // use a version-managed node (nvm/fnm) if you hit a "requires Node vXX" error.
        pnpm:       { attrs: [ CLI FOSS permissive ] description: "pnpm — fast, disk-efficient Node package manager." install: [ { via: npm  name: pnpm } ] }
        yarn:       { attrs: [ CLI FOSS permissive ] description: "Yarn — a Node package manager." install: [ { via: npm  name: yarn } ] }
        sass:       { attrs: [ CLI FOSS permissive ] description: "Sass — CSS with superpowers (the `sass` compiler)." install: [ { via: npm  name: sass } ] }
        // elm: no distro packages it — the official prebuilt binary from elm/compiler releases is a
        // single gzipped glibc executable (archive: gz). Off-PATH under the app dir, so elm-dotfiles
        // aliases it; declines on musl Alpine.
        elm: { attrs: [ CLI toolchain FOSS permissive ] suggests: elm-dotfiles  description: "Elm — a functional language for reliable web frontends (compiles to JS)."
            install: [ { via: tarball  when: "not alpine"  installDir: "$CONFIGSYS_APP_DIR/elm"  requires: glibc  archive: gz  binary: elm
                         version: { github: elm/compiler  asset: "elm-*-linux-x64.gz" } } ] }
        elm-dotfiles: { description: "elm shell setup, linked into place." install: [ { via: dotfiles  requires: bash-dotfiles  glue: elm } ] }

        // Deno & Bun — alternative JS/TS runtimes. Native on Arch/Homebrew where packaged; else
        // the upstream github release ZIP (glibc-linked; the tarball driver unzips it). Both have
        // STABLE asset names (no version in the filename), so they use github's API-free
        // `releases/latest/download` URL — robust even when api.github.com is unreachable.
        deno: { attrs: [ CLI runtime FOSS permissive ] suggests: deno-dotfiles  description: "Deno — secure JavaScript/TypeScript runtime with built-in tooling."
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }             // brew formula `deno`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/deno"  requires: [ glibc, unzip ]  version: { static: latest }
                  url: "https://github.com/denoland/deno/releases/latest/download/deno-x86_64-unknown-linux-gnu.zip" } ]
        }
        bun: { attrs: [ CLI runtime toolchain FOSS permissive ] suggests: bun-dotfiles  description: "Bun — fast all-in-one JavaScript runtime, bundler, and package manager."
            install: [
                { via: native  when: "fedora_atomic" }             // brew formula `bun`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/bun"  requires: [ glibc, unzip ]  version: { static: latest }
                  url: "https://github.com/oven-sh/bun/releases/latest/download/bun-linux-x64.zip" } ]
        }

        // Go toolchain, directly usable. Auto-provides the `go` capability the go-install
        // driver requires. Package names: apt `golang-go`, dnf `golang`, else `go`.
        go: { attrs: [ CLI toolchain FOSS permissive ] suggests: go-dotfiles  description: "The Go programming language toolchain."
            install: [
                { via: native  name: { apt: golang-go  dnf: golang  default: go } }
                // the official Go toolchain tarball — latest stable, userland under
                // $CONFIGSYS_SDK_DIR/go (~/sdks/go by default; `strip: 1` drops the archive's `go/`
                // wrapper so `go` lands at .../go/bin). For source builds that need a newer Go than
                // the distro ships (lazygit/superfile floors). Least-preferred (native stays the
                // default; pin `go tarball`, or let a go>=X floor advise it). The source driver puts
                // ~/sdks/go/bin on PATH for builds; `provides: { go }` is the floor it guarantees.
                { via: tarball  installDir: "$CONFIGSYS_SDK_DIR/go"  strip: 1  requires: [ glibc, curl ]
                  provides: { go: ">=1.21" }
                  version: { url: "https://go.dev/VERSION?m=text"  regex: "go([0-9.]+)" }
                  url: "https://go.dev/dl/go$VERSION.linux-amd64.tar.gz" }
            ]
        }
        // Sample `go install` tool (module path in `name:`; binary = its last segment).
        goimports: { attrs: [ CLI FOSS permissive ] description: "goimports — format Go code and fix imports."
            // goimports@latest's go.mod needs a modern toolchain to even parse (a distro go 1.18
            // fails "invalid go version"). Soft-floor go >=1.21: resolves with default go, and the
            // resident-floor check advises `upgrade go` / auto-tightens to the go tarball (>=1.21).
            install: [ { via: go-install  name: "golang.org/x/tools/cmd/goimports"  requires: [ { go: ">=1.21" } ] } ] }

        // Ruby toolchain (ships gem + irb). Auto-provides `ruby` for the gem driver. apt
        // `ruby-full` bundles the dev headers gems' native extensions need; else `ruby`.
        ruby: { attrs: [ CLI runtime toolchain FOSS permissive ] suggests: ruby-dotfiles  description: "The Ruby programming language."
            install: [ { via: native  name: { apt: ruby-full  default: ruby } } ]
        }
        // Sample gem (userland by default; see the gem driver).
        bundler: { attrs: [ CLI FOSS permissive ] description: "Bundler — manage Ruby gem dependencies (`bundle`)." install: [ { via: gem  name: bundler } ] }

        // PHP toolchain — the CLI interpreter + Composer (its project dependency manager). The bare
        // `php` package is the Apache/mod_php web stack on apt AND dnf, so the CLI package is
        // `php-cli` there; Arch/brew ship a plain `php`; Alpine is versioned-only (`php84`);
        // openSUSE uses `php8-cli`. Third-party repos (Surý on Debian/Ubuntu, Remi on Fedora/RHEL)
        // add non-default PHP versions — not modeled here; the distro default is enough.
        php: { attrs: [ CLI toolchain FOSS permissive ] description: "PHP — the PHP command-line interpreter (`php`)."
            install: [ { via: native  repo-component: universe
                         name: { apt: php-cli  dnf: php-cli  pacman: php  apk: php84  zypper: php8-cli  brew: php } } ]
        }
        composer: { attrs: [ CLI FOSS permissive ] suggests: composer-dotfiles  description: "Composer — PHP's per-project dependency manager." requires: php
            install: [ { via: native  when: "not rhel"  repo-component: universe  name: { zypper: php-composer2  default: composer } }
                       { via: native  when: "rhel"  requires: epel  name: composer } ]
        }

        // .NET SDK — build & run C#/F# apps. Native from the distro's OWN repos on arch (rolling),
        // ubuntu 22.04+, fedora, and alpine (no Microsoft feed needed). On debian/rhel/openSUSE the
        // upstream dotnet-install.sh lands a per-user SDK under ~/.dotnet (add it to PATH yourself);
        // the Canonical snap (classic) is a pinnable all-distro alternate. Distro packages are
        // per-major (8.0 = current LTS) — bump the channel/pkg as newer LTS lines land.
        dotnet: { attrs: [ CLI SDK toolchain FOSS permissive tele ] suggests: dotnet-dotfiles  description: ".NET SDK — build & run .NET (C#/F#) apps (`dotnet`)."
            install: [
                { via: native  when: "arch"    name: dotnet-sdk }              // rolling latest
                { via: native  when: "ubuntu"  name: dotnet-sdk-8.0 }          // Canonical feed (22.04+)
                { via: native  when: "fedora"  name: dotnet-sdk-8.0 }          // Fedora's own repo
                { via: native  when: "alpine"  name: dotnet8-sdk }             // community
                { via: script  when: "debian or rhel or opensuse"
                  install-cmd:   'curl -fsSL https://dot.net/v1/dotnet-install.sh | bash -s -- --channel 8.0'
                  version-cmd:   '"$HOME/.dotnet/dotnet" --version 2>/dev/null'
                  version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                  uninstall-cmd: 'rm -rf "$HOME/.dotnet"'
                  location:      '~/.dotnet' }
                { via: snap  name: dotnet-sdk  classic: true } ]               // Canonical; pinnable all-distro
        }

        // --- native language toolchains (directly usable; ecosystem module drivers deferred) ---
        // JDK — VERSION-SCOPED providers of the `jdk` capability (the python3.X pattern for Java).
        // Every LTS line is reachable by a `jdk-NN` name. `jdk` is the canonical default: it holds
        // the OpenJDK 21 bindings and `provides: { jdk: 21 }` (not `never-auto`), so a bare `jdk` /
        // `requires: jdk` installs the current LTS default; `jdk-21` is a thin alias to it (so the
        // -NN naming is complete without a second jdk:21 provider — two would tie). `jdk-17`/`jdk-25`
        // are opt-in `never-auto` lines; a versioned `requires: { jdk: ">=25" }` selects/enables the
        // matching line. 17/21/25 are ALL LTS (the non-LTS interim releases aren't packaged here —
        // mark a future jdk-NN's description `(non-LTS)` if one is added). Native openjdk-N tracks the
        // latest patch. graalvm is GraalVM CE (native-image) via SDKMAN — another (never-auto) jdk:21
        // provider; the sdkman/graalvm components are the manual alt-distribution path.
        // To bump the default LTS: move the native bindings + `provides:` onto `jdk`, turn the OLD
        // default's `jdk-NN` alias into a real `never-auto` line, and repoint `jdk-NN` at the new line.
        jdk: { attrs: [ toolchain runtime FOSS copyleft ] description: "Java Development Kit — the current LTS default (OpenJDK 21)."
            provides: { jdk: 21 }
            install: [ { via: native  name: { apt: openjdk-21-jdk  dnf: java-21-openjdk-devel  pacman: jdk21-openjdk  apk: openjdk21  zypper: java-21-openjdk-devel  brew: "openjdk@21" } }
                       { via: native  when: "amzn"  name: java-21-amazon-corretto-devel } ] }   // Amazon ships Corretto, not OpenJDK
        jdk-17: { attrs: [ toolchain runtime FOSS copyleft ] description: "OpenJDK 17 — LTS (2021)." standing: never-auto  provides: { jdk: 17 }
            install: [ { via: native  name: { apt: openjdk-17-jdk  dnf: java-17-openjdk-devel  pacman: jdk17-openjdk  apk: openjdk17  zypper: java-17-openjdk-devel  brew: "openjdk@17" } }
                       { via: native  when: "amzn"  name: java-17-amazon-corretto-devel } ] }
        jdk-21: { attrs: [ toolchain runtime FOSS copyleft ] description: "OpenJDK 21 — LTS (2023); the current default (alias for `jdk`)." standing: never-auto
            install: [ { via: parts  parts: [ jdk ] } ] }
        jdk-25: { attrs: [ toolchain runtime FOSS copyleft ] description: "OpenJDK 25 — LTS (2025)." standing: never-auto  provides: { jdk: 25 }
            install: [ { via: native  name: { apt: openjdk-25-jdk  dnf: java-25-openjdk-devel  pacman: jdk25-openjdk  apk: openjdk25  zypper: java-25-openjdk-devel  brew: "openjdk@25" } }
                       { via: native  when: "amzn"  name: java-25-amazon-corretto-devel } ] }
        graalvm: { attrs: [ CLI runtime toolchain FOSS copyleft ] description: "GraalVM CE 21 — a JDK with native-image (ahead-of-time compilation), via SDKMAN."
            standing: never-auto  provides: { jdk: 21 }
            install: [ { via: sdkman  name: java  version: "21.0.2-graalce"   // bump the SDKMAN id as releases roll
                         latest-check: { github: graalvm/graalvm-ce-builds  tag-re: "jdk-([0-9][0-9.]*)" } } ] }   // `refresh` flags when a newer GraalVM ships
        // SDKMAN — a JVM SDK manager installed by its own shell script (the demonstrator for the
        // `script` driver: lifecycle commands declared as data, incl. a clean uninstall). `sdk`
        // is a shell function, so version-cmd sources the init script in the same shell.
        sdkman: { attrs: [ CLI FOSS permissive ] description: "SDKMAN! — manage parallel versions of JVM SDKs and tools."
            suggests: sdkman-dotfiles
            install: [ { via: script
                         install-cmd: 'curl -s https://get.sdkman.io | bash'
                         version-cmd: 'source "$HOME/.sdkman/bin/sdkman-init.sh" && sdk version'
                         version-re: '([0-9]+\.[0-9]+\.[0-9]+)'
                         uninstall-cmd: 'rm -rf "$HOME/.sdkman"'
                         location: '~/.sdkman' } ]
        }
        sdkman-dotfiles: { description: "SDKMAN shell init — sources sdkman-init.sh from ~/.bash.d so `sdk` + the selected SDKs are on PATH."
            install: [ { via: dotfiles  requires: bash-dotfiles  glue: sdkman } ] }

        // Kotlin compiler — native on Arch/Homebrew; else the github release ZIP. Needs a JVM to
        // run (requires jdk) and unzip to unpack. (SDKMAN is the other path — via the script driver.)
        kotlin: { attrs: [ toolchain FOSS permissive ] suggests: kotlin-dotfiles  description: "Kotlin — modern JVM language, Android's default."
            install: [
                { via: native  when: "arch" }                      // pacman: kotlin
                { via: native  when: "fedora_atomic" }             // brew formula `kotlin`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/kotlin"  requires: [ jdk, unzip ]
                  version: { github: JetBrains/kotlin  strip-v: true  asset: "kotlin-compiler-*.zip" }
                  url: "https://github.com/JetBrains/kotlin/releases/download/v$VERSION/kotlin-compiler-$VERSION.zip" } ]
        }
        // OCaml compiler (opam driver deferred).
        ocaml: { attrs: [ CLI toolchain FOSS copyleft ] description: "OCaml — pragmatic functional language with a fast native compiler." install: [ { via: native  repo-component: universe } ] }
        // Lua interpreter (luarocks deferred). Some distros suffix the package with the version.
        lua:   { attrs: [ CLI toolchain runtime FOSS permissive ] description: "The Lua programming language — small, embeddable scripting." install: [ { via: native  repo-component: universe  name: { apt: lua5.4  apk: lua5.4  zypper: lua54  default: lua } } ] }
        // Tcl/Tk — the Tool Command Language interpreter (`tclsh`) + its Tk GUI toolkit (`wish`).
        // Native everywhere (uniform `tcl`/`tk`); Homebrew ships both in one `tcl-tk` formula.
        tcl: { attrs: [ toolchain runtime CLI FOSS permissive ] description: "Tcl — the Tool Command Language interpreter (`tclsh`)."
            install: [ { via: native  repo-component: universe  name: { brew: tcl-tk } } ] }
        tk:  { attrs: [ lib FOSS permissive ] description: "Tk — the Tcl GUI toolkit (`wish`) and widget library." requires: tcl
            install: [ { via: native  repo-component: universe  name: { brew: tcl-tk } } ] }

        // --- more languages. GCC front-ends (gfortran/gnat/d-via-gdc) whose package name varies
        // per manager; niche/compiled langs via github release or an official repo. ---
        gfortran: { attrs: [ toolchain FOSS GNU copyleft ] description: "GNU Fortran — the GCC Fortran compiler (`gfortran`)."
            install: [ { via: native  name: { dnf: gcc-gfortran  pacman: gcc-fortran  zypper: gcc-fortran  brew: gcc  default: gfortran } } ] }   // brew bundles gfortran in `gcc`
        gnat: { attrs: [ CLI toolchain FOSS GNU copyleft ] description: "GNAT — the GCC Ada compiler."
            install: [ { via: native  when: "(not fedora_atomic) and not amzn"  name: { dnf: gcc-gnat  pacman: gcc-ada  apk: gcc-gnat  zypper: gcc-ada  default: gnat } } ] }   // no brew Ada front-end
        gnucobol: { attrs: [ CLI toolchain FOSS GNU copyleft ] description: "GnuCOBOL — a COBOL compiler (`cobc`)."
            install: [ { via: native  when: "(not arch) and not amzn"  name: gnucobol }   // `gnucobol` on apt/dnf/zypper/apk
                       { via: aur  when: "arch"  name: gnucobol } ] }   // AUR-only on Arch
        // Objective-C: the GNU ObjC compiler frontend + libobjc runtime (compile via `gcc -x
        // objective-c` or clang; no `objc` binary). apt calls it gobjc, everyone else gcc-objc;
        // Alpine's musl gcc and Amazon's base repo don't package it -> they decline.
        objective-c: { attrs: [ toolchain FOSS GNU copyleft ] description: "Objective-C — the GNU Objective-C compiler frontend + libobjc runtime."
            install: [ { via: native  when: "not (alpine or amzn or fedora_atomic)"  name: { apt: gobjc  default: gcc-objc } } ] }   // no gcc-objc brew formula on atomic (layer/toolbox instead)
        // GNUstep: the open-source Cocoa/OpenStep framework for Objective-C — needs the ObjC
        // compiler, so requires: objective-c. Debian/Ubuntu ship the full dev meta (gnustep-devel =
        // make+base+gui+back); Fedora/Arch/openSUSE package only Foundation + the build system (no
        // AppKit GUI in their base repos — that's AUR on Arch). gnustep-dotfiles sources the build
        // environment. Declines where objective-c does (Alpine/Amazon/atomic).
        gnustep: { attrs: [ lib FOSS GNU copyleft ] suggests: gnustep-dotfiles  requires: objective-c
            description: "GNUstep — open-source Cocoa/OpenStep framework for Objective-C (Foundation + AppKit)."
            install: [
                { via: native  when: "debian"    packages: [ gnustep-devel ] }                        // dev meta: make + base + gui + back
                { via: native  when: "fedora"    packages: [ gnustep-make, gnustep-base-devel ] }      // Foundation + build system (no AppKit in Fedora repos)
                { via: native  when: "arch"      packages: [ gnustep-make, gnustep-base ] }            // official base (gnustep-gui is AUR-only)
                { via: native  when: "opensuse"  packages: [ gnustep-make, gnustep-base-devel ] } ]
        }
        gnustep-dotfiles: { description: "gnustep shell setup, linked into place." install: [ { via: dotfiles  requires: bash-dotfiles  glue: gnustep } ] }
        d: { attrs: [ CLI toolchain FOSS permissive ] description: "The D programming language (a D compiler — LDC / GDC / DMD per distro)."
            install: [ { via: native  when: "fedora or arch or alpine or fedora_atomic"  name: ldc }   // LLVM D compiler
                       { via: native  when: "debian"  name: gdc }        // GCC D front-end (ldc is sid-only on debian)
                       { via: native  when: "opensuse"  name: dmd } ] }
        crystal: { attrs: [ CLI toolchain FOSS permissive ] description: "Crystal — a Ruby-like, LLVM-backed compiled language."
            install: [ { via: native  when: "arch or alpine or fedora_atomic" }   // pacman/apk/brew `crystal`
                       { via: script  when: "debian or redhat"           // official installer: adds the crystal repo + installs the package
                         install-cmd:   'curl -fsSL https://crystal-lang.org/install.sh | sudo bash'
                         version-cmd:   'crystal --version 2>/dev/null'
                         version-re:    '([0-9][0-9.]*)'
                         uninstall-cmd: 'sudo apt-get remove -y crystal 2>/dev/null || sudo dnf remove -y crystal 2>/dev/null'
                         location:      'crystal (dist.crystal-lang.org repo)' } ] }
        dart: { attrs: [ CLI toolchain SDK FOSS permissive ] suggests: dart-dotfiles  description: "Dart — Google's language & SDK for apps and Flutter."
            install: [ { via: native  when: "arch" }                     // pacman: dart (extra)
                       { via: native  when: "fedora_atomic"  name: dart-sdk }   // brew dart-sdk
                       { via: native  when: "debian"  name: dart          // Google's official apt repo (single `stable` suite — codename-independent)
                         pubkey-url: "https://dl-ssl.google.com/linux/linux_signing_key.pub"  pubkey-path: /usr/share/keyrings/dart.gpg
                         source-line: "deb [signed-by=/usr/share/keyrings/dart.gpg arch=amd64] https://storage.googleapis.com/download.dartlang.org/linux/debian stable main"
                         source-path: /etc/apt/sources.list.d/dart.list } ] }
        raku: { attrs: [ CLI runtime toolchain FOSS permissive ] description: "Raku (Rakudo) — the Raku language, formerly Perl 6."
            install: [ { via: native  when: "(not arch) and not amzn"  repo-component: universe  name: { brew: rakudo-star  default: rakudo } }
                       { via: aur  when: "arch"  name: rakudo-star } ] }   // AUR-only on Arch
        v: { attrs: [ CLI toolchain FOSS permissive ] suggests: v-dotfiles  description: "V — a simple, fast-compiling language (the `v` compiler)." requires: cc
            install: [ { via: native  when: "fedora_atomic"  name: vlang }   // brew vlang
                       { via: aur  when: "arch"  name: vlang-bin }
                       { via: tarball  when: "not arch and not fedora_atomic"  installDir: "$CONFIGSYS_APP_DIR/v"  requires: [ glibc, unzip ]  version: { static: latest }
                         url: "https://github.com/vlang/v/releases/latest/download/v_linux.zip" } ] }   // prebuilt zip
        gleam: { attrs: [ CLI toolchain FOSS permissive ] suggests: gleam-dotfiles  description: "Gleam — a friendly, statically-typed language for the Erlang VM." requires: erlang
            install: [ { via: native  when: "arch or alpine or fedora_atomic" }   // pacman/apk/brew gleam
                       { via: tarball  when: "not arch and not alpine and not fedora_atomic"  installDir: "$CONFIGSYS_APP_DIR/gleam"  requires: glibc
                         version: { github: gleam-lang/gleam  strip-v: true  asset: "gleam-*-x86_64-unknown-linux-musl.tar.gz" } } ] }   // single static binary
        fennel: { attrs: [ CLI toolchain FOSS permissive ] description: "Fennel — a Lisp that compiles to Lua." requires: lua
            install: [ { via: native  when: "fedora or arch or alpine or fedora_atomic" }   // dnf/pacman/apk/brew fennel
                       { via: luarocks  when: "not fedora and not arch and not alpine and not fedora_atomic"  name: fennel } ] }
        // swift: no distro-native package (Linux install is swiftly/tarball, manual); Arch has an AUR
        // binary. Listed for arch; elsewhere it's an honest unroutable until we model swiftly.
        swift: { attrs: [ toolchain CLI FOSS permissive ] description: "Swift — the Swift language toolchain."
            install: [ { via: aur  when: "arch"  name: swift-bin } ] }

        // JVM + Scheme langs. scala/clojure/groovy need a JDK. (No `via: sdkman` driver exists — sdkman
        // is only a component — so these use native / official installer scripts / snap, not sdkman.)
        clojure: { attrs: [ CLI runtime toolchain FOSS copyleft ] description: "Clojure — a Lisp dialect on the JVM (`clj`)." requires: jdk
            install: [ { via: native  when: "debian or arch or alpine or fedora_atomic"  repo-component: universe }   // uniform `clojure`
                       { via: script  when: "fedora or rhel or opensuse"   // clojure.org's official linux-install.sh
                         install-cmd:   'curl -fsSL https://github.com/clojure/brew-install/releases/latest/download/linux-install.sh | sudo bash'
                         version-cmd:   'clojure --version 2>/dev/null'
                         version-re:    '([0-9][0-9.]*)'
                         uninstall-cmd: 'sudo rm -rf /usr/local/bin/clj /usr/local/bin/clojure /usr/local/lib/clojure'
                         location:      '/usr/local/lib/clojure' } ] }
        groovy: { attrs: [ CLI runtime toolchain FOSS permissive ] description: "Apache Groovy — a dynamic language for the JVM." requires: jdk
            install: [ { via: sdkman }   // current Groovy 5, any distro (the clean default)
                       { via: native  when: "arch or debian or fedora_atomic"  standing: never-auto  repo-component: universe } ] }   // pacman/apt/brew (older); pinnable
        scala: { attrs: [ CLI runtime toolchain FOSS permissive ] description: "Scala — an object-functional language on the JVM." requires: jdk
            install: [ { via: sdkman }   // current Scala 3, any distro (SDKMAN — native is ancient on debian, AUR-only on arch)
                       { via: native  when: "fedora_atomic"  standing: never-auto }   // brew scala (pinnable alt)
                       { via: aur  when: "arch"  name: scala  standing: never-auto } ] }
        sbt: { attrs: [ CLI FOSS permissive ] description: "sbt — the interactive build tool for Scala." requires: jdk
            install: [ { via: sdkman } ] }
        leiningen: { attrs: [ CLI FOSS copyleft ] description: "Leiningen — build automation for Clojure (`lein`)." requires: jdk
            install: [ { via: sdkman } ] }
        // More JVM-ecosystem tools via SDKMAN (all need a JDK; `sdk install <name>`, any distro). Build
        // tools, framework CLIs, run/scripting, data engines, DB/quality/release, profiling. (SDKMAN
        // has more — grails/vertx/helidon/tomcat/jetty/hadoop/kscript/… — add the same way if wanted.)
        mvnd:       { attrs: [ CLI daemon FOSS permissive ] description: "Maven Daemon (mvnd) — a faster Maven with a resident build daemon." requires: jdk  install: [ { via: sdkman } ] }
        ant:        { attrs: [ CLI FOSS permissive ] description: "Apache Ant — the classic XML-driven Java build tool." requires: jdk  install: [ { via: sdkman } ] }
        springboot: { attrs: [ CLI FOSS permissive ] description: "Spring Boot CLI — scaffold and run Spring Boot applications." requires: jdk  install: [ { via: sdkman } ] }
        quarkus:    { attrs: [ CLI SDK FOSS permissive ] description: "Quarkus CLI — tooling for the Quarkus Java framework." requires: jdk  install: [ { via: sdkman } ] }
        micronaut:  { attrs: [ CLI SDK FOSS permissive ] description: "Micronaut CLI (`mn`) — build Micronaut microservices." requires: jdk  install: [ { via: sdkman } ] }
        jbang:      { attrs: [ CLI FOSS permissive ] description: "JBang — run Java/JVM scripts with no project setup." requires: jdk  install: [ { via: sdkman } ] }
        scalacli:   { attrs: [ CLI toolchain FOSS permissive ] description: "Scala CLI — the modern all-in-one Scala runner and tooling." requires: jdk  install: [ { via: sdkman } ] }
        // coursier isn't an SDKMAN candidate; upstream ships the `cs` launcher as a gzipped native
        // binary on GitHub (per-arch) — fetch + decompress it to ~/.local/bin (on PATH).
        coursier:   { attrs: [ CLI FOSS permissive ] suggests: coursier-dotfiles  description: "Coursier (`cs`) — the JVM artifact fetcher and application installer." requires: jdk
            install: [ { via: script  requires: [ curl, jdk ]
                         install-cmd:   'mkdir -p "$HOME/.local/bin" && A="$(uname -m)"; case "$A" in aarch64|arm64) F=cs-aarch64-pc-linux.gz ;; *) F=cs-x86_64-pc-linux.gz ;; esac; curl -fL "https://github.com/coursier/coursier/releases/latest/download/$F" | gzip -d > "$HOME/.local/bin/cs" && chmod +x "$HOME/.local/bin/cs"'
                         version-cmd:   '"$HOME/.local/bin/cs" version 2>/dev/null'
                         version-re:    '([0-9][0-9.]*)'
                         uninstall-cmd: 'rm -f "$HOME/.local/bin/cs"'
                         location:      '~/.local/bin/cs' } ] }
        liquibase:  { attrs: [ CLI FOSSish permissive freemium ] description: "Liquibase — database schema change management and migrations." requires: jdk  install: [ { via: sdkman } ] }
        detekt:     { attrs: [ CLI FOSS permissive ] description: "detekt — static code analysis for Kotlin." requires: jdk  install: [ { via: sdkman } ] }
        jreleaser:  { attrs: [ CLI FOSS permissive ] description: "JReleaser — release automation for JVM (and other) projects." requires: jdk  install: [ { via: sdkman } ] }
        visualvm:   { attrs: [ GUI app FOSS copyleft ] description: "VisualVM — a visual JVM profiler and monitor." requires: jdk  install: [ { via: sdkman } ] }
        jmc:        { attrs: [ GUI app FOSS permissive ] description: "JDK Mission Control — JVM profiling and diagnostics (JFR)." requires: jdk  install: [ { via: sdkman } ] }
        jmeter:     { attrs: [ GUI app FOSS permissive ] description: "Apache JMeter — load and performance testing." requires: jdk  install: [ { via: sdkman } ] }
        racket: { attrs: [ CLI GUI runtime toolchain FOSS permissive ] description: "Racket — a full-spectrum Scheme/Lisp language (ships DrRacket)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine) and not amzn"  repo-component: universe } ] }   // uniform `racket` (brew ships a macOS cask, not a formula)
        guile: { attrs: [ CLI runtime toolchain FOSS GNU copyleft ] description: "GNU Guile — the GNU Scheme interpreter."
            install: [ { via: native  when: "not amzn"   repo-component: universe  name: { apt: guile-3.0  dnf: guile30  default: guile } } ] }   // versioned name on debian/fedora
        // Haskell — the GHC compiler. Native (distro ghc) is the default; ghcup is the escape hatch
        // for a MODERN GHC when the distro's is too old to build a recent Hackage package (hlint).
        haskell: { attrs: [ CLI toolchain FOSS permissive ] description: "Haskell toolchain (GHC) — pure functional programming."
            install: [
                { via: native  when: "not amzn"   repo-component: universe  name: { default: ghc } }
                // ghcup — the official Haskell toolchain installer; pulls a modern GHC (+cabal) into
                // ~/.ghcup/bin. never-auto (distro ghc stays the default); a `haskell >= X` floor
                // (hlint) advises pinning here, or `pin set haskell haskell` picks it. `provides` is
                // the floor it guarantees. The cabal driver prepends ~/.ghcup/bin so a ghcup toolchain
                // is used for cabal builds when present. Non-interactive; any rc-write ghcup's
                // installer makes is caught + staged by the shell-writes guard.
                { via: script  when: "not amzn"  standing: never-auto  requires: curl
                  provides: { haskell: ">=9.4" }
                  install-cmd:   'export BOOTSTRAP_HASKELL_NONINTERACTIVE=1 BOOTSTRAP_HASKELL_INSTALL_NO_STACK=1 ; curl --proto "=https" --tlsv1.2 -fsSL https://get-ghcup.haskell.org | sh'
                  version-cmd:   '"$HOME/.ghcup/bin/ghc" --numeric-version 2>/dev/null'
                  // latest = the GHC ghcup RECOMMENDS (what it installs by default — deliberately
                  // behind the bleeding-edge release for ecosystem compatibility). Needs ghcup on
                  // disk, so it's blank until this method is installed (there's no clean offline
                  // source for ghcup's recommended version).
                  latest-cmd:    '"$HOME/.ghcup/bin/ghcup" list -t ghc -r 2>/dev/null | grep -m1 recommended | cut -d" " -f2'
                  uninstall-cmd: '"$HOME/.ghcup/bin/ghcup" nuke >/dev/null 2>&1 || rm -rf "$HOME/.ghcup"'
                  location:      '~/.ghcup' } ] }
        // Erlang/OTP + Elixir (elixir pulls erlang, but erlang is nameable on its own).
        erlang: { attrs: [ CLI runtime toolchain FOSS permissive ] description: "Erlang/OTP — battle-tested concurrent, fault-tolerant runtime." install: [ { via: native  when: "(debian or redhat or arch or opensuse) and not amzn"  repo-component: universe }  { via: native  when: "fedora_atomic" } ] }   // brew formula `erlang`
        elixir: { attrs: [ CLI toolchain runtime FOSS permissive ] description: "Elixir — functional, concurrent language on the Erlang VM." install: [ { via: native  when: "not amzn"   repo-component: universe } ] }
        // Nim compiler (nimble ships alongside).
        nim:   { attrs: [ toolchain FOSS permissive ] suggests: nim-dotfiles  description: "Nim — expressive, statically-typed compiled systems language."
            // packaged on arch/opensuse/alpine (alpine = musl build) and brew; NOT in the ubuntu/
            // debian/fedora repos, so those pull the official nim-lang.org prebuilt (glibc x64).
            install: [ { via: native  when: "arch or opensuse or alpine" }
                       { via: native  when: "fedora_atomic" }
                       { via: tarball  when: "debian or (redhat and not amzn)"  installDir: "$CONFIGSYS_APP_DIR/nim"  requires: glibc
                         version: { url: "https://nim-lang.org/install_unix.html"  regex: "nim-([0-9]+\.[0-9]+\.[0-9]+)-linux_x64" }
                         url: "https://nim-lang.org/download/nim-$VERSION-linux_x64.tar.xz" } ] }

        // R (statistics) and GNU Octave (numerical computing) — native everywhere.
        r:      { attrs: [ CLI runtime toolchain FOSS copyleft ] suggests: r-dotfiles  description: "R — language and environment for statistical computing." install: [ { via: native  repo-component: universe  name: { apt: r-base  dnf: R  pacman: r  zypper: R-base  apk: R  brew: r } } ] }
        octave: { attrs: [ CLI GUI app FOSS GNU copyleft ] suggests: octave-dotfiles  description: "GNU Octave — numerical computing, largely MATLAB-compatible." install: [ { via: native  when: "not amzn"   repo-component: universe }  { via: flatpak  hub: flathub  app: org.octave.Octave } ] }
        // Common Lisp: SBCL (the compiler) + Quicklisp (the library manager, bootstrapped by its
        // own lisp script and wired into the SBCL init file).
        sbcl: { attrs: [ CLI toolchain FOSS permissive ] description: "Steel Bank Common Lisp — a fast Common Lisp compiler." install: [ { via: native  when: "not amzn"   repo-component: universe } ] }
        quicklisp: { attrs: [ CLI FOSS permissive ] description: "Quicklisp — a library manager for Common Lisp."
            requires: sbcl
            install: [ { via: script
                         install-cmd:   'curl -fsSL https://beta.quicklisp.org/quicklisp.lisp -o /tmp/quicklisp.lisp && yes "" | sbcl --non-interactive --load /tmp/quicklisp.lisp --eval "(quicklisp-quickstart:install)" --eval "(ql:add-to-init-file)" --eval "(quit)" && rm -f /tmp/quicklisp.lisp'
                         version-cmd:   'test -d "$HOME/quicklisp" && echo present'
                         uninstall-cmd: 'rm -rf "$HOME/quicklisp"'
                         location:      '~/quicklisp' } ]
        }

        // --- ecosystem module tools + a sample module each (validated in a podman run) ---
        // opam (OCaml package manager). NOTE: `opam install` needs a one-time `opam init` on a
        // fresh system — the opam driver is validated against opam 2.1.5's CLI, but first use on
        // an uninitialized machine may need `opam init` (tracked; see docs/expansion-plan.md).
        opam:  { attrs: [ CLI FOSS copyleft ] suggests: opam-dotfiles  description: "opam — the OCaml package manager." install: [ { via: native  when: "not amzn"  repo-component: universe } ] }
        dune:  { attrs: [ CLI FOSS permissive ] description: "Dune — the build system for OCaml projects." install: [ { via: opam  name: dune } ] }
        // luarocks (Lua package manager; the native package pulls lua) + a sample rock
        // (dkjson is pure-Lua with no C deps, so it installs without lua headers).
        luarocks: { attrs: [ CLI FOSS permissive ] suggests: luarocks-dotfiles  description: "LuaRocks — package manager for Lua modules." install: [ { via: native  when: "not amzn"  repo-component: universe  name: { zypper: lua54-luarocks  default: luarocks } } ] }
        dkjson:   { attrs: [ lib FOSS permissive ] description: "dkjson — a pure-Lua JSON encode/decode library." install: [ { via: luarocks  name: dkjson } ] }
        // cabal (Haskell build tool; needs ghc to build) + a sample executable.
        cabal: { attrs: [ CLI FOSS permissive ] suggests: cabal-dotfiles  description: "Cabal — Haskell's build system and package manager." requires: haskell
                 install: [ { via: native  when: "not amzn"   repo-component: universe  name: { apk: cabal  default: cabal-install } } ] }
        // hlint's recent releases need a modern GHC to build from Hackage; the distro ghc is often
        // too old. The `haskell >= 9.4` floor advises pinning haskell -> ghcup (auto under
        // `auto-tighten`), and the cabal driver then builds with the ghcup toolchain.
        hlint: { attrs: [ CLI FOSS permissive ] description: "HLint — suggests improvements to Haskell code." requires: [ { haskell: ">=9.4" } ]
                 install: [ { via: cabal  name: hlint  version: { hackage: hlint } } ] }

        // Zig — native on Arch/Homebrew; elsewhere the upstream tarball. zig's Linux build is
        // statically linked (runs on glibc AND musl), so no glibc requirement. Its prebuilt
        // binaries live on ziglang.org (not github assets), so github supplies only the VERSION
        // and a url template builds the download.
        zig: { attrs: [ CLI toolchain FOSS permissive ] suggests: zig-dotfiles  description: "Zig — simple, fast systems language and C/C++ toolchain."
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }             // brew formula `zig`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/zig"
                  version: { github: ziglang/zig  strip-v: true }
                  // zig 0.14+ swapped the tarball name to zig-<arch>-linux-<ver> (was zig-linux-<arch>-<ver>)
                  url: "https://ziglang.org/download/$VERSION/zig-$ARCH-linux-$VERSION.tar.xz" }
            ]
        }
        // Julia — official binaries live on the julialang S3 (not github releases), so a pinned
        // version + the S3 tarball URL (glibc build; path carries both the X.Y dir and full
        // version, so bump both on update). Native on Arch/Homebrew where packaged.
        julia: { attrs: [ CLI toolchain runtime FOSS permissive ] suggests: julia-dotfiles  description: "Julia — high-performance language for scientific computing."
            install: [
                { via: native  when: "arch" }                      // pacman: julia
                { via: native  when: "fedora_atomic" }             // brew formula `julia`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/julia"  requires: glibc  version: { static: 1.12.6 }
                  url: "https://julialang-s3.julialang.org/bin/linux/x64/1.12/julia-1.12.6-linux-x86_64.tar.gz" } ]
        }
        // Odin — upstream github release tarball (glibc-linked, so it declines on musl).
        odin: { attrs: [ CLI toolchain FOSS permissive ] suggests: odin-dotfiles  description: "Odin — data-oriented systems programming language."
            install: [
                { via: native  when: "fedora_atomic" }             // brew formula `odin`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/odin"  requires: glibc
                  version: { github: odin-lang/Odin  asset: "odin-linux-amd64-*.tar.gz" }
                  url: "https://github.com/odin-lang/Odin/releases/download/$VERSION/odin-linux-amd64-$VERSION.tar.gz" }
            ]
        }

        // --- web browsers ---
        // Firefox is native (in every base repo; openSUSE calls it MozillaFirefox) with the Flathub
        // Flatpak (org.mozilla.firefox) offered as a uniform alternative everywhere — native stays
        // the default where the distro packages it, flatpak wins on atomic (brew has no firefox).
        // Chrome/Brave/Opera/Vivaldi/Edge aren't in any base distro repo, so each wires in its
        // vendor's own apt + dnf repo (native, the default there) with the Flathub Flatpak kept as a
        // uniform candidate everywhere (and the default on openSUSE/atomic, which have no vendor repo
        // set up here). Arch: AUR (google-chrome/brave-bin/opera/microsoft-edge-stable-bin) except
        // vivaldi, which is in the official `extra` repo. Flathub Chrome/Edge are community-maintained.
        firefox: { attrs: [ GUI web app FOSS copyleft tele ] description: "Mozilla Firefox — the open-source web browser." install: [ { via: flatpak  hub: flathub  app: org.mozilla.firefox }
                              { via: native  when: "not fedora_atomic"  repo-component: universe  name: { zypper: MozillaFirefox  default: firefox } }
                              { via: snap  name: firefox } ] }
        chromium: { attrs: [ GUI app FOSS permissive ] description: "Chromium — the open-source browser upstream of Chrome." install: [ { via: native  when: "((debian or redhat or arch or opensuse) and not ubuntu) and not amzn"  name: { default: chromium } }  { via: snap  name: chromium }  { via: flatpak  hub: flathub  app: org.chromium.Chromium } ] }   // Ubuntu ships chromium ONLY as the (Canonical-official) snap — its apt `chromium-browser` is a snap shim; ubuntu excluded from native so the snap is the sole real method there. Flathub flatpak offered everywhere (+ the only method on atomic).
        chrome:  { attrs: [ GUI app proprietary freeware tele patent ] description: "Google Chrome — Google's web browser."
            install: [
                { via: native  when: "debian"  name: google-chrome-stable   // Google's official apt repo
                  pubkey-url: "https://dl.google.com/linux/linux_signing_key.pub"
                  pubkey-path: /usr/share/keyrings/google-chrome.asc
                  source-line: "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.asc] https://dl.google.com/linux/chrome/deb/ stable main"
                  source-path: /etc/apt/sources.list.d/google-chrome.list }
                { via: native  when: "redhat"  name: google-chrome-stable   // Google's official dnf repo
                  pubkey-url: "https://dl.google.com/linux/linux_signing_key.pub"
                  repo-id: google-chrome  repo-name: "Google Chrome"
                  repo-url: "https://dl.google.com/linux/chrome/rpm/stable/x86_64" }
                { via: aur  when: "arch"  name: google-chrome }             // AUR
                { via: flatpak  hub: flathub  app: com.google.Chrome } ]    // Flathub — default on openSUSE/atomic, a candidate everywhere
        }
        brave:   { attrs: [ GUI app FOSS permissive tele ] description: "Brave — a privacy-focused Chromium browser with built-in ad-blocking."
            install: [
                { via: native  when: "debian"  name: brave-browser   // Brave's official apt repo
                  pubkey-url: "https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg"
                  pubkey-path: /usr/share/keyrings/brave-browser-archive-keyring.gpg
                  source-line: "deb [arch=amd64 signed-by=/usr/share/keyrings/brave-browser-archive-keyring.gpg] https://brave-browser-apt-release.s3.brave.com/ stable main"
                  source-path: /etc/apt/sources.list.d/brave-browser-release.list }
                { via: native  when: "redhat"  name: brave-browser   // Brave's official dnf repo
                  pubkey-url: "https://brave-browser-rpm-release.s3.brave.com/brave-core.asc"
                  repo-id: brave-browser  repo-name: "Brave Browser"
                  repo-url: "https://brave-browser-rpm-release.s3.brave.com/x86_64/" }
                { via: aur  when: "arch"  name: brave-bin }
                { via: flatpak  hub: flathub  app: com.brave.Browser } ]
        }
        opera:   { attrs: [ GUI app proprietary freeware tele ads ] description: "Opera — a feature-rich Chromium browser."
            install: [
                { via: native  when: "debian"  name: opera-stable   // Opera's official apt repo
                  pubkey-url: "https://deb.opera.com/archive.key"
                  pubkey-path: /usr/share/keyrings/opera.asc
                  source-line: "deb [signed-by=/usr/share/keyrings/opera.asc] https://deb.opera.com/opera-stable/ stable non-free"
                  source-path: /etc/apt/sources.list.d/opera-stable.list }
                { via: native  when: "redhat"  name: opera-stable   // Opera's official dnf repo
                  pubkey-url: "https://rpm.opera.com/rpmrepo.key"
                  repo-id: opera  repo-name: "Opera"
                  repo-url: "https://rpm.opera.com/rpm" }
                { via: aur  when: "arch"  name: opera }
                { via: flatpak  hub: flathub  app: com.opera.Opera } ]
        }
        vivaldi: { attrs: [ GUI app proprietary freeware tele ] description: "Vivaldi — a highly customizable Chromium browser."
            install: [
                { via: native  when: "debian"  name: vivaldi-stable   // Vivaldi's official apt repo
                  pubkey-url: "https://repo.vivaldi.com/archive/linux_signing_key.pub"
                  pubkey-path: /usr/share/keyrings/vivaldi-browser.asc
                  source-line: "deb [signed-by=/usr/share/keyrings/vivaldi-browser.asc] https://repo.vivaldi.com/archive/deb/ stable main"
                  source-path: /etc/apt/sources.list.d/vivaldi.list }
                { via: native  when: "redhat"  name: vivaldi-stable   // Vivaldi's official dnf repo
                  pubkey-url: "https://repo.vivaldi.com/archive/linux_signing_key.pub"
                  repo-id: vivaldi  repo-name: "Vivaldi"
                  repo-url: "https://repo.vivaldi.com/archive/rpm/x86_64" }
                { via: native  when: "arch"  name: vivaldi }   // in Arch's official extra repo
                { via: flatpak  hub: flathub  app: com.vivaldi.Vivaldi } ]
        }
        edge:    { attrs: [ GUI app proprietary freeware tele ] description: "Microsoft Edge — a Chromium-based browser."
            install: [
                { via: native  when: "debian"  name: microsoft-edge-stable   // Microsoft's official apt repo
                  pubkey-url: "https://packages.microsoft.com/keys/microsoft.asc"
                  pubkey-path: /usr/share/keyrings/microsoft-edge.asc
                  source-line: "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft-edge.asc] https://packages.microsoft.com/repos/edge stable main"
                  source-path: /etc/apt/sources.list.d/microsoft-edge.list }
                { via: native  when: "redhat"  name: microsoft-edge-stable   // Microsoft's official dnf repo
                  pubkey-url: "https://packages.microsoft.com/keys/microsoft.asc"
                  repo-id: microsoft-edge  repo-name: "Microsoft Edge"
                  repo-url: "https://packages.microsoft.com/yumrepos/edge" }
                { via: aur  when: "arch"  name: microsoft-edge-stable-bin }
                { via: flatpak  hub: flathub  app: com.microsoft.Edge } ]
        }
        // Tor Browser via torbrowser-launcher (the official downloader/verifier). Native where
        // packaged (Debian/Ubuntu universe, Fedora, openSUSE), AUR `tor-browser-bin` on Arch, and
        // Flathub everywhere (self-contained — the only method on atomic/musl).
        tor-browser: { attrs: [ GUI app FOSS permissive ]
            description: "Tor Browser — anonymized browsing over the Tor network."
            install: [
                { via: native  when: "debian or fedora or opensuse"  repo-component: universe  name: torbrowser-launcher }
                { via: aur  when: "arch"  name: tor-browser-bin }
                { via: flatpak  hub: flathub  app: org.torproject.torbrowser-launcher } ]
        }
        // Password managers (Bitwarden). bitwarden = the desktop app (official pacman/zypper pkg;
        // flatpak everywhere incl. atomic; official snap on ubuntu — no apt/dnf repo pkg exists).
        bitwarden: { attrs: [ GUI app electron FOSS copyleft account cloud freemium ] description: "Bitwarden — the desktop password-manager app."
                     install: [ { via: native  when: "arch or opensuse" }
                                { via: flatpak  hub: flathub  app: com.bitwarden.desktop }
                                { via: snap  when: "ubuntu"  name: bitwarden } ] }
        // vaultwarden = a lightweight self-hosted Bitwarden-compatible SERVER. Officially packaged
        // only on arch/fedora/alpine; elsewhere it's run as a container (no core install method) so
        // it declines honestly there.
        vaultwarden: { attrs: [ daemon web FOSS copyleft ] description: "Vaultwarden — a lightweight self-hosted Bitwarden-compatible server (Rust)."
                       install: [ { via: native  when: "arch or fedora or alpine" } ] }

        // ===================== network + web-dev tooling =====================
        // iproute2 — `ip`/`ss`/`tc`. Native everywhere; EL's dnf calls the package `iproute`.
        iproute2:   { attrs: [ CLI FOSS copyleft ] description: "iproute2 — modern Linux networking tools (`ip`, `ss`)." install: [ { via: native  name: { dnf: iproute  default: iproute2 } } ] }
        bridge-utils: { attrs: [ CLI FOSS GNU copyleft legacy ] description: "bridge-utils (`brctl`) — legacy Ethernet-bridge admin (superseded by iproute2's `ip`)." install: [ { via: native  when: "not fedora_atomic" } ] }   // Linux-only; not on brew
        dosfstools: { attrs: [ CLI FOSS GNU copyleft ] description: "dosfstools — create and check FAT filesystems (`mkfs.fat`, `fsck.fat`)." install: [ { via: native  when: "not fedora_atomic" } ] }   // Linux-only; not on brew
        // Capture & probe — native CLI staples. Name maps only where distros diverge; the
        // rest carry the same package name everywhere.
        wireshark:  { attrs: [ GUI app FOSS copyleft ] description: "Wireshark — a GUI network protocol analyzer." install: [ { via: native  when: "not fedora_atomic"  name: { pacman: wireshark-qt }
                                   debconf: "wireshark-common wireshark-common/install-setuid boolean true" }
                                 { via: flatpak  hub: flathub  app: org.wireshark.Wireshark } ] }   // GUI analyzer; Arch splits the GUI into wireshark-qt. debconf preseed enables non-root capture on Debian (apt reads it; dnf/pacman ignore it & set dumpcap's caps in-package). Pair with wireshark-group. Flatpak offered everywhere (analyzing .pcap files is zero-config; LIVE capture needs its bundled setuid dumpcap + wireshark-group, like native) — and it's the ONLY GUI on atomic (Linux brew has no wireshark cask, just the CLI formula).
        wireshark-group: { description: "Add your user to the wireshark group (non-root capture)."   // opt-in: non-root capture. usermod -aG wireshark $YOU; needs the group the package creates (hence requires). On Fedora/Arch the package pre-sets dumpcap's file caps, so group membership alone enables capture. On Debian/Ubuntu dumpcap is NOT setcap'd by a non-interactive install — group membership is necessary but not sufficient there (see the wireshark story). Mirrors docker-group.
            requires: wireshark
            install: [ { via: group  name: wireshark } ]
        }
        tshark:     { attrs: [ CLI FOSS copyleft ] description: "TShark — Wireshark's command-line capture/analysis." install: [ { via: native  name: { dnf: wireshark-cli  pacman: wireshark-cli  zypper: wireshark } } ] }   // CLI capture; ships as wireshark-cli on dnf/pacman, tshark on apt
        tcpdump:    { attrs: [ CLI FOSS permissive ] description: "tcpdump — command-line packet capture and analysis." install: [ { via: native } ] }
        nmap:       { attrs: [ CLI FOSS copyleft ] description: "Nmap — a network scanner and security probe." install: [ { via: native } ] }
        mtr:        { attrs: [ CLI TUI FOSS copyleft ] description: "Live network diagnostic — ping + traceroute in one display."
                      install: [ { via: native } ] }
        traceroute: { attrs: [ CLI FOSS copyleft ] description: "Trace the network path to a host, hop by hop." install: [ { via: native  when: "not fedora_atomic" } ] }   // no `traceroute` brew formula (Homebrew has mtr/tcptraceroute instead); macOS ships it in base — so decline on brew-native atomic rather than fail
        iperf3:     { attrs: [ CLI FOSS permissive ] description: "iperf3 — measure network throughput between two hosts." install: [ { via: native  name: { zypper: iperf  default: iperf3 } } ] }
        socat:      { attrs: [ CLI FOSS copyleft ] description: "Multipurpose socket relay — bidirectional data between two endpoints." install: [ { via: native } ] }
        ethtool:    { attrs: [ CLI FOSS copyleft ] description: "ethtool — query and control NIC driver/hardware settings." install: [ { via: native } ] }
        whois:      { attrs: [ CLI FOSS copyleft ] description: "Domain/IP registration lookup (`whois`)." install: [ { via: native } ] }
        netcat:     { attrs: [ CLI FOSS ] description: "TCP/UDP swiss-army knife (`nc`) — connect, listen, pipe raw sockets." install: [ { via: native  name: { dnf: nmap-ncat  pacman: openbsd-netcat  default: netcat-openbsd } } ] }   // the BSD nc; Fedora ships it as nmap-ncat, Arch as openbsd-netcat
        dig:        { attrs: [ CLI FOSS permissive ] description: "DNS lookup tool (`dig`) — query records and troubleshoot resolution." install: [ { via: native  name: { apt: dnsutils  dnf: bind-utils  pacman: bind  apk: bind-tools  zypper: bind-utils  brew: bind  default: bind-utils } } ] }   // dig/nslookup; apt `dnsutils` is the transitional metapkg (resolves on old + new), Arch/Homebrew ship the tools in `bind`

        // Traffic monitors — live per-interface/-process bandwidth. In EPEL on EL, base repos
        // elsewhere (the same two-binding shape as btop).
        iftop:   { attrs: [ TUI FOSS copyleft ] description: "iftop — a live per-connection bandwidth monitor." install: [ { via: native  when: "rhel"  requires: epel } { via: native } ] }
        nethogs: { attrs: [ TUI FOSS copyleft ] description: "NetHogs — a per-process network bandwidth monitor." install: [ { via: native  when: "rhel"  requires: epel } { via: native } ] }
        nload:   { attrs: [ TUI FOSS copyleft ] description: "nload — a console real-time network traffic monitor." install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"  } ] }
        // gping: ping with a live graph (Rust). Native where packaged (Arch, Alpine, Homebrew, and
        // Debian>=13/Ubuntu>=23.10); Fedora is COPR-only and older Debian/Ubuntu/openSUSE/EL lack
        // it, so cargo builds it there.
        gping:   { attrs: [ CLI TUI FOSS permissive ] description: "Ping, but with a live graph (`gping`)."
                   install: [ { via: native  when: "arch or alpine or fedora_atomic or (ubuntu >= 23.10) or (debian >= 13)" }
                              { via: cargo  name: gping } ] }
        vnstat:  { attrs: [ CLI daemon FOSS copyleft ] description: "vnStat — a network traffic logger and stats tool." install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"  } ] }
        bmon:    { attrs: [ TUI FOSS permissive ] description: "bmon — a bandwidth monitor and rate estimator (per-interface)." install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "debian or fedora or arch or opensuse or alpine or amzn" } ] }
        wavemon: { attrs: [ TUI FOSS copyleft ] description: "wavemon — an ncurses monitor for wireless network devices." install: [ { via: native  when: "debian or fedora or arch or opensuse or alpine"  repo-component: universe } ] }   // Ubuntu universe; not in EPEL/Amazon/atomic
        // Rust hardware/audio TUIs — native only where packaged (arch/alpine/openSUSE, +debian/fedora
        // for wiremix); cargo builds them everywhere else.
        impala:  { attrs: [ TUI FOSS copyleft ] description: "impala — a TUI to manage Wi‑Fi networks (uses the `iwd` daemon)."
                   install: [ { via: native  when: "arch or alpine or opensuse" }
                              { via: cargo   when: "not (arch or alpine or opensuse)"  name: impala } ] }
        bluetui: { attrs: [ TUI app FOSS permissive ] description: "bluetui — a TUI to manage Bluetooth devices (uses BlueZ)."
                   install: [ { via: native  when: "arch or opensuse" }
                              { via: cargo   when: "not (arch or opensuse)"  name: bluetui } ] }   // not in Alpine's repos -> cargo there (impala IS in Alpine, bluetui isn't)
        wiremix: { attrs: [ TUI app FOSS permissive ] description: "wiremix — a TUI audio mixer for PipeWire."
                   install: [ { via: native  when: "fedora or arch or opensuse" }
                              // cargo builds libspa-sys from source -> needs the PipeWire dev headers + pkg-config
                              // (absent on immutable atomic, so decline there rather than source-build on it)
                              { via: cargo   when: "not (fedora or arch or opensuse or fedora_atomic)"  name: wiremix  requires: [ cargo, pipewire-dev, pkg-config ] } ] }   // Debian/Alpine don't carry it in-repo -> cargo there
        // dnspeep: watch the DNS queries your machine makes. Not distro-packaged nor on crates.io —
        // upstream's glibc release tarball is a single `dnspeep` binary (dnspeep-dotfiles PATHs it);
        // declines on musl Alpine. Runs as root (libpcap).
        dnspeep: { attrs: [ CLI FOSS permissive ] suggests: dnspeep-dotfiles  description: "dnspeep — spy on the DNS queries your computer makes (needs root)."
            install: [ { via: tarball  when: "not alpine"  installDir: "$CONFIGSYS_APP_DIR/dnspeep"  requires: glibc
                         version: { github: jvns/dnspeep  strip-v: true  asset: "dnspeep-linux.tar.gz" } } ] }   // asset lives INSIDE version: (the tarball driver reads version.asset)
        dnspeep-dotfiles: { description: "dnspeep shell setup, linked into place." install: [ { via: dotfiles  requires: bash-dotfiles  glue: dnspeep } ] }

        // Web/HTTP dev — httpie + jq native (httpie via EPEL on EL); yq/mitmproxy isolated via
        // pipx; xh/websocat are Rust crates.
        httpie:    { attrs: [ CLI FOSS permissive ] suggests: httpie-dotfiles  description: "Human-friendly HTTP client (`http`) — a nicer curl for APIs." install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"  } ] }   // the `http`/`https` CLI
        jq:        { attrs: [ CLI FOSS permissive ] suggests: jq-dotfiles  description: "Command-line JSON processor — query and transform JSON."
                     install: [ { via: native }
                                { via: tarball  archive: none  binary: jq  installDir: "$CONFIGSYS_APP_DIR/jq"  version: { github: jqlang/jq  asset: "jq-linux-amd64" } } ] }   // upstream ships a raw static binary
        yq:        { attrs: [ CLI FOSS permissive ] description: "YAML/JSON/XML processor — jq, but for YAML." requires: jq                                                                    // the jq-family yq (yq/xq/tomlq) — shells out to jq at runtime; NOT mikefarah's Go yq
                     install: [ { via: pipx  name: yq  version: { pypi: yq } } ] }
        // mitmproxy 12+ needs Python >=3.12, but a pipx venv built on an OLD system python (Pop
        // 22.04 / Debian 11-12 ship 3.10-3.11) silently caps upgrades at the last compatible release
        // (11.x). On debian, build the venv with deadsnakes' python3.13 — the FULL path /usr/bin/
        // python3.13 (not the bare name, which PATH may resolve to a uv/pyenv-managed build that
        // breaks pipx venv creation). The other distros (Fedora/Arch/atomic/…) already ship 3.12+, so
        // plain pipx uses the system python (and python3.13 doesn't even resolve on atomic — pyenv
        // needs build deps absent there).
        mitmproxy: { attrs: [ CLI TUI FOSS permissive ] description: "Interactive HTTPS proxy — intercept, inspect, and replay traffic." install: [ { via: pipx  when: "debian"  name: mitmproxy  standing: 1  python: "/usr/bin/python3.13"  requires: python3.13  version: { pypi: mitmproxy } }  { via: pipx  when: "not debian"  name: mitmproxy  standing: 1  version: { pypi: mitmproxy } }  { via: flatpak  hub: flathub  app: org.mitmproxy.mitmproxy } ] }   // pipx (official PyPI) stays the default; the Flathub build is an offered option
        xh:        { attrs: [ CLI FOSS permissive ] suggests: xh-dotfiles  description: "Fast HTTPie-compatible HTTP client (`xh`), written in Rust." install: [ { via: cargo  name: xh  version: { crates: xh } }  { via: tarball  installDir: "$CONFIGSYS_APP_DIR/xh"  version: { github: ducaale/xh  asset: "xh-*-x86_64-unknown-linux-musl.tar.gz" } } ] }                // prebuilt musl binary is the default over building from source
        websocat:  { attrs: [ CLI FOSS permissive ] suggests: websocat-dotfiles  description: "netcat for WebSockets — connect, pipe, and script ws:// endpoints." install: [ { via: cargo  name: websocat  version: { crates: websocat } }  { via: tarball  archive: none  binary: websocat  installDir: "$CONFIGSYS_APP_DIR/websocat"  version: { github: vi/websocat  asset: "websocat.x86_64-unknown-linux-musl" } } ] }   // prebuilt musl binary default

        // GUI API clients — Flatpak from Flathub, like chrome (all community-maintained, current).
        postman:  { attrs: [ GUI app electron proprietary account cloud freemium ] description: "Postman — a GUI for building and testing APIs." install: [ { via: flatpak  hub: flathub  app: com.getpostman.Postman }  { via: snap  name: postman } ] }
        insomnia: { attrs: [ GUI app FOSS permissive electron account ] description: "Insomnia — an open-source API client and design tool." install: [ { via: flatpak  hub: flathub  app: rest.insomnia.Insomnia }  { via: native-pkg-file  when: "debian or redhat"  version: { github: Kong/insomnia  tag-re: "([0-9][0-9.]*)" }  asset: { deb: { x86_64: "Insomnia.Core-*.deb" }  rpm: { x86_64: "Insomnia.Core-*.rpm" } } } ] }   // monorepo `core@` tags: the release scan finds the Core release; tag-re -> clean version
        bruno:    { attrs: [ GUI app electron FOSS permissive freemium ] description: "Bruno — a fast, git-friendly, offline-first API client." install: [ { via: flatpak  hub: flathub  app: com.usebruno.Bruno }  { via: native-pkg-file  when: "debian or redhat"  version: { github: usebruno/bruno  strip-v: true }  asset: { deb: { x86_64: "bruno_*_amd64_linux.deb" }  rpm: { x86_64: "bruno_*_x86_64_linux.rpm" } } } ] }   // upstream .deb (amd64)/.rpm (x86_64 token differs)
        tree-sitter-cli: { attrs: [ CLI FOSS permissive ] suggests: tree-sitter-cli-dotfiles  description: "tree-sitter CLI — build and test tree-sitter grammars."
            install: [ { via: cargo  name: tree-sitter-cli  standing: 1  version: { crates: tree-sitter-cli } }   // kept the default (some want it built from source, without the prebuilt-binary apparatus)
                       { via: tarball  archive: gz  binary: tree-sitter  installDir: "$CONFIGSYS_APP_DIR/tree-sitter"  version: { github: tree-sitter/tree-sitter  asset: "tree-sitter-linux-x64.gz" } } ]   // upstream ships a plain-gzipped single binary
        }
        mononoki-nerd: { attrs: [ font FOSS permissive ] description: "Mononoki Nerd Font — a clean monospace coding font with icons."
            install: [ { via: font  name: Mononoki          // -> requires fontconfig + unzip
                         version: { github: ryanoasis/nerd-fonts  asset: "Mononoki.zip" }
                         url: "https://github.com/ryanoasis/nerd-fonts/releases/download/$VERSION/Mononoki.zip" } ]
        }

        // when:-varying: native on Pop (the NVIDIA rig), flatpak elsewhere
        steam: { attrs: [ GUI app proprietary account cloud online ] description: "Steam — Valve's game store and launcher."
            install: [
                { via: native   when: "pop_os!"  name: "steam:i386"  foreign-arch: i386 }
                { via: flatpak  hub: flathub  app: com.valvesoftware.Steam }
            ]
        }

        // Wine — Windows compatibility layer. Distro-native everywhere; debian/ubuntu need i386
        // multiarch (handled by foreign-arch), Arch needs the `multilib` repo enabled (user does that
        // once). WineHQ's own repo ships newer builds — not modeled (per-codename); the distro Wine
        // is a fine default. winetricks fetches runtime DLLs/fonts into a prefix.
        wine: { attrs: [ GUI runtime FOSS copyleft ] description: "Wine — run Windows applications on Linux."
            install: [ { via: native  when: "debian"  foreign-arch: i386 }
                       { via: native  when: "rhel"  requires: epel }   // wine ships in EPEL
                       { via: native  when: "fedora or arch or alpine or opensuse" } ] }
        winetricks: { attrs: [ CLI FOSS copyleft ] description: "winetricks — fetch runtime DLLs/fonts and tweak Wine prefixes." requires: wine
            install: [ { via: native  when: "rhel"  requires: epel }   // EPEL8+
                       { via: native  when: "debian or fedora or arch or opensuse"  repo-component: universe } ] }   // not in Alpine's repos
        // Proton tooling. Proton itself is SELF-CONTAINED (bundles its own Wine + DXVK/VKD3D + a Steam
        // runtime) and is installed BY Steam (Steam Play) — not a package, and independent of the
        // system `wine` above. What you install by hand is the community tooling: ProtonUp-Qt (the GUI
        // that fetches GE-Proton and other custom compat tools into ~/.steam/…/compatibilitytools.d)
        // and protontricks (winetricks for Proton game prefixes). No `requires: wine` — both are for
        // Steam's Proton stack, which carries its own Wine.
        protonup-qt: { attrs: [ GUI app FOSS copyleft ] description: "ProtonUp-Qt — a GUI to install & manage GE-Proton and other Steam/Wine compatibility tools."
            install: [ { via: flatpak  hub: flathub  app: net.davidotek.pupgui2 }
                       { via: aur  when: "arch"  name: protonup-qt } ] }
        protontricks: { attrs: [ CLI GUI app FOSS copyleft ] description: "protontricks — winetricks for Steam Proton game prefixes."
            install: [ { via: flatpak  hub: flathub  app: com.github.Matoking.protontricks }
                       { via: aur  when: "arch"  name: protontricks }
                       { via: pipx  name: protontricks  standing: never-auto } ] }

        // --- apps: native everywhere. A clean-config tool manages its ~/.config as a
        // dir-dotfile (content in dotfiles/<name>/ symlinked to $XDG_CONFIG_HOME/<name>, like
        // neovim). The dotfiles are `suggests:` (soft) so the app installs before dotfiles/<name>/
        // has your content. Apps with a FAT ~/.config (profile + cache/state) only `suggests:`
        // their dotfiles for now — pending a dir-vs-specific-files call.
        podman: { attrs: [ CLI FOSS permissive ] description: "Podman — daemonless, rootless container engine (docker-compatible)."
            suggests: podman-dotfiles
            install: [ { via: native  when: "not amzn"   repo-component: universe } ]   // apt universe / dnf (EL AppStream) / pacman
        }
        podman-dotfiles: { description: "Podman config, linked into place."   // ~/.config/containers — shared by podman / buildah / skopeo
            install: [ { via: dotfiles  config: { src: containers  dst: $XDG_CONFIG_HOME/containers } } ]
        }

        libreoffice: { attrs: [ GUI app FOSS permissive copyleft ] description: "LibreOffice — the open-source office suite."   // fat ~/.config/libreoffice (profile + cache) — dotfiles pending
            suggests: libreoffice-dotfiles
            install: [ { via: flatpak  hub: flathub  app: org.libreoffice.LibreOffice }   // uniform option everywhere; the only method on atomic (brew's libreoffice is a mac-only cask)
                       // install the `libreoffice` meta but DETECT via libreoffice-core: Debian/Ubuntu/
                       // Pop commonly ship the suite as the parts (-core/-calc/…) WITHOUT the meta, so
                       // probing the meta falsely reports "missing". libreoffice-core is present
                       // whenever any LibreOffice is (only apt reads installed-name; pacman installs
                       // libreoffice-fresh, which is itself what's present).
                       { via: native  when: "(not fedora_atomic) and not amzn"  repo-component: universe
                         name: { pacman: libreoffice-fresh }  installed-name: libreoffice-core } ]
        }

        // kicad: native where it's packaged, Flathub (org.kicad.KiCad) where it isn't. It's in
        // NO EL9 repo (base/EPEL/CRB/RPM Fusion, verified on rockylinux:9), so native is guarded
        // `not rhel` and the flatpak binding catches EL (and is a per-machine `pin` away anywhere
        // the distro package is too old). A from-source build is the configsys-kicad plugin's
        // `kicad-build` override, the way blender-build overrides native blender.
        kicad: { attrs: [ GUI app FOSS copyleft ] description: "KiCad — electronics design (schematics and PCB layout)."   // fat-ish config — dotfiles pending
            suggests: kicad-dotfiles
            install: [ { via: flatpak  when: fedora_atomic  hub: flathub  app: org.kicad.KiCad }   // atomic: more specific than `not rhel` so flatpak wins over brew (mac-only cask)
                       { via: native   when: "(not rhel) and not amzn"  repo-component: universe }
                       { via: flatpak  hub: flathub  app: org.kicad.KiCad } ]
        }

        // blender: the easy default is the native package (the editor). A from-source build
        // (to get a `bpy` module matching your editor) is a personal override that lives in a
        // user layer, the way a Pop-only native Steam does. Fat versioned config
        // (~/.config/blender/<ver>) — dotfiles deferred. On EL it's in EPEL; base repos elsewhere.
        blender: { attrs: [ GUI app FOSS copyleft ] description: "Blender — 3D modeling, animation, and rendering suite."
            suggests: blender-dotfiles
            install: [ { via: flatpak  hub: flathub  app: org.blender.Blender }   // uniform option everywhere; the only method on atomic (brew's blender is a mac-only cask)
                       { via: native  when: "rhel"  requires: epel }
                       { via: native  when: "(not fedora_atomic) and not amzn"  repo-component: universe }
                       { via: snap  name: blender  classic: true } ]   // Blender-official snap (candidate-only)
        }

        // GPU compute toolchains + NVIDIA infra. General-purpose — used well beyond Blender/OpenCV —
        // so they live in base. NVIDIA CUDA is a VERSION-SCOPED capability: cuda-toolkit-11 and -12
        // each `provides: { cuda-toolkit: N }`, so a consumer can select by version —
        // `requires: { cuda-toolkit: ">=12" }` (cudnn-9) picks 12, `"<12"` (cudnn-8) picks 11 (the
        // constraint ENABLES the opt-in -11). A version-agnostic consumer (`requires: cuda-toolkit`,
        // e.g. a source-build Blender's Cycles backends) takes the DEFAULT — cuda-toolkit-12; -11 is
        // `opt-in` so it never becomes the generic default, but it's still adopted when it's the one
        // actually installed (the detection tier) or named/constrained. The -12 toolkit + versioned
        // cuDNNs ride NVIDIA's network repo (cuda-repo) — real GPU work wants the vendor repo, not the
        // lagging distro one; -11 stays the low-friction distro package for the older CUDA-11 line.
        // Convenience aliases to the current default line (CUDA 12 / cuDNN 9) so `cuda`/`cudnn`
        // just work installed by name or in a profile. Pure `via: parts` aggregators (no unit of
        // their own); they deliberately do NOT provide the cuda-toolkit capability — dependants
        // (blender, opencv, …) keep requiring the VERSIONED cuda-toolkit/cuDNN capability directly,
        // untouched. cudnn already pulls cuda-toolkit-12 via its versioned requires. Bump the part
        // when the default line moves.
        cuda:  { attrs: [ SDK toolchain proprietary freeware ] description: "NVIDIA CUDA Toolkit — alias for the current default line (CUDA 12)."  install: [ { via: parts  parts: [ cuda-toolkit-12 ] } ] }
        cudnn: { attrs: [ lib proprietary freeware ] description: "NVIDIA cuDNN — alias for the current default line (cuDNN 9)."          install: [ { via: parts  parts: [ cudnn-9 ] } ] }
        cuda-toolkit-11: { attrs: [ SDK toolchain proprietary freeware ] description: "NVIDIA CUDA Toolkit 11 — GPU compute compiler and libraries (distro package)."
            standing: never-auto  provides: { cuda-toolkit: 11 }
            install: [ { via: native  when: "debian or redhat or arch"  name: { apt: nvidia-cuda-toolkit  dnf: cuda  pacman: cuda } } ]   // only these package a distro CUDA; no CUDA in Alpine/openSUSE base
        }
        cuda-toolkit-12: { attrs: [ SDK toolchain proprietary freeware ] description: "NVIDIA CUDA Toolkit 12 (from NVIDIA's CUDA repo)."
            provides: { cuda-toolkit: 12 }
            install: [
                { via: native  when: "arch"  name: cuda }              // Arch: rolling latest (12.x)
                { via: script  when: "debian"  requires: cuda-repo
                  install-cmd:   'sudo apt-get install -y cuda-toolkit-12-6 && sudo ldconfig'
                  version-cmd:   "dpkg-query -W -f='${Version}' cuda-toolkit-12-6 2>/dev/null"
                  latest-cmd:    'apt-cache policy cuda-toolkit-12-6 2>/dev/null | grep Candidate'
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo apt-get remove -y cuda-toolkit-12-6 && sudo ldconfig'
                  location:      'cuda-toolkit-12-6 (apt)' }
                { via: script  when: "redhat"  requires: cuda-repo
                  install-cmd:   'sudo dnf install -y cuda-toolkit-12-6 && sudo ldconfig'
                  version-cmd:   'rpm -q --qf %{VERSION} cuda-toolkit-12-6 2>/dev/null'
                  latest-cmd:    "dnf -q repoquery --qf '%{version}' cuda-toolkit-12-6 2>/dev/null | tail -1"
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo dnf remove -y cuda-toolkit-12-6'
                  location:      'cuda-toolkit-12-6 (dnf)' }
            ]
        }
        // cuda-repo — set up NVIDIA's CUDA network repo (the apt/dnf source cuDNN & CUDA come from).
        // `via: script` because the URL is distro-codename-specific; derived from /etc/os-release
        // (UBUNTU_CODENAME covers ubuntu derivatives). Not needed on Arch (official repos).
        cuda-repo: { attrs: [ headless proprietary freeware ]
            description: "NVIDIA CUDA network repo (apt/dnf) — the source cuDNN & CUDA packages come from."
            install: [
                { via: script  when: "debian"
                  install-cmd:   'set -e; . /etc/os-release; if [ -n "${UBUNTU_CODENAME:-}" ]; then case "$UBUNTU_CODENAME" in focal) SEG=ubuntu2004;; jammy) SEG=ubuntu2204;; noble) SEG=ubuntu2404;; *) SEG=ubuntu2204;; esac; elif [ "$ID" = debian ]; then SEG="debian${VERSION_ID%%.*}"; else SEG="${ID}$(echo "$VERSION_ID" | tr -d .)"; fi; A="$(uname -m)"; if [ "$A" = aarch64 ]; then A=sbsa; else A=x86_64; fi; T="$(mktemp -d)"; curl -fSL "https://developer.download.nvidia.com/compute/cuda/repos/$SEG/$A/cuda-keyring_1.1-1_all.deb" -o "$T/k.deb"; sudo dpkg -i "$T/k.deb"; sudo apt-get update; rm -rf "$T"'
                  version-cmd:   "dpkg-query -W -f='${Version}' cuda-keyring 2>/dev/null"
                  latest-cmd:    'apt-cache policy cuda-keyring 2>/dev/null | grep Candidate'
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo apt-get remove -y cuda-keyring'
                  location:      '/etc/apt/sources.list.d/cuda-*.list (+ cuda-keyring)' }
                { via: script  when: "redhat"
                  install-cmd:   'set -e; . /etc/os-release; case "$ID" in fedora) SEG="fedora$VERSION_ID";; *) SEG="rhel${VERSION_ID%%.*}";; esac; A="$(uname -m)"; if [ "$A" = aarch64 ]; then A=sbsa; else A=x86_64; fi; sudo dnf config-manager --add-repo "https://developer.download.nvidia.com/compute/cuda/repos/$SEG/$A/cuda-$SEG.repo"; sudo dnf -q clean expire-cache'
                  version-cmd:   'ls /etc/yum.repos.d/cuda-*.repo >/dev/null 2>&1 && echo present'
                  version-re:    '(present)'
                  uninstall-cmd: 'sudo rm -f /etc/yum.repos.d/cuda-*.repo'
                  location:      '/etc/yum.repos.d/cuda-*.repo' }
            ]
        }
        // cuDNN, versioned — DNN primitives, useful well beyond OpenCV (any CUDA ML build). Each is an
        // EXPLICIT, self-consistent choice a stack requires (never auto-detected at install). debian/
        // redhat use `via: script` = install the dev package AND run ldconfig (NVIDIA's libcudnn
        // packages skip the ldconfig trigger, so the runtime .so isn't cached). `requires: cuda-repo`
        // adds NVIDIA's source. Arch ships one rolling `cudnn` (currently 9.x) — attached to cudnn-9.
        cudnn-8: { attrs: [ lib proprietary freeware ]
            description: "NVIDIA cuDNN 8 — DNN primitives for the CUDA 11 line."
            requires: { cuda-toolkit: "<12" }
            install: [
                { via: script  when: "debian"  requires: cuda-repo
                  install-cmd:   'sudo apt-get install -y libcudnn8-dev && sudo ldconfig'
                  version-cmd:   "dpkg-query -W -f='${Version}' libcudnn8-dev 2>/dev/null"
                  latest-cmd:    'apt-cache policy libcudnn8-dev 2>/dev/null | grep Candidate'
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo apt-get remove -y libcudnn8-dev && sudo ldconfig'
                  location:      'libcudnn8-dev (apt) + ldconfig cache' }
                { via: script  when: "redhat"  requires: cuda-repo
                  install-cmd:   'sudo dnf install -y libcudnn8-devel && sudo ldconfig'
                  version-cmd:   'rpm -q --qf %{VERSION} libcudnn8-devel 2>/dev/null'
                  latest-cmd:    "dnf -q repoquery --qf '%{version}' libcudnn8-devel 2>/dev/null | tail -1"
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo dnf remove -y libcudnn8-devel && sudo ldconfig'
                  location:      'libcudnn8-devel (dnf) + ldconfig cache' }
            ]
        }
        cudnn-9: { attrs: [ lib proprietary freeware ]
            description: "NVIDIA cuDNN 9 — DNN primitives for the CUDA 12 line."
            requires: { cuda-toolkit: ">=12" }
            install: [
                { via: native  when: "arch"  name: cudnn }             // Arch's rolling cudnn (9.x); pacman runs ldconfig
                { via: script  when: "debian"  requires: cuda-repo
                  install-cmd:   'sudo apt-get install -y libcudnn9-dev-cuda-12 && sudo ldconfig'
                  version-cmd:   "dpkg-query -W -f='${Version}' libcudnn9-dev-cuda-12 2>/dev/null"
                  latest-cmd:    'apt-cache policy libcudnn9-dev-cuda-12 2>/dev/null | grep Candidate'
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo apt-get remove -y libcudnn9-dev-cuda-12 && sudo ldconfig'
                  location:      'libcudnn9-dev-cuda-12 (apt) + ldconfig cache' }
                { via: script  when: "redhat"  requires: cuda-repo
                  install-cmd:   'sudo dnf install -y libcudnn9-devel-cuda-12 && sudo ldconfig'
                  version-cmd:   'rpm -q --qf %{VERSION} libcudnn9-devel-cuda-12 2>/dev/null'
                  latest-cmd:    "dnf -q repoquery --qf '%{version}' libcudnn9-devel-cuda-12 2>/dev/null | tail -1"
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo dnf remove -y libcudnn9-devel-cuda-12 && sudo ldconfig'
                  location:      'libcudnn9-devel-cuda-12 (dnf) + ldconfig cache' }
            ]
        }
        rocm-hip: { attrs: [ SDK driver FOSS permissive ] description: "AMD ROCm/HIP — GPU compute toolkit for AMD hardware."
            install: [ { via: native  when: "not amzn"   name: { apt: rocm-hip-sdk  dnf: rocm-hip  pacman: rocm-hip-sdk } } ]
        }
        // MIOpen: AMD's deep-learning primitive library on ROCm/HIP — the true cuDNN analog for AMD
        // (as cuDNN needs CUDA, MIOpen needs ROCm), so it hard-requires rocm-hip. Fedora ships it in
        // base (`miopen`), Arch as `miopen-hip`; Debian/Ubuntu pull it from AMD's ROCm repo
        // (`miopen-hip-dev`, vendor repo — allowlisted like rocm-hip itself).
        miopen: { attrs: [ lib FOSS permissive ] description: "AMD MIOpen — deep-learning primitives for ROCm/HIP (AMD's cuDNN)."
            requires: rocm-hip
            install: [ { via: native  when: "debian or fedora or arch"  name: { apt: miopen-hip-dev  dnf: miopen  pacman: miopen-hip } } ]
        }
        // oneDNN (aka DNNL): Intel's deep-learning primitive library. UNLIKE cuDNN/MIOpen it is a
        // PORTABLE library (CPU + Intel/other GPU backends) shipped standalone in ordinary distro
        // repos — it needs neither a vendor repo nor the oneAPI Base Toolkit, so no hard toolkit
        // edge. Pair it with intel-oneapi-basekit yourself when building for Intel-GPU targets.
        onednn: { attrs: [ lib FOSS permissive ] description: "oneDNN (DNNL) — Intel's deep-learning primitives library (portable; Intel's cuDNN)."
            install: [ { via: native  when: "debian or fedora or arch or opensuse"  repo-component: universe
                         name: { apt: libdnnl-dev  dnf: onednn-devel  pacman: onednn  zypper: onednn-devel } } ]
        }
        intel-oneapi-basekit: { attrs: [ SDK toolchain proprietary freeware ] description: "Intel oneAPI Base Toolkit — compute compilers and libraries."
            install: [ { via: native  name: { apt: intel-basekit  dnf: intel-basekit  pacman: intel-oneapi-basekit } } ]
        }

        // OpenCV — computer-vision library, split by face: the C++ dev library and the Python
        // (cv2) bindings. The distro packages here are CPU-only; a CUDA-accelerated build is an
        // opt-in `via: source` method (requires the `cuda-toolkit` capability) added by configsys-source
        // — `configsys pin set opencv source` to get it.
        opencv: { attrs: [ lib FOSS permissive ] description: "OpenCV computer-vision library — C++ headers and libraries (dev)."
            install: [ { via: native  when: "(debian or redhat or opensuse or arch or alpine) and not amzn"  repo-component: universe
                         name: { apt: libopencv-dev  dnf: opencv-devel  zypper: opencv-devel  pacman: opencv  apk: opencv-dev } }
                       { via: native  when: "fedora_atomic"  name: opencv } ]   // brew formula `opencv`
        }
        opencv-python: { attrs: [ lib FOSS permissive ] description: "OpenCV Python bindings (the `cv2` module)."
            install: [ { via: native  when: "(debian or redhat or opensuse or arch or alpine) and not amzn"  repo-component: universe
                         name: { apt: python3-opencv  dnf: python3-opencv  zypper: python313-opencv  pacman: opencv  apk: py3-opencv } } ]
        }

        // docker: "the engine, working" = the package + its daemon enabled. Post-install is just
        // composition — docker-service is an ordinary component ordered after docker-engine via
        // `requires:` (which also avoids the package<->service dependency cycle a single unit
        // would create). Passwordless docker (group membership) is a security opt-in: add
        // `docker-group` to your profile alongside `docker`. RHEL steers you to podman — use that
        // there. Config lives in ~/.docker, so no dotfiles.
        docker: { attrs: [ CLI FOSS permissive ] description: "Docker — build and run containers (`docker` CLI)."
            install: [ { via: parts  parts: [ docker-engine, docker-service ] } ]
        }
        docker-engine: { attrs: [ daemon FOSS permissive ] description: "Docker Engine — the container runtime daemon."
            install: [ { via: native  repo-component: universe  name: { dnf: moby-engine  pacman: docker  zypper: docker  apk: docker  default: docker.io } }
                       { via: native  when: "amzn"  name: docker } ]
        }
        docker-service: { description: "Enable and start the Docker daemon (systemd)."
            requires: docker-engine
            install: [ { via: service  unit: docker } ]
        }
        docker-group: { description: "Add your user to the `docker` group (non-root docker access)."   // opt-in: passwordless docker (usermod -aG docker $YOU). Needs the group the engine creates.
            requires: docker-engine
            install: [ { via: group  name: docker } ]
        }

        // --- snapd: the daemon behind `via: snap`. The snap DRIVER `requires` the two setup
        // components below (see drivers:), so pinning a snap on a non-Ubuntu distro installs snapd,
        // enables its socket, and creates the /snap symlink classic snaps need. On Ubuntu it's all
        // preinstalled, so these resolve as already-satisfied (no action). openSUSE/Alpine have no
        // snapd binding here (snapd needs a community repo / isn't supported) — a snap pin there is
        // an honest resolve error; flatpak/native cover those apps.
        snapd: { attrs: [ daemon FOSS copyleft ] description: "snapd — the daemon that installs and runs snap packages."
            install: [ { via: native  when: "(debian or redhat) and not amzn"  name: snapd }   // apt / dnf snapd
                       { via: aur     when: "arch"  name: snapd } ]              // Arch: AUR
        }
        snapd-socket: { attrs: [ daemon FOSS copyleft ] description: "Enable snapd's systemd socket (so snaps can install/run)."
            requires: snapd
            install: [ { via: service  unit: snapd.socket } ]
        }
        snapd-snap-link: { attrs: [ headless FOSS copyleft ] description: "The /snap symlink classic-confinement snaps need (snapd stores snaps under /var/lib/snapd/snap)."
            requires: snapd
            install: [ { via: script
              install-cmd:   "test -e /snap || sudo ln -s /var/lib/snapd/snap /snap"   // Ubuntu already has /snap -> no-op; Fedora/Arch need the link
              version-cmd:   "test -e /snap && echo present"
              version-re:    "(present)"
              uninstall-cmd: "test -L /snap && sudo rm -f /snap || true"
              location:      "/snap" } ]
        }

        // --- virtualization: QEMU/KVM + libvirt + virt-manager, and VirtualBox ---
        qemu:    { attrs: [ CLI app FOSS copyleft ] description: "QEMU — machine emulator and virtualizer." install: [ { via: native  when: "not amzn"   name: { apt: qemu-system-x86  dnf: qemu-kvm  pacman: qemu-base  default: qemu } } ] }
        libvirt: { attrs: [ daemon lib FOSS copyleft ] description: "libvirt — virtualization management API and daemon." install: [ { via: native  when: "not amzn"   name: { apt: libvirt-daemon-system  default: libvirt } } ] }
        libvirt-service: { description: "Enable and start the libvirt daemon (systemd)." requires: libvirt  install: [ { via: service  unit: libvirtd } ] }
        // virt-manager pulls the whole stack (hypervisor + daemon) so it's usable out of the box.
        virt-manager: { attrs: [ GUI app FOSS copyleft ] description: "Virtual Machine Manager — a GUI for libvirt/KVM."
            requires: [ qemu, libvirt, libvirt-service ]
            install: [ { via: native  when: "not amzn"  }
                       { via: flatpak  hub: flathub  app: org.virt_manager.virt-manager } ]   // talks to the host libvirt socket (requires: still pull the host stack)
        }
        // VirtualBox needs a kernel module (vboxdrv, built via DKMS; Secure Boot requires signing
        // it — configsys can't do that part). apt: multiverse; Fedora: RPM Fusion; Arch/openSUSE: base.
        virtualbox: { attrs: [ GUI app FOSSish copyleft ] description: "VirtualBox — Oracle's desktop virtualizer."
            install: [
                { via: native  when: "redhat"  requires: rpmfusion  name: VirtualBox }
                { via: native  when: "debian or arch or opensuse"  repo-component: multiverse } ]
        }

        // --- compression suites ---
        // gzip/bzip2/xz are on every base system already; these are the ones worth adding.
        zstd:  { attrs: [ CLI lib FOSS permissive ] description: "Zstandard — fast, high-ratio compression (`zstd`)." install: [ { via: native } ] }
        lz4:   { attrs: [ CLI lib FOSS permissive ] description: "LZ4 — extremely fast compression (`lz4`)." install: [ { via: native } ] }
        p7zip: { attrs: [ CLI FOSS copyleft ] description: "7-Zip for Unix (`7z`/`7zz`) — high-ratio archiver, many formats." install: [ { via: native  name: { apt: p7zip-full  pacman: 7zip  zypper: 7zip  apk: 7zip  default: p7zip } }  { via: native  when: "ubuntu >= 22.04 or debian >= 12"  name: 7zip }  { via: native  when: "fedora_atomic"  name: sevenzip } ] }   // modern Debian/Ubuntu ship the actively-maintained `7zip` (`7zz`); it wins over the legacy p7zip-full by specificity. brew's current formula is `sevenzip` (p7zip is the legacy 17.06 fork)
        // unrar is nonfree (patent-encumbered): apt multiverse, Fedora RPM Fusion, Arch base.
        unrar: { attrs: [ CLI freeware ] description: "Extract RAR archives."
            install: [
                { via: native  when: "redhat"  requires: rpmfusion }
                { via: native  when: "debian"  repo-component: multiverse }
                { via: native  when: "arch" } ]
        }
        // rar (proprietary RARLAB) CREATES rar archives (unrar only extracts). Not in Fedora/
        // RPM Fusion or openSUSE main, and Arch carries it only in the AUR — so it's native only
        // on Debian (multiverse), AUR on Arch, and the official rarlab tarball everywhere else
        // (glibc; the tar unpacks a rar/ dir holding the rar + unrar binaries). Declines on musl
        // Alpine. suggests rar-dotfiles to put the tarball binary on PATH.
        rar: { attrs: [ CLI proprietary paid ] description: "Create and extract RAR archives (proprietary RARLAB `rar`)."
            suggests: rar-dotfiles
            install: [
                { via: native  when: "debian"  repo-component: multiverse }
                { via: aur     when: "arch" }
                { via: tarball  when: "not (debian or arch or alpine)"  installDir: "$CONFIGSYS_APP_DIR/rar"  requires: glibc
                  version: { static: "7.23" }  url: "https://www.rarlab.com/rar/rarlinux-x64-723.tar.gz"
                  latest-check: { url: "https://www.rarlab.com/download.htm"  regex: "rarlinux-x64-([0-9]+)[.]tar" } }
            ]
        }
        rar-dotfiles: { description: "rar shell setup, linked into place." install: [ { via: dotfiles  requires: bash-dotfiles  glue: rar } ] }
        // (The `compression` grouping is a PROFILE, not a parts component: nothing depends on it and
        // it's not OS-conditional, so the profile degrades gracefully — a part that's unroutable here,
        // e.g. unrar on musl/atomic, is skipped rather than failing the whole set. See config.hu.)

        // --- audio/video codecs (gstreamer names verified across all five families) ---
        // Free bundle: ffmpeg (already a component) + gstreamer good/bad plugins. The patent-
        // encumbered "ugly"/libav set is a SEPARATE opt-in (codecs-restricted), off by default.
        gst-good: { attrs: [ lib plugin FOSS copyleft ] description: "GStreamer good plugins — well-supported, license-clean codecs." install: [ { via: native  when: "debian or redhat or arch or opensuse or alpine"  name: { apt: gstreamer1.0-plugins-good  dnf: gstreamer1-plugins-good      pacman: gst-plugins-good  zypper: gstreamer-plugins-good  apk: gst-plugins-good } } ] }
        gst-bad:  { attrs: [ lib plugin FOSS copyleft ] description: "GStreamer bad plugins — less-mature but useful codecs." install: [ { via: native  when: "debian or redhat or arch or opensuse or alpine"  name: { apt: gstreamer1.0-plugins-bad   dnf: gstreamer1-plugins-bad-free  pacman: gst-plugins-bad   zypper: gstreamer-plugins-bad   apk: gst-plugins-bad } } ] }
        codecs:   { attrs: [ lib FOSS copyleft ] description: "Free multimedia codecs bundle — ffmpeg + gstreamer good/bad plugins." install: [ { via: parts  when: "debian or redhat or arch or opensuse or alpine"  parts: [ ffmpeg, gst-good, gst-bad ] } ] }
        // Restricted/nonfree codecs — patent-encumbered, opt-in. Fedora needs RPM Fusion; openSUSE's
        // full ugly/libav codecs come from Packman (the name resolves in OSS; Packman isn't modeled).
        gst-ugly:  { attrs: [ lib plugin FOSS copyleft patent ] description: "GStreamer ugly plugins — good code, patent-encumbered codecs." install: [
                       { via: native  when: "redhat"  requires: rpmfusion  name: gstreamer1-plugins-ugly }
                       { via: native  when: "debian"  repo-component: multiverse  name: gstreamer1.0-plugins-ugly }
                       { via: native  when: "arch or opensuse or alpine"  name: { pacman: gst-plugins-ugly  zypper: gstreamer-plugins-ugly  apk: gst-plugins-ugly } } ] }
        gst-libav: { attrs: [ lib plugin FOSS copyleft patent ] description: "GStreamer libav plugin — FFmpeg-backed codecs." install: [
                       { via: native  when: "redhat"  requires: rpmfusion  name: gstreamer1-plugin-libav }
                       { via: native  when: "debian"  repo-component: universe  name: gstreamer1.0-libav }
                       { via: native  when: "arch or opensuse or alpine"  name: { pacman: gst-libav  zypper: gstreamer-plugins-libav  apk: gst-libav } } ] }
        libavcodec-extra: { attrs: [ lib FOSS copyleft patent ] description: "Extra (nonfree) FFmpeg codecs." install: [ { via: native  when: "debian"  repo-component: universe } ] }
        codecs-restricted: { attrs: [ lib FOSS patent ] description: "Restricted/patented codecs — opt-in nonfree multimedia support." install: [
                               { via: parts  when: "debian"  parts: [ gst-ugly, gst-libav, libavcodec-extra ] }
                               { via: parts  when: "redhat or arch or opensuse or alpine"  parts: [ gst-ugly, gst-libav ] } ] }

        // discord / slack: flatpak everywhere (no uniform native path — Fedora has none), and
        // their config is sandboxed under ~/.var/app and holds auth tokens, so no dotfiles.
        discord: { attrs: [ GUI app proprietary electron account cloud online tele freemium ] description: "Discord — voice, video, and text chat." install: [ { via: flatpak  hub: flathub  app: com.discordapp.Discord }  { via: snap  name: discord }
                             { via: native-pkg-file  when: "debian"  name: discord  standing: never-auto  url: "https://discord.com/api/download?platform=linux&format=deb" } ] }   // Discord's official .deb (rolling; the URL 302-redirects to the latest — no version API, so latest reads as unknown, never a false "outdated"). `candidate-only` so the debian gate doesn't make it beat the universal flatpak by specificity — the sandboxed flatpak stays the default; the .deb is a pinnable option.
        slack:   { attrs: [ GUI app proprietary electron account cloud online tele freemium ] description: "Slack — team messaging and collaboration."
            install: [
                { via: native  when: "debian"  name: slack-desktop   // Slack's official packagecloud apt repo (jessie-pinned upstream; serves current builds)
                  pubkey-url: "https://packagecloud.io/slacktechnologies/slack/gpgkey"
                  pubkey-path: /usr/share/keyrings/slack.asc
                  source-line: "deb [signed-by=/usr/share/keyrings/slack.asc] https://packagecloud.io/slacktechnologies/slack/debian/ jessie main"
                  source-path: /etc/apt/sources.list.d/slack.list }
                { via: native  when: "redhat"  name: slack   // Slack's official packagecloud dnf repo (rpm package is `slack`)
                  pubkey-url: "https://packagecloud.io/slacktechnologies/slack/gpgkey"
                  repo-id: slack  repo-name: "Slack"
                  repo-url: "https://packagecloud.io/slacktechnologies/slack/fedora/21/x86_64" }
                { via: aur  when: "arch"  name: slack-desktop }
                { via: flatpak  hub: flathub  app: com.slack.Slack }
                { via: snap  name: slack } ]
        }

        // --- media & creative apps -------------------------------------------------
        // Flatpak-preferred: the Flathub builds are current and not hobbled by the sandbox for
        // these. gimp/krita also take a native binding on Alpine — musl, where a native apk
        // package beats pulling a glibc flatpak runtime (and both are in Alpine's community
        // repo). Elsewhere, and for the others, a native default is a per-machine `pin` away.
        gimp: { attrs: [ GUI app FOSS GNU copyleft ] description: "GIMP — a raster image editor."
            install: [ { via: native   when: "alpine" }
                       { via: flatpak  hub: flathub  app: org.gimp.GIMP } ]
        }
        krita: { attrs: [ GUI app FOSS copyleft GNU ] description: "Krita — a digital painting studio."
            install: [ { via: native   when: "debian or fedora or arch or opensuse or alpine"  repo-component: universe }
                       { via: flatpak  hub: flathub  app: org.kde.krita } ]
        }
        ardour: { attrs: [ GUI app FOSS copyleft ] description: "Ardour — a professional digital audio workstation (DAW)." install: [ { via: native  when: "debian or arch or opensuse"  repo-component: universe }  { via: flatpak  hub: flathub  app: org.ardour.Ardour } ] }
        lmms:   { attrs: [ GUI app FOSS copyleft ] description: "LMMS — a music production studio (synths, sequencing, loops)." install: [ { via: native  when: "debian or fedora or arch or opensuse"  repo-component: universe }  { via: flatpak  hub: flathub  app: io.lmms.LMMS } ] }
        // Audacity — the Muse-Group telemetry proposal (2021) was walked back and never shipped; no
        // networked telemetry in released builds. EL via EPEL; flatpak is the universal/atomic method.
        audacity: { attrs: [ GUI app FOSS copyleft ] description: "Audacity — a multi-track audio recorder and editor."
            install: [ { via: native  when: "rhel"  requires: epel }
                       { via: native  when: "(debian or fedora or arch or opensuse or alpine) and not amzn"  repo-component: universe }
                       { via: flatpak  hub: flathub  app: org.audacityteam.Audacity } ] }
        // playerctl — control any MPRIS media player (play/pause/next, read metadata). EL via EPEL.
        playerctl: { attrs: [ CLI FOSS copyleft ] description: "playerctl — control MPRIS media players from the CLI (play/pause/next, metadata)."
            install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"  repo-component: universe } ] }
        // mpd-mpris — exposes MPD over MPRIS so playerctl / desktop media keys drive it. Native on
        // Arch (extra) + Alpine (community); a Go build elsewhere. (Ships a systemd user service.)
        mpd-mpris: { attrs: [ CLI daemon FOSS permissive ] description: "mpd-mpris — bridge MPD to the MPRIS2 D-Bus interface (control MPD with `playerctl`)."
            install: [ { via: native  when: "arch or alpine" }
                       { via: go-install  when: "not (arch or alpine)"  name: "github.com/natsukagami/mpd-mpris/cmd/mpd-mpris"  requires: go } ] }

        // --- digital-art tools (Flathub, matching gimp/krita/ardour above — uniform across distros) ---
        inkscape:   { attrs: [ GUI app FOSS copyleft ] description: "Inkscape — a vector graphics editor (SVG)." install: [ { via: native  when: "debian or fedora or arch or opensuse"  repo-component: universe }  { via: native  when: "rhel"  requires: epel }  { via: flatpak  hub: flathub  app: org.inkscape.Inkscape } ] }
        darktable:  { attrs: [ GUI app FOSS copyleft ] description: "darktable — RAW photo workflow and non-destructive editing." install: [ { via: native  when: "debian or fedora or arch or opensuse"  repo-component: universe }  { via: native  when: "rhel"  requires: epel }  { via: flatpak  hub: flathub  app: org.darktable.Darktable } ] }
        freecad:    { attrs: [ GUI app FOSS copyleft ] description: "FreeCAD — a parametric 3D CAD modeler." install: [ { via: native  when: "debian or arch or opensuse"  repo-component: universe }  { via: flatpak  hub: flathub  app: org.freecad.FreeCAD }  { via: appImage  name: FreeCAD  scope: user  version: { github: FreeCAD/FreeCAD  asset: "FreeCAD_*-Linux-x86_64-*.AppImage" }  path: ~/apps/freecad.appimage } ] }   // native on debian/arch/opensuse; Fedora/EL lack it -> flatpak/appImage. asset glob absorbs the bundled-python (pyXYZ) token
        openscad:   { attrs: [ GUI app FOSS copyleft ] description: "OpenSCAD — the programmer's solid 3D CAD modeller." install: [ { via: native  when: "debian or fedora or arch or opensuse"  repo-component: universe }  { via: native  when: "rhel"  requires: epel }  { via: flatpak  hub: flathub  app: org.openscad.OpenSCAD } ] }
        godot:      { attrs: [ GUI app FOSS permissive ] description: "Godot — an open-source 2D/3D game engine." install: [ { via: flatpak  hub: flathub  app: org.godotengine.Godot }  { via: tarball  installDir: "$CONFIGSYS_APP_DIR/godot"  requires: unzip  version: { github: godotengine/godot  tag-re: "([0-9][0-9.]*)"  asset: "Godot_v*-stable_linux.x86_64.zip" } } ] }   // flatpak stays default; the zip holds a single `Godot_v<ver>_linux.x86_64` exe (no clean rename for zip)
        scribus:    { attrs: [ GUI app FOSS copyleft ] description: "Scribus — open-source desktop publishing (DTP)." install: [ { via: native  when: "debian or fedora or arch or opensuse"  repo-component: universe }  { via: native  when: "rhel"  requires: epel }  { via: flatpak  hub: flathub  app: net.scribus.Scribus } ] }
        digikam:    { attrs: [ GUI app FOSS copyleft ] description: "digiKam — photo management and RAW editing." install: [ { via: native  when: "debian or fedora or arch or opensuse"  repo-component: universe }  { via: native  when: "rhel"  requires: epel }  { via: flatpak  hub: flathub  app: org.kde.digikam } ] }

        // --- media servers (self-hosted; each runs a systemd service — the <name>-service pulls the
        // install AND starts it, like the db-servers) + media players (kodi/stremio, flatpak-first) ---
        // No server ships a Flathub build; the only Jellyfin flatpak is the CLIENT, not the server.
        jellyfin: { attrs: [ daemon web app FOSS copyleft ] description: "Jellyfin — a free, self-hosted media server (movies, TV, music)."
            install: [
                { via: native  when: "ubuntu"  name: jellyfin       // official repo (codename bumps as they add releases)
                  pubkey-url: "https://repo.jellyfin.org/ubuntu/jellyfin_team.gpg.key"  pubkey-path: /usr/share/keyrings/jellyfin.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/jellyfin.gpg] https://repo.jellyfin.org/ubuntu noble main"
                  source-path: /etc/apt/sources.list.d/jellyfin.list }
                { via: native  when: "debian"  name: jellyfin
                  pubkey-url: "https://repo.jellyfin.org/debian/jellyfin_team.gpg.key"  pubkey-path: /usr/share/keyrings/jellyfin.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/jellyfin.gpg] https://repo.jellyfin.org/debian bookworm main"
                  source-path: /etc/apt/sources.list.d/jellyfin.list }
                { via: native  when: "fedora"  name: jellyfin  requires: rpmfusion   // pulls ffmpeg from RPM Fusion
                  pubkey-url: "https://repo.jellyfin.org/fedora/jellyfin_team.gpg.key"
                  repo-id: jellyfin  repo-name: "Jellyfin"  repo-url: "https://repo.jellyfin.org/fedora/$releasever/$basearch" }
                { via: native  when: "arch"  packages: [ jellyfin-server, jellyfin-web ] } ] }   // Arch `extra`
        jellyfin-service: { description: "Enable and start the Jellyfin server (systemd)." requires: jellyfin  install: [ { via: service  unit: jellyfin } ] }
        plex: { attrs: [ daemon web app proprietary account cloud freemium ] description: "Plex Media Server — a media server with the Plex client ecosystem."
            install: [
                { via: native  when: "debian"  name: plexmediaserver   // official repo (single `public` suite — codename-independent)
                  pubkey-url: "https://downloads.plex.tv/plex-keys/PlexSign.key"  pubkey-path: /usr/share/keyrings/plex.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/plex.gpg] https://downloads.plex.tv/repo/deb public main"
                  source-path: /etc/apt/sources.list.d/plexmediaserver.list }
                { via: native  when: "redhat"  name: plexmediaserver
                  pubkey-url: "https://downloads.plex.tv/plex-keys/PlexSign.key"
                  repo-id: plex  repo-name: "Plex"  repo-url: "https://downloads.plex.tv/repo/rpm/$basearch/" }
                { via: aur  when: "arch"  name: plex-media-server } ] }
        plex-service: { description: "Enable and start Plex Media Server (systemd)." requires: plex  install: [ { via: service  unit: plexmediaserver } ] }
        emby: { attrs: [ daemon web FOSSish freemium ] description: "Emby Server — a media server (open-core; some features are premium)."
            install: [   // no official repo: Arch `extra`, else the upstream .deb/.rpm on GitHub
                { via: native  when: "arch"  name: emby-server }
                { via: native-pkg-file  when: "debian"  name: emby-server
                  version: { github: MediaBrowser/Emby.Releases  strip-v: true }  asset: "emby-server-deb_*_amd64.deb" }
                { via: native-pkg-file  when: "redhat or opensuse"  name: emby-server
                  version: { github: MediaBrowser/Emby.Releases  strip-v: true }  asset: "emby-server-rpm_*_x86_64.rpm" } ] }
        emby-service: { description: "Enable and start Emby Server (systemd)." requires: emby  install: [ { via: service  unit: emby-server } ] }
        navidrome: { attrs: [ daemon web FOSS copyleft ] description: "Navidrome — a self-hosted music streaming server (Subsonic/OpenSubsonic-compatible)." requires: ffmpeg
            install: [   // Arch `extra`; else the upstream .deb/.rpm, or the prebuilt tarball (hand-write a unit)
                { via: native  when: "arch"  name: navidrome }
                { via: native-pkg-file  when: "debian"  name: navidrome
                  version: { github: navidrome/navidrome  strip-v: true }  asset: "navidrome_*_linux_amd64.deb" }
                { via: native-pkg-file  when: "redhat"  name: navidrome
                  version: { github: navidrome/navidrome  strip-v: true }  asset: "navidrome_*_linux_amd64.rpm" }
                { via: tarball  when: "not arch and not debian and not redhat"  installDir: "$CONFIGSYS_APP_DIR/navidrome"  requires: glibc
                  version: { github: navidrome/navidrome  strip-v: true  asset: "navidrome_*_linux_amd64.tar.gz" } } ] }
        kodi: { attrs: [ GUI app FOSS copyleft patent ] description: "Kodi — an open-source home-theater / media-center app."
            install: [ { via: flatpak  hub: flathub  app: tv.kodi.Kodi }   // upstream-recommended; native alternates below
                       { via: native  when: "ubuntu"  repo-component: universe }
                       { via: native  when: "fedora"  requires: rpmfusion }   // RPM Fusion free, not base Fedora
                       { via: native  when: "arch" } ] }
        stremio: { attrs: [ GUI app freeware cloud online ] description: "Stremio — a media-center streaming/aggregator client." install: [ { via: flatpak  hub: flathub  app: com.stremio.Stremio }  { via: aur  when: "arch"  name: stremio } ] }

        // --- self-hosted / home-server apps. Clean daemons get a matching -service (a plain
        // `systemctl enable`); pi-hole/adguardhome self-install their service; config-dependent ones
        // (wireguard tunnels, prometheus units) you wire up yourself. ---
        // Home Assistant CORE in a pipx-managed venv on python3.14 (its runtime floor, now stable) —
        // NOT Home Assistant OS/Supervised, which are Docker/appliance images (no docker driver here).
        // requires python3.14 BY NAME so /usr/bin/python3.14 exists for pipx's `--python`, plus a C
        // toolchain + ffmpeg for building/running deps. Some integrations pip-install extra system
        // libs at runtime — add those to a profile if one you use needs it.
        home-assistant: { attrs: [ web daemon FOSS permissive ] description: "Home Assistant Core — a Python home-automation hub (venv install)."
            requires: [ python3.14, cpp-toolchain, ffmpeg ]
            install: [ { via: pipx  name: homeassistant  python: python3.14 } ] }
        pi-hole: { attrs: [ daemon web FOSS copyleft ] description: "Pi-hole — a network-wide DNS ad-blocker (FTL/dnsmasq + web admin)."
            install: [ { via: script   // the upstream installer sets up the service + `pihole` CLI (interactive)
                install-cmd:   'curl -sSL https://install.pi-hole.net | bash'
                version-cmd:   'pihole -v 2>/dev/null'
                version-re:    'v?([0-9][0-9.]*)'
                uninstall-cmd: 'pihole uninstall'
                location:      '/etc/pihole' } ] }
        adguardhome: { attrs: [ daemon web FOSS copyleft ] description: "AdGuard Home — a network-wide DNS ad/tracker blocker (single Go binary)."
            install: [
                { via: native   when: "arch" }                     // pacman: adguardhome (extra)
                { via: tarball  when: "not arch"  installDir: "$CONFIGSYS_APP_DIR/adguardhome"  requires: glibc   // then `AdGuardHome -s install` registers the service; first-run web setup on :3000
                  version: { github: AdguardTeam/AdGuardHome  strip-v: true  asset: "AdGuardHome_linux_amd64.tar.gz" } }
                { via: snap  name: adguard-home } ]                // self-contained alternate (pinnable)
        }
        homebridge: { attrs: [ daemon FOSS permissive ] description: "Homebridge — bridge non-HomeKit devices to Apple HomeKit (Node.js)."
            install: [
                { via: native  when: "debian"  name: homebridge   // official repo (bundles its own Node + a service user); single `stable` suite, codename-independent
                  pubkey-url: "https://repo.homebridge.io/KEY.gpg"  pubkey-path: /usr/share/keyrings/homebridge.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/homebridge.gpg] https://repo.homebridge.io stable main"
                  source-path: /etc/apt/sources.list.d/homebridge.list }
                { via: npm  when: "not debian"  name: homebridge } ]   // needs node; then `hb-service install`
        }
        mosquitto: { attrs: [ daemon FOSS copyleft ] description: "Eclipse Mosquitto — a lightweight MQTT broker (the common Home Assistant companion)." install: [ { via: native  when: "not amzn"  } ] }
        mosquitto-service: { description: "Enable and start the Mosquitto MQTT broker (systemd)." requires: mosquitto  install: [ { via: service  unit: mosquitto } ] }
        syncthing: { attrs: [ daemon web FOSS permissive ] description: "Syncthing — continuous peer-to-peer file synchronization."
            install: [ { via: native  when: "not amzn"  }                             // uniform pkg `syncthing`
                       { via: tarball  standing: never-auto  installDir: "$CONFIGSYS_APP_DIR/syncthing"  requires: glibc   // newest upstream build (pinnable)
                         version: { github: syncthing/syncthing  strip-v: true  asset: "syncthing-linux-amd64-*.tar.gz" } } ] }
        tailscale: { attrs: [ CLI daemon FOSSish permissive account cloud freemium ] description: "Tailscale — a WireGuard-based mesh VPN (`tailscale` CLI + `tailscaled`)."
            install: [   // official repo; the apt codename bumps as they add releases, dnf is $basearch-templated
                { via: native  when: "ubuntu"
                  pubkey-url: "https://pkgs.tailscale.com/stable/ubuntu/noble.noarmor.gpg"  pubkey-path: /usr/share/keyrings/tailscale-archive-keyring.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/tailscale-archive-keyring.gpg] https://pkgs.tailscale.com/stable/ubuntu noble main"
                  source-path: /etc/apt/sources.list.d/tailscale.list }
                { via: native  when: "debian"
                  pubkey-url: "https://pkgs.tailscale.com/stable/debian/bookworm.noarmor.gpg"  pubkey-path: /usr/share/keyrings/tailscale-archive-keyring.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/tailscale-archive-keyring.gpg] https://pkgs.tailscale.com/stable/debian bookworm main"
                  source-path: /etc/apt/sources.list.d/tailscale.list }
                { via: native  when: "redhat"
                  pubkey-url: "https://pkgs.tailscale.com/stable/fedora/repo.gpg"
                  repo-id: tailscale  repo-name: "Tailscale"  repo-url: "https://pkgs.tailscale.com/stable/fedora/$basearch" }
                { via: native  when: "arch" } ] }
        tailscale-service: { description: "Enable and start the Tailscale daemon (systemd)." requires: tailscale  install: [ { via: service  unit: tailscaled } ] }
        grafana: { attrs: [ web daemon FOSS copyleft tele ] description: "Grafana — analytics & observability dashboards (OSS)."
            install: [
                { via: native  when: "debian"  name: grafana   // official repo (single `stable` suite — codename-independent)
                  pubkey-url: "https://apt.grafana.com/gpg.key"  pubkey-path: /etc/apt/keyrings/grafana.gpg
                  source-line: "deb [signed-by=/etc/apt/keyrings/grafana.gpg] https://apt.grafana.com stable main"
                  source-path: /etc/apt/sources.list.d/grafana.list }
                { via: native  when: "redhat"  name: grafana
                  pubkey-url: "https://rpm.grafana.com/gpg.key"
                  repo-id: grafana  repo-name: "Grafana"  repo-url: "https://rpm.grafana.com" }
                { via: native  when: "arch"  name: grafana } ] }
        grafana-service: { description: "Enable and start Grafana (systemd)." requires: grafana  install: [ { via: service  unit: grafana-server } ] }
        prometheus: { attrs: [ daemon web FOSS permissive ] description: "Prometheus — a time-series metrics & alerting server."
            install: [
                { via: native  when: "arch or debian"  repo-component: universe }   // pacman/apt `prometheus` (debian lags upstream)
                { via: tarball  when: "not arch and not debian"  installDir: "$CONFIGSYS_APP_DIR/prometheus"  requires: glibc   // upstream static binaries; self-author the unit
                  version: { github: prometheus/prometheus  strip-v: true  asset: "prometheus-*.linux-amd64.tar.gz" } } ] }
        cockpit: { attrs: [ web daemon FOSS copyleft ] description: "Cockpit — a web-based server administration UI (socket-activated)."
            install: [ { via: native  when: "(debian or redhat or arch or opensuse) and not amzn" } ] }   // uniform pkg `cockpit`
        cockpit-service: { description: "Enable Cockpit's web UI (systemd socket)." requires: cockpit  install: [ { via: service  unit: cockpit.socket } ] }
        wireguard: { attrs: [ CLI driver FOSS copyleft ] description: "WireGuard — fast, modern VPN tunneling (`wg`/`wg-quick`)."
            install: [ { via: native  name: { apt: wireguard  default: wireguard-tools } } ] }   // debian `wireguard` metapkg; else `wireguard-tools`
        nextcloud: { attrs: [ daemon web FOSS copyleft ] description: "Nextcloud — a self-hosted file-sync & collaboration server (all-in-one snap)."
            install: [ { via: snap  name: nextcloud } ] }         // snap-or-Docker in practice; no native server package
        obs-studio: { attrs: [ GUI app FOSS copyleft ] description: "OBS Studio — live streaming and screen recording." install: [ { via: flatpak  hub: flathub  app: com.obsproject.Studio }  { via: snap  name: obs-studio } ] }
        spotify:    { attrs: [ GUI  proprietary  account  ads  cloud ]  description: "Spotify — music streaming client." install: [ { via: flatpak  hub: flathub  app: com.spotify.Client }  { via: snap  name: spotify } ] }   // not in distro repos; Flathub + official snap
        // MPD stack — a music-player daemon + a CLI client, plus the Strawberry GUI player.
        mpd: { attrs: [ daemon FOSS copyleft ] suggests: mpd-dotfiles  description: "MPD — Music Player Daemon, a server-side music player driven by clients (`mpd`)."
            install: [ { via: native  when: "rhel"  requires: epel }
                       { via: native  repo-component: universe  when: "not amzn" } ] }
        mpd-dotfiles: { description: "mpd config (mpd.conf), linked into place." install: [ { via: dotfiles  config: { src: mpd  dst: $XDG_CONFIG_HOME/mpd } } ] }
        mpc: { attrs: [ CLI FOSS copyleft ] description: "mpc — a minimalist command-line client for MPD (`mpc`)."
            install: [ { via: native  when: "rhel"  requires: epel }
                       { via: native  repo-component: universe  when: "not amzn"  name: { zypper: mpclient  default: mpc } } ] }   // openSUSE's `mpc` is the GNU MPC math lib; the MPD client there is `mpclient`
        strawberry: { attrs: [ GUI app FOSS copyleft ] description: "Strawberry — a music player and music-collection organizer (a Clementine fork)."
            install: [ { via: flatpak  hub: flathub  app: org.strawberrymusicplayer.strawberry }   // uniform option + the only method on atomic
                       { via: native  when: "rhel"  requires: epel }
                       { via: native  when: "fedora or arch or opensuse" }   // in-repo on these (Fedora proper needs no RPM Fusion for the app)
                       { via: native  when: "debian and not ubuntu" }   // Debian ships strawberry in its own repos
                       // Ubuntu/Pop: use Strawberry's official PPA — its placement in `universe` is
                       // release-dependent (absent on 22.04), so the PPA is the reliable apt route.
                       { via: native  when: "ubuntu"  ppa: "jonaski/strawberry"  requires: software-properties-common } ] }

        // --- digital-music tools --- (GUI apps via Flathub; audio-system bits native)
        musescore:     { attrs: [ GUI app FOSS copyleft ] description: "MuseScore — music notation and composition." install: [ { via: flatpak  hub: flathub  app: org.musescore.MuseScore }  { via: appImage  name: MuseScore  scope: user  version: { github: musescore/MuseScore  strip-v: true  asset: "MuseScore-Studio-*-x86_64.AppImage" }  path: ~/apps/musescore.appimage } ] }   // asset glob absorbs the build-number suffix
        hydrogen:      { attrs: [ GUI app FOSS copyleft ] description: "Hydrogen — a pattern-based drum machine." install: [ { via: native  when: "debian or fedora or arch or opensuse"  repo-component: universe }  { via: flatpak  hub: flathub  app: org.hydrogenmusic.Hydrogen } ] }
        carla:         { attrs: [ GUI app FOSS copyleft ] description: "Carla — an audio plugin host (LV2/VST/…)." install: [ { via: native  when: "debian or fedora or arch or opensuse"  repo-component: universe }  { via: flatpak  hub: flathub  app: studio.kx.carla } ] }
        sonic-pi:      { attrs: [ GUI app FOSS permissive ] description: "Sonic Pi — a live-coding music synth for everyone." install: [ { via: native  when: "debian"  repo-component: universe }  { via: flatpak  hub: flathub  app: net.sonic_pi.SonicPi } ] }
        supercollider: { attrs: [ GUI app FOSS copyleft ] description: "SuperCollider — audio synthesis and algorithmic composition." install: [ { via: native  when: "(debian or redhat or arch or opensuse) and not amzn"  repo-component: universe }  { via: native  when: "fedora_atomic" } ] }   // brew formula `supercollider`
        qjackctl:      { attrs: [ GUI app FOSS copyleft ] description: "QjackCtl — a GUI controller for the JACK audio server." install: [ { via: native  when: "not amzn"   repo-component: universe } ] }
        // PipeWire — the modern audio/video server. Native; already the default on most current
        // distros (where installing it is a harmless no-op).
        pipewire:      { attrs: [ daemon FOSS permissive ] description: "PipeWire — modern audio/video server (PulseAudio/JACK replacement)." install: [ { via: native } ] }
        // PipeWire dev headers (libpipewire-0.3 + libspa) — build dep for things that link PipeWire
        // (e.g. wiremix's libspa-sys). Arch/openSUSE ship headers in the main package (no -dev split).
        pipewire-dev:  { attrs: [ lib FOSS permissive ] description: "PipeWire development headers (libpipewire-0.3 / libspa)."
            install: [ { via: native  when: "debian"  name: libpipewire-0.3-dev }
                       { via: native  when: "redhat"  name: pipewire-devel }
                       { via: native  when: "alpine"  name: pipewire-dev }
                       { via: native  when: "opensuse"  name: pipewire-devel }
                       { via: native  when: "arch"  name: pipewire } ] }
        // JACK — low-latency audio server (jack2 is the current implementation). NOTE: conflicts with
        // pipewire's JACK shim (both provide the client libs) — install one JACK provider or the other.
        jack: { attrs: [ daemon FOSS copyleft ] description: "JACK Audio Connection Kit — low-latency audio server & routing."
            install: [ { via: native  when: "debian"  name: jackd2 }
                       { via: native  when: "fedora"  name: jack-audio-connection-kit }
                       { via: native  when: "rhel"  requires: epel  name: jack-audio-connection-kit }   // EPEL
                       { via: native  when: "arch or opensuse"  name: { pacman: jack2  zypper: jack } }
                       { via: native  when: "fedora_atomic"  name: jack } ] }   // brew formula `jack`
        // yabridge — bridge Windows VST2/VST3/CLAP plugins into Linux audio hosts. Needs Wine; x86_64
        // only. Native on Arch (`extra`); elsewhere the upstream github release tarball.
        yabridge: { attrs: [ CLI GUI FOSS copyleft ] description: "yabridge — bridge Windows VST/VST3/CLAP plugins into Linux audio hosts." requires: wine
            install: [ { via: native   when: "arch" }
                       { via: tarball  when: "not arch"  installDir: "$CONFIGSYS_APP_DIR/yabridge"  requires: glibc
                         version: { github: robbert-vdh/yabridge  strip-v: true  asset: "yabridge-*.tar.gz" } } ] }
        // tenacity: the telemetry-free Audacity fork. No reliable native package anywhere, so
        // flatpak-only (unroutable on Alpine -> surfaces as a diagnostic, never a crash).
        tenacity: { attrs: [ GUI app FOSS copyleft ] description: "Tenacity — an open-source multi-track audio editor (Audacity fork)." install: [ { via: native  when: "arch" }  { via: flatpak  hub: flathub  app: org.tenacityaudio.Tenacity } ] }

        // gnuradio: an SDR *framework* (Python bindings, out-of-tree modules) — flatpak is
        // impractical, so native everywhere (package name `gnuradio`).
        gnuradio: { attrs: [ GUI CLI app FOSS GNU copyleft ] description: "GNU Radio — a software-defined radio toolkit." install: [ { via: native  when: "not amzn"  } ] }

        // ffmpeg: native, but neither Fedora nor EL ships it in base repos — the full build
        // lives in RPM Fusion on both (Fedora and EL alike). `when: "redhat"` covers both;
        // rpmfusion-free (below) does the per-distro repo setup. Everywhere else it's in base.
        ffmpeg: { attrs: [ CLI lib FOSS copyleft patent ] description: "FFmpeg — record, convert, and stream audio and video."
            install: [ { via: native  when: "redhat"  requires: rpmfusion }
                       { via: native  name: { zypper: ffmpeg-7  default: ffmpeg } } ]
        }
        // FFmpeg/libav dev headers — build dep for things that link FFmpeg (e.g. wl-screenrec's
        // ffmpeg-sys-next). Debian splits per-lib; Fedora/EL ship a single ffmpeg-devel from RPM
        // Fusion; Arch bundles headers in the main ffmpeg package.
        ffmpeg-dev: { attrs: [ lib FOSS copyleft patent ] description: "FFmpeg development headers (libavutil/libavformat/libavcodec/…)."
            install: [ { via: native  when: "debian"  packages: [ libavutil-dev, libavformat-dev, libavcodec-dev,
                             libavfilter-dev, libavdevice-dev, libswscale-dev, libswresample-dev ] }
                       { via: native  when: "redhat"  requires: rpmfusion  name: ffmpeg-devel }
                       { via: native  when: "alpine"  name: ffmpeg-dev }
                       { via: native  when: "arch"  name: ffmpeg } ] }
        // libdrm dev headers — Direct Rendering Manager; wl-screenrec uses it for the DRM capture path.
        libdrm-dev: { attrs: [ lib FOSS permissive ] description: "libdrm development headers (Direct Rendering Manager)."
            install: [ { via: native  when: "debian"  name: libdrm-dev }
                       { via: native  when: "redhat or opensuse"  name: libdrm-devel }
                       { via: native  when: "alpine"  name: libdrm-dev }
                       { via: native  when: "arch"  name: libdrm } ] }
        // vlc: RPM Fusion on Fedora, but EL carries it in EPEL (not RPM Fusion) — so the two
        // rpm families take different capability edges. Base repos everywhere else.
        vlc: { attrs: [ GUI app FOSS copyleft patent ] description: "VLC — plays virtually any media file or stream."
            install: [ { via: flatpak  hub: flathub  app: org.videolan.VLC }   // uniform option everywhere; the only method on atomic (brew's vlc is a mac-only cask)
                       { via: native  when: "fedora"  requires: rpmfusion }
                       { via: native  when: "rhel"    requires: epel }
                       { via: native  when: "(not fedora_atomic) and not amzn" } ]
        }
        // RPM Fusion Free: enabling it = (EL only) turn on EPEL + CRB, then drop the free
        // .repo (dnf expands $releasever/$basearch and auto-imports the per-release key on the
        // first -y install) and pull the release package that formalizes the config. Fedora and
        // EL differ only in the repo path + key + those EL prereqs, so it's two bindings.
        // Provides the `rpmfusion` capability ffmpeg (both families) and vlc (Fedora) pull in.
        // Validated end to end on fedora:41 and rockylinux:9 (ffmpeg deps resolve). NOTE: EL
        // support targets the free rebuilds (Rocky/Alma/CentOS, CRB via config-manager); RHEL
        // proper enables CodeReady via subscription-manager, which the user does once by hand.
        rpmfusion-free: { attrs: [ plugin FOSS ] description: "RPM Fusion (free) — an extra Fedora/RHEL packages repo."
            provides: rpmfusion
            install: [
                { via: native  when: "rhel"  requires: epel  name: rpmfusion-free-release
                  enable-repo: crb
                  repo-id: rpmfusion-free  repo-name: "RPM Fusion for EL - Free"
                  repo-url: "https://download1.rpmfusion.org/free/el/updates/$releasever/$basearch/"
                  pubkey-url: "https://rpmfusion.org/keys?action=AttachFile&do=get&target=RPM-GPG-KEY-rpmfusion-free-el-$releasever" }
                { via: native  when: "fedora"  name: rpmfusion-free-release
                  repo-id: rpmfusion-free  repo-name: "RPM Fusion Free"
                  repo-url: "https://download1.rpmfusion.org/free/fedora/releases/$releasever/Everything/$basearch/os/"
                  pubkey-url: "https://rpmfusion.org/keys?action=AttachFile&do=get&target=RPM-GPG-KEY-rpmfusion-free-fedora-$releasever" }
            ]
        }

        // unityhub: the Unity Hub AppImage. Unity Editor(s) are installed THROUGH the Hub at
        // runtime — there's no `unity3d` package to route. Config in ~/.config/UnityHub (deferred).
        unityhub: { attrs: [ GUI app proprietary account freemium electron ] description: "Unity Hub — manage Unity game-engine installs and projects."
            suggests: unityhub-dotfiles
            // Unity retired the public AppImage (URL 404s); the official Linux channel is now their
            // apt repo. ASCII key -> a `.asc` keyring + signed-by (same pattern as chrome/vivaldi).
            install: [ { via: native  when: "debian"  name: unityhub  standing: 1
                         pubkey-url: "https://hub.unity3d.com/linux/keys/public"
                         pubkey-path: /usr/share/keyrings/unityhub.asc
                         source-line: "deb [signed-by=/usr/share/keyrings/unityhub.asc] https://hub.unity3d.com/linux/repos/deb stable main"
                         source-path: /etc/apt/sources.list.d/unityhub.list }
                       { via: flatpak  hub: flathub  app: com.unity.UnityHub } ]   // universal fallback (+ atomic)
        }

        // --- desktop environments (metapackage names verified per-distro in a podman sweep of
        // apt/dnf/pacman/zypper/apk, plus this Pop host for cosmic) ---
        // Native metapackages. Installing a DE where the OS already ships it is a harmless no-op
        // (inspect reads it as installed). `when:`-gated to the traditional package families
        // (excludes atomic / brew-native desktops, which are image-based). Arch installs some as
        // package GROUPS (xfce4/mate) — the pacman driver detects group membership for get_version.
        gnome:    { attrs: [ GUI app FOSS GNU copyleft ] description: "GNOME — the polished, mainstream GNOME desktop." install: [ { via: native  when: "debian or redhat or arch or opensuse or alpine"  name: { default: gnome-shell } } ] }
        kde:      { attrs: [ GUI FOSS copyleft ] description: "KDE Plasma — a feature-rich, highly customizable desktop." install: [ { via: native  when: "(debian or redhat or arch or opensuse or alpine) and not amzn"  name: { apt: kde-plasma-desktop  dnf: plasma-desktop  pacman: plasma-meta  zypper: plasma6-session  apk: plasma-desktop } } ] }
        xfce:     { attrs: [ GUI app FOSS copyleft ] description: "Xfce — a lightweight, traditional desktop environment." install: [ { via: native  when: "(debian or redhat or arch or opensuse or alpine) and not amzn"  name: { apt: xfce4  dnf: xfce4-session  pacman: xfce4  zypper: xfce4-session  apk: xfce4 } } ] }
        lxqt:     { attrs: [ GUI FOSS copyleft ] description: "LXQt — a lightweight Qt desktop." install: [ { via: native  when: "(debian or redhat or arch or opensuse or alpine) and not amzn"  name: { apt: lxqt  dnf: lxqt-session  pacman: lxqt  zypper: lxqt-session  apk: lxqt-desktop } } ] }
        mate:     { attrs: [ GUI FOSS copyleft ] description: "MATE — a classic GNOME 2-style desktop." install: [ { via: native  when: "(debian or redhat or arch or opensuse or alpine) and not amzn"  name: { apt: mate-desktop-environment  dnf: mate-desktop  pacman: mate  zypper: mate-session-manager  apk: mate-desktop-environment } } ] }
        sway:     { attrs: [ GUI FOSS permissive ] suggests: sway-dotfiles  description: "Sway — an i3-compatible tiling Wayland compositor." install: [ { via: native  when: "(debian or redhat or arch or opensuse or alpine) and not amzn" } ] }   // same package name in every family
        cinnamon: { attrs: [ GUI FOSS copyleft ] description: "Cinnamon — a modern desktop with a traditional layout." install: [ { via: native  when: "(debian or redhat or arch or opensuse) and not amzn"  name: { apt: cinnamon-desktop-environment  dnf: cinnamon  pacman: cinnamon  zypper: cinnamon } } ] }   // not packaged for Alpine
        budgie:   { attrs: [ GUI FOSS copyleft ] description: "Budgie — an elegant, modern desktop environment." install: [ { via: native  when: "(debian or redhat or arch or opensuse) and not amzn"  name: { default: budgie-desktop } } ] }                                                                    // not packaged for Alpine
        hyprland: { attrs: [ GUI FOSS permissive ] suggests: hyprland-dotfiles  description: "Hyprland — a dynamic tiling Wayland compositor with eye candy." install: [ { via: native  when: "(redhat or arch or opensuse or alpine) and not amzn"  name: { default: hyprland } } ] }                                                                          // not in stock Ubuntu
        cosmic:   { attrs: [ GUI FOSS copyleft ] description: "COSMIC — System76's Rust-based desktop environment." install: [ { via: native  when: "(pop_os! or redhat or arch or opensuse or alpine) and not amzn"  name: { default: cosmic-session } } ] }                                                          // stock Debian/Ubuntu lack it; Pop + others ship cosmic-session
        // Window managers (X11/Wayland tilers + a classic). Gated to the families that package them.
        i3:       { attrs: [ GUI FOSS permissive ] suggests: i3-dotfiles  description: "i3 — a keyboard-driven tiling window manager (X11)." install: [ { via: native  when: "(debian or redhat or arch or opensuse or alpine) and not amzn"  name: { pacman: i3-wm  apk: i3wm  default: i3 } } ] }
        qtile:    { attrs: [ GUI app FOSS permissive ] suggests: qtile-dotfiles  description: "Qtile — a tiling window manager written and configured in Python." install: [ { via: native  when: "(redhat or arch) and not amzn" }   // `qtile` on dnf/pacman; NOT packaged in Debian/Ubuntu
                                { via: pipx  when: "debian"  name: qtile } ] }   // Debian/Ubuntu: install the Python WM with pipx
        xmonad:   { attrs: [ GUI FOSS permissive ] suggests: xmonad-dotfiles  description: "xmonad — a tiling window manager written and configured in Haskell." install: [ { via: native  when: "(debian or redhat or arch or opensuse) and not amzn"  name: { default: xmonad } } ] }
        fvwm2:    { attrs: [ GUI FOSS copyleft ] suggests: fvwm2-dotfiles  description: "FVWM2 — the classic, highly configurable X11 window manager." install: [ { via: native  when: "debian"  name: fvwm } ] }   // the classic 2.x `fvwm` is Debian-only now; Arch ships only the 3.x line (`fvwm3`, a distinct component/AUR), so decline there rather than route to it

        // lazygit: native on fedora/arch; elsewhere (debian/EL) a static Go binary from the
        // GitHub release, unpacked under ~/apps/lazygit (scope-honoring). Its bash.d snippet
        // aliases `lazygit` to that binary when present (a no-op where it's native on PATH).
        lazygit: { attrs: [ TUI FOSS permissive ]
            description: "Terminal UI for git — stage, commit, branch, rebase visually."
            suggests: lazygit-dotfiles
            install: [
                { via: native  when: "arch" }                        // not in Fedora repos -> tarball there
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/lazygit"
                  version: { github: jesseduffield/lazygit  strip-v: true  asset: "lazygit_*_Linux_x86_64.tar.gz" } }
            ]
        }
        lazygit-dotfiles: { description: "lazygit config, linked into place."
            install: [ { via: dotfiles  requires: bash-dotfiles  glue: lazygit } ]
        }

        // --- dotfiles ---
        bash-dotfiles: { description: "Bash config (.bashrc + ~/.bash.d), linked into place."
            // absorb-into: a pre-existing ~/.bash_aliases is MOVED into the ~/.bash.d loader
            // dir (and made executable) instead of just backed up, so the user's own aliases
            // keep running — the new ~/.bash_aliases sources every ~/.bash.d/*.sh.
            install: [ { via: dotfiles  aliases: { src: bash_aliases  dst: ~/.bash_aliases
                         absorb-into: ~/.config/bash/conf.d/pre-configsys-aliases.sh } } ]
        }
        // Per-shell GLUE LOADERS (distinct from the shells' own *-dotfiles config). Glue snippets
        // link into the uniform ~/.config/<shell>/conf.d/ and the driver activates a shell's variant
        // only when that shell's binary is on PATH. fish auto-sources its conf.d natively — fish-glue
        // just ensures the dir. zsh needs one configsys-owned marker block in ~/.zshrc (added on
        // install, removed on uninstall) sourcing ~/.config/zsh/conf.d/*.zsh — skipped if ~/.zshrc is
        // a configsys-managed symlink (your captured config owns the source line then).
        zsh-glue:  { attrs: [ CLI FOSS permissive ] description: "Zsh glue loader — sources ~/.config/zsh/conf.d/*.zsh from ~/.zshrc."
            install: [ { via: dotfiles  loader: zsh } ] }
        fish-glue: { attrs: [ CLI FOSS ] description: "Fish glue loader — ensures ~/.config/fish/conf.d/ (fish auto-sources it)."
            install: [ { via: dotfiles  loader: fish } ] }

        // --- editors / IDEs ---
        neovim: { attrs: [ TUI app FOSS permissive ] description: "Hyperextensible Vim-based editor (`nvim`)."
            requires: [ ripgrep, tree-sitter-cli ]
            suggests: neovim-dotfiles
            install: [ { via: native  when: fedora_atomic }   // atomic: brew has neovim directly — cleaner than an AppImage needing fuse2
                       { via: appImage  name: Neovim  scope: user   // -> requires libfuse2; keep it in ~/apps
                         version: { github: neovim/neovim  asset: "nvim-linux-$ARCH.appimage" }
                         url: "https://github.com/neovim/neovim/releases/download/$VERSION/nvim-linux-$ARCH.appimage"
                         path: ~/apps/nvim.appimage } ]
        }
        neovim-dotfiles: { description: "Neovim config, linked into place."
            install: [ { via: dotfiles  requires: bash-dotfiles
                         // configsys ships NO neovim config — it's a deeply personal thing. This
                         // only declares WHERE it lives, so `configsys dotfiles capture` can adopt
                         // your existing ~/.config/nvim into your config (your plugin, else the
                         // local store) and manage/sync it from there. Until you capture, this
                         // spec is unpopulated and install leaves ~/.config/nvim untouched.
                         config:  { src: neovim  dst: $XDG_CONFIG_HOME/nvim }
                         aliases: { glue: neovim } } ]
        }
        // Emacs — native under `emacs` in every family.
        emacs: { attrs: [ GUI TUI app FOSS GNU copyleft ] suggests: emacs-dotfiles  description: "The extensible, self-documenting text editor." install: [ { via: native  repo-component: universe }  { via: flatpak  hub: flathub  app: org.gnu.emacs } ] }
        // Helix — native on dnf/pacman/zypper/apk/brew; NOT in the Ubuntu base repos, so the github
        // release tarball on the Debian family (ships `hx` alongside its runtime/ dir).
        helix: { attrs: [ TUI app FOSS permissive ] suggests: helix-dotfiles  description: "Post-modern modal editor (`hx`) — batteries included."
            install: [
                { via: native  when: "(redhat or arch or opensuse or alpine or fedora_atomic) and not amzn" }
                { via: tarball  when: "not alpine"  installDir: "$CONFIGSYS_APP_DIR/helix"  requires: glibc
                  version: { github: helix-editor/helix  strip-v: true  asset: "helix-*-x86_64-linux.tar.xz" } } ]   // glibc build — offered everywhere except musl (alpine has the native pkg)
        }
        // micro (`micro`): Go terminal editor. Native on Debian/Ubuntu universe, Fedora, Arch,
        // Alpine, Homebrew; NOT in openSUSE's repos (name-sweep confirmed) and no EL package, so the
        // upstream release tarball (ships `micro`) covers openSUSE + EL + anything missed.
        micro: { attrs: [ TUI app FOSS permissive ] suggests: micro-dotfiles 
            description: "Modern, intuitive terminal text editor (`micro`)."
            install: [
                { via: native  when: "(not (rhel or opensuse)) and not amzn"  repo-component: universe }
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/micro"  requires: glibc
                  version: { github: zyedidia/micro  strip-v: true  asset: "micro-*-linux64.tar.gz" } }
            ]
        }
        // Zed — native on Arch; elsewhere its own install script (installs into ~/.local).
        zed: { attrs: [ GUI app FOSS copyleft tele ] suggests: zed-dotfiles  description: "High-performance, multiplayer code editor from the Atom team."
            install: [
                { via: native  when: "arch" }
                { via: flatpak  hub: flathub  app: dev.zed.Zed }
                { via: script
                  install-cmd:   'curl -f https://zed.dev/install.sh | sh'
                  version-cmd:   '"$HOME/.local/bin/zed" --version'
                  version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                  uninstall-cmd: 'rm -rf "$HOME/.local/zed.app" "$HOME/.local/bin/zed"'
                  location:      '~/.local/bin/zed' }
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/zed"  version: { github: zed-industries/zed  strip-v: true  asset: "zed-linux-x86_64.tar.gz" } } ]   // upstream release tarball (zed.app bundle) — cleaner than the curl|sh script
        }
        // vscode: native from Microsoft's vendor repos. Debian/Ubuntu/Pop use the MS apt
        // repo (key + an inline `deb` source-line -> package `code`); Fedora/EL use the MS
        // dnf repo (key + a .repo file); Arch builds `visual-studio-code-bin` from the AUR
        // (the OSS `code` in the Arch repos is a different, unbranded build).
        vscode: { attrs: [ GUI app FOSSish electron tele ] suggests: vscode-dotfiles  description: "Visual Studio Code — Microsoft's extensible code editor."
            install: [
                { via: flatpak  hub: flathub  app: com.visualstudio.code }   // community Flathub build — offered everywhere; the only method on atomic (no MS vendor repo to wire in)
                { via: native  when: "debian"  name: code
                  pubkey-url: "https://packages.microsoft.com/keys/microsoft.asc"
                  pubkey-path: /usr/share/keyrings/packages.microsoft.asc
                  source-line: "deb [arch=amd64,arm64,armhf signed-by=/usr/share/keyrings/packages.microsoft.asc] https://packages.microsoft.com/repos/code stable main"
                  source-path: /etc/apt/sources.list.d/vscode.list }
                { via: native  when: "redhat"  name: code
                  pubkey-url: "https://packages.microsoft.com/keys/microsoft.asc"
                  repo-id: code  repo-name: "Visual Studio Code"
                  repo-url: "https://packages.microsoft.com/yumrepos/vscode" }
                { via: aur  when: "arch"  name: visual-studio-code-bin }
                { via: snap  name: code  classic: true }   // Microsoft-official snap (candidate-only: the MS apt repo stays the Ubuntu default)
            ]
        }
        // vscodium: the fully-open build of Code — no Microsoft telemetry/branding, and the OSS
        // (non-proprietary) marketplace. Its own apt/dnf repos (download.vscodium.com), Flathub, snap,
        // Arch AUR; package/CLI is `codium`. The telemetry-free sibling of `vscode` (which IS MS's build).
        vscodium: { attrs: [ GUI app FOSS permissive electron ] suggests: vscodium-dotfiles  description: "VSCodium — the community, telemetry-free open-source build of VS Code (`codium`)."
            install: [
                { via: flatpak  hub: flathub  app: com.vscodium.codium }   // universal; the only method on atomic
                { via: native  when: "debian"  name: codium
                  pubkey-url: "https://gitlab.com/paulcarroty/vscodium-deb-rpm-repo/raw/master/pub.gpg"
                  pubkey-path: /usr/share/keyrings/vscodium.asc
                  source-line: "deb [signed-by=/usr/share/keyrings/vscodium.asc] https://download.vscodium.com/debs vscodium main"
                  source-path: /etc/apt/sources.list.d/vscodium.list }
                { via: native  when: "redhat"  name: codium
                  pubkey-url: "https://gitlab.com/paulcarroty/vscodium-deb-rpm-repo/raw/master/pub.gpg"
                  repo-id: vscodium  repo-name: "VSCodium"
                  repo-url: "https://download.vscodium.com/rpms/" }
                { via: aur  when: "arch"  name: vscodium-bin }
                { via: snap  name: codium  classic: true }
            ]
        }
        // antigravity: Google's agent-first AI IDE (a VS Code fork — imports VS Code settings/exts;
        // "Manager view" orchestrates parallel agents across Gemini/Claude/GPT-OSS). Free PREVIEW.
        // Google ships auto-updating GAR apt/dnf repos (us-central1-apt/yum.pkg.dev, package
        // `antigravity`) — the ideal binding, but its exact key + apt suite are behind a JS page we
        // couldn't pin, so those are a TODO (a good target for a refresh version/preview hook). Here:
        // Arch AUR, and the upstream tarball elsewhere (a manual VERSION pin — bump the url; the app
        // self-updates after first launch, so a stale pin only affects the initial install).
        antigravity: { attrs: [ GUI app electron proprietary freeware account cloud tele beta ] suggests: antigravity-dotfiles  description: "Google Antigravity — Google's agent-first AI IDE (a VS Code fork; Gemini/Claude/GPT-OSS)."
            install: [
                { via: aur  when: "arch"  name: antigravity-bin }
                { via: tarball  when: "not arch"  installDir: "$CONFIGSYS_APP_DIR/antigravity"  requires: glibc  version: { static: "1.23.2" }
                  url: "https://edgedl.me.gvt1.com/edgedl/release2/j0qc3/antigravity/stable/1.23.2-4781536860569600/linux-x64/Antigravity.tar.gz" } ]
        }
        // android-studio: Google's official tarball, unpacked scope-honoring (~/android-studio
        // for user, /opt/android-studio for system). No clean version API, so the version is a
        // manual pin — bump it from developer.android.com/studio. Fat IDE config deferred.
        android-studio: { attrs: [ GUI app FOSS permissive tele-optin ] description: "Android Studio — the official Android IDE."
            suggests: android-studio-dotfiles
            install: [ { via: tarball  version: { static: 2024.2.1.11 }  standing: 1  requires: glibc   // Google's official tarball stays the default (glibc-linked JVM/launchers). No plain version endpoint for a `latest-check:` (the studio page is JS) — bump from developer.android.com/studio.
                         url: "https://redirector.gvt1.com/edgedl/android/studio/ide-zips/$VERSION/android-studio-$VERSION-linux.tar.gz" }
                       { via: flatpak  hub: flathub  app: com.google.AndroidStudio } ]   // community Flathub build offered as an alternative
        }
        // jmtpfs: FUSE filesystem to mount an MTP device (an Android phone over USB) as a
        // directory. Native on the debian + redhat families (apt universe, Fedora); AUR on Arch.
        // NOT in openSUSE/Alpine repos (name sweep confirmed), so the native binding is gated to
        // where it exists. The package pulls its FUSE + libmtp deps transitively (no `requires:`).
        jmtpfs: { attrs: [ CLI FOSS copyleft ] description: "jmtpfs — mount MTP devices (Android phones) via FUSE."
            install: [
                { via: aur     when: "arch" }
                { via: native  when: "(debian or redhat) and not amzn"  repo-component: universe }
            ]
        }
        // JetBrains Toolbox — the launcher that installs/updates IDEA, CLion, PyCharm, etc.
        // (cleaner than one-off IDE components). The version-less URL 302-redirects to the
        // latest tarball, which `curl -fSL` follows — so `static: latest`, no version to chase.
        jetbrains-toolbox: { attrs: [ GUI app proprietary freeware ] suggests: jetbrains-toolbox-dotfiles  description: "JetBrains Toolbox — install and manage JetBrains IDEs."
            install: [ { via: tarball  installDir: "$CONFIGSYS_APP_DIR/jetbrains-toolbox"  requires: glibc   // glibc-linked launcher
                         version: { static: latest }
                         url: "https://download.jetbrains.com/product?code=TBA&latest&distribution=linux" } ]
        }

        // --- AI / LLM command-line tools ---
        // Claude Code and Codex are npm globals (userland via the npm driver). llm and aider are
        // Python CLIs (pipx). Ollama is a LOCAL INFERENCE SERVER: native on Arch/Homebrew, else its
        // own install script (which also sets up the systemd service); a best-effort uninstall is
        // declared so the script driver can remove it cleanly.
        // Anthropic's official native installer is the preferred method (no Node needed, self-updating);
        // `claude --version` lets detection SEE an existing native install so it's never reinstalled.
        // npm stays as a pinnable fallback but is never the auto-default.
        claude-code: { attrs: [ CLI proprietary account cloud online paid freemium ] suggests: claude-code-dotfiles  description: "Claude Code — Anthropic's agentic coding CLI."
            install: [ { via: script  requires: curl
                         install-cmd:   'curl -fsSL https://claude.ai/install.sh | bash'
                         version-cmd:   'claude --version 2>/dev/null'
                         version-re:    '([0-9][0-9.]*)'
                         upgrade-cmd:   'claude update'
                         uninstall-cmd: 'rm -f "$HOME/.local/bin/claude"'
                         location:      '~/.local/bin/claude' }
                       { via: npm  name: "@anthropic-ai/claude-code"  standing: never-auto } ] }
        codex:       { attrs: [ CLI FOSS permissive account cloud online paid freemium ] suggests: codex-dotfiles  description: "OpenAI Codex CLI — agentic coding in the terminal." install: [ { via: npm  name: "@openai/codex" } ] }
        llm:         { attrs: [ CLI FOSS permissive ] description: "`llm` — a CLI to access LLMs from the shell and scripts." install: [ { via: pipx  name: llm  version: { pypi: llm } } ] }
        aider:       { attrs: [ CLI FOSS permissive account cloud ] suggests: aider-dotfiles  description: "Aider — AI pair-programming in your terminal, over your git repo." install: [ { via: pipx  name: aider-chat  version: { pypi: aider-chat } } ] }        // PyPI dist is aider-chat
        ollama: { attrs: [ CLI daemon FOSS permissive ] description: "Ollama — run large language models locally."
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }             // brew formula `ollama`
                { via: script
                  install-cmd:   'curl -fsSL https://ollama.com/install.sh | sh'
                  version-cmd:   'ollama --version'
                  version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                  uninstall-cmd: 'sudo systemctl stop ollama 2>/dev/null; sudo rm -f /usr/local/bin/ollama /etc/systemd/system/ollama.service; sudo rm -rf /usr/share/ollama'
                  location:      '/usr/local/bin/ollama' }
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/ollama"  requires: zstd  version: { github: ollama/ollama  strip-v: true  asset: "ollama-linux-amd64.tar.zst" } } ]   // upstream tarball (zstd; bin/ + lib/) — a no-daemon userland alt to the install script
        }

        // --- container / k8s / dev TUIs & C++ package managers ---
        // lazydocker's asset embeds the version (github asset discovery, like lazygit); lazysql
        // and k9s have stable asset names, so they use github's API-free latest/download URL.
        lazydocker: { attrs: [ TUI FOSS permissive ] suggests: lazydocker-dotfiles 
            description: "Terminal UI for Docker/Compose — containers, logs, stats."
            install: [ { via: tarball  installDir: "$CONFIGSYS_APP_DIR/lazydocker"  requires: glibc
                         version: { github: jesseduffield/lazydocker  strip-v: true  asset: "lazydocker_*_Linux_x86_64.tar.gz" } } ]
        }
        // TUI clients + creative/misc terminal apps.
        discordo: { attrs: [ TUI app FOSS permissive account cloud online ] description: "Discordo — a lightweight terminal (TUI) Discord client."
                    install: [ { via: aur  when: "arch"  name: discordo-git }
                               { via: go-install  when: "not arch"  name: "github.com/ayn2op/discordo"  requires: [ { go: ">=1.26" } ] } ] }   // no releases (rolling master); AUR on arch, `go install` elsewhere (a modern Go toolchain floor advises the go tarball)
        caligula: { attrs: [ TUI FOSS copyleft ] description: "Caligula — a user-friendly TUI disk imager / ISO burner."
                    install: [ { via: native  when: "arch or fedora_atomic" }
                               { via: cargo   when: "not (arch or fedora_atomic)"  name: caligula } ] }   // pacman / brew where packaged; cargo everywhere else
        // balenaEtcher (Electron GUI imager). No distro repo pkg, no Flathub, and 2.x dropped the
        // AppImage — so it's the upstream .deb/.rpm (native-pkg-file) + AUR only. Declines on
        // Alpine (musl/Electron) and atomic.
        balena-etcher: { attrs: [ GUI app electron FOSS permissive tele ] description: "balenaEtcher — a GUI tool to flash OS images to USB/SD cards (`balena-etcher`)."
            install: [ { via: native-pkg-file  when: "debian"           version: { github: balena-io/etcher }  asset: { deb: { x86_64: "balena-etcher_*_amd64.deb" } } }
                       { via: native-pkg-file  when: "redhat or opensuse"  version: { github: balena-io/etcher }  asset: { rpm: { x86_64: "balena-etcher-*.x86_64.rpm" } } }
                       { via: aur  when: "arch"  name: balena-etcher } ] }
        durdraw: { attrs: [ TUI app FOSS permissive ] description: "Durdraw — an ASCII/ANSI/Unicode terminal art and animation editor."
                   install: [ { via: pipx  name: durdraw }
                              { via: aur   when: "arch"  name: durdraw } ] }   // Python; pipx is the universal method
        astroterm: { attrs: [ TUI app FOSS permissive ] description: "astroterm — a terminal planetarium / star map (stars, planets, constellations)."
                     install: [ { via: native  when: "fedora or fedora_atomic" }
                                { via: aur     when: "arch"  name: astroterm } ] }   // dnf on Fedora (F40+), brew on atomic, AUR on arch; declines elsewhere
        webcamize: { attrs: [ CLI FOSS copyleft ] description: "webcamize — use a DSLR/mirrorless/other camera as a Linux webcam (via v4l2loopback)."
                     install: [ { via: aur  when: "arch"  name: webcamize } ] }   // AUR-only (build-from-source elsewhere); needs v4l2loopback + libgphoto2 at runtime
        lazysql: { attrs: [ TUI FOSS permissive ] suggests: lazysql-dotfiles  description: "Terminal UI for SQL databases (`lazysql`)."
            install: [ { via: tarball  installDir: "$CONFIGSYS_APP_DIR/lazysql"  requires: glibc  version: { static: latest }
                         url: "https://github.com/jorgerojas26/lazysql/releases/latest/download/lazysql_Linux_x86_64.tar.gz" } ]
        }
        k9s: { attrs: [ TUI FOSS permissive ] suggests: k9s-dotfiles 
            description: "Terminal UI to navigate and manage Kubernetes clusters."
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }             // brew formula `k9s`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/k9s"  requires: glibc  version: { static: latest }
                  url: "https://github.com/derailed/k9s/releases/latest/download/k9s_Linux_amd64.tar.gz" } ]
        }
        // kubectl isn't in the Debian/Fedora base repos; native on Arch/Homebrew, else the upstream
        // static binary from dl.k8s.io (bare-binary tarball mode; `stable.txt` gives the version).
        // The Go binary runs anywhere, so no glibc gate.
        kubectl: { attrs: [ CLI FOSS permissive ] suggests: kubectl-dotfiles  description: "kubectl — the Kubernetes command-line client."
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/kubectl"  archive: none   // static Go binary from dl.k8s.io — runs anywhere; a uniform option (native stays default on arch/atomic)
                  version: { url: "https://dl.k8s.io/release/stable.txt" }
                  url: "https://dl.k8s.io/release/v$VERSION/bin/linux/amd64/kubectl" }
                { via: snap  name: kubectl  classic: true } ]   // Canonical-official snap (candidate-only)
        }
        // helm & k3s install via their upstream scripts (script driver) where not native.
        helm: { attrs: [ CLI FOSS permissive ] suggests: helm-dotfiles  description: "Helm — the package manager for Kubernetes."
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }
                { via: script
                  install-cmd:   'curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash'
                  version-cmd:   'helm version --short'
                  version-re:    '(v?[0-9]+\.[0-9]+\.[0-9]+)'
                  uninstall-cmd: 'sudo rm -f /usr/local/bin/helm'
                  location:      '/usr/local/bin/helm' }
                { via: snap  name: helm  classic: true } ]   // community (Snapcrafters) snap (candidate-only)
        }
        k3s: { attrs: [ daemon CLI FOSS permissive ] description: "k3s — lightweight, single-binary Kubernetes."
            install: [ { via: script  standing: 1                              // keep the get.k3s.io script the default: it sets up the systemd SERVICE (the point of a k8s server); the tarball is just the bare binary
                         install-cmd:   'curl -sfL https://get.k3s.io | sh'
                         version-cmd:   'k3s --version'
                         version-re:    '(v[0-9]+\.[0-9]+\.[0-9]+)'
                         uninstall-cmd: '/usr/local/bin/k3s-uninstall.sh'
                         location:      '/usr/local/bin/k3s' }
                       { via: tarball  archive: none  binary: k3s  installDir: "$CONFIGSYS_APP_DIR/k3s"  version: { github: k3s-io/k3s  asset: "k3s" } } ]   // raw static binary (the API gives the +k3s1-tagged download URL); an option for "just the binary"
        }
        // conan is a Python CLI (pipx). vcpkg is a git clone + bootstrap (script driver; needs git).
        conan: { attrs: [ CLI FOSS permissive ] description: "Conan — a C/C++ package manager." install: [ { via: pipx  name: conan  version: { pypi: conan } } ] }
        vcpkg: { attrs: [ CLI FOSS permissive ] suggests: vcpkg-dotfiles  description: "vcpkg — Microsoft's C/C++ library manager."
            requires: [ git, curl, zip, unzip ]     // bootstrap-vcpkg fetches + unpacks its tool
            install: [ { via: script
                         install-cmd:   'git clone https://github.com/microsoft/vcpkg "$HOME/.vcpkg" && "$HOME/.vcpkg/bootstrap-vcpkg.sh" -disableMetrics'
                         version-cmd:   '"$HOME/.vcpkg/vcpkg" version'
                         version-re:    '([0-9]{4}-[0-9]{2}-[0-9]{2})'
                         uninstall-cmd: 'rm -rf "$HOME/.vcpkg"'
                         location:      '~/.vcpkg' } ]
        }

        // --- build systems ---
        make:  { attrs: [ CLI FOSS GNU copyleft ] description: "GNU Make — build automation via Makefiles." install: [ { via: native } ] }
        cmake: { attrs: [ CLI FOSS permissive ] description: "CMake — cross-platform build-system generator." install: [ { via: native } ] }
        ninja: { attrs: [ CLI FOSS permissive ] description: "Ninja — a small, fast build backend." install: [ { via: native  name: { apt: ninja-build  dnf: ninja-build  apk: samurai  default: ninja } } ] }
        meson: { attrs: [ CLI FOSS permissive ] description: "Meson — a fast, modern build system." install: [ { via: native } ] }

        // --- autotools / GNU C build tools (the basic C-dev toolchain; grouped in the `autotools`
        // profile). Same package name on every manager except pkg-config. Source plugins/recipes
        // `requires:` these by name and resolve them from here. ---
        pkg-config: { attrs: [ CLI FOSS copyleft ] description: "pkg-config — query installed libraries' compile and link flags at build time."
                      install: [ { via: native  name: { dnf: pkgconf-pkg-config  pacman: pkgconf  apk: pkgconf } } ] }
        autoconf: { attrs: [ CLI toolchain FOSS GNU copyleft ] description: "GNU Autoconf — generate a package's `configure` script from autotools macros." install: [ { via: native } ] }
        automake: { attrs: [ CLI toolchain FOSS GNU copyleft ] description: "GNU Automake — generate a portable Makefile.in from Makefile.am (autotools)." install: [ { via: native } ] }
        libtool:  { attrs: [ CLI lib FOSS GNU copyleft ] description: "GNU Libtool — a portable shared-library build/link wrapper (autotools)." install: [ { via: native } ] }
        bison:    { attrs: [ CLI toolchain FOSS GNU copyleft ] description: "GNU Bison — the yacc-compatible parser generator." install: [ { via: native } ] }
        flex:     { attrs: [ CLI toolchain FOSS permissive ] description: "flex — the fast lexical-analyzer (lexer) generator." install: [ { via: native } ] }
        // perl + nasm — referenced by the `languages` profile; they belong in base so those resolve.
        perl:     { attrs: [ CLI runtime FOSS copyleft ] description: "Perl — a capable, mature general-purpose scripting language (`perl`)." install: [ { via: native } ] }
        nasm:     { attrs: [ CLI toolchain FOSS permissive ] description: "NASM — the Netwide x86/x86-64 assembler (`nasm`)." install: [ { via: native } ] }
        // just: native on rpm/Arch/openSUSE/brew; the upstream musl tarball (statically linked,
        // runs anywhere) is offered as a uniform option everywhere — it's the default on the Debian
        // family (no repo package; works on older apt too, e.g. Ubuntu/Pop 22.04) and a candidate
        // elsewhere (native stays the default where the distro packages it).
        just: { attrs: [ CLI FOSS permissive ] suggests: just-dotfiles  description: "just — a handy command runner (Makefile-like `justfile`)."
            install: [
                { via: native  when: "(redhat or arch or opensuse or fedora_atomic) and not amzn" }
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/just"
                  version: { github: casey/just  strip-v: true  asset: "just-*-x86_64-unknown-linux-musl.tar.gz" } } ]
        }
        // Bazelisk (the official launcher that manages bazel versions) — a bare static binary.
        bazelisk: { attrs: [ CLI FOSS permissive ] suggests: bazelisk-dotfiles  description: "Bazelisk — a launcher that manages Bazel versions."
            install: [
                { via: native  when: "fedora_atomic" }             // brew formula `bazelisk`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/bazelisk"  archive: none  binary: bazelisk  version: { static: latest }
                  url: "https://github.com/bazelbuild/bazelisk/releases/latest/download/bazelisk-linux-amd64" } ]
        }
        // Maven (native everywhere) and Gradle (native except Fedora base — use SDKMAN there). Both
        // need a JVM.
        maven:  { attrs: [ CLI FOSS permissive ] suggests: maven-dotfiles  description: "Apache Maven — Java build and dependency management." requires: jdk
                  install: [ { via: native }  { via: sdkman  standing: never-auto } ] }   // native default; SDKMAN for a pinned version
        gradle: { attrs: [ CLI FOSS permissive ] suggests: gradle-dotfiles  description: "Gradle — JVM build automation." requires: jdk
                  install: [ { via: native  when: "debian or arch or fedora_atomic" }   // native where packaged
                             { via: sdkman  when: "not debian and not arch and not fedora_atomic" } ] }   // SDKMAN elsewhere (fedora/alpine/opensuse) + any pinned version
        // Jenkins — CI/CD automation server (web UI on :8080). Official apt/dnf vendor repos (stable
        // LTS) + AUR on Arch; needs a JDK. No brew/atomic/alpine binding (use the war or a container).
        jenkins: { attrs: [ web daemon FOSS permissive ] description: "Jenkins — an automation server for CI/CD (web UI on :8080)." requires: jdk
            install: [
                { via: native  when: "debian"  name: jenkins   // Jenkins' official apt repo (stable/LTS)
                  pubkey-url: "https://pkg.jenkins.io/debian-stable/jenkins.io-2023.key"
                  pubkey-path: /usr/share/keyrings/jenkins-keyring.asc
                  source-line: "deb [signed-by=/usr/share/keyrings/jenkins-keyring.asc] https://pkg.jenkins.io/debian-stable binary/"
                  source-path: /etc/apt/sources.list.d/jenkins.list }
                { via: native  when: "redhat"  name: jenkins   // Jenkins' official dnf repo (stable/LTS)
                  pubkey-url: "https://pkg.jenkins.io/redhat-stable/jenkins.io-2023.key"
                  repo-id: jenkins  repo-name: "Jenkins"
                  repo-url: "https://pkg.jenkins.io/redhat-stable/" }
                { via: aur  when: "arch"  name: jenkins } ]
        }

        // --- debugging / static analysis / profiling (NB: ASan/UBSan/TSan are gcc/clang FLAGS,
        // not packages — nothing to install for those). ---
        valgrind:  { attrs: [ CLI FOSS copyleft ] suggests: valgrind-dotfiles  description: "Valgrind — memory-error and leak detector." install: [ { via: native } ] }
        cppcheck:  { attrs: [ CLI FOSS copyleft ] description: "Cppcheck — static analysis for C/C++." install: [ { via: native } ] }
        doxygen:   { attrs: [ CLI FOSS GNU copyleft ] description: "Doxygen — generate API docs from annotated C/C++/… source." install: [ { via: native } ] }
        swig:      { attrs: [ CLI FOSS permissive ] description: "SWIG — generate scripting-language bindings for C/C++ (`swig`)." install: [ { via: native  installed-name: swig4.0 } ] }   // apt `swig` is a meta over swig4.0
        source-highlight: { attrs: [ CLI FOSS GNU copyleft ] description: "GNU Source-highlight — syntax-highlight source to HTML and other formats."
                            install: [ { via: native  when: "not (rhel or amzn)" }
                                       { via: native  when: "rhel"  requires: epel } ] }   // EL via EPEL
        po4a:      { attrs: [ CLI FOSS GNU copyleft ] description: "po4a — keep doc translations (man/markdown/…) in sync via PO files."
                     install: [ { via: native  when: "not (rhel or amzn)" }
                                { via: native  when: "rhel"  requires: epel } ] }   // EL via EPEL
        asciidoc:  { attrs: [ CLI FOSS GNU copyleft ] description: "AsciiDoc — a plain-text document format rendered to HTML/DocBook/man (`asciidoc`, `a2x`)."
                     install: [ { via: native  when: "not (rhel or amzn)" }
                                { via: native  when: "rhel"  requires: epel } ] }   // EL via EPEL
        strace:    { attrs: [ CLI FOSS copyleft ] description: "strace — trace the system calls of a running program." install: [ { via: native } ] }
        ltrace:    { attrs: [ CLI FOSS copyleft ] description: "ltrace — trace the library calls of a running program." install: [ { via: native } ] }
        lldb:      { attrs: [ CLI FOSS permissive ] description: "LLDB — the LLVM project's debugger." install: [ { via: native } ] }
        heaptrack: { attrs: [ CLI GUI app FOSS copyleft ] description: "heaptrack — a heap-memory profiler for C/C++." install: [ { via: native  when: "(debian or redhat or arch or opensuse) and not amzn" } ] }
        clang-tidy: { attrs: [ CLI FOSS permissive ] description: "clang-tidy — C/C++ linter and static analyzer." install: [ { via: native  when: "debian or redhat or arch"  name: { apt: clang-tidy  dnf: clang-tools-extra  pacman: clang } } ] }
        clangd:    { attrs: [ CLI FOSS permissive ] description: "clangd — the LLVM C/C++ language server (LSP)." install: [ { via: native  when: "debian or redhat or arch"  name: { apt: clangd  dnf: clang-tools-extra  pacman: clang } } ] }
        // perf is kernel-coupled and named per-distro: Ubuntu's linux-tools track, Debian's
        // linux-perf (also Proxmox); plain `perf` on redhat/arch/opensuse/alpine.
        perf: { attrs: [ CLI FOSS copyleft ] description: "Linux `perf` — sampling profiler and performance counters." install: [ { via: native  name: { default: perf } }
                           { via: native  when: debian  name: { apt: linux-perf } }
                           { via: native  when: ubuntu  name: { apt: linux-tools-generic } } ] }
        // A one-shot bundle of the core analysis kit. This one IS a parts aggregator (not a profile)
        // because it's OS-conditional — the `when:` gates the whole kit out where some parts are absent.
        analysis: { attrs: [ CLI FOSS copyleft permissive ] description: "Debug & analysis kit — valgrind, cppcheck, clang-tidy, lldb, strace, ltrace." install: [ { via: parts  when: "debian or redhat or arch"  parts: [ valgrind, cppcheck, clang-tidy, lldb, strace, ltrace ] } ] }

        // --- configuration management ---
        // ansible is native everywhere (robust, CLI on PATH — pipx would hide it, since the
        // `ansible` command actually ships in the ansible-core dependency, which pipx won't link).
        // salt is Python with self-contained scripts (pipx). puppet is Ruby (gem). No chef (heavy
        // enterprise tool that also overlaps configsys itself).
        ansible: { attrs: [ CLI FOSS copyleft ] description: "Ansible — agentless IT automation and configuration management." install: [ { via: native  repo-component: universe } ] }
        salt:    { attrs: [ CLI daemon FOSS permissive ] description: "Salt — event-driven automation and configuration management." install: [ { via: pipx  name: salt  version: { pypi: salt } } ] }
        puppet:  { attrs: [ CLI daemon FOSS FOSSish permissive ] description: "Puppet — declarative configuration management." install: [ { via: gem   name: puppet } ] }

        // --- back-end: cloud CLIs, IaC, protobuf, DB clients + servers ---
        // Cloud CLIs via their official installers (script driver, userland).
        awscli: { attrs: [ CLI FOSS permissive account cloud ] suggests: awscli-dotfiles  description: "AWS CLI — the command-line interface for Amazon Web Services."
            requires: [ curl, unzip ]
            install: [ { via: script
                         install-cmd:   'curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o /tmp/awscliv2.zip && unzip -q -o /tmp/awscliv2.zip -d /tmp/awscli-inst && /tmp/awscli-inst/aws/install --update -i "$HOME/.local/aws-cli" -b "$HOME/.local/bin" && rm -rf /tmp/awscliv2.zip /tmp/awscli-inst'
                         version-cmd:   '"$HOME/.local/bin/aws" --version'
                         version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                         uninstall-cmd: 'rm -rf "$HOME/.local/aws-cli" "$HOME/.local/bin/aws" "$HOME/.local/bin/aws_completer"'
                         location:      '~/.local/bin/aws' } ]
        }
        gcloud: { attrs: [ CLI proprietary freeware account cloud ] suggests: gcloud-dotfiles  description: "Google Cloud CLI (`gcloud`) — manage GCP resources."
            requires: curl
            install: [ { via: script
                         install-cmd:   'curl -fsSL https://sdk.cloud.google.com | bash -s -- --disable-prompts --install-dir="$HOME"'
                         version-cmd:   '"$HOME/google-cloud-sdk/bin/gcloud" version'
                         version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                         uninstall-cmd: 'rm -rf "$HOME/google-cloud-sdk"'
                         location:      '~/google-cloud-sdk/bin' } ]
        }
        azure-cli: { attrs: [ CLI FOSS permissive account cloud ] description: "Azure CLI (`az`) — manage Microsoft Azure resources." install: [ { via: pipx  name: azure-cli  version: { pypi: azure-cli } } ] }
        // IaC + gRPC — Go static binaries from github release tarballs.
        opentofu: { attrs: [ CLI app FOSS permissive ] suggests: opentofu-dotfiles  description: "OpenTofu — open-source, Terraform-compatible infrastructure as code." install: [ { via: tarball  installDir: "$CONFIGSYS_APP_DIR/opentofu"  version: { github: opentofu/opentofu  strip-v: true  asset: "tofu_*_linux_amd64.tar.gz" } } ] }
        grpcurl:  { attrs: [ CLI FOSS permissive ] suggests: grpcurl-dotfiles  description: "curl for gRPC — call and inspect gRPC services from the shell." install: [ { via: tarball  installDir: "$CONFIGSYS_APP_DIR/grpcurl"   version: { github: fullstorydev/grpcurl  strip-v: true  asset: "grpcurl_*_linux_x86_64.tar.gz" } } ] }
        protobuf: { attrs: [ CLI toolchain FOSS permissive ] suggests: protobuf-dotfiles  description: "Protocol Buffers compiler (`protoc`)." install: [ { via: native  repo-component: universe  name: { apt: protobuf-compiler  dnf: protobuf-compiler  zypper: protobuf-devel  default: protobuf } }  { via: tarball  installDir: "$CONFIGSYS_APP_DIR/protobuf"  requires: unzip  version: { github: protocolbuffers/protobuf  strip-v: true  asset: "protoc-*-linux-x86_64.zip" } } ] }   // prebuilt protoc + well-known-types include/
        // DB clients: dbeaver (GUI, Flathub), pgcli/mycli (pipx), sqlitebrowser (Flathub).
        dbeaver:       { attrs: [ GUI app FOSS permissive ] description: "Universal database GUI — browse and query many DB engines." install: [ { via: flatpak  hub: flathub  app: io.dbeaver.DBeaverCommunity }  { via: native-pkg-file  when: "debian or redhat"  version: { github: dbeaver/dbeaver }  asset: { deb: { x86_64: "dbeaver-ce-*-linux-x86_64.deb" }  rpm: { x86_64: "dbeaver-ce-*-linux-x86_64.rpm" } } } ] }   // upstream .deb/.rpm (CE)
        pgcli:         { attrs: [ CLI FOSS permissive ] suggests: pgcli-dotfiles  description: "Postgres CLI with autocompletion and syntax highlighting." install: [ { via: pipx  name: pgcli  version: { pypi: pgcli } } ] }
        mycli:         { attrs: [ CLI FOSS permissive ] suggests: mycli-dotfiles  description: "MySQL/MariaDB CLI with autocompletion and highlighting." install: [ { via: pipx  name: mycli  version: { pypi: mycli } } ] }
        sqlitebrowser: { attrs: [ GUI app FOSS copyleft ] description: "GUI to create, design, and edit SQLite databases." install: [ { via: native  when: "debian or fedora or arch or opensuse"  repo-component: universe }  { via: flatpak  hub: flathub  app: org.sqlitebrowser.sqlitebrowser } ] }
        // DB servers: native package + a systemd service (verified on apt/dnf/pacman). NOTE:
        // first-run init differs per distro (Fedora postgres needs `postgresql-setup --initdb`).
        postgresql:         { attrs: [ daemon FOSS permissive ] description: "PostgreSQL — advanced open-source relational database." install: [ { via: native  when: "debian or redhat or arch"  name: { dnf: postgresql-server  default: postgresql } }  { via: native  when: "amzn"  name: postgresql15-server } ] }
        postgresql-service: { description: "Enable and start the PostgreSQL server (systemd)." requires: postgresql  install: [ { via: service  unit: postgresql } ] }
        mariadb:            { attrs: [ daemon CLI FOSS copyleft ] description: "MariaDB — MySQL-compatible relational database." install: [ { via: native  when: "debian or redhat or arch"  name: { pacman: mariadb  default: mariadb-server } }  { via: native  when: "amzn"  name: mariadb1011-server }  { via: native  when: "fedora_atomic"  name: mariadb } ] }   // brew formula `mariadb` (not the distro `-server` split)
        mariadb-service:    { description: "Enable and start the MariaDB server (systemd)." requires: mariadb  install: [ { via: service  unit: mariadb } ] }
        // redis is being replaced by its FOSS fork valkey on Fedora/Arch (drop-in compatible).
        redis:              { attrs: [ daemon CLI FOSS copyleft source-available ] description: "Redis — in-memory data store and cache." install: [ { via: native  when: "debian or redhat or arch"  name: { apt: redis-server  dnf: valkey  pacman: valkey } }  { via: native  when: "fedora_atomic"  name: redis } ] }   // brew formula `redis` (distro repos lean valkey post-relicense; brew keeps redis)
        redis-service:      { description: "Enable and start the Redis server (systemd)." requires: redis  install: [ { via: service  when: "debian"  unit: redis-server }
                                                          { via: service  when: "redhat or arch"  unit: valkey } ] }
        // MongoDB: removed from distro repos over its SSPL license, so it installs from MongoDB's
        // OWN vendor repos (apt keyed per family with a hardcoded codename, dnf on EL) + the AUR
        // binary on Arch. MongoDB ships no Fedora/openSUSE/Amazon repo -> those decline. Version-
        // pathed (8.0) — bump the repo path + key on a major MongoDB bump.
        mongodb: { attrs: [ daemon source-available FOSSish ] description: "MongoDB Community Server — a document (NoSQL) database (`mongod`)."
            install: [
                { via: native  when: "ubuntu"  name: mongodb-org   // MongoDB's official apt repo (Ubuntu). $CODENAME is resolved on the target (Pop!_OS -> its Ubuntu base codename), so this works on any release MongoDB publishes for — not just one hardcoded suite.
                  pubkey-url: "https://www.mongodb.org/static/pgp/server-8.0.asc"  pubkey-path: /usr/share/keyrings/mongodb-server-8.0.asc
                  source-line: "deb [signed-by=/usr/share/keyrings/mongodb-server-8.0.asc] https://repo.mongodb.org/apt/ubuntu $CODENAME/mongodb-org/8.0 multiverse"
                  source-path: /etc/apt/sources.list.d/mongodb-org-8.0.list }
                { via: native  when: "debian"  name: mongodb-org   // MongoDB's official apt repo (Debian); $CODENAME resolved on the target
                  pubkey-url: "https://www.mongodb.org/static/pgp/server-8.0.asc"  pubkey-path: /usr/share/keyrings/mongodb-server-8.0.asc
                  source-line: "deb [signed-by=/usr/share/keyrings/mongodb-server-8.0.asc] https://repo.mongodb.org/apt/debian $CODENAME/mongodb-org/8.0 main"
                  source-path: /etc/apt/sources.list.d/mongodb-org-8.0.list }
                { via: native  when: "rhel"  name: mongodb-org   // MongoDB's official dnf repo (EL only; no Fedora repo)
                  pubkey-url: "https://www.mongodb.org/static/pgp/server-8.0.asc"
                  repo-id: mongodb-org-8.0  repo-name: "MongoDB Repository"
                  repo-url: "https://repo.mongodb.org/yum/redhat/$releasever/mongodb-org/8.0/x86_64/" }
                { via: aur  when: "arch"  name: mongodb-bin } ]   // AUR (prebuilt)
        }
        mongodb-service: { description: "Enable and start the MongoDB server (systemd)." requires: mongodb  install: [ { via: service  unit: mongod } ] }

        // --- science & math ---
        gnuplot:    { attrs: [ CLI app FOSS ] suggests: gnuplot-dotfiles  description: "gnuplot — command-driven plotting for data and functions." install: [ { via: native  repo-component: universe } ] }
        jupyterlab: { attrs: [ web app FOSS permissive ] description: "JupyterLab — notebooks and IDE for data science." install: [ { via: pipx  name: jupyterlab  version: { pypi: jupyterlab } } ] }        // `jupyter-lab` on PATH
        paraview:   { attrs: [ GUI app FOSS permissive ] description: "ParaView — large-scale scientific data visualization." install: [ { via: native  when: "(debian or redhat or arch or opensuse) and not amzn"  repo-component: universe }  { via: flatpak  hub: flathub  app: org.paraview.ParaView } ] }
        maxima:     { attrs: [ CLI app FOSS copyleft ] suggests: maxima-dotfiles  description: "Maxima — a computer algebra system for symbolic math." install: [ { via: native  when: "(debian or redhat or arch or opensuse) and not amzn"  repo-component: universe }  { via: native  when: "fedora_atomic" } ] }   // brew formula `maxima`
        wxmaxima:   { attrs: [ GUI app FOSS copyleft ] description: "wxMaxima — a GUI front end for the Maxima CAS." install: [ { via: native  when: "(debian or redhat) and not amzn"  repo-component: universe }  { via: flatpak  hub: flathub  app: io.github.wxmaxima_developers.wxMaxima } ] }   // native: debian/redhat (Arch AUR only); flatpak covers the rest
        pari:       { attrs: [ CLI app FOSS copyleft ] description: "PARI/GP — computer algebra for number theory." install: [ { via: native  when: "not amzn"   repo-component: universe  name: { apt: pari-gp  dnf: pari-gp  pacman: pari  zypper: pari-gp  default: pari } } ] }
        gap:        { attrs: [ CLI FOSS copyleft ] description: "GAP — a system for computational discrete algebra (group theory)." install: [ { via: native  when: "(debian or redhat or arch or opensuse) and not amzn"  repo-component: universe }  { via: native  when: "fedora_atomic" } ] }   // brew formula `gap`
        sagemath:   { attrs: [ CLI web app FOSS copyleft ] description: "SageMath — an open-source mathematics software system." install: [ { via: native  when: "debian or arch"  repo-component: universe } ] }      // Fedora: COPR/conda only

        // LaTeX (TeX Live) — the recommended subset vs the full multi-GB distribution.
        texlive:      { attrs: [ CLI FOSS permissive ] description: "TeX Live — the TeX/LaTeX typesetting distribution." install: [ { via: native  when: "debian or redhat or arch"  name: { apt: texlive-latex-recommended  dnf: texlive-scheme-medium  pacman: texlive-latexrecommended }  }  { via: native  when: "fedora_atomic"  name: texlive } ] }   // brew formula `texlive`
        texlive-full: { attrs: [ CLI FOSS permissive ] description: "TeX Live (full) — the complete TeX/LaTeX distribution." install: [ { via: native  when: "debian or redhat or arch"  name: { apt: texlive-full  dnf: texlive-scheme-full  pacman: texlive-meta } } ] }

        // Miniforge — a conda env manager (the right home for the numpy/scipy/pandas stack).
        miniforge: { attrs: [ CLI FOSS permissive ] suggests: miniforge-dotfiles  description: "Miniforge — a minimal conda installer (conda-forge default)."
            requires: curl
            install: [ { via: script
                         install-cmd:   'curl -fsSL "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh" -o /tmp/mf.sh && bash /tmp/mf.sh -b -p "$HOME/miniforge3" && rm -f /tmp/mf.sh'
                         version-cmd:   '"$HOME/miniforge3/bin/conda" --version'
                         version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                         uninstall-cmd: 'rm -rf "$HOME/miniforge3"'
                         location:      '~/miniforge3/bin' } ]
        }

        arduino: { attrs: [ GUI app electron FOSS copyleft ] description: "Arduino IDE — program Arduino microcontrollers."
            suggests: arduino-dotfiles
            install: [ { via: appImage  name: "Arduino IDE"
                         version: { github: arduino/arduino-ide  asset: "arduino-ide_*_Linux_64bit.AppImage" }
                         url: "https://github.com/arduino/arduino-ide/releases/download/$VERSION/arduino-ide_$VERSION_Linux_64bit.AppImage"
                         path: ~/apps/arduino-ide.appimage }
                       { via: flatpak  hub: flathub  app: cc.arduino.IDE2 } ]
        }
        arduino-dotfiles: { description: "Arduino config, linked into place."
            install: [ { via: dotfiles  requires: bash-dotfiles  glue: arduino } ]
        }

        // --- parts: composition (a component that IS several others, no unit of its own) ---
        // Distro-specific vulkan building blocks — only pulled as `parts` of vulkan-runtime on
        // their own family, so `when:`-gated (installing one directly on the wrong distro fails).
        libvulkan1:            { attrs: [ lib FOSS permissive ] description: "Vulkan loader runtime (libvulkan)." install: [ { via: native  when: "debian" } ] }
        vulkan-loader:         { attrs: [ lib FOSS permissive ] description: "Vulkan loader — the Vulkan ICD loader runtime." install: [ { via: native  when: "redhat" } ] }
        vulkan-icd-loader:     { attrs: [ lib FOSS permissive ] description: "Vulkan ICD loader (Arch's libvulkan)." install: [ { via: native  when: "arch" } ] }
        vulkan-radeon:         { attrs: [ driver FOSS permissive ] description: "Mesa Vulkan driver for AMD GPUs (RADV)." install: [ { via: native  when: "arch" } ] }
        vulkan-intel:          { attrs: [ driver FOSS permissive ] description: "Mesa Vulkan driver for Intel GPUs (ANV)." install: [ { via: native  when: "arch" } ] }
        vulkan-swrast:         { attrs: [ driver FOSS permissive ] description: "Mesa software (CPU) Vulkan rasterizer (lavapipe)." install: [ { via: native  when: "arch" } ] }
        mesa-vulkan-drivers:   { attrs: [ driver FOSS permissive ] description: "Mesa Vulkan drivers — open-source Vulkan for Intel/AMD." install: [ { via: native  when: "debian or redhat" } ] }
        vulkan-runtime: { attrs: [ lib runtime FOSS permissive ] description: "Vulkan runtime libraries."
            install: [
                { via: parts  when: "debian"  parts: [ libvulkan1, mesa-vulkan-drivers ] }
                { via: parts  when: "redhat"  parts: [ vulkan-loader, mesa-vulkan-drivers ] }  // fedora + EL
                { via: parts  when: "arch"    parts: [ vulkan-icd-loader, vulkan-radeon, vulkan-intel, vulkan-swrast ] }
            ]
        }

        // --- tarball + composition: the vulkan SDK and the vulkan-dev bundle ---
        // vulkan-sdk is ONE component that is both a tarball unit AND an inline config
        // dotfile (dotfiles\vulkan-sdk), keyed by the component; the tarball driver
        // pulls curl. (Old: a [tarball\vulkan-sdk, dotfiles\vulkan-sdk] list bundle.)
        vulkan-sdk: { attrs: [ SDK FOSS permissive ] description: "Vulkan SDK — headers, tools, and validation layers."
            suggests: vulkan-sdk-dotfiles
            install: [ { via: tarball  version: { static: 1.4.350.1 }  installDir: "$CONFIGSYS_SDK_DIR/vulkan"  requires: glibc   // glibc-linked SDK
                         url: "https://sdk.lunarg.com/sdk/download/$VERSION/linux/vulkansdk-linux-$ARCH-$VERSION.tar.xz" } ]
        }
        vulkan-sdk-dotfiles: { description: "Vulkan SDK env config, linked into place."
            install: [ { via: dotfiles  requires: bash-dotfiles
                         glue: vulkan-sdk } ]
        }
        // vulkan-dev X libs, per OS: Debian ships three; Fedora's libxcb-devel bundles
        // xinput+xinerama (+ xcb-util-cursor-devel); Arch's libxcb does likewise (+ xcb-util-cursor).
        libxcb-xinput0:        { attrs: [ lib FOSS permissive ] description: "libxcb XInput extension runtime library." install: [ { via: native  when: "debian"  repo-component: universe } ] }
        libxcb-xinerama0:      { attrs: [ lib FOSS permissive ] description: "libxcb Xinerama extension runtime library." install: [ { via: native  when: "debian"  repo-component: universe } ] }
        libxcb-cursor-dev:     { attrs: [ lib FOSS permissive ] description: "libxcb-cursor development headers." install: [ { via: native  when: "debian"  repo-component: universe } ] }
        libxcb-devel:          { attrs: [ lib FOSS permissive ] description: "libxcb development headers." install: [ { via: native  when: "redhat" } ] }   // fedora + EL
        xcb-util-cursor-devel: { attrs: [ lib FOSS permissive ] description: "xcb-util-cursor development headers." install: [ { via: native  when: "redhat" } ] }   // fedora + EL
        libxcb:                { attrs: [ lib FOSS permissive ] description: "libxcb — the X protocol C-language binding." install: [ { via: native  when: "arch" } ] }   // arch
        xcb-util-cursor:       { attrs: [ lib FOSS permissive ] description: "xcb-util-cursor — XCB cursor management library." install: [ { via: native  when: "arch" } ] }   // arch
        // vulkan-dev: a parts bundle composing the X libs, build tools, the SDK tarball,
        // and the vulkan runtime (itself a parts aggregator). One binding per OS family;
        // cpp-toolchain pulls the C/C++ compiler (portable across families).
        vulkan-dev: { attrs: [ lib FOSS permissive ] description: "Vulkan development headers and validation layers."
            install: [
                { via: parts  when: "debian"
                  parts: [ libxcb-xinput0, libxcb-xinerama0, libxcb-cursor-dev,
                           cpp-toolchain, make, vulkan-sdk, vulkan-runtime ] }
                { via: parts  when: "redhat"
                  parts: [ libxcb-devel, xcb-util-cursor-devel,
                           cpp-toolchain, make, vulkan-sdk, vulkan-runtime ] }
                { via: parts  when: "arch"
                  parts: [ libxcb, xcb-util-cursor,
                           cpp-toolchain, make, vulkan-sdk, vulkan-runtime ] }
            ]
        }

        // --- github .deb where no repo has it, native package elsewhere (cpu-keyed asset) ---
        fastfetch: { attrs: [ CLI FOSS permissive ] suggests: fastfetch-dotfiles 
            description: "System info fetcher — the logo + specs banner (neofetch-style)."
            install: [
                // Debian/Ubuntu don't carry fastfetch in-repo (absent through 22.04/24.04/bookworm),
                // but upstream ships an official .deb — install THAT via the OS package tool. It's a
                // distinct, opt-in method from `native` (it doesn't ride `apt upgrade`); here it's the
                // debian-family default because there is no repo package to prefer. (Relax the bare
                // `native` gate below to a version bound once debian-family broadly ships it in-repo.)
                { via: native-pkg-file  when: "debian"
                  version: { github: fastfetch-cli/fastfetch }
                  asset: { x86_64: fastfetch-linux-amd64.deb  aarch64: fastfetch-linux-aarch64.deb } }
                { via: native  when: "rhel"  requires: epel }   // EL ships fastfetch in EPEL
                { via: native  when: "(not debian) and not amzn" }             // arch/fedora/suse/... carry it in-repo
            ]
        }

        // --- toolchain (portable, descriptive capabilities) ---
        // `cc` = a C compiler, `cxx` = a C++ compiler. Source-build components COMPOSE these
        // (requires: cxx, cmake, ninja, ...); `cxx requires: cc`, so C++ reuses the C toolchain.
        // One definition across every family — this replaces the old apt-named `build-essential`,
        // which was Debian-*package*-building essentials (it pulls dpkg-dev), not an app toolchain.
        // Alpine bundles the whole kit in `build-base` (pulls musl-dev headers); on Arch/Void the
        // `gcc` package bundles g++. `make`/`cmake`/`ninja` stay separate, composable build tools.
        // (Versioned/standard selection — requires: C++20, or gcc-15 by name — is a later layer;
        // for now cc/cxx are the system default compiler, which handles modern C++ on any current
        // distro.)
        c-toolchain: { attrs: [ CLI toolchain FOSS copyleft GNU ] description: "C toolchain (cc) — compiler and make for building C."
            provides: cc
            install: [
                { via: native  when: "alpine"  name: build-base }   // gcc + g++ + make + musl-dev
                { via: native  name: gcc }                          // else: gcc (pulls libc dev headers)
            ]
        }
        cpp-toolchain: { attrs: [ CLI toolchain FOSS copyleft GNU ] description: "C++ toolchain — compiler and make for building C++."
            provides: cxx
            requires: cc
            install: [
                { via: native  when: "alpine"  name: build-base }
                { via: native  when: "redhat or opensuse"  name: "gcc-c++" }
                { via: native  when: "debian"  name: "g++" }
                { via: native  name: gcc }   // default: gcc bundles g++ (arch, brew, and plugin OSes like Void)
            ]
        }

        // --- C++ standard library (a separate capability from the compiler) ---
        // g++ BUNDLES its stdlib (libstdc++), so cpp-toolchain needs nothing extra. clang does NOT
        // ship a stdlib: on Linux it defaults to GCC's libstdc++, and can opt into LLVM's libc++ with
        // `-stdlib=libc++`. So clang `requires: [ cc, cxx-stdlib ]` — the gcc C toolchain (clang uses
        // gcc's crt*.o + libgcc on Linux regardless of stdlib) plus *a* C++ standard library, but NOT
        // the g++ compiler (EXCEPT on Debian — see the libstdc++ component: its default C++ dev
        // headers are only installable via g++). `cxx-stdlib` defaults to libstdc++ (below, non-opt-in); to build with
        // libc++ instead, install `libc++` and provider-pin `cxx-stdlib: libc++` (then pass
        // -stdlib=libc++ — configsys installs the library, your build selects it). The two stdlibs are
        // NOT ABI-compatible with each other; g++ can only use libstdc++, clang can use either.
        //
        // Compiler VERSION and library VERSION are chosen INDEPENDENTLY, and this is capability-
        // based (nothing here assumes apt or update-alternatives). Every versioned compiler
        // resolves `cxx-stdlib` to the SAME provider — the system's default libstdc++ unless you
        // pin otherwise — so e.g. clang-18 and clang-20 SHARE one standard library; installing a
        // newer clang does NOT bring a newer library. A compiler's `C++NN` labels (on the
        // gcc-NN/clang-NN components below) describe its FRONT-END language mode, not a guarantee
        // of library features — those track whatever `cxx-stdlib` resolved to. Sharing is
        // order-independent: the compiler and the stdlib pull the same library, whichever is
        // installed first. To move the LIBRARY forward, change that provider, not the compiler:
        // install/prefer a newer libstdc++ (whatever your package manager names it), or
        // provider-pin `cxx-stdlib: libc++`, whose version DOES track clang. (clang also pulls the
        // gcc C toolchain — `c-toolchain`, for crt/libgcc — but not the g++ compiler; that split is
        // the whole point of requiring `cxx-stdlib` rather than `cxx`. The one exception is Debian,
        // whose default libstdc++ dev headers ship only with g++ — pin cxx-stdlib: libc++ to skip it.)
        libstdc++: { attrs: [ lib FOSS GNU copyleft ] description: "GNU libstdc++ — the GCC C++ standard library runtime."                                  // GNU C++ stdlib (clang's default on Linux)
            provides: [ cxx-stdlib, libstdc++ ]
            install: [
                // On Debian `libstdc++-dev` is a VIRTUAL package — many libstdc++-N-dev providers,
                // no default candidate, so apt refuses to install it. The default C++ stdlib dev
                // headers ship WITH g++ (g++ -> g++-N -> libstdc++-N-dev, tracking the system's
                // default gcc), and there is no standalone "default libstdc++ dev" package. So here
                // (only on distros without a concrete package) satisfying `cxx-stdlib` DOES pull
                // g++. To keep clang off g++ on Debian, provider-pin `cxx-stdlib: libc++` (LLVM's
                // stdlib — no libstdc++/g++ at all).
                { via: native  when: "debian"  name: "g++" }
                { via: native  when: "alpine"  name: "g++" }        // Alpine also ships C++ headers via g++
                { via: native  when: "redhat or opensuse"  name: "libstdc++-devel" }   // concrete package
                { via: native  name: gcc }            // arch etc.: the C++ headers ship in the gcc package
            ]
        }
        libc++: { attrs: [ lib FOSS permissive ] description: "LLVM libc++ — the Clang C++ standard library runtime."                                     // LLVM C++ stdlib — opt-in; build with -stdlib=libc++
            provides: [ cxx-stdlib, libc++ ]
            standing: never-auto
            suggests: libc++abi                       // soft: the split ABI dev package (bundled on Alpine)
            install: [ { via: native  when: "not amzn"   name: { apt: libc++-dev  dnf: libcxx-devel  zypper: libc++-devel
                                              pacman: libc++  apk: libc++-dev } } ]
        }
        libc++abi: { attrs: [ lib FOSS permissive ] description: "LLVM libc++abi — libc++'s low-level ABI support."                                  // LLVM libc++abi dev — a separate package except on Alpine
            install: [ { via: native  when: "(not alpine) and not amzn"  name: { apt: libc++abi-dev  dnf: libcxxabi-devel
                                                                  zypper: libc++abi-devel  pacman: libc++abi } } ]
        }

        // software-properties-common is a software package in Ubuntu and Debian that provides
        // the add-apt-repository script. It allows users to easily manage independent software
        // sources and PPAs (Personal Package Archives) without manually editing the
        // /etc/apt/sources.list file.
        software-properties-common: { attrs: [ CLI FOSS copyleft ] description: "add-apt-repository and friends — manage APT repos." install: [ { via: native when: debian } ] }

        // gdb: base-repo native everywhere (apt main / dnf base / pacman extra; EL base, no
        // EPEL), plus its shell-startup dotfile.
        gdb: { attrs: [ CLI FOSS GNU copyleft ] description: "GNU Debugger — the standard C/C++/… debugger."
            suggests: gdb-dotfiles
            install: [ { via: native } ]
        }
        gdb-dotfiles: { description: "GDB config (.gdbinit), linked into place."   // gdb reads ~/.gdbinit natively (no bash-dotfiles loader needed)
            install: [ { via: dotfiles  src: gdbinit  dst: ~/.gdbinit } ]
        }

        // --- AUR: packages built from PKGBUILD via makepkg -si (Arch only). The `aur`
        // driver pulls base-devel + git (the build toolchain); yay is the AUR helper
        // itself, prebuilt (-bin). Guarded to arch — the driver has no meaning elsewhere.
        base-devel: { attrs: [ CLI toolchain FOSS copyleft ] description: "Arch base-devel group — build tools for compiling packages." install: [ { via: native when: "arch" } ] }
        yay: { attrs: [ CLI FOSS copyleft ] description: "yay — an AUR helper for Arch (pacman-like AUR installs)."
            install: [ { via: aur  when: "arch"  name: yay-bin  version: { aur: yay-bin } } ]
        }

        // gcc-select: the `update-alternatives --config gcc` alias dotfile (Debian only) —
        // required by the versioned gcc-NN toolchains so `gcc` points at the chosen one. (The plain
        // C/C++ compiler is now `c-toolchain`/`cpp-toolchain` above, which supersede the old `gcc`
        // and `gcc-cpp` components that only existed to feed `build-essential`.)
        gcc-select: { attrs: [ CLI FOSS ] description: "Shell alias to switch the default gcc version (update-alternatives)."
            install: [ { via: dotfiles  when: "debian"  requires: bash-dotfiles
                         glue: gcc } ]
        }

        // --- versioned gcc. Three drivers, selected by OS/version:
        //   debian -> `gcc` (apt PPA + update-alternatives; needs cxx, s-p-c, the alias)
        //   fedora -> `gcc` (dnf compat packages gccNN; availability is per-release)
        //   EL     -> `gcc-toolset` (SCL under /opt/rh)
        // --- versioned gcc. Each also `provides:` the language-standard capabilities its compiler
        // supports (`cc`/`cxx` = a C/C++ compiler; C11/C17/C23 and "C++17"/"C++20"/... = a compiler
        // that accepts that `-std=`), so a build can `requires: "C++20"` (or `cc`, or pin `gcc-15`)
        // and get a compiler that satisfies it. All are `standing: never-auto`: they satisfy a plain
        // `requires: cxx` ONLY when explicitly wanted / provider-pinned — otherwise the unversioned
        // `cpp-toolchain` (the system default compiler) wins and there's no ambiguity. The provides
        // are capability LABELS (the `-std` mode exists + is substantially usable), easy to hand-tune
        // per real support; the newest standards (C++26) are the most likely to want adjusting.
        // Older lines (10/11/12) are useful as pinned HOST compilers for toolchains that reject a
        // too-new gcc — notably CUDA's nvcc (points nvcc at gcc-10), and OpenCV's CUDA-11 build
        // (requires: gcc-10) and Blender 4.3 (requires: gcc-11), both in their plugins. Availability
        // of a DOWNLEVEL (older-than-default) gcc, the shared story those consumers refer back to:
        //   debian/ubuntu -> parallel apt packages (ubuntu-toolchain-r PPA); additive, no rollback.
        //   rhel/EL       -> the gcc-toolset-NN SCL under /opt/rh; isolated from the system gcc.
        //   fedora/arch   -> NOT carried: their repos ship only the latest gcc, and no clean COPR/AUR
        //                    parallel gccNN lands at /usr/bin/gcc-NN. So a downlevel pin there is an
        //                    honest unmet-require at resolve/check time — not a rollback, not a
        //                    mid-build failure — until it's built from source. (fedora DOES carry the
        //                    near-default compat gccNN used by the `when: "fedora = NN"` bindings
        //                    below; that's a native package, not a downlevel side-install.)
        gcc-10: { attrs: [ toolchain FOSS GNU copyleft ] description: "GCC 10 — the GNU Compiler Collection, version 10."
            provides: [ cc, cxx, C11, C17, "C++17", "C++20" ]
            standing: never-auto
            install: [
                { via: gcc  when: "debian"  packages: [ gcc-10, g++-10 ]  slaves: [ g++ ]  ppa: ubuntu-toolchain-r/test
                  requires: [ cxx, software-properties-common ]  suggests: gcc-select }
                { via: gcc-toolset  when: "rhel" }
            ]
        }
        gcc-11: { attrs: [ toolchain FOSS GNU copyleft ] description: "GCC 11 — the GNU Compiler Collection, version 11."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23" ]
            standing: never-auto
            install: [
                { via: gcc  when: "debian"  packages: [ gcc-11, g++-11 ]  slaves: [ g++ ]  ppa: ubuntu-toolchain-r/test
                  requires: [ cxx, software-properties-common ]  suggests: gcc-select }
                { via: gcc-toolset  when: "rhel" }
            ]
        }
        gcc-12: { attrs: [ toolchain FOSS GNU copyleft ] description: "GCC 12 — the GNU Compiler Collection, version 12."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23" ]
            standing: never-auto
            install: [
                { via: gcc  when: "debian"  packages: [ gcc-12, g++-12 ]  slaves: [ g++ ]  ppa: ubuntu-toolchain-r/test
                  requires: [ cxx, software-properties-common ]  suggests: gcc-select }
                { via: gcc-toolset  when: "rhel" }
            ]
        }
        gcc-13: { attrs: [ toolchain FOSS GNU copyleft ] description: "GCC 13 — the GNU Compiler Collection, version 13."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23" ]
            standing: never-auto
            install: [
                { via: gcc  when: "debian"  packages: [ gcc-13, g++-13 ]  slaves: [ g++ ]  ppa: ubuntu-toolchain-r/test
                  requires: [ cxx, software-properties-common ]  suggests: gcc-select }
                { via: gcc  when: "fedora = 41"  packages: [ gcc13, gcc13-c++ ] }
                { via: gcc-toolset  when: "rhel" }
            ]
        }
        gcc-14: { attrs: [ toolchain FOSS GNU copyleft ] description: "GCC 14 — the GNU Compiler Collection, version 14."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23" ]
            standing: never-auto
            install: [
                { via: gcc  when: "debian"  packages: [ gcc-14, g++-14 ]  slaves: [ g++ ]  ppa: ubuntu-toolchain-r/test
                  requires: [ cxx, software-properties-common ]  suggests: gcc-select }
                { via: gcc  when: "fedora = 42"  packages: [ gcc14, gcc14-c++ ] }
                { via: gcc-toolset  when: "rhel" }
            ]
        }
        gcc-15: { attrs: [ toolchain FOSS GNU copyleft ] description: "GCC 15 — the GNU Compiler Collection, version 15."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23", "C++26" ]
            standing: never-auto
            install: [
                { via: gcc  when: "debian"  packages: [ gcc-15, g++-15 ]  slaves: [ g++ ]  ppa: ubuntu-toolchain-r/test
                  requires: [ cxx, software-properties-common ]  suggests: gcc-select }
                { via: gcc-toolset  when: "rhel" }
            ]
        }

        // --- versioned clang. `clang` driver = native PM + update-alternatives:
        //   debian -> apt.llvm.org + alternatives (curl for the key; + the alias)
        //   fedora -> dnf compat clangNN (per-release; the system clang covers the newest)
        //   EL     -> dnf compat clangNN from EPEL (requires epel)
        clang-select: { attrs: [ CLI FOSS ] description: "Shell alias to switch the default clang version (update-alternatives)."             // the `update-alternatives --config clang` alias dotfile
            requires: bash-dotfiles
            install: [ { via: dotfiles  when: "debian"  glue: clang } ]
        }
        // clang ships no C++ stdlib and, on Linux, no C runtime of its own: it uses GCC's crt*.o +
        // libgcc (hence `requires: c-toolchain` — the gcc toolchain COMPONENT, not the g++ compiler)
        // and defaults to GCC's libstdc++ (hence `requires: cxx-stdlib`, which resolves to the
        // libstdc++ component; provider-pin it to libc++ to build with -stdlib=libc++). It requires
        // the c-toolchain *component* rather than the `cc` capability on purpose: clang itself
        // `provides: cc` (opt-in), so requiring the capability would let it self-satisfy and never
        // pull gcc. It provides a C/C++ compiler + the standard labels (opt-in, same rule as gcc-NN).
        clang-18: { attrs: [ CLI toolchain FOSS permissive ] description: "Clang/LLVM 18 — C/C++/Obj-C compiler, version 18."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23" ]
            standing: never-auto
            requires: [ c-toolchain, cxx-stdlib ]
            install: [
                { via: clang  when: "debian"  packages: [ clang-18 ]
                  requires: curl  suggests: clang-select }
                { via: clang  when: "fedora"  packages: [ clang18 ] }
            ]
        }
        clang-19: { attrs: [ CLI toolchain FOSS permissive ] description: "Clang/LLVM 19 — C/C++/Obj-C compiler, version 19."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23" ]
            standing: never-auto
            requires: [ c-toolchain, cxx-stdlib ]
            install: [
                { via: clang  when: "debian"  packages: [ clang-19 ]
                  requires: curl  suggests: clang-select }
                { via: clang  when: "fedora = 41"  packages: [ clang ] }      // system clang -> /usr/bin/clang-19
                { via: clang  when: "fedora = 42"  packages: [ clang19 ] }
                { via: clang  when: "rhel"  packages: [ clang19 ]  requires: epel }
            ]
        }
        clang-20: { attrs: [ CLI toolchain FOSS permissive ] description: "Clang/LLVM 20 — C/C++/Obj-C compiler, version 20."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23", "C++26" ]
            standing: never-auto
            requires: [ c-toolchain, cxx-stdlib ]
            install: [
                { via: clang  when: "debian"  packages: [ clang-20 ]
                  requires: curl  suggests: clang-select }
                { via: clang  when: "fedora = 42"  packages: [ clang ] }      // system clang -> /usr/bin/clang-20
                { via: clang  when: "rhel"  packages: [ clang20 ]  requires: epel }
            ]
        }

        // ===================== C/C++ libraries + GUI toolkits =====================
        // Dev packages (headers + libs). Native names are gated to the distros whose package name
        // is known-good; openSUSE / brew / others are extendable later (their split/renamed packages
        // need a per-manager name). folly + EASTL aren't packaged in the mainstream repos — they get
        // what IS available (Fedora / the AUR) and decline elsewhere (build from source there).
        boost: { attrs: [ lib FOSS permissive ] description: "Boost — peer-reviewed, portable C++ source libraries (dev)."
            install: [ { via: native  when: "debian or redhat or arch or alpine"  repo-component: universe
                         name: { apt: libboost-all-dev  dnf: boost-devel  pacman: boost  apk: boost-dev } } ]
        }
        abseil: { attrs: [ lib FOSS permissive ] description: "Abseil — Google's C++ common libraries (dev)."
            install: [ { via: native  when: "debian or redhat or arch or alpine"  repo-component: universe
                         name: { apt: libabsl-dev  dnf: abseil-cpp-devel  pacman: abseil-cpp  apk: abseil-cpp-dev } } ]
        }
        folly: { attrs: [ lib FOSS permissive ] description: "Folly — Facebook's C++ utility library (dev)."
            install: [ { via: native  when: "fedora"  name: folly-devel }        // Fedora repos (not EL)
                       { via: aur     when: "arch"    name: folly } ]             // Arch: AUR
        }
        eastl: { attrs: [ lib FOSS permissive ] description: "EASTL — Electronic Arts' STL implementation (dev)."
            install: [ { via: aur  when: "arch"  name: eastl } ]                  // AUR only; vendor/source elsewhere
        }
        qt: { attrs: [ lib SDK FOSS FOSSish copyleft ] description: "Qt 6 — cross-platform C++ application framework (Qt Base, dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine) and not amzn"  repo-component: universe
                         name: { apt: qt6-base-dev  dnf: qt6-qtbase-devel  pacman: qt6-base  apk: qt6-qtbase-dev } } ]
        }
        gtk: { attrs: [ lib FOSS copyleft ] description: "GTK 4 — the GTK GUI toolkit (dev)."
            install: [ { via: native  when: "debian or redhat or arch or alpine"  repo-component: universe
                         name: { apt: libgtk-4-dev  dnf: gtk4-devel  pacman: gtk4  apk: gtk4.0-dev } } ]
        }
        gtkmm: { attrs: [ lib FOSS copyleft ] description: "gtkmm — the C++ bindings for GTK (dev; GTK 4 where packaged, else GTK 3)."
            requires: gtk
            // gtkmm-4.0 isn't in the Ubuntu repos before 24.04 (nor Debian < 13) — fall back to the
            // GTK3 bindings there so it still resolves, rather than 404 on libgtkmm-4.0-dev.
            // 4.0 is the default across the debian subtree; the OLD releases that predate it
            // (ubuntu < 24.04, debian < 13) explicitly fall back to the GTK3 bindings. Written this
            // way so a derivative whose version isn't an ubuntu/debian number (elementary, …) still
            // gets 4.0 rather than dropping out.
            install: [ { via: native  when: "debian and not ((ubuntu < 24.04) or (debian < 13))"  repo-component: universe  name: { apt: libgtkmm-4.0-dev } }
                       { via: native  when: "(ubuntu < 24.04) or (debian < 13)"                    repo-component: universe  name: { apt: libgtkmm-3.0-dev } }
                       { via: native  when: "redhat and not amzn"  name: { dnf: gtkmm4.0-devel } }
                       { via: native  when: "arch"  name: { pacman: gtkmm-4.0 } } ]
        }

        // --- graphics dev SDKs (dev headers + libs) ---
        // OpenGL is a per-distro parts bundle (GL + GLU) — no single `opengl` package. No brew (macOS
        // ships GL as a deprecated system framework).
        opengl: { attrs: [ lib FOSS permissive ] description: "OpenGL development environment — GL + GLU headers and libraries."
            // `packages:` installs the whole set; `installed-name:` gives state-detection one member
            // to probe (there is no `opengl` package — apt now READS `packages:`, where before it
            // silently fell back to the component name and tried to install `opengl`).
            install: [ { via: native  when: "debian"    packages: [ libgl1-mesa-dev, libglu1-mesa-dev ]  installed-name: libgl1-mesa-dev }
                       { via: native  when: "(redhat) and not amzn"    packages: [ mesa-libGL-devel, mesa-libGLU-devel ]  installed-name: mesa-libGL-devel }
                       { via: native  when: "arch"      packages: [ mesa, glu ]        installed-name: mesa }
                       { via: native  when: "alpine"    packages: [ mesa-dev, glu-dev ]  installed-name: mesa-dev }
                       { via: native  when: "opensuse"  packages: [ Mesa-libGL-devel, glu-devel ]  installed-name: Mesa-libGL-devel } ]
        }
        glfw: { attrs: [ lib FOSS permissive ] description: "GLFW — multi-platform OpenGL/Vulkan window & input library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"  repo-component: universe
                         name: { apt: libglfw3-dev  dnf: glfw-devel  pacman: glfw  apk: glfw-dev  zypper: libglfw-devel  brew: glfw } } ]
        }
        glew: { attrs: [ lib FOSS permissive ] description: "GLEW — the OpenGL Extension Wrangler library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"  repo-component: universe
                         name: { apt: libglew-dev  dnf: glew-devel  pacman: glew  apk: glew-dev  zypper: glew-devel  brew: glew } } ] }
        glm: { attrs: [ lib FOSS permissive ] description: "GLM — OpenGL Mathematics, a header-only C++ math library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"  repo-component: universe
                         name: { apt: libglm-dev  dnf: glm-devel  pacman: glm  apk: glm-dev  zypper: glm-devel  brew: glm } } ] }
        libsecret: { attrs: [ lib FOSS copyleft ] description: "libsecret — the GNOME secret-service client library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libsecret-1-dev  dnf: libsecret-devel  pacman: libsecret  apk: libsecret-dev  zypper: libsecret-devel  brew: libsecret } } ] }
        libgit2: { attrs: [ lib FOSS permissive ] description: "libgit2 — a portable C implementation of the Git core methods (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"  repo-component: universe
                         name: { apt: libgit2-dev  dnf: libgit2-devel  pacman: libgit2  apk: libgit2-dev  zypper: libgit2-devel  brew: libgit2 } } ] }
        dbus-dev: { attrs: [ lib FOSS ] description: "D-Bus development headers (libdbus-1)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libdbus-1-dev  dnf: dbus-devel  pacman: dbus  apk: dbus-dev  zypper: dbus-1-devel  brew: dbus } } ] }
        gtk3: { attrs: [ lib FOSS copyleft ] description: "GTK 3 — the GTK 3 GUI toolkit (dev; distinct from `gtk`, which is GTK 4)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"  repo-component: universe
                         name: { apt: libgtk-3-dev  dnf: gtk3-devel  pacman: gtk3  apk: "gtk+3.0-dev"  zypper: gtk3-devel  brew: "gtk+3" } } ] }
        libxi: { attrs: [ lib FOSS permissive ] description: "libXi — X11 Input-extension client library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libxi-dev  dnf: libXi-devel  pacman: libxi  apk: libxi-dev  zypper: libXi-devel  brew: libxi } } ] }
        libxcursor: { attrs: [ lib FOSS permissive ] description: "libXcursor — X11 cursor-management library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libxcursor-dev  dnf: libXcursor-devel  pacman: libxcursor  apk: libxcursor-dev  zypper: libXcursor-devel  brew: libxcursor } } ] }
        libxrandr: { attrs: [ lib FOSS permissive ] description: "libXrandr — X11 RandR (resize/rotate) client library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libxrandr-dev  dnf: libXrandr-devel  pacman: libxrandr  apk: libxrandr-dev  zypper: libXrandr-devel  brew: libxrandr } } ] }
        libxxf86vm: { attrs: [ lib FOSS permissive ] description: "libXxf86vm — X11 XFree86-VidMode extension library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libxxf86vm-dev  dnf: libXxf86vm-devel  pacman: libxxf86vm  apk: libxxf86vm-dev  zypper: libXxf86vm-devel  brew: libxxf86vm } } ] }
        libdecor: { attrs: [ lib FOSS permissive ] description: "libdecor — client-side window decorations for Wayland (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse) and not amzn"
                         name: { apt: libdecor-0-dev  dnf: libdecor-devel  pacman: libdecor  apk: libdecor-dev  zypper: libdecor-devel } } ] }   // Wayland/Linux; not on brew
        nng: { attrs: [ lib FOSS permissive ] description: "nng — the nanomsg-next-gen lightweight messaging library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libnng-dev  dnf: nng-devel  pacman: nng  apk: nng-dev  zypper: libnng-devel  brew: nng } } ] }
        unixodbc: { attrs: [ lib FOSS copyleft ] description: "unixODBC — the ODBC driver manager for Unix (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: unixodbc-dev  dnf: unixODBC-devel  pacman: unixodbc  apk: unixodbc-dev  zypper: unixODBC-devel  brew: unixodbc } } ] }
        egl: { attrs: [ lib FOSS permissive ] description: "EGL — the native-platform interface between OpenGL/GLES and the window system (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse) and not amzn"
                         name: { apt: libegl-dev  dnf: mesa-libEGL-devel  pacman: mesa  apk: mesa-dev  zypper: Mesa-libEGL-devel } } ] }   // Linux graphics; not on brew
        wxwidgets: { attrs: [ lib FOSS FOSSish ] description: "wxWidgets (wxGTK) — a cross-platform C++ GUI toolkit (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"  repo-component: universe
                         name: { apt: libwxgtk3.2-dev  dnf: wxGTK-devel  pacman: wxwidgets-gtk3  apk: wxwidgets-dev  zypper: "wxWidgets-3_2-devel"  brew: wxwidgets } } ] }   // apt name is release-specific (3.2 on 22.04+; older ships 3.0)
        opencascade: { attrs: [ lib FOSS copyleft ] description: "Open CASCADE Technology (OCCT) — a 3D CAD/CAM/CAE geometric modeling kernel (dev)."
            install: [ { via: native  when: "debian"    packages: [ libocct-foundation-dev, libocct-modeling-algorithms-dev, libocct-modeling-data-dev,
                             libocct-ocaf-dev, libocct-visualization-dev, libocct-data-exchange-dev ]  installed-name: libocct-foundation-dev }
                       { via: native  when: "fedora"    name: opencascade-devel }
                       { via: native  when: "arch"      name: opencascade }
                       { via: native  when: "opensuse"  name: opencascade-devel } ] }   // not in EL base / alpine / brew
        // --- more common -dev build libraries (compact name-map form; NAMESWEEP PENDING) ---
        x11: { attrs: [ lib FOSS permissive ] description: "libX11 — the core X11 client library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libx11-dev  dnf: libX11-devel  pacman: libx11  apk: libx11-dev  zypper: libX11-devel  brew: libx11 } } ] }
        xinerama: { attrs: [ lib FOSS permissive ] description: "libXinerama — X11 multi-monitor (Xinerama) extension library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libxinerama-dev  dnf: libXinerama-devel  pacman: libxinerama  apk: libxinerama-dev  zypper: libXinerama-devel  brew: libxinerama } } ] }
        xkbcommon: { attrs: [ lib FOSS permissive ] description: "libxkbcommon — keyboard-keymap handling for X11/Wayland (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libxkbcommon-dev  dnf: libxkbcommon-devel  pacman: libxkbcommon  apk: libxkbcommon-dev  zypper: libxkbcommon-devel  brew: libxkbcommon } } ] }
        wayland: { attrs: [ lib FOSS permissive ] description: "Wayland — the display-server protocol libraries (`wayland-scanner`, libwayland; dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse) and not amzn"
                         name: { apt: libwayland-dev  dnf: wayland-devel  pacman: wayland  apk: wayland-dev  zypper: wayland-devel } } ] }   // Linux-only; not on brew
        curl-dev: { attrs: [ lib FOSS permissive ] description: "libcurl development headers (client-side URL transfers)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libcurl4-openssl-dev  dnf: libcurl-devel  pacman: curl  apk: curl-dev  zypper: libcurl-devel  brew: curl } } ] }
        cairo: { attrs: [ lib FOSS copyleft ] description: "Cairo — 2D vector graphics library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libcairo2-dev  dnf: cairo-devel  pacman: cairo  apk: cairo-dev  zypper: cairo-devel  brew: cairo } } ] }
        expat: { attrs: [ lib FOSS permissive ] description: "Expat — a stream-oriented XML parser library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libexpat1-dev  dnf: expat-devel  pacman: expat  apk: expat-dev  zypper: libexpat-devel  brew: expat } } ] }
        libevent: { attrs: [ lib FOSS permissive ] description: "libevent — an event-notification library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libevent-dev  dnf: libevent-devel  pacman: libevent  apk: libevent-dev  zypper: libevent-devel  brew: libevent } } ] }
        fmt: { attrs: [ lib FOSS permissive ] description: "{fmt} — a modern C++ formatting library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libfmt-dev  dnf: fmt-devel  pacman: fmt  apk: fmt-dev  zypper: fmt-devel  brew: fmt } } ] }
        tinyxml2: { attrs: [ lib FOSS permissive ] description: "TinyXML-2 — a small, efficient C++ XML parser (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libtinyxml2-dev  dnf: tinyxml2-devel  pacman: tinyxml2  apk: tinyxml2-dev  zypper: tinyxml2-devel  brew: tinyxml2 } } ] }
        asio: { attrs: [ lib FOSS permissive ] description: "Asio — a cross-platform C++ networking/async library (header-only; dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libasio-dev  dnf: asio-devel  pacman: asio  apk: asio-dev  zypper: asio-devel  brew: asio } } ] }
        zstd: { attrs: [ lib FOSS permissive ] description: "Zstandard (zstd) — fast real-time compression library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libzstd-dev  dnf: libzstd-devel  pacman: zstd  apk: zstd-dev  zypper: libzstd-devel  brew: zstd } } ] }
        lz4: { attrs: [ lib FOSS permissive ] description: "LZ4 — extremely fast compression library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: liblz4-dev  dnf: lz4-devel  pacman: lz4  apk: lz4-dev  zypper: liblz4-devel  brew: lz4 } } ] }
        protobuf-dev: { attrs: [ lib FOSS permissive ] description: "Protocol Buffers C++ runtime + headers (libprotobuf; distinct from the `protobuf` compiler)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libprotobuf-dev  dnf: protobuf-devel  pacman: protobuf  apk: protobuf-dev  zypper: protobuf-devel  brew: protobuf } } ] }
        double-conversion: { attrs: [ lib FOSS permissive ] description: "double-conversion — binary↔decimal conversion routines (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libdouble-conversion-dev  dnf: double-conversion-devel  pacman: double-conversion  apk: double-conversion-dev  zypper: double-conversion-devel  brew: double-conversion } } ] }
        gflags: { attrs: [ lib FOSS permissive ] description: "gflags — Google's commandline-flags library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libgflags-dev  dnf: gflags-devel  pacman: gflags  apk: gflags-dev  zypper: gflags-devel  brew: gflags } } ] }
        glog: { attrs: [ lib FOSS permissive ] description: "glog — Google's application-logging library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libgoogle-glog-dev  dnf: glog-devel  pacman: google-glog  apk: glog-dev  zypper: glog-devel  brew: glog } } ] }
        snappy: { attrs: [ lib FOSS permissive ] description: "Snappy — Google's fast compression/decompression library (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libsnappy-dev  dnf: snappy-devel  pacman: snappy  apk: snappy-dev  zypper: snappy-devel  brew: snappy } } ] }
        sdl2-image: { attrs: [ lib FOSS permissive ] description: "SDL2_image — image-file loading for SDL2 (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libsdl2-image-dev  dnf: SDL2_image-devel  pacman: sdl2_image  apk: sdl2_image-dev  zypper: libSDL2_image-devel  brew: sdl2_image } } ] }
        sdl2-ttf: { attrs: [ lib FOSS permissive ] description: "SDL2_ttf — TrueType-font rendering for SDL2 (dev)."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libsdl2-ttf-dev  dnf: SDL2_ttf-devel  pacman: sdl2_ttf  apk: sdl2_ttf-dev  zypper: libSDL2_ttf-devel  brew: sdl2_ttf } } ] }
        // SDL2 (the common target). Arch dropped classic `sdl2` → `sdl2-compat` (SDL2 API on SDL3).
        sdl: { attrs: [ lib FOSS permissive ] description: "SDL2 — Simple DirectMedia Layer (video/audio/input), dev headers + libs."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"  repo-component: universe
                         name: { apt: libsdl2-dev  dnf: SDL2-devel  pacman: sdl2-compat  apk: sdl2-dev  zypper: sdl2-compat-devel  brew: sdl2 } } ]
        }
        // SFML — note the major-version skew: 2.x on debian/fedora/alpine, 3.x on arch/brew (a
        // breaking API change). openSUSE package unconfirmed → omitted there.
        sfml: { attrs: [ lib FOSS permissive ] description: "SFML — Simple and Fast Multimedia Library (C++), dev headers + libs."
            install: [ { via: native  when: "(debian or redhat or arch or alpine or fedora_atomic) and not amzn"  repo-component: universe
                         name: { apt: libsfml-dev  dnf: SFML-devel  pacman: sfml  apk: sfml-dev  brew: sfml } } ]
        }


        // ---- dotfiles companions (bulk pass) ---------------------------------------
        // Config pointers (declare WHERE a tool reads its user config; ship no content --
        // `configsys dotfiles capture <name>` adopts an existing one) and shell-setup snippets
        // (PATH/alias/env for off-PATH installs). Each is soft-`suggests:`ed by its parent.
        aider-dotfiles: { description: "aider config, linked into place." install: [ { via: dotfiles  config: { src: aider.conf.yml  dst: ~/.aider.conf.yml } } ] }
        android-studio-dotfiles: { description: "android-studio shell setup, linked into place." install: [ { via: dotfiles  requires: bash-dotfiles  glue: android-studio } ] }
