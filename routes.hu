        fastfetch-dotfiles: { description: "fastfetch config, linked into place." install: [ { via: dotfiles  config: { src: fastfetch  dst: $XDG_CONFIG_HOME/fastfetch } } ] }
        // fish config = config.fish (the rc), NOT the whole ~/.config/fish dir — its conf.d/ is owned
        // by the glue driver, and managing the whole dir would fight glue + falsely read "unmanaged".
        fish-dotfiles: { description: "fish config (config.fish), linked into place." install: [ { via: dotfiles  config: { src: config.fish  dst: $XDG_CONFIG_HOME/fish/config.fish } } ] }
