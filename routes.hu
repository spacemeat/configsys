        // apod (termapod): scrapes NASA's Astronomy Picture of the Day and splats it to the terminal
        // in 24-bit-colour Unicode blocks. No API key (it scrapes apod.nasa.gov). Its ~/.config/termapod
        // dir is a per-DAY image cache (image-*.jpg + caption.txt), NOT config — so there is nothing to
        // manage as dotfiles. apod-glue runs it at interactive shell startup (the old bash.d/apod.sh).
        apod: {
            attrs: [ CLI FOSS permissive online ]
            description: "Astronomy Picture of the Day in the terminal (`termapod`) — NASA's APOD splatted in 24-bit colour."
            suggests: apod-glue
            install: [ { via: pipx  name: termapod  version: { pypi: termapod } } ]
        }
        apod-glue: { description: "apod: run `termapod` (the Astronomy Picture of the Day) on interactive shell startup." install: [ { via: glue  requires: shell-glue  glue: apod } ] }

        // --- citizen-science / a classic game (best-effort — see comments) ---
        // Folding@home — donate CPU/GPU to protein-folding research; runs a local daemon + web control.
        // The .deb lives on F@h's OWN download server, NOT as a GitHub release asset (the fah-client
        // github repo carries only git tags, whose version line — 8.5.x — also differs from the
        // packaged stable .deb — 8.1.x). So the version is SCRAPED from the server's directory
        // listing and the `url:` templated from it. RedHat/openSUSE: no equivalently-locatable rpm
        // path, so they decline (rather than fail). Arch via AUR.
        foldingathome: { attrs: [ daemon web FOSS GPL ] description: "Folding@home — donate compute to protein-folding research (the `fah-client` daemon + web control)."
            install: [ { via: aur  name: foldingathome }
                       { via: native-pkg-file  when: "debian"  cpu-names: { x86_64: amd64 }  name: fah-client
                         version: { url: "https://download.foldingathome.org/releases/public/fah-client/debian-stable-64bit/release/"  regex: "fah-client_([0-9.]+)_amd64[.]deb" }
                         url: "https://download.foldingathome.org/releases/public/fah-client/debian-stable-64bit/release/fah-client_$VERSION_amd64.deb" } ] }
        // Zork — the classic Infocom text adventure. The trilogy is freeware but unpackaged; install the
        // Frotz Z-machine interpreter and supply the Zork data files yourself (`frotz zork1.z5`).
        zork: { attrs: [ CLI game ] description: "Zork — the Infocom classic, played via the Frotz Z-machine interpreter (bring your own .z5 data files)."
            install: [ { via: native  when: "rhel"  requires: epel  name: frotz }
                       { via: native  when: "not rhel and not arch and not opensuse"  repo-component: universe  name: frotz }
                       { via: native  when: "arch"  name: frotz-ncurses }  { via: brew  name: frotz } ] }   // Arch splits frotz into frotz-ncurses/-sdl/-dumb in [extra] (terminal flavor here); not in openSUSE

        // --- media servers (self-hosted; each runs a systemd service — the <name>-service pulls the
        // install AND starts it, like the db-servers) + media players (kodi/stremio, flatpak-first) ---
        // No server ships a Flathub build; the only Jellyfin flatpak is the CLIENT, not the server.
        jellyfin: { attrs: [ daemon web app FOSS copyleft ] description: "Jellyfin — a free, self-hosted media server (movies, TV, music)."
            install: [
                { via: native  when: "ubuntu"  name: jellyfin       // official repo (codename bumps as they add releases)
                  pubkey-url: "https://repo.jellyfin.org/ubuntu/jellyfin_team.gpg.key"  pubkey-path: /usr/share/keyrings/jellyfin.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/jellyfin.gpg] https://repo.jellyfin.org/ubuntu noble main"
                  source-path: /etc/apt/sources.list.d/jellyfin.list }
                { via: native  when: "debian"  name: jellyfin
                  pubkey-url: "https://repo.jellyfin.org/debian/jellyfin_team.gpg.key"  pubkey-path: /usr/share/keyrings/jellyfin.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/jellyfin.gpg] https://repo.jellyfin.org/debian bookworm main"
                  source-path: /etc/apt/sources.list.d/jellyfin.list }
                { via: native  when: "fedora"  name: jellyfin  requires: rpmfusion   // pulls ffmpeg from RPM Fusion
                  pubkey-url: "https://repo.jellyfin.org/fedora/jellyfin_team.gpg.key"
                  repo-id: jellyfin  repo-name: "Jellyfin"  repo-url: "https://repo.jellyfin.org/fedora/$releasever/$basearch" }
                { via: native  when: "arch"  packages: [ jellyfin-server, jellyfin-web ] } ] }   // Arch `extra`
        jellyfin-service: { description: "Enable and start the Jellyfin server (systemd / runit)." requires: jellyfin  install: [ { via: service  unit: jellyfin } ] }
        plex: { attrs: [ daemon web app proprietary account cloud freemium ] description: "Plex Media Server — a media server with the Plex client ecosystem."
            install: [
                { via: native  when: "debian"  name: plexmediaserver   // official repo (single `public` suite — codename-independent)
                  pubkey-url: "https://downloads.plex.tv/plex-keys/PlexSign.key"  pubkey-path: /usr/share/keyrings/plex.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/plex.gpg] https://downloads.plex.tv/repo/deb public main"
                  source-path: /etc/apt/sources.list.d/plexmediaserver.list }
                { via: native  when: "redhat"  name: plexmediaserver
                  pubkey-url: "https://downloads.plex.tv/plex-keys/PlexSign.key"
                  repo-id: plex  repo-name: "Plex"  repo-url: "https://downloads.plex.tv/repo/rpm/$basearch/" }
                { via: aur  name: plex-media-server } ] }
        plex-service: { description: "Enable and start Plex Media Server (systemd / runit)." requires: plex  install: [ { via: service  unit: plexmediaserver } ] }
        emby: { attrs: [ daemon web FOSSish freemium ] description: "Emby Server — a media server (open-core; some features are premium)."
            install: [   // no official repo: Arch `extra`, else the upstream .deb/.rpm on GitHub
                { via: native  when: "arch"  name: emby-server }
                { via: native-pkg-file  when: "debian"  cpu-names: { x86_64: amd64  aarch64: arm64 }  name: emby-server
                  version: { github: MediaBrowser/Emby.Releases  strip-v: true }  asset: "emby-server-deb_*_$ARCH.deb" }
                { via: native-pkg-file  when: "redhat or opensuse"  cpu-names: { x86_64: x86_64  aarch64: aarch64 }  name: emby-server
                  version: { github: MediaBrowser/Emby.Releases  strip-v: true }  asset: "emby-server-rpm_*_$ARCH.rpm" } ] }
        emby-service: { description: "Enable and start Emby Server (systemd / runit)." requires: emby  install: [ { via: service  unit: emby-server } ] }
        navidrome: { attrs: [ daemon web FOSS copyleft ] description: "Navidrome — a self-hosted music streaming server (Subsonic/OpenSubsonic-compatible)." requires: ffmpeg
            install: [   // Arch `extra`; else the upstream .deb/.rpm, or the prebuilt tarball (hand-write a unit)
                { via: native  when: "arch"  name: navidrome }
                { via: native-pkg-file  when: "debian"  cpu-names: { x86_64: amd64  aarch64: arm64 }  name: navidrome
                  version: { github: navidrome/navidrome  strip-v: true }  asset: "navidrome_*_linux_$ARCH.deb" }
                { via: native-pkg-file  when: "redhat"  cpu-names: { x86_64: amd64  aarch64: arm64 }  name: navidrome
                  version: { github: navidrome/navidrome  strip-v: true }  asset: "navidrome_*_linux_$ARCH.rpm" }
                { via: tarball  when: "not arch and not debian and not redhat"  cpu-names: { x86_64: amd64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/navidrome"  requires: glibc
                  version: { github: navidrome/navidrome  strip-v: true  asset: "navidrome_*_linux_$ARCH.tar.gz" } }  { via: brew  name: navidrome } ] }
        kodi: { attrs: [ GUI app FOSS copyleft patent ] description: "Kodi — an open-source home-theater / media-center app."
            install: [ { via: flatpak  hub: flathub  app: tv.kodi.Kodi }   // upstream-recommended; native alternates below
                       { via: native  when: "ubuntu or void or void_musl"  repo-component: universe }
                       { via: native  when: "fedora"  requires: rpmfusion }   // RPM Fusion free, not base Fedora
                       { via: native  when: "arch" } ] }
        stremio: { attrs: [ GUI app freeware cloud online ] description: "Stremio — a media-center streaming/aggregator client." install: [ { via: flatpak  hub: flathub  app: com.stremio.Stremio }  { via: aur  name: stremio } ] }

        // --- self-hosted / home-server apps. Clean daemons get a matching -service (a plain
        // `systemctl enable`); pi-hole/adguardhome self-install their service; config-dependent ones
        // (wireguard tunnels, prometheus units) you wire up yourself. ---
        // Home Assistant CORE in a pipx-managed venv on python3.14 (its runtime floor, now stable) —
        // NOT Home Assistant OS/Supervised, which are Docker/appliance images (no docker driver here).
        // requires python3.14 BY NAME so /usr/bin/python3.14 exists for pipx's `--python`, plus a C
        // toolchain + ffmpeg for building/running deps. Some integrations pip-install extra system
        // libs at runtime — add those to a profile if one you use needs it.
        home-assistant: { attrs: [ web daemon FOSS permissive ] description: "Home Assistant Core — a Python home-automation hub (venv install)."
            requires: [ python3.14, cpp-toolchain, ffmpeg ]
            install: [ { via: pipx  name: homeassistant  python: python3.14 } ] }
        pi-hole: { attrs: [ daemon web FOSS copyleft ] description: "Pi-hole — a network-wide DNS ad-blocker (FTL/dnsmasq + web admin)."
            install: [ { via: script   // the upstream installer sets up the service + `pihole` CLI (interactive)
                install-cmd:   'curl -sSL https://install.pi-hole.net | bash'
                version-cmd:   'pihole -v 2>/dev/null'
                version-re:    'v?([0-9][0-9.]*)'
                uninstall-cmd: 'pihole uninstall'
                location:      '/etc/pihole' } ] }
        adguardhome: { attrs: [ daemon web FOSS copyleft ] description: "AdGuard Home — a network-wide DNS ad/tracker blocker (single Go binary)."
            install: [
                { via: native   when: "arch" }                     // pacman: adguardhome (extra)
                { via: tarball  when: "not arch"  cpu-names: { x86_64: amd64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/adguardhome"  requires: glibc   // then `AdGuardHome -s install` registers the service; first-run web setup on :3000
                  version: { github: AdguardTeam/AdGuardHome  strip-v: true  asset: "AdGuardHome_linux_$ARCH.tar.gz" } }
                { via: snap  name: adguard-home } ]                // self-contained alternate (pinnable)
        }
        homebridge: { attrs: [ daemon FOSS permissive ] description: "Homebridge — bridge non-HomeKit devices to Apple HomeKit (Node.js)."
            install: [
                { via: native  when: "debian"  name: homebridge   // official repo (bundles its own Node + a service user); single `stable` suite, codename-independent
                  pubkey-url: "https://repo.homebridge.io/KEY.gpg"  pubkey-path: /usr/share/keyrings/homebridge.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/homebridge.gpg] https://repo.homebridge.io stable main"
                  source-path: /etc/apt/sources.list.d/homebridge.list }
                { via: npm  name: homebridge } ]   // needs node (the npm driver pulls it); then `hb-service install`
        }
        mosquitto: { attrs: [ daemon FOSS copyleft ] description: "Eclipse Mosquitto — a lightweight MQTT broker (the common Home Assistant companion)." install: [ { via: native  when: "not amzn"  }  { via: brew  name: mosquitto } ] }
        mosquitto-service: { description: "Enable and start the Mosquitto MQTT broker (systemd / runit)." requires: mosquitto  install: [ { via: service  unit: mosquitto } ] }
        syncthing: { attrs: [ daemon web FOSS permissive ] description: "Syncthing — continuous peer-to-peer file synchronization."
            install: [ { via: native  when: "not amzn"  }                             // uniform pkg `syncthing`
                       { via: tarball  cpu-names: { x86_64: amd64  aarch64: arm64 }  standing: never-auto  installDir: "$CONFIGSYS_APP_DIR/syncthing"  requires: glibc   // newest upstream build (pinnable)
                         version: { github: syncthing/syncthing  strip-v: true  asset: "syncthing-linux-$ARCH-*.tar.gz" } }  { via: brew  name: syncthing } ] }
        tailscale: { attrs: [ CLI daemon FOSSish permissive account cloud freemium ] description: "Tailscale — a WireGuard-based mesh VPN (`tailscale` CLI + `tailscaled`)."
            install: [   // official repo; the apt codename bumps as they add releases, dnf is $basearch-templated
                { via: native  when: "ubuntu"
                  pubkey-url: "https://pkgs.tailscale.com/stable/ubuntu/noble.noarmor.gpg"  pubkey-path: /usr/share/keyrings/tailscale-archive-keyring.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/tailscale-archive-keyring.gpg] https://pkgs.tailscale.com/stable/ubuntu noble main"
                  source-path: /etc/apt/sources.list.d/tailscale.list }
                { via: native  when: "debian"
                  pubkey-url: "https://pkgs.tailscale.com/stable/debian/bookworm.noarmor.gpg"  pubkey-path: /usr/share/keyrings/tailscale-archive-keyring.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/tailscale-archive-keyring.gpg] https://pkgs.tailscale.com/stable/debian bookworm main"
                  source-path: /etc/apt/sources.list.d/tailscale.list }
                { via: native  when: "redhat"
                  pubkey-url: "https://pkgs.tailscale.com/stable/fedora/repo.gpg"
                  repo-id: tailscale  repo-name: "Tailscale"  repo-url: "https://pkgs.tailscale.com/stable/fedora/$basearch" }
                { via: native  when: "arch or void or void_musl" } ] }
        tailscale-service: { description: "Enable and start the Tailscale daemon (systemd / runit)." requires: tailscale  install: [ { via: service  unit: tailscaled } ] }
        // headscale: a self-hosted Tailscale control server (static Go). Native on Fedora/Arch/Tumbleweed/
        // Alpine; the upstream .deb on Debian/Ubuntu (systemd unit + /etc/headscale/config.yaml); the raw
        // static binary elsewhere (EL/Void/Leap — bring your own unit); Canonical's snap is pinnable.
        headscale: { attrs: [ CLI daemon FOSS permissive ] suggests: headscale-glue  description: "headscale — a self-hosted, open-source Tailscale control server."
            install: [ { via: native  when: "(fedora >= 43) or arch or opensuse_tumbleweed or alpine" }   // Fedora packages it from 43
                       { via: native-pkg-file  when: "debian"  version: { github: juanfont/headscale  strip-v: true }
                         asset: { x86_64: "headscale_*_linux_amd64.deb"  aarch64: "headscale_*_linux_arm64.deb" } }
                       { via: tarball  archive: none  binary: headscale  cpu-names: { x86_64: amd64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/headscale"
                         version: { github: juanfont/headscale  strip-v: true  asset: "headscale_*_linux_$ARCH" } }
                       { via: snap  name: headscale } ] }
        headscale-glue: { description: "headscale PATH alias (tarball binary), linked into place." install: [ { via: glue  requires: shell-glue  glue: headscale } ] }
        headscale-service: { description: "Enable and start the headscale server (systemd / runit)." requires: headscale  install: [ { via: service  unit: headscale } ] }
        grafana: { attrs: [ web daemon FOSS copyleft tele ] description: "Grafana — analytics & observability dashboards (OSS)."
            install: [
                { via: native  when: "debian"  name: grafana   // official repo (single `stable` suite — codename-independent)
                  pubkey-url: "https://apt.grafana.com/gpg.key"  pubkey-path: /etc/apt/keyrings/grafana.gpg
                  source-line: "deb [signed-by=/etc/apt/keyrings/grafana.gpg] https://apt.grafana.com stable main"
                  source-path: /etc/apt/sources.list.d/grafana.list }
                { via: native  when: "redhat"  name: grafana
                  pubkey-url: "https://rpm.grafana.com/gpg.key"
                  repo-id: grafana  repo-name: "Grafana"  repo-url: "https://rpm.grafana.com" }
                { via: native  when: "arch or void or void_musl"  name: grafana }  { via: brew  name: grafana } ] }
        grafana-service: { description: "Enable and start Grafana (systemd / runit)." requires: grafana  install: [ { via: service  unit: grafana-server  runit: grafana } ] }
        prometheus: { attrs: [ daemon web FOSS permissive ] description: "Prometheus — a time-series metrics & alerting server."
            install: [
                { via: native  when: "arch or debian or void or void_musl"  repo-component: universe }   // pacman/apt `prometheus` (debian lags upstream)
                { via: tarball  when: "not arch and not debian"  cpu-names: { x86_64: amd64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/prometheus"  requires: glibc   // upstream static binaries; self-author the unit
                  version: { github: prometheus/prometheus  strip-v: true  asset: "prometheus-*.linux-$ARCH.tar.gz" } }  { via: brew  name: prometheus } ] }
        cockpit: { attrs: [ web daemon FOSS copyleft ] description: "Cockpit — a web-based server administration UI (socket-activated)."
            install: [ { via: native  when: "(debian or redhat or arch or opensuse) and not amzn" } ] }   // uniform pkg `cockpit`
        cockpit-service: { description: "Enable Cockpit's web UI (systemd socket)." requires: cockpit  install: [ { via: service  unit: cockpit.socket } ] }
        wireguard: { attrs: [ CLI driver FOSS copyleft ] description: "WireGuard — fast, modern VPN tunneling (`wg`/`wg-quick`)."
            install: [ { via: native  name: { apt: wireguard  default: wireguard-tools } } ] }   // debian `wireguard` metapkg; else `wireguard-tools`
        nextcloud: { attrs: [ daemon web FOSS copyleft ] description: "Nextcloud — a self-hosted file-sync & collaboration server (all-in-one snap)."
            install: [ { via: snap  name: nextcloud } ] }         // snap-or-Docker in practice; no native server package
        obs-studio: { attrs: [ GUI app FOSS copyleft ] description: "OBS Studio — live streaming and screen recording." install: [ { via: flatpak  hub: flathub  app: com.obsproject.Studio }  { via: snap  name: obs-studio } ] }
        spotify:    { attrs: [ GUI  proprietary  account  ads  cloud ]  description: "Spotify — music streaming client." install: [ { via: flatpak  hub: flathub  app: com.spotify.Client }  { via: snap  name: spotify } ] }   // not in distro repos; Flathub + official snap
        // MPD stack — a music-player daemon + a CLI client, plus the Strawberry GUI player.
        mpd: { attrs: [ daemon FOSS copyleft ] suggests: mpd-dotfiles  description: "MPD — Music Player Daemon, a server-side music player driven by clients (`mpd`)."
            install: [ { via: native  when: "rhel"  requires: epel }
                       { via: native  repo-component: universe  when: "not amzn" }  { via: brew  name: mpd } ] }
        mpd-dotfiles: { description: "mpd config (mpd.conf), linked into place." install: [ { via: dotfiles  config: { src: mpd  dst: $XDG_CONFIG_HOME/mpd } } ] }
        mpc: { attrs: [ CLI FOSS copyleft ] description: "mpc — a minimalist command-line client for MPD (`mpc`)."
            install: [ { via: native  when: "rhel"  requires: epel }
                       { via: native  repo-component: universe  when: "not amzn"  name: { zypper: mpclient  default: mpc } }  { via: brew  name: mpc } ] }   // openSUSE's `mpc` is the GNU MPC math lib; the MPD client there is `mpclient`
        strawberry: { attrs: [ GUI app FOSS copyleft ] description: "Strawberry — a music player and music-collection organizer (a Clementine fork)."
            install: [ { via: flatpak  hub: flathub  app: org.strawberrymusicplayer.strawberry }   // uniform option + the only method on atomic
                       { via: native  when: "rhel"  requires: epel }
                       { via: native  when: "fedora or arch or opensuse or void or void_musl" }   // in-repo on these (Fedora proper needs no RPM Fusion for the app)
                       { via: native  when: "debian and not ubuntu" }   // Debian ships strawberry in its own repos
                       // Ubuntu/Pop: use Strawberry's official PPA — its placement in `universe` is
                       // release-dependent (absent on 22.04), so the PPA is the reliable apt route.
                       { via: native  when: "ubuntu"  ppa: "jonaski/strawberry"  requires: software-properties-common } ] }

        // --- digital-music tools --- (GUI apps via Flathub; audio-system bits native)
        musescore:     { attrs: [ GUI app FOSS copyleft ] description: "MuseScore — music notation and composition." install: [ { via: flatpak  hub: flathub  app: org.musescore.MuseScore }  { via: appImage  cpu-names: { x86_64: x86_64  aarch64: aarch64 }  name: MuseScore  scope: user  version: { github: musescore/MuseScore  strip-v: true  asset: "MuseScore-Studio-*-$ARCH.AppImage" }  path: ~/apps/musescore.appimage } ] }   // asset glob absorbs the build-number suffix
        hydrogen:      { attrs: [ GUI app FOSS copyleft ] description: "Hydrogen — a pattern-based drum machine." install: [ { via: native  when: "debian or fedora or arch or opensuse or void or void_musl"  repo-component: universe }  { via: flatpak  hub: flathub  app: org.hydrogenmusic.Hydrogen } ] }
        carla:         { attrs: [ GUI app FOSS copyleft ] description: "Carla — an audio plugin host (LV2/VST/…)." install: [ { via: native  when: "debian or fedora or arch or opensuse"  repo-component: universe }  { via: flatpak  hub: flathub  app: studio.kx.carla } ] }
        sonic-pi:      { attrs: [ GUI app FOSS permissive ] description: "Sonic Pi — a live-coding music synth for everyone." install: [ { via: native  when: "debian"  repo-component: universe }  { via: flatpak  hub: flathub  app: net.sonic_pi.SonicPi } ] }
        supercollider: { attrs: [ GUI app FOSS copyleft ] description: "SuperCollider — audio synthesis and algorithmic composition." install: [ { via: native  when: "(debian or redhat or arch or opensuse) and not amzn"  repo-component: universe }  { via: native  when: "fedora_atomic or void or void_musl" } ] }   // brew formula `supercollider`
        qjackctl:      { attrs: [ GUI app FOSS copyleft ] description: "QjackCtl — a GUI controller for the JACK audio server." install: [ { via: native  when: "not amzn"   repo-component: universe } ] }
        // PipeWire — the modern audio/video server. Native; already the default on most current
        // distros (where installing it is a harmless no-op).
        pipewire:      { attrs: [ daemon FOSS permissive ] description: "PipeWire — modern audio/video server (PulseAudio/JACK replacement)." install: [ { via: native } ] }
        // PipeWire dev headers (libpipewire-0.3 + libspa) — build dep for things that link PipeWire
        // (e.g. wiremix's libspa-sys). Arch/openSUSE ship headers in the main package (no -dev split).
        pipewire-dev:  { attrs: [ lib FOSS permissive ] description: "PipeWire development headers (libpipewire-0.3 / libspa)."
            install: [ { via: native  when: "debian or void or void_musl"  name: { xbps: pipewire-devel  default: libpipewire-0.3-dev } }
                       { via: native  when: "redhat"  name: pipewire-devel }
                       { via: native  when: "alpine"  name: pipewire-dev }
                       { via: native  when: "opensuse"  name: pipewire-devel }
                       { via: native  when: "arch"  name: pipewire } ] }
        // JACK — low-latency audio server (jack2 is the current implementation). NOTE: conflicts with
        // pipewire's JACK shim (both provide the client libs) — install one JACK provider or the other.
        jack: { attrs: [ daemon FOSS copyleft ] description: "JACK Audio Connection Kit — low-latency audio server & routing."
            install: [ { via: native  when: "debian or void or void_musl"  name: { xbps: jack  default: jackd2 } }
                       { via: native  when: "fedora"  name: jack-audio-connection-kit }
                       { via: native  when: "rhel"  requires: epel  name: jack-audio-connection-kit }   // EPEL
                       { via: native  when: "arch or opensuse"  name: { pacman: jack2  zypper: jack } }
                       { via: native  when: "fedora_atomic"  name: jack } ] }   // brew formula `jack`
        // yabridge — bridge Windows VST2/VST3/CLAP plugins into Linux audio hosts. Needs Wine; x86_64
        // only. Native on Arch (`extra`); elsewhere the upstream github release tarball.
        yabridge: { attrs: [ CLI GUI FOSS copyleft ] description: "yabridge — bridge Windows VST/VST3/CLAP plugins into Linux audio hosts." requires: wine
            install: [ { via: native   when: "arch" }
                       { via: tarball  when: "not arch"  installDir: "$CONFIGSYS_APP_DIR/yabridge"  requires: glibc
                         version: { github: robbert-vdh/yabridge  strip-v: true  asset: "yabridge-*.tar.gz" } } ] }
        // tenacity: the telemetry-free Audacity fork. No reliable native package anywhere, so
        // flatpak-only (unroutable on Alpine -> surfaces as a diagnostic, never a crash).
        tenacity: { attrs: [ GUI app FOSS copyleft ] description: "Tenacity — an open-source multi-track audio editor (Audacity fork)." install: [ { via: native  when: "arch" }  { via: flatpak  hub: flathub  app: org.tenacityaudio.Tenacity } ] }

        // gnuradio: an SDR *framework* (Python bindings, out-of-tree modules) — flatpak is
        // impractical, so native everywhere (package name `gnuradio`).
        gnuradio: { attrs: [ GUI CLI app FOSS GNU copyleft ] description: "GNU Radio — a software-defined radio toolkit." install: [ { via: native  when: "not amzn"  } ] }

        // ffmpeg: native, but neither Fedora nor EL ships it in base repos — the full build
        // lives in RPM Fusion on both (Fedora and EL alike). `when: "redhat"` covers both;
        // rpmfusion-free (below) does the per-distro repo setup. Everywhere else it's in base.
        ffmpeg: { attrs: [ CLI lib FOSS copyleft patent ] description: "FFmpeg — record, convert, and stream audio and video."
            install: [ { via: native  when: "redhat"  requires: rpmfusion }
                       { via: native  name: { zypper: ffmpeg-7  default: ffmpeg } }  { via: brew  name: ffmpeg } ]
        }
        // FFmpeg/libav dev headers — build dep for things that link FFmpeg (e.g. wl-screenrec's
        // ffmpeg-sys-next). Debian splits per-lib; Fedora/EL ship a single ffmpeg-devel from RPM
        // Fusion; Arch bundles headers in the main ffmpeg package.
        ffmpeg-dev: { attrs: [ lib FOSS copyleft patent ] description: "FFmpeg development headers (libavutil/libavformat/libavcodec/…)."
            install: [ { via: native  when: "debian"  packages: [ libavutil-dev, libavformat-dev, libavcodec-dev,
                             libavfilter-dev, libavdevice-dev, libswscale-dev, libswresample-dev ]  installed-name: libavutil-dev }
                       { via: native  when: "redhat"  requires: rpmfusion  name: ffmpeg-devel }
                       { via: native  when: "alpine or void or void_musl"  name: { xbps: ffmpeg6-devel  default: ffmpeg-dev } }
                       { via: native  when: "arch"  name: ffmpeg } ] }
        // libdrm dev headers — Direct Rendering Manager; wl-screenrec uses it for the DRM capture path.
        libdrm-dev: { attrs: [ lib FOSS permissive ] description: "libdrm development headers (Direct Rendering Manager)."
            install: [ { via: native  when: "debian or void or void_musl"  name: { xbps: libdrm-devel  default: libdrm-dev } }
                       { via: native  when: "redhat or opensuse"  name: libdrm-devel }
                       { via: native  when: "alpine"  name: libdrm-dev }
                       { via: native  when: "arch"  name: libdrm } ] }
        // vlc: RPM Fusion on Fedora, but EL carries it in EPEL (not RPM Fusion) — so the two
        // rpm families take different capability edges. Base repos everywhere else.
        vlc: { attrs: [ GUI app FOSS copyleft patent ] description: "VLC — plays virtually any media file or stream."
            install: [ { via: flatpak  hub: flathub  app: org.videolan.VLC }   // uniform option everywhere; the only method on atomic (brew's vlc is a mac-only cask)
                       { via: native  when: "fedora"  requires: rpmfusion }
                       { via: native  when: "rhel"    requires: epel }
                       { via: native  when: "(not fedora_atomic) and not amzn" } ]
        }
        // RPM Fusion Free: enabling it = (EL only) turn on EPEL + CRB, then drop the free
        // .repo (dnf expands $releasever/$basearch and auto-imports the per-release key on the
        // first -y install) and pull the release package that formalizes the config. Fedora and
        // EL differ only in the repo path + key + those EL prereqs, so it's two bindings.
        // Provides the `rpmfusion` capability ffmpeg (both families) and vlc (Fedora) pull in.
        // Validated end to end on fedora:41 and rockylinux:9 (ffmpeg deps resolve). NOTE: EL
        // support targets the free rebuilds (Rocky/Alma/CentOS, CRB via config-manager); RHEL
        // proper enables CodeReady via subscription-manager, which the user does once by hand.
        rpmfusion-free: { attrs: [ plugin FOSS ] description: "RPM Fusion (free) — an extra Fedora/RHEL packages repo."
            provides: rpmfusion
            install: [
                { via: native  when: "rhel"  requires: epel  name: rpmfusion-free-release
                  enable-repo: crb
                  repo-id: rpmfusion-free  repo-name: "RPM Fusion for EL - Free"
                  repo-url: "https://download1.rpmfusion.org/free/el/updates/$releasever/$basearch/"
                  pubkey-url: "https://rpmfusion.org/keys?action=AttachFile&do=get&target=RPM-GPG-KEY-rpmfusion-free-el-$releasever" }
                { via: native  when: "fedora"  name: rpmfusion-free-release
                  repo-id: rpmfusion-free  repo-name: "RPM Fusion Free"
                  repo-url: "https://download1.rpmfusion.org/free/fedora/releases/$releasever/Everything/$basearch/os/"
                  pubkey-url: "https://rpmfusion.org/keys?action=AttachFile&do=get&target=RPM-GPG-KEY-rpmfusion-free-fedora-$releasever" }
            ]
        }
        // RPM Fusion (nonfree) — the patent/nonfree Fedora/RHEL repo (e.g. Steam, some codecs).
        // Depends on the free repo being present (requires: rpmfusion), mirroring the standard
        // "enable both" gaming/multimedia setup. Same per-distro release-pkg pattern as -free.
        rpmfusion-nonfree: { attrs: [ plugin proprietary patent ] description: "RPM Fusion (nonfree) — an extra Fedora/RHEL packages repo (patent/nonfree)."
            provides: rpmfusion-nonfree
            requires: rpmfusion
            install: [
                { via: native  when: "rhel"  requires: epel  name: rpmfusion-nonfree-release
                  enable-repo: crb
                  repo-id: rpmfusion-nonfree  repo-name: "RPM Fusion for EL - Nonfree"
                  repo-url: "https://download1.rpmfusion.org/nonfree/el/updates/$releasever/$basearch/"
                  pubkey-url: "https://rpmfusion.org/keys?action=AttachFile&do=get&target=RPM-GPG-KEY-rpmfusion-nonfree-el-$releasever" }
                { via: native  when: "fedora"  name: rpmfusion-nonfree-release
                  repo-id: rpmfusion-nonfree  repo-name: "RPM Fusion Nonfree"
                  repo-url: "https://download1.rpmfusion.org/nonfree/fedora/releases/$releasever/Everything/$basearch/os/"
                  pubkey-url: "https://rpmfusion.org/keys?action=AttachFile&do=get&target=RPM-GPG-KEY-rpmfusion-nonfree-fedora-$releasever" }
            ]
        }

        // unityhub: the Unity Hub AppImage. Unity Editor(s) are installed THROUGH the Hub at
        // runtime — there's no `unity3d` package to route. Config in ~/.config/UnityHub (deferred).
        unityhub: { attrs: [ GUI app proprietary account freemium electron ] description: "Unity Hub — manage Unity game-engine installs and projects."
            suggests: unityhub-glue
            // Unity retired the public AppImage (URL 404s); the official Linux channel is now their
            // apt repo. ASCII key -> a `.asc` keyring + signed-by (same pattern as chrome/vivaldi).
            install: [ { via: native  when: "debian"  name: unityhub  standing: 1
                         pubkey-url: "https://hub.unity3d.com/linux/keys/public"
                         pubkey-path: /usr/share/keyrings/unityhub.asc
                         source-line: "deb [signed-by=/usr/share/keyrings/unityhub.asc] https://hub.unity3d.com/linux/repos/deb stable main"
                         source-path: /etc/apt/sources.list.d/unityhub.list }
                       { via: flatpak  hub: flathub  app: com.unity.UnityHub } ]   // universal fallback (+ atomic)
        }

        // --- desktop environments (metapackage names verified per-distro in a podman sweep of
        // apt/dnf/pacman/zypper/apk, plus this Pop host for cosmic) ---
        // Native metapackages. Installing a DE where the OS already ships it is a harmless no-op
        // (inspect reads it as installed). `when:`-gated to the traditional package families
        // (excludes atomic / brew-native desktops, which are image-based). Arch installs some as
        // package GROUPS (xfce4/mate) — the pacman driver detects group membership for get_version.
        gnome:    { attrs: [ GUI app FOSS GNU copyleft ] description: "GNOME — the polished, mainstream GNOME desktop." install: [ { via: native  when: "debian or redhat or arch or opensuse or alpine or void or void_musl"  name: { xbps: gnome-shell default: gnome-shell } } ] }
        kde:      { attrs: [ GUI FOSS copyleft ] description: "KDE Plasma — a feature-rich, highly customizable desktop." install: [ { via: native  when: "void or void_musl"  name: plasma-desktop }  { via: native  when: "(debian or redhat or arch or opensuse or alpine) and not amzn"  name: { apt: kde-plasma-desktop  dnf: plasma-desktop  pacman: plasma-meta  zypper: plasma6-session  apk: plasma-desktop } } ] }
        xfce:     { attrs: [ GUI app FOSS copyleft ] description: "Xfce — a lightweight, traditional desktop environment." install: [ { via: native  when: "void or void_musl"  name: xfce4 }  { via: native  when: "(debian or redhat or arch or opensuse or alpine) and not amzn"  name: { apt: xfce4  dnf: xfce4-session  pacman: xfce4  zypper: xfce4-session  apk: xfce4 } } ] }
        lxqt:     { attrs: [ GUI FOSS copyleft ] description: "LXQt — a lightweight Qt desktop." install: [ { via: native  when: "void or void_musl" }  { via: native  when: "(debian or redhat or arch or opensuse or alpine) and not amzn"  name: { apt: lxqt  dnf: lxqt-session  pacman: lxqt  zypper: lxqt-session  apk: lxqt-desktop } } ] }
        mate:     { attrs: [ GUI FOSS copyleft ] description: "MATE — a classic GNOME 2-style desktop." install: [ { via: native  when: "void or void_musl" }  { via: native  when: "(debian or redhat or arch or opensuse or alpine) and not amzn"  name: { apt: mate-desktop-environment  dnf: mate-desktop  pacman: mate  zypper: mate-session-manager  apk: mate-desktop-environment } } ] }
        sway:     { attrs: [ GUI FOSS permissive ] suggests: sway-dotfiles  description: "Sway — an i3-compatible tiling Wayland compositor." install: [ { via: native  when: "void or void_musl" }  { via: native  when: "(debian or redhat or arch or opensuse or alpine) and not amzn" } ] }   // same package name in every family
        cinnamon: { attrs: [ GUI FOSS copyleft ] description: "Cinnamon — a modern desktop with a traditional layout." install: [ { via: native  when: "void or void_musl" }  { via: native  when: "(debian or redhat or arch or opensuse) and not amzn"  name: { apt: cinnamon-desktop-environment  dnf: cinnamon  pacman: cinnamon  zypper: cinnamon } } ] }   // not packaged for Alpine
        budgie:   { attrs: [ GUI FOSS copyleft ] description: "Budgie — an elegant, modern desktop environment." install: [ { via: native  when: "void or void_musl"  name: budgie-desktop }  { via: native  when: "(debian or redhat or arch or opensuse) and not amzn"  name: { default: budgie-desktop } } ] }                                                                    // not packaged for Alpine
        hyprland: { attrs: [ GUI FOSS permissive ] suggests: hyprland-dotfiles  description: "Hyprland — a dynamic tiling Wayland compositor with eye candy." install: [ { via: native  when: "(redhat or arch or opensuse or alpine) and not amzn"  name: { default: hyprland } } ] }                                                                          // not in stock Ubuntu
        cosmic:   { attrs: [ GUI FOSS copyleft ] description: "COSMIC — System76's Rust-based desktop environment." install: [ { via: native  when: "(pop_os! or redhat or arch or opensuse or alpine) and not amzn"  name: { default: cosmic-session } } ] }                                                          // stock Debian/Ubuntu lack it; Pop + others ship cosmic-session
        // Bare compositors (no full desktop): niri, plus GNOME's mutter / KDE's kwin on their own (usually
        // pulled in by the gnome/kde metapackages — listed so a session can be assembled piecemeal).
        niri:     { attrs: [ GUI FOSS GNU copyleft ] suggests: niri-dotfiles  description: "niri — a scrollable-tiling Wayland compositor (`niri`, `niri-session`)."
                    install: [ { via: native  when: "fedora or arch or opensuse_tumbleweed or (alpine >= 3.23) or void or void_musl" } ] }   // not in Debian/Ubuntu (third-party PPA only), EPEL or brew; Leap 16's 0.1.9 is too old. Upstream ships source only
        mutter:   { attrs: [ GUI FOSS GNU copyleft ] description: "mutter — GNOME's Wayland compositor and window manager, standalone."
                    install: [ { via: native  when: "(debian or redhat or arch or opensuse or alpine or void or void_musl) and not amzn" } ] }   // EL: in AppStream (no EPEL needed)
        kwin:     { attrs: [ GUI FOSS GNU copyleft ] description: "KWin — KDE's Wayland compositor and window manager, standalone (`kwin_wayland`)."
                    install: [ { via: native  when: "(debian or fedora or arch or opensuse or alpine or void or void_musl) and not (opensuse_leap < 16) and not amzn"  repo-component: universe
                                 name: { apt: kwin-wayland  zypper: kwin6  default: kwin } }
                               { via: native  when: "rhel"  requires: epel } ] }   // Wayland session; the X11 build is a separate kwin-x11 package now. Leap 15.6 still ships kwin5 -> excluded. EL via EPEL 9/10
        // Window managers (X11/Wayland tilers + a classic). Gated to the families that package them.
        i3:       { attrs: [ GUI FOSS permissive ] suggests: i3-dotfiles  description: "i3 — a keyboard-driven tiling window manager (X11)." install: [ { via: native  when: "void or void_musl" }  { via: native  when: "(debian or redhat or arch or opensuse or alpine) and not amzn"  name: { pacman: i3-wm  apk: i3wm  default: i3 } } ] }
        qtile:    { attrs: [ GUI app FOSS permissive ] suggests: qtile-dotfiles  description: "Qtile — a tiling window manager written and configured in Python." install: [ { via: native  when: "void or void_musl" }  { via: native  when: "(redhat or arch) and not amzn" }   // `qtile` on dnf/pacman; NOT packaged in Debian/Ubuntu
                                { via: pipx  name: qtile } ] }   // the Python WM via pipx wherever native doesn't carry it (pinnable anywhere)
        xmonad:   { attrs: [ GUI FOSS permissive ] suggests: xmonad-dotfiles  description: "xmonad — a tiling window manager written and configured in Haskell." install: [ { via: native  when: "(debian or redhat or arch or opensuse) and not amzn"  name: { default: xmonad } } ] }
        fvwm2:    { attrs: [ GUI FOSS copyleft ] suggests: fvwm2-dotfiles  description: "FVWM2 — the classic, highly configurable X11 window manager." install: [ { via: native  when: "debian or void or void_musl"  name: fvwm } ] }   // the classic 2.x `fvwm` is Debian-only now; Arch ships only the 3.x line (`fvwm3`, a distinct component/AUR), so decline there rather than route to it

        // lazygit: native where the packaged version is reasonably current (Arch, Void, Alpine,
        // Tumbleweed, Debian 13+, Ubuntu 25.10+, brew on atomic); elsewhere (Fedora/EL, older
        // Debian/Ubuntu, Leap's 2023-era 0.40) a static Go binary from the GitHub release, unpacked
        // under ~/apps/lazygit (scope-honoring). Its glue aliases `lazygit` to that binary when
        // present (a no-op where it's native on PATH).
        lazygit: { attrs: [ TUI FOSS permissive ]
            description: "Terminal UI for git — stage, commit, branch, rebase visually."
            suggests: [ lazygit-dotfiles  lazygit-glue ]
            install: [
                { via: native  when: "arch or void or void_musl or alpine or opensuse_tumbleweed or fedora_atomic or (debian >= 13) or (ubuntu >= 25.10)"  repo-component: universe }   // not in Fedora/EPEL -> tarball there
                { via: tarball  cpu-names: { x86_64: x86_64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/lazygit"
                  version: { github: jesseduffield/lazygit  strip-v: true  asset: "lazygit_*_Linux_$ARCH.tar.gz" } }
                { via: brew  name: lazygit }
            ]
        }
        // lazygit's dir also holds the state.yml it rewrites constantly — link only the user's config.yml.
        lazygit-dotfiles: { description: "lazygit config (config.yml), linked into place."
            install: [ { via: dotfiles  config: { src: lazygit-config.yml  dst: $XDG_CONFIG_HOME/lazygit/config.yml } } ] }
        lazygit-glue: { description: "lazygit shell glue (aliases the ~/apps binary onto PATH), linked into place."
            install: [ { via: glue  requires: shell-glue  glue: lazygit } ]
        }

        // --- dotfiles ---
        // shell-glue — the generic glue SUBSTRATE every `via: glue` snippet requires. Its install
        // wires up conf.d loading for EVERY installed shell (design: per-installed-shell, not $SHELL):
        //   * bash — links ~/.bash_aliases to the shipped `bash_aliases` loader (which sources
        //            ~/.config/bash/conf.d/*.sh), absorbing any pre-existing real ~/.bash_aliases
        //            into conf.d/pre-configsys-aliases.sh so the user's own aliases keep running;
        //   * zsh  — one configsys-owned, marker-delimited block in ~/.zshrc sourcing conf.d/*.zsh
        //            (skipped if ~/.zshrc is a configsys-managed symlink — the capture owns it then);
        //   * fish — native conf.d auto-source, so just ensure the dir;
        //   * elvish/nushell — a marker block that INLINES the concatenated conf.d snippets (neither
        //            can dynamically source a dir), regenerated on every (de)activation.
        // (This replaces the old per-shell bash-dotfiles / zsh-glue / fish-glue loader components.)
        shell-glue: { attrs: [ CLI FOSS permissive ] description: "Shell glue substrate — wires ~/.config/<shell>/conf.d/ loading for every installed shell (bash/zsh/fish/elvish/nushell)."
            install: [ { via: glue  loader: all } ] }

        // --- editors / IDEs ---
        neovim: { attrs: [ TUI app FOSS permissive ] description: "Hyperextensible Vim-based editor (`nvim`)."
            suggests: [ ripgrep  tree-sitter-cli  neovim-dotfiles  neovim-glue ]   // rg/tree-sitter serve popular plugin configs (telescope, nvim-treesitter) — neovim itself runs without them
            // The upstream AppImage (current release) is the default wherever it runs: it's built on
            // ubuntu-22.04 runners, so it needs glibc >= 2.35 and is gated to those OSes. Distro
            // packages are `never-auto` — pinnable, and the method where the AppImage can't run
            // (EL9 via EPEL, Leap 15, Debian 11 / Ubuntu 20.04 ship older neovims). musl (Alpine,
            // void_musl) and atomic (brew; AppImages aren't managed there) take native outright.
            install: [ { via: native  when: "void_musl or alpine" }  { via: native  when: fedora_atomic }   // atomic: brew has neovim directly — cleaner than an AppImage needing fuse2
                       { via: native  when: "debian or fedora or arch or opensuse or void"  repo-component: universe  standing: never-auto }
                       { via: native  when: "rhel"  requires: epel  standing: never-auto }
                       { via: appImage  when: "(arch or void or fedora or (rhel >= 10) or opensuse_tumbleweed or (opensuse_leap >= 16) or (ubuntu >= 22.04) or (debian >= 12) or (elementary >= 7) or (linuxmint >= 21) or (lmde >= 6) or (mx >= 23) or (zorin >= 17) or pikaos or kali)"  cpu-names: { x86_64: x86_64  aarch64: arm64 }  name: Neovim  scope: user   // -> requires libfuse2; keep it in ~/apps
                         version: { github: neovim/neovim  asset: "nvim-linux-$ARCH.appimage" }
                         url: "https://github.com/neovim/neovim/releases/download/$VERSION/nvim-linux-$ARCH.appimage"
                         path: ~/apps/nvim.appimage }
                       { via: brew  name: neovim  standing: never-auto } ]   // never-auto like the distro pkgs: where the AppImage can't run, the (more specific) distro neovim still wins; brew is the default only where nothing else exists (kde_linux)
        }
        neovim-dotfiles: { description: "Neovim config, linked into place."
            install: [ { via: dotfiles
                         // configsys ships NO neovim config — it's a deeply personal thing. This
                         // only declares WHERE it lives, so `configsys dotfiles capture` can adopt
                         // your existing ~/.config/nvim into your config (your plugin, else the
                         // local store) and manage/sync it from there. Until you capture, this
                         // spec is unpopulated and install leaves ~/.config/nvim untouched.
                         config:  { src: neovim  dst: $XDG_CONFIG_HOME/nvim } } ]
        }
        neovim-glue: { description: "neovim shell setup, linked into place." install: [ { via: glue  requires: shell-glue  glue: neovim } ] }
        // Emacs — native under `emacs` in every family.
        emacs: { attrs: [ GUI TUI app FOSS GNU copyleft ] suggests: emacs-dotfiles  description: "The extensible, self-documenting text editor." install: [ { via: native  repo-component: universe }  { via: flatpak  hub: flathub  app: org.gnu.emacs }  { via: brew  name: emacs } ] }   // Linux brew emacs is a terminal build
        // Helix — native on dnf/pacman/zypper/apk/brew; NOT in the Ubuntu base repos, so the github
        // release tarball on the Debian family (ships `hx` alongside its runtime/ dir).
        helix: { attrs: [ TUI app FOSS permissive ] suggests: [ helix-dotfiles  helix-glue ]  description: "Post-modern modal editor (`hx`) — batteries included."
            install: [
                { via: native  when: "void or void_musl" }
                { via: native  when: "(redhat or arch or opensuse or alpine or fedora_atomic) and not amzn" }
                { via: tarball  when: "not alpine"  cpu-names: { x86_64: x86_64  aarch64: aarch64 }  installDir: "$CONFIGSYS_APP_DIR/helix"  requires: [ glibc, xz ]
                  version: { github: helix-editor/helix  strip-v: true  asset: "helix-*-$ARCH-linux.tar.xz" } }  { via: brew  name: helix } ]   // glibc build — offered everywhere except musl (alpine has the native pkg)
        }
        vis: { attrs: [ TUI app FOSS permissive ] suggests: vis-dotfiles  description: "vis — a vim-like editor with sam's structural regular expressions (`vis`)."
            install: [ { via: native  when: "debian or fedora or arch or opensuse or alpine or void or void_musl or fedora_atomic"  repo-component: universe }  { via: brew  name: vis } ] }   // brew on atomic; not in EPEL (source-only there)
        vis-dotfiles: { description: "vis config (visrc.lua), linked into place." install: [ { via: dotfiles  config: { src: vis  dst: $XDG_CONFIG_HOME/vis } } ] }
        // micro (`micro`): Go terminal editor. Native on Debian/Ubuntu universe, Fedora, Arch,
        // Alpine, openSUSE (as `micro-editor`), Void, Homebrew; EL via EPEL. Amazon Linux has neither,
        // so the upstream release tarball (ships `micro`) covers it + anything missed. Upstream moved
        // from zyedidia/micro to the micro-editor org.
        micro: { attrs: [ TUI app FOSS permissive ] suggests: [ micro-dotfiles  micro-glue ] 
            description: "Modern, intuitive terminal text editor (`micro`)."
            install: [
                { via: native  when: "(not rhel) and not amzn"  repo-component: universe  name: { zypper: micro-editor } }
                { via: native  when: "rhel"  requires: epel }
                { via: tarball  cpu-names: { x86_64: linux64  aarch64: linux-arm64 }  installDir: "$CONFIGSYS_APP_DIR/micro"  requires: glibc
                  version: { github: micro-editor/micro  strip-v: true  asset: "micro-*-$ARCH.tar.gz" } }
                { via: brew  name: micro }
            ]
        }
        // fresh — a modern, mouse-friendly terminal text editor in Rust (familiar shortcuts, LSP,
        // built-in file tree + terminal). Not in distro repos: upstream ships a .deb/.rpm and a static
        // musl binary that runs anywhere (incl. Alpine). Binary `fresh`.
        fresh: { attrs: [ TUI FOSS permissive ] description: "fresh — a modern, mouse-friendly terminal text editor (`fresh`)."
            install: [ { via: native-pkg-file  when: "debian"  version: { github: sinelaw/fresh  strip-v: true }  asset: { deb: { x86_64: "fresh-editor_*_amd64.deb" } } }
                       { via: native-pkg-file  when: "redhat or opensuse"  version: { github: sinelaw/fresh  strip-v: true }  asset: { rpm: { x86_64: "fresh-editor*x86_64.rpm" } } }
                       { via: tarball  when: "not (debian or redhat or opensuse)"  cpu-names: { x86_64: x86_64  aarch64: aarch64 }  installDir: "$CONFIGSYS_APP_DIR/fresh"
                         version: { github: sinelaw/fresh  strip-v: true  asset: "fresh-editor-$ARCH-unknown-linux-musl.tar.gz" } }  { via: brew  name: fresh-editor } ] }   // musl static -> runs on Alpine too
        // Zed — native on Arch; elsewhere its own install script (installs into ~/.local).
        zed: { attrs: [ GUI app FOSS copyleft tele ] suggests: [ zed-dotfiles  zed-glue ]  description: "High-performance, multiplayer code editor from the Atom team."
            install: [
                { via: native  when: "arch" }
                { via: flatpak  hub: flathub  app: dev.zed.Zed }
                { via: script
                  install-cmd:   'curl -f https://zed.dev/install.sh | sh'
                  version-cmd:   '"$HOME/.local/bin/zed" --version'
                  version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                  uninstall-cmd: 'rm -rf "$HOME/.local/zed.app" "$HOME/.local/bin/zed"'
                  location:      '~/.local/bin/zed' }
                { via: tarball  cpu-names: { x86_64: x86_64  aarch64: aarch64 }  installDir: "$CONFIGSYS_APP_DIR/zed"  version: { github: zed-industries/zed  strip-v: true  asset: "zed-linux-$ARCH.tar.gz" } } ]   // upstream release tarball (zed.app bundle) — cleaner than the curl|sh script
        }
        // vscode: native from Microsoft's vendor repos. Debian/Ubuntu/Pop use the MS apt
        // repo (key + an inline `deb` source-line -> package `code`); Fedora/EL use the MS
        // dnf repo (key + a .repo file); Arch builds `visual-studio-code-bin` from the AUR
        // (the OSS `code` in the Arch repos is a different, unbranded build).
        vscode: { attrs: [ GUI app FOSSish electron tele ] suggests: vscode-dotfiles  description: "Visual Studio Code — Microsoft's extensible code editor."
            install: [
                { via: flatpak  hub: flathub  app: com.visualstudio.code }   // community Flathub build — offered everywhere; the only method on atomic (no MS vendor repo to wire in)
                { via: native  when: "debian"  name: code
                  pubkey-url: "https://packages.microsoft.com/keys/microsoft.asc"
                  pubkey-path: /usr/share/keyrings/packages.microsoft.asc
                  source-line: "deb [arch=amd64,arm64,armhf signed-by=/usr/share/keyrings/packages.microsoft.asc] https://packages.microsoft.com/repos/code stable main"
                  source-path: /etc/apt/sources.list.d/vscode.list }
                { via: native  when: "redhat"  name: code
                  pubkey-url: "https://packages.microsoft.com/keys/microsoft.asc"
                  repo-id: code  repo-name: "Visual Studio Code"
                  repo-url: "https://packages.microsoft.com/yumrepos/vscode" }
                { via: aur  name: visual-studio-code-bin }
                { via: snap  name: code  classic: true }   // Microsoft-official snap (never-auto: the MS apt repo stays the Ubuntu default)
            ]
        }
        // vscodium: the fully-open build of Code — no Microsoft telemetry/branding, and the OSS
        // (non-proprietary) marketplace. Its own apt/dnf repos (download.vscodium.com), Flathub, snap,
        // Arch AUR; package/CLI is `codium`. The telemetry-free sibling of `vscode` (which IS MS's build).
        vscodium: { attrs: [ GUI app FOSS permissive electron ] suggests: vscodium-dotfiles  description: "VSCodium — the community, telemetry-free open-source build of VS Code (`codium`)."
            install: [
                { via: flatpak  hub: flathub  app: com.vscodium.codium }   // universal; the only method on atomic
                { via: native  when: "debian"  name: codium
                  pubkey-url: "https://gitlab.com/paulcarroty/vscodium-deb-rpm-repo/raw/master/pub.gpg"
                  pubkey-path: /usr/share/keyrings/vscodium.asc
                  source-line: "deb [signed-by=/usr/share/keyrings/vscodium.asc] https://download.vscodium.com/debs vscodium main"
                  source-path: /etc/apt/sources.list.d/vscodium.list }
                { via: native  when: "redhat"  name: codium
                  pubkey-url: "https://gitlab.com/paulcarroty/vscodium-deb-rpm-repo/raw/master/pub.gpg"
                  repo-id: vscodium  repo-name: "VSCodium"
                  repo-url: "https://download.vscodium.com/rpms/" }
                { via: aur  name: vscodium-bin }
                { via: snap  name: codium  classic: true }
            ]
        }
        // antigravity: Google's agent-first AI IDE (a VS Code fork — imports VS Code settings/exts;
        // "Manager view" orchestrates parallel agents across Gemini/Claude/GPT-OSS). Free PREVIEW.
        // Google ships auto-updating GAR apt/dnf repos (us-central1-apt/yum.pkg.dev, package
        // `antigravity`) — the ideal binding, but its exact key + apt suite are behind a JS page we
        // couldn't pin, so those are a TODO (a good target for a refresh version/preview hook). Here:
        // Arch AUR, and the upstream tarball elsewhere (a manual VERSION pin — bump the url; the app
        // self-updates after first launch, so a stale pin only affects the initial install).
        antigravity: { attrs: [ GUI app electron proprietary freeware account cloud tele beta ] suggests: antigravity-glue  description: "Google Antigravity — Google's agent-first AI IDE (a VS Code fork; Gemini/Claude/GPT-OSS)."
            install: [
                { via: aur  name: antigravity }
                { via: tarball  when: "not arch"  cpu-names: { x86_64: x64  aarch64: arm }  installDir: "$CONFIGSYS_APP_DIR/antigravity"  requires: glibc  version: { static: "2.19.1" }
                  url: "https://storage.googleapis.com/antigravity-public/antigravity-hub/2.19.1-6046815158665216/linux-$ARCH/Antigravity.tar.gz" } ]
        }
        // android-studio: Google's official tarball, unpacked scope-honoring (~/android-studio
        // for user, /opt/android-studio for system). No clean version API, so the version is a
        // manual pin — bump it from developer.android.com/studio. Fat IDE config deferred.
        android-studio: { attrs: [ GUI app FOSS permissive tele-optin ] description: "Android Studio — the official Android IDE."
            suggests: android-studio-glue
            install: [ { via: tarball  installDir: "$CONFIGSYS_APP_DIR/android-studio"  version: { static: 2024.2.1.11 }  standing: 1  requires: glibc   // Google's official tarball stays the default (glibc-linked JVM/launchers). No plain version endpoint for a `latest-check:` (the studio page is JS) — bump from developer.android.com/studio.
                         url: "https://redirector.gvt1.com/edgedl/android/studio/ide-zips/$VERSION/android-studio-$VERSION-linux.tar.gz" }
                       { via: flatpak  hub: flathub  app: com.google.AndroidStudio } ]   // community Flathub build offered as an alternative
        }
        // jmtpfs: FUSE filesystem to mount an MTP device (an Android phone over USB) as a
        // directory. Native on the debian + redhat families (apt universe, Fedora); AUR on Arch.
        // NOT in openSUSE/Alpine repos (name sweep confirmed), so the native binding is gated to
        // where it exists. The package pulls its FUSE + libmtp deps transitively (no `requires:`).
        android-file-transfer: { attrs: [ GUI CLI FOSS permissive ] description: "Android File Transfer for Linux — MTP access to Android devices (`android-file-transfer`, `aft-mtp-cli`)." install: [ { via: native  when: "debian or fedora or arch or opensuse or void or void_musl"  name: { xbps: android-file-transfer-linux zypper: android-file-transfer-linux  default: android-file-transfer } } ] }   // Arch [extra] (was AUR android-file-transfer-linux)
        jmtpfs: { attrs: [ CLI FOSS copyleft ] description: "jmtpfs — mount MTP devices (Android phones) via FUSE."
            install: [
                { via: native  when: "void or void_musl" }
                { via: aur  }
                { via: native  when: "(debian or redhat) and not amzn"  repo-component: universe }
            ]
        }
        // JetBrains Toolbox — the launcher that installs/updates IDEA, CLion, PyCharm, etc.
        // (cleaner than one-off IDE components). The version-less URL 302-redirects to the
        // latest tarball, which `curl -fSL` follows — so `static: latest`, no version to chase.
        jetbrains-toolbox: { attrs: [ GUI app proprietary freeware ] suggests: jetbrains-toolbox-glue  description: "JetBrains Toolbox — install and manage JetBrains IDEs."
            install: [ { via: tarball  installDir: "$CONFIGSYS_APP_DIR/jetbrains-toolbox"  requires: glibc   // glibc-linked launcher
                         version: { static: latest }
                         url: "https://download.jetbrains.com/product?code=TBA&latest&distribution=linux" } ]
        }

        // --- AI / LLM command-line tools ---
        // Claude Code and Codex are npm globals (userland via the npm driver). llm and aider are
        // Python CLIs (pipx). Ollama is a LOCAL INFERENCE SERVER: native on Arch/Homebrew, else its
        // own install script (which also sets up the systemd service); a best-effort uninstall is
        // declared so the script driver can remove it cleanly.
        // Anthropic's official native installer is the preferred method (no Node needed, self-updating);
        // `claude --version` lets detection SEE an existing native install so it's never reinstalled.
        // npm stays as a pinnable fallback but is never the auto-default.
        claude-code: { attrs: [ CLI proprietary account cloud online paid freemium ] suggests: claude-code-dotfiles  description: "Claude Code — Anthropic's agentic coding CLI."
            install: [ { via: script  requires: curl
                         install-cmd:   'curl -fsSL https://claude.ai/install.sh | bash'
                         version-cmd:   'claude --version 2>/dev/null'
                         version-re:    '([0-9][0-9.]*)'
                         upgrade-cmd:   'claude update'
                         uninstall-cmd: 'rm -f "$HOME/.local/bin/claude"'
                         location:      '~/.local/bin/claude' }
                       { via: npm  name: "@anthropic-ai/claude-code"  standing: never-auto } ] }
        codex:       { attrs: [ CLI FOSS permissive account cloud online paid freemium ] suggests: codex-dotfiles  description: "OpenAI Codex CLI — agentic coding in the terminal." install: [ { via: npm  name: "@openai/codex" } ] }
        llm:         { attrs: [ CLI FOSS permissive ] description: "`llm` — a CLI to access LLMs from the shell and scripts." install: [ { via: pipx  name: llm  version: { pypi: llm } }  { via: brew  name: llm } ] }
        aider:       { attrs: [ CLI FOSS permissive account cloud ] suggests: aider-dotfiles  description: "Aider — AI pair-programming in your terminal, over your git repo." install: [ { via: pipx  name: aider-chat  version: { pypi: aider-chat } }  { via: brew  name: aider } ] }        // PyPI dist is aider-chat
        ollama: { attrs: [ CLI daemon FOSS permissive ] description: "Ollama — run large language models locally."
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }             // brew formula `ollama`
                { via: script
                  install-cmd:   'curl -fsSL https://ollama.com/install.sh | sh'
                  version-cmd:   'ollama --version'
                  version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                  uninstall-cmd: 'sudo systemctl stop ollama 2>/dev/null; sudo rm -f /usr/local/bin/ollama /etc/systemd/system/ollama.service; sudo rm -rf /usr/share/ollama'
                  location:      '/usr/local/bin/ollama' }
                { via: tarball  cpu-names: { x86_64: amd64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/ollama"  requires: zstd  version: { github: ollama/ollama  strip-v: true  asset: "ollama-linux-$ARCH.tar.zst" } }  { via: brew  name: ollama } ]   // upstream tarball (zstd; bin/ + lib/) — a no-daemon userland alt to the install script
        }

        // --- container / k8s / dev TUIs & C++ package managers ---
        // lazydocker's asset embeds the version (github asset discovery, like lazygit); lazysql
        // and k9s have stable asset names, so they use github's API-free latest/download URL.
        lazydocker: { attrs: [ TUI FOSS permissive ] suggests: [ lazydocker-dotfiles  lazydocker-glue ] 
            description: "Terminal UI for Docker/Compose — containers, logs, stats."
            install: [ { via: native  when: "void_musl" }  { via: tarball  cpu-names: { x86_64: x86_64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/lazydocker"  requires: glibc
                         version: { github: jesseduffield/lazydocker  strip-v: true  asset: "lazydocker_*_Linux_$ARCH.tar.gz" } }  { via: brew  name: lazydocker } ]
        }
        // TUI clients + creative/misc terminal apps.
        discordo: { attrs: [ TUI app FOSS permissive account cloud online ] description: "Discordo — a lightweight terminal (TUI) Discord client."
                    install: [ { via: aur  name: discordo-git }
                               { via: go-install  name: "github.com/ayn2op/discordo"  requires: [ { go: ">=1.26" } ] } ] }   // no releases (rolling master); AUR on arch, `go install` elsewhere (a modern Go toolchain floor advises the go tarball)
        caligula: { attrs: [ TUI FOSS copyleft ] description: "Caligula — a user-friendly TUI disk imager / ISO burner."
                    install: [ { via: native  when: "arch or fedora_atomic or void or void_musl" }
                               { via: cargo   name: caligula  version: { crates: caligula } } ] }   // pacman / brew where packaged; cargo everywhere else (and pinnable anywhere)
        // balenaEtcher (Electron GUI imager). No distro repo pkg, no Flathub, and 2.x dropped the
        // AppImage — so it's the upstream .deb/.rpm (native-pkg-file) + AUR only. Declines on
        // Alpine (musl/Electron) and atomic.
        balena-etcher: { attrs: [ GUI app electron FOSS permissive tele ] description: "balenaEtcher — a GUI tool to flash OS images to USB/SD cards (`balena-etcher`)."
            install: [ { via: native-pkg-file  when: "debian"           version: { github: balena-io/etcher }  asset: { deb: { x86_64: "balena-etcher_*_amd64.deb" } } }
                       { via: native-pkg-file  when: "redhat or opensuse"  version: { github: balena-io/etcher }  asset: { rpm: { x86_64: "balena-etcher-*.x86_64.rpm" } } }
                       { via: aur  name: balena-etcher } ] }
        durdraw: { attrs: [ TUI app FOSS permissive ] description: "Durdraw — an ASCII/ANSI/Unicode terminal art and animation editor."
                   install: [ { via: pipx  name: durdraw }
                              { via: aur  name: durdraw }  { via: brew  name: durdraw } ] }   // Python; pipx is the universal method
        astroterm: { attrs: [ TUI app FOSS permissive ] description: "astroterm — a terminal planetarium / star map (stars, planets, constellations)."
                     install: [ { via: native  when: "fedora or fedora_atomic or arch" }  { via: brew  name: astroterm } ] }   // dnf on Fedora (F40+), brew on atomic, Arch [extra] (promoted from the AUR); declines elsewhere
        webcamize: { attrs: [ CLI FOSS copyleft ] description: "webcamize — use a DSLR/mirrorless/other camera as a Linux webcam (via v4l2loopback)."
                     install: [ { via: aur  name: webcamize } ] }   // AUR-only (build-from-source elsewhere); needs v4l2loopback + libgphoto2 at runtime
        lazysql: { attrs: [ TUI FOSS permissive ] suggests: lazysql-glue  description: "Terminal UI for SQL databases (`lazysql`)."
            install: [ { via: native  when: "void_musl" }  { via: tarball  cpu-names: { x86_64: x86_64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/lazysql"  requires: glibc  version: { static: latest }
                         url: "https://github.com/jorgerojas26/lazysql/releases/latest/download/lazysql_Linux_$ARCH.tar.gz" }  { via: brew  name: lazysql } ]
        }
        // DBX (t8y2/dbx): a Tauri database client — not in any distro. Upstream .deb/.rpm/AppImage are
        // built on ubuntu-22.04 (glibc >= 2.35; the .deb needs webkit2gtk-4.1), so every method is gated to
        // those OSes. Releases share the repo with a `packages-v*` CLI tag stream -> tag-re keeps to `v*`.
        dbx: { attrs: [ GUI app FOSS permissive ] description: "DBX — a lightweight, cross-platform client for 100+ databases (`dbx`; optional bring-your-own-key AI assistant)."
            install: [ { via: native-pkg-file  when: "(ubuntu >= 22.04) or (debian >= 12) or (elementary >= 7) or (linuxmint >= 21) or (lmde >= 6) or (mx >= 23) or (zorin >= 17) or pikaos or kali"  version: { github: t8y2/dbx  tag-re: "^v([0-9][0-9.]*)$" }
                         asset: { x86_64: "DBX_*_amd64.deb"  aarch64: "DBX_*_arm64.deb" } }
                       { via: native-pkg-file  when: "fedora or (rhel >= 10) or opensuse_tumbleweed or (opensuse_leap >= 16)"  version: { github: t8y2/dbx  tag-re: "^v([0-9][0-9.]*)$" }
                         asset: { x86_64: "DBX-*-1.x86_64.rpm"  aarch64: "DBX_*_arm64.rpm" } }
                       { via: aur  when: "arch"  name: dbx-bin }   // `when: "arch"`: keeps it ahead of the AppImage, whose version gate lists arch
                       { via: appImage  when: "arch or void or fedora or (rhel >= 10) or opensuse_tumbleweed or (opensuse_leap >= 16) or (ubuntu >= 22.04) or (debian >= 12) or (elementary >= 7) or (linuxmint >= 21) or (lmde >= 6) or (mx >= 23) or (zorin >= 17) or pikaos or kali"  cpu-names: { x86_64: amd64  aarch64: arm64 }  name: DBX  scope: user
                         version: { github: t8y2/dbx  tag-re: "^v([0-9][0-9.]*)$"  asset: "DBX_*_$ARCH.AppImage" }  path: ~/apps/dbx.appimage } ] }
        k9s: { attrs: [ TUI FOSS permissive ] suggests: [ k9s-dotfiles  k9s-glue ] 
            description: "Terminal UI to navigate and manage Kubernetes clusters."
            install: [
                { via: native  when: "arch or void or void_musl" }
                { via: native  when: "fedora_atomic" }             // brew formula `k9s`
                { via: tarball  cpu-names: { x86_64: amd64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/k9s"  requires: glibc  version: { static: latest }
                  url: "https://github.com/derailed/k9s/releases/latest/download/k9s_Linux_$ARCH.tar.gz" }  { via: brew  name: k9s } ]
        }
        // kubectl isn't in the Debian/Fedora base repos; native on Arch/Homebrew, else the upstream
        // static binary from dl.k8s.io (bare-binary tarball mode; `stable.txt` gives the version).
        // The Go binary runs anywhere, so no glibc gate.
        kubectl: { attrs: [ CLI FOSS permissive ] suggests: kubectl-glue  description: "kubectl — the Kubernetes command-line client."
            install: [
                { via: native  when: "arch or void or void_musl" }
                { via: native  when: "fedora_atomic"  name: kubernetes-cli }   // brew's canonical formula (`kubectl` is an alias)
                { via: tarball  cpu-names: { x86_64: amd64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/kubectl"  archive: none   // static Go binary from dl.k8s.io — runs anywhere; a uniform option (native stays default on arch/atomic)
                  version: { url: "https://dl.k8s.io/release/stable.txt" }
                  url: "https://dl.k8s.io/release/v$VERSION/bin/linux/$ARCH/kubectl" }
                { via: snap  name: kubectl  classic: true }  { via: brew  name: kubernetes-cli } ]   // Canonical-official snap (never-auto)
        }
        // helm & k3s install via their upstream scripts (script driver) where not native.
        helm: { attrs: [ CLI FOSS permissive ] suggests: helm-dotfiles  description: "Helm — the package manager for Kubernetes."
            install: [
                { via: native  when: "arch or void or void_musl" }
                { via: native  when: "fedora_atomic" }
                { via: script
                  install-cmd:   'curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash'
                  version-cmd:   'helm version --short'
                  version-re:    '(v?[0-9]+\.[0-9]+\.[0-9]+)'
                  uninstall-cmd: 'sudo rm -f /usr/local/bin/helm'
                  location:      '/usr/local/bin/helm' }
                { via: snap  name: helm  classic: true }  { via: brew  name: helm } ]   // community (Snapcrafters) snap (never-auto)
        }
        k3s: { attrs: [ daemon CLI FOSS permissive ] description: "k3s — lightweight, single-binary Kubernetes."
            install: [ { via: script  standing: 1                              // keep the get.k3s.io script the default: it sets up the systemd SERVICE (the point of a k8s server); the tarball is just the bare binary
                         install-cmd:   'curl -sfL https://get.k3s.io | sh'
                         version-cmd:   'k3s --version'
                         version-re:    '(v[0-9]+\.[0-9]+\.[0-9]+)'
                         uninstall-cmd: '/usr/local/bin/k3s-uninstall.sh'
                         location:      '/usr/local/bin/k3s' }
                       { via: tarball  archive: none  binary: k3s  installDir: "$CONFIGSYS_APP_DIR/k3s"  version: { github: k3s-io/k3s  asset: "k3s" } } ]   // raw static binary (the API gives the +k3s1-tagged download URL); an option for "just the binary"
        }
        // conan is a Python CLI (pipx). vcpkg is a git clone + bootstrap (script driver; needs git).
        conan: { attrs: [ CLI FOSS permissive ] description: "Conan — a C/C++ package manager." install: [ { via: pipx  name: conan  version: { pypi: conan } }  { via: brew  name: conan } ] }
        vcpkg: { attrs: [ CLI FOSS permissive ] suggests: vcpkg-glue  description: "vcpkg — Microsoft's C/C++ library manager."
            requires: [ git, curl, zip, unzip ]     // bootstrap-vcpkg fetches + unpacks its tool
            install: [ { via: script
                         install-cmd:   'git clone https://github.com/microsoft/vcpkg "$HOME/.vcpkg" && "$HOME/.vcpkg/bootstrap-vcpkg.sh" -disableMetrics'
                         version-cmd:   '"$HOME/.vcpkg/vcpkg" version'
                         version-re:    '([0-9]{4}-[0-9]{2}-[0-9]{2})'
                         uninstall-cmd: 'rm -rf "$HOME/.vcpkg"'
                         location:      '~/.vcpkg' }  { via: brew  name: vcpkg } ]
        }

        // --- build systems ---
        make:  { attrs: [ CLI FOSS GNU copyleft ] description: "GNU Make — build automation via Makefiles." install: [ { via: native }  { via: brew  name: make } ] }
        cmake: { attrs: [ CLI FOSS permissive ] description: "CMake — cross-platform build-system generator." install: [ { via: native }  { via: brew  name: cmake } ] }
        ccmake: { attrs: [ TUI FOSS permissive ] description: "ccmake — the curses (TUI) frontend to CMake." install: [ { via: native  when: "debian"  name: cmake-curses-gui } ] }   // Debian splits it out; other distros bundle ccmake in `cmake`
        cmake-gui: { attrs: [ GUI FOSS permissive ] description: "cmake-gui — the Qt GUI frontend to CMake." install: [ { via: native  when: "debian or redhat or opensuse or void or void_musl"  name: { apt: cmake-qt-gui  dnf: cmake-gui  zypper: cmake-gui } } ] }   // Debian/Fedora/openSUSE split it out; Arch bundles it in `cmake`
        ninja: { attrs: [ CLI FOSS permissive ] description: "Ninja — a small, fast build backend." install: [ { via: native  name: { apt: ninja-build  dnf: ninja-build  apk: samurai  default: ninja } }  { via: brew  name: ninja } ] }
        meson: { attrs: [ CLI FOSS permissive ] description: "Meson — a fast, modern build system." install: [ { via: native }  { via: brew  name: meson } ] }

        // --- autotools / GNU C build tools (the basic C-dev toolchain; grouped in the `autotools`
        // profile). Same package name on every manager except pkg-config. Source plugins/recipes
        // `requires:` these by name and resolve them from here. ---
        pkg-config: { attrs: [ CLI FOSS copyleft ] description: "pkg-config — query installed libraries' compile and link flags at build time."
                      install: [ { via: native  name: { dnf: pkgconf-pkg-config  pacman: pkgconf  apk: pkgconf  zypper: pkgconf-pkg-config } } ] }
        autoconf: { attrs: [ CLI toolchain FOSS GNU copyleft ] description: "GNU Autoconf — generate a package's `configure` script from autotools macros." install: [ { via: native }  { via: brew  name: autoconf } ] }
        automake: { attrs: [ CLI toolchain FOSS GNU copyleft ] description: "GNU Automake — generate a portable Makefile.in from Makefile.am (autotools)." install: [ { via: native }  { via: brew  name: automake } ] }
        libtool:  { attrs: [ CLI lib FOSS GNU copyleft ] description: "GNU Libtool — a portable shared-library build/link wrapper (autotools)." install: [ { via: native }  { via: brew  name: libtool } ] }
        bison:    { attrs: [ CLI toolchain FOSS GNU copyleft ] description: "GNU Bison — the yacc-compatible parser generator." install: [ { via: native }  { via: brew  name: bison } ] }
        flex:     { attrs: [ CLI toolchain FOSS permissive ] description: "flex — the fast lexical-analyzer (lexer) generator." install: [ { via: native }  { via: brew  name: flex } ] }
        // perl + nasm — referenced by the `languages` profile; they belong in base so those resolve.
        perl:     { attrs: [ CLI runtime FOSS copyleft ] description: "Perl — a capable, mature general-purpose scripting language (`perl`)." install: [ { via: native }  { via: brew  name: perl } ] }
        nasm:     { attrs: [ CLI toolchain FOSS permissive ] description: "NASM — the Netwide x86/x86-64 assembler (`nasm`)." install: [ { via: native }  { via: brew  name: nasm } ] }
        // just: native on rpm/Arch/openSUSE/brew; the upstream musl tarball (statically linked,
        // runs anywhere) is offered as a uniform option everywhere — it's the default on the Debian
        // family (no repo package; works on older apt too, e.g. Ubuntu/Pop 22.04) and a candidate
        // elsewhere (native stays the default where the distro packages it).
        just: { attrs: [ CLI FOSS permissive ] suggests: just-glue  description: "just — a handy command runner (Makefile-like `justfile`)."
            install: [
                { via: native  when: "void or void_musl" }
                { via: native  when: "(redhat or arch or opensuse or fedora_atomic) and not amzn" }
                { via: tarball  cpu-names: { x86_64: x86_64  aarch64: aarch64 }  installDir: "$CONFIGSYS_APP_DIR/just"
                  version: { github: casey/just  strip-v: true  asset: "just-*-$ARCH-unknown-linux-musl.tar.gz" } }
                { via: cargo  name: just  version: { crates: just } }  { via: brew  name: just } ]                        // `cargo install just` as a pinnable alt
        }
        // Bazelisk (the official launcher that manages bazel versions) — a bare static binary.
        bazelisk: { attrs: [ CLI FOSS permissive ] suggests: bazelisk-glue  description: "Bazelisk — a launcher that manages Bazel versions."
            install: [
                { via: native  when: "fedora_atomic" }             // brew formula `bazelisk`
                { via: tarball  cpu-names: { x86_64: amd64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/bazelisk"  archive: none  binary: bazelisk  version: { static: latest }
                  url: "https://github.com/bazelbuild/bazelisk/releases/latest/download/bazelisk-linux-$ARCH" }  { via: brew  name: bazelisk } ]
        }
        // Maven (native everywhere) and Gradle (native except Fedora base — use SDKMAN there). Both
        // need a JVM.
        maven:  { attrs: [ CLI FOSS permissive ] suggests: maven-dotfiles  description: "Apache Maven — Java build and dependency management." requires: jdk
                  install: [ { via: native  name: { xbps: apache-maven } }  { via: sdkman  standing: never-auto }  { via: brew  name: maven } ] }   // native default; SDKMAN for a pinned version
        gradle: { attrs: [ CLI FOSS permissive ] suggests: gradle-dotfiles  description: "Gradle — JVM build automation." requires: jdk
                  install: [ { via: native  when: "debian or arch or fedora_atomic or void or void_musl" }   // native where packaged
                             { via: sdkman  when: "not debian and not arch and not fedora_atomic" }  { via: brew  name: gradle } ] }   // SDKMAN elsewhere (fedora/alpine/opensuse) + any pinned version
        // Jenkins — CI/CD automation server (web UI on :8080). Official apt/dnf vendor repos (stable
        // LTS) + AUR on Arch; needs a JDK. No brew/atomic/alpine binding (use the war or a container).
        // Jenkins signs both its apt and dnf repos with a rotating "Jenkins Project" key. Since
        // 2025-12 the repos are signed by a NEW key (fpr 5E38 6EAD B55F 0150 4CAE 8BCF 7198 F4B7 14AB
        // FC68) that Jenkins has NOT published at a jenkins.io-<year>.key URL yet — their
        // jenkins.io-2023.key still ships only the OLD key, so fetching THAT leaves apt/dnf with
        // `NO_PUBKEY …7198…` and a repo that won't verify (breaking every `apt-get update`). So pin
        // the CURRENT key by full fingerprint from the Ubuntu keyserver (HTTPS + fingerprint = not
        // spoofable). REVERT to Jenkins' own keyfile once they publish it (jenkins.io-2025.key).
        // NOTE: the key is fetched only if the keyring file is ABSENT — a machine with a stale
        // jenkins-keyring.asc must delete it first for the new key to be pulled.
        jenkins: { attrs: [ web daemon FOSS permissive ] description: "Jenkins — an automation server for CI/CD (web UI on :8080)." requires: jdk
            install: [
                { via: native  when: "void or void_musl" }
                { via: native  when: "debian"  name: jenkins   // Jenkins' official apt repo (stable/LTS)
                  pubkey-url: "https://keyserver.ubuntu.com/pks/lookup?op=get&options=mr&search=0x5E386EADB55F01504CAE8BCF7198F4B714ABFC68"
                  pubkey-path: /usr/share/keyrings/jenkins-keyring.asc
                  source-line: "deb [signed-by=/usr/share/keyrings/jenkins-keyring.asc] https://pkg.jenkins.io/debian-stable binary/"
                  source-path: /etc/apt/sources.list.d/jenkins.list }
                { via: native  when: "redhat"  name: jenkins   // Jenkins' official dnf repo (stable/LTS); same rotated key
                  pubkey-url: "https://keyserver.ubuntu.com/pks/lookup?op=get&options=mr&search=0x5E386EADB55F01504CAE8BCF7198F4B714ABFC68"
                  repo-id: jenkins  repo-name: "Jenkins"
                  repo-url: "https://pkg.jenkins.io/redhat-stable/" }
                { via: native  when: "arch" }  { via: brew  name: jenkins } ]   // Arch [extra] (promoted from the AUR)
        }

        // --- debugging / static analysis / profiling (NB: ASan/UBSan/TSan are gcc/clang FLAGS,
        // not packages — nothing to install for those). ---
        valgrind:  { attrs: [ CLI FOSS copyleft ] suggests: valgrind-dotfiles  description: "Valgrind — memory-error and leak detector." install: [ { via: native }  { via: brew  name: valgrind } ] }
        cppcheck:  { attrs: [ CLI FOSS copyleft ] description: "Cppcheck — static analysis for C/C++." install: [ { via: native }  { via: brew  name: cppcheck } ] }
        doxygen:   { attrs: [ CLI FOSS GNU copyleft ] description: "Doxygen — generate API docs from annotated C/C++/… source." install: [ { via: native }  { via: brew  name: doxygen } ] }
        swig:      { attrs: [ CLI FOSS permissive ] description: "SWIG — generate scripting-language bindings for C/C++ (`swig`)." install: [ { via: native }  { via: brew  name: swig } ] }   // apt `swig`: a meta over swig4.0 on older Debian/Ubuntu (installed too, so it answers), the real package on 24.04+ (swig 4.2; no swig4.0)
        source-highlight: { attrs: [ CLI FOSS GNU copyleft ] description: "GNU Source-highlight — syntax-highlight source to HTML and other formats."
                            install: [ { via: native  when: "not (rhel or amzn)" }
                                       { via: native  when: "rhel"  requires: epel }  { via: brew  name: source-highlight } ] }   // EL via EPEL
        po4a:      { attrs: [ CLI FOSS GNU copyleft ] description: "po4a — keep doc translations (man/markdown/…) in sync via PO files."
                     install: [ { via: native  when: "not (rhel or amzn)" }
                                { via: native  when: "rhel"  requires: epel }  { via: brew  name: po4a } ] }   // EL via EPEL
        asciidoc:  { attrs: [ CLI FOSS GNU copyleft ] description: "AsciiDoc — a plain-text document format rendered to HTML/DocBook/man (`asciidoc`, `a2x`)."
                     install: [ { via: native  when: "not (rhel or amzn)" }
                                { via: native  when: "rhel"  requires: epel }  { via: brew  name: asciidoc } ] }   // EL via EPEL
        strace:    { attrs: [ CLI FOSS copyleft ] description: "strace — trace the system calls of a running program." install: [ { via: native }  { via: brew  name: strace } ] }
        ltrace:    { attrs: [ CLI FOSS copyleft ] description: "ltrace — trace the library calls of a running program." install: [ { via: native } ] }
        lldb:      { attrs: [ CLI FOSS permissive ] description: "LLDB — the LLVM project's debugger." install: [ { via: native }  { via: brew  name: lldb } ] }
        // --- reverse-engineering / analysis ---
        radare2:   { attrs: [ CLI FOSS GNU copyleft ] description: "radare2 — a portable reverse-engineering framework & low-level debugger (`r2`)." install: [ { via: native  repo-component: universe }  { via: native  when: "fedora_atomic" }  { via: brew  name: radare2 } ] }   // packaged on every family (+ brew on atomic); a modern stand-in for the old SoftICE workflow
        ghidra:    { attrs: [ GUI app FOSS permissive ] description: "Ghidra — the NSA's open-source software reverse-engineering (SRE) suite." install: [ { via: flatpak  hub: flathub  app: org.ghidra_sre.Ghidra }  { via: native  when: "arch or void or void_musl" }  { via: tarball  installDir: "$CONFIGSYS_APP_DIR/ghidra"  requires: [ unzip, jdk-21 ]  version: { github: NationalSecurityAgency/ghidra  tag-re: "Ghidra_([0-9.]+)_build"  asset: "ghidra_*_PUBLIC_*.zip" } } ] }   // flatpak bundles a JRE (default); the release zip needs a JDK 21 -> requires it
        // RAD Debugger (Epic): alpha. Release binaries are Windows-only; on Linux it BUILDS (the AUR package
        // runs ./build.sh), but its debugging target is still Windows x64 only — native Linux debugging is
        // upstream's next phase. AUR-only, x86_64.
        raddebugger: { attrs: [ GUI app FOSS permissive beta ] description: "RAD Debugger — Epic's fast native debugger (`raddbg`; alpha — on Linux it builds, but debugs Windows x64 targets only so far)."
            install: [ { via: aur  cpu-names: { x86_64: x86_64 }  name: raddebugger } ] }
        grex:      { attrs: [ CLI FOSS permissive ] description: "grex — generate a regular expression from user-provided examples (`grex`)." install: [ { via: tarball  installDir: "$CONFIGSYS_APP_DIR/grex"  version: { github: pemistahl/grex  strip-v: true  asset: "grex-*-$ARCH-unknown-linux-musl.tar.gz" } }  { via: native  when: "fedora_atomic" }  { via: cargo  name: grex  version: { crates: grex } }  { via: brew  name: grex } ] }   // musl tarball runs everywhere (incl. Alpine); brew on atomic; cargo as a pinnable build
        faker:     { attrs: [ CLI lib FOSS permissive ] description: "Faker — generate fake data (names, addresses, …) from the CLI (`faker`) or as a Python library." install: [ { via: pipx  name: Faker }  { via: brew  name: faker } ] }   // the `faker` console script ships with the PyPI package -> pipx everywhere
        obsidian:  { attrs: [ GUI app proprietary electron ] description: "Obsidian — a local-first Markdown knowledge base / note-taking app (free, proprietary)." install: [ { via: flatpak  hub: flathub  app: md.obsidian.Obsidian }  { via: aur  name: obsidian-bin } ] }   // flatpak is the universal + atomic path; works fully offline (sync is a paid add-on)
        scratch:   { attrs: [ GUI app FOSS permissive electron ] description: "Scratch — MIT's block-based visual programming environment for learners (the official offline desktop editor)." install: [ { via: flatpak  hub: flathub  app: edu.mit.Scratch } ] }   // the only Linux desktop build (Flathub; note it lags the web editor)
        heaptrack: { attrs: [ CLI GUI app FOSS copyleft ] description: "heaptrack — a heap-memory profiler for C/C++." install: [ { via: native  when: "void or void_musl" }  { via: native  when: "(debian or redhat or arch or opensuse) and not amzn" } ] }
        clang-tidy: { attrs: [ CLI FOSS permissive ] description: "clang-tidy — C/C++ linter and static analyzer." install: [ { via: native  when: "debian or redhat or arch or void or void_musl"  name: { xbps: clang-tools-extra apt: clang-tidy  dnf: clang-tools-extra  pacman: clang } } ] }
        clang: { attrs: [ CLI toolchain FOSS permissive ] description: "Clang/LLVM — the distro's default C/C++/Obj-C compiler (`clang`; the versioned clang-NN are separate components)." install: [ { via: native  when: "not alpine"  name: { brew: llvm  default: clang } }  { via: brew  name: llvm } ] }   // distro-default clang; brew ships it in `llvm`; Alpine has only version-scoped clangNN (use the clang-N components)
        clangd:    { attrs: [ CLI FOSS permissive ] description: "clangd — the LLVM C/C++ language server (LSP)." install: [ { via: native  when: "debian or redhat or arch or void or void_musl"  name: { xbps: clang-tools-extra apt: clangd  dnf: clang-tools-extra  pacman: clang } } ] }
        // perf is kernel-coupled and named per-distro: Ubuntu's linux-tools track, Debian's
        // linux-perf (also Proxmox); plain `perf` on redhat/arch/opensuse/alpine.
        perf: { attrs: [ CLI FOSS copyleft ] description: "Linux `perf` — sampling profiler and performance counters." install: [ { via: native  name: { default: perf } }
                           { via: native  when: debian  name: { apt: linux-perf } }
                           { via: native  when: ubuntu  name: { apt: linux-tools-generic } } ] }
        // The `analysis` debug/analysis kit (valgrind, cppcheck, clang-tidy, lldb, strace, ltrace) is a
        // user-facing profile (in config.hu), not a parts-component — you curate/pin the tools you want,
        // and each installs wherever it routes rather than an all-or-nothing per-OS gate.

        // --- configuration management ---
        // ansible is native everywhere (robust, CLI on PATH — pipx would hide it, since the
        // `ansible` command actually ships in the ansible-core dependency, which pipx won't link).
        // salt is Python with self-contained scripts (pipx). puppet is Ruby (gem). No chef (heavy
        // enterprise tool that also overlaps configsys itself).
        ansible: { attrs: [ CLI FOSS copyleft ] description: "Ansible — agentless IT automation and configuration management." install: [ { via: native  repo-component: universe }  { via: brew  name: ansible } ] }
        salt:    { attrs: [ CLI daemon FOSS permissive ] description: "Salt — event-driven automation and configuration management." install: [ { via: pipx  name: salt  version: { pypi: salt } } ] }
        puppet:  { attrs: [ CLI daemon FOSS FOSSish permissive ] description: "Puppet — declarative configuration management." install: [ { via: gem   name: puppet } ] }

        // --- back-end: cloud CLIs, IaC, protobuf, DB clients + servers ---
        // Cloud CLIs via their official installers (script driver, userland).
        awscli: { attrs: [ CLI FOSS permissive account cloud ] suggests: awscli-dotfiles  description: "AWS CLI — the command-line interface for Amazon Web Services."
            requires: [ curl, unzip ]
            install: [ { via: script
                         install-cmd:   'curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o /tmp/awscliv2.zip && unzip -q -o /tmp/awscliv2.zip -d /tmp/awscli-inst && /tmp/awscli-inst/aws/install --update -i "$HOME/.local/aws-cli" -b "$HOME/.local/bin" && rm -rf /tmp/awscliv2.zip /tmp/awscli-inst'
                         version-cmd:   '"$HOME/.local/bin/aws" --version'
                         version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                         uninstall-cmd: 'rm -rf "$HOME/.local/aws-cli" "$HOME/.local/bin/aws" "$HOME/.local/bin/aws_completer"'
                         location:      '~/.local/bin/aws' }  { via: brew  name: awscli } ]
        }
        gcloud: { attrs: [ CLI proprietary freeware account cloud ] suggests: gcloud-glue  description: "Google Cloud CLI (`gcloud`) — manage GCP resources."
            requires: curl
            install: [ { via: script
                         install-cmd:   'curl -fsSL https://sdk.cloud.google.com | bash -s -- --disable-prompts --install-dir="$HOME"'
                         version-cmd:   '"$HOME/google-cloud-sdk/bin/gcloud" version'
                         version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                         uninstall-cmd: 'rm -rf "$HOME/google-cloud-sdk"'
                         location:      '~/google-cloud-sdk/bin' } ]
        }
        azure-cli: { attrs: [ CLI FOSS permissive account cloud ] description: "Azure CLI (`az`) — manage Microsoft Azure resources." install: [ { via: pipx  name: azure-cli  version: { pypi: azure-cli } } ] }
        // IaC + gRPC — Go static binaries from github release tarballs.
        opentofu: { attrs: [ CLI app FOSS permissive ] suggests: opentofu-glue  description: "OpenTofu — open-source, Terraform-compatible infrastructure as code." install: [ { via: tarball  cpu-names: { x86_64: amd64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/opentofu"  version: { github: opentofu/opentofu  strip-v: true  asset: "tofu_*_linux_$ARCH.tar.gz" } }  { via: brew  name: opentofu } ] }
        grpcurl:  { attrs: [ CLI FOSS permissive ] suggests: grpcurl-glue  description: "curl for gRPC — call and inspect gRPC services from the shell." install: [ { via: tarball  cpu-names: { x86_64: x86_64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/grpcurl"   version: { github: fullstorydev/grpcurl  strip-v: true  asset: "grpcurl_*_linux_$ARCH.tar.gz" } }  { via: brew  name: grpcurl } ] }
        protobuf: { attrs: [ CLI toolchain FOSS permissive ] suggests: protobuf-glue  description: "Protocol Buffers compiler (`protoc`)." install: [ { via: native  repo-component: universe  name: { apt: protobuf-compiler  dnf: protobuf-compiler  zypper: protobuf-devel  default: protobuf } }  { via: tarball  cpu-names: { x86_64: x86_64  aarch64: aarch_64 }  installDir: "$CONFIGSYS_APP_DIR/protobuf"  requires: unzip  version: { github: protocolbuffers/protobuf  strip-v: true  asset: "protoc-*-linux-$ARCH.zip" } }  { via: brew  name: protobuf } ] }   // prebuilt protoc + well-known-types include/
        protobuf-dev: { attrs: [ lib FOSS permissive ] description: "Protocol Buffers C++ runtime + headers (libprotobuf; distinct from the `protobuf` compiler)."
            install: [ { via: native  when: "void or void_musl"  name: protobuf-devel }  { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libprotobuf-dev  dnf: protobuf-devel  pacman: protobuf  apk: protobuf-dev  zypper: protobuf-devel  brew: protobuf } } ] }
        // DB clients: dbeaver (GUI, Flathub), pgcli/mycli (pipx), sqlitebrowser (Flathub).
        dbeaver:       { attrs: [ GUI app FOSS permissive ] description: "Universal database GUI — browse and query many DB engines." install: [ { via: flatpak  hub: flathub  app: io.dbeaver.DBeaverCommunity }  { via: native-pkg-file  when: "debian or redhat"  version: { github: dbeaver/dbeaver }  asset: { deb: { x86_64: "dbeaver-ce-*-linux-x86_64.deb" }  rpm: { x86_64: "dbeaver-ce-*-linux-x86_64.rpm" } } } ] }   // upstream .deb/.rpm (CE)
        pgcli:         { attrs: [ CLI FOSS permissive ] suggests: pgcli-dotfiles  description: "Postgres CLI with autocompletion and syntax highlighting." install: [ { via: pipx  name: pgcli  version: { pypi: pgcli } }  { via: brew  name: pgcli } ] }
        mycli:         { attrs: [ CLI FOSS permissive ] suggests: mycli-dotfiles  description: "MySQL/MariaDB CLI with autocompletion and highlighting." install: [ { via: pipx  name: mycli  version: { pypi: mycli } }  { via: brew  name: mycli } ] }
        sqlitebrowser: { attrs: [ GUI app FOSS copyleft ] description: "GUI to create, design, and edit SQLite databases." install: [ { via: native  when: "debian or fedora or arch or opensuse or void or void_musl"  repo-component: universe }  { via: flatpak  hub: flathub  app: org.sqlitebrowser.sqlitebrowser } ] }
        // DB servers: native package + a systemd service (verified on apt/dnf/pacman). NOTE:
        // first-run init differs per distro (Fedora postgres needs `postgresql-setup --initdb`).
        postgresql:         { attrs: [ daemon FOSS permissive ] description: "PostgreSQL — advanced open-source relational database." install: [ { via: native  when: "debian or redhat or arch or void or void_musl"  name: { dnf: postgresql-server  default: postgresql } }  { via: native  when: "amzn"  name: postgresql15-server } ] }
        postgresql-service: { description: "Enable and start the PostgreSQL server (systemd / runit)." requires: postgresql  install: [ { via: service  unit: postgresql  runit: "postgresql[0-9]*" } ] }
        mariadb:            { attrs: [ daemon CLI FOSS copyleft ] description: "MariaDB — MySQL-compatible relational database." install: [ { via: native  when: "debian or redhat or arch or void or void_musl"  name: { xbps: mariadb pacman: mariadb  default: mariadb-server } }  { via: native  when: "amzn"  name: mariadb1011-server }  { via: native  when: "fedora_atomic"  name: mariadb }  { via: brew  name: mariadb } ] }   // brew formula `mariadb` (not the distro `-server` split)
        mariadb-service:    { description: "Enable and start the MariaDB server (systemd / runit)." requires: mariadb  install: [ { via: service  unit: mariadb  runit: mysqld } ] }
        // redis is being replaced by its FOSS fork valkey on Fedora/Arch (drop-in compatible).
        redis:              { attrs: [ daemon CLI FOSS copyleft source-available ] description: "Redis — in-memory data store and cache." install: [ { via: native  when: "debian or redhat or arch or void or void_musl"  name: { apt: redis-server  dnf: valkey  pacman: valkey } }  { via: native  when: "fedora_atomic"  name: redis }  { via: brew  name: redis } ] }   // brew formula `redis` (distro repos lean valkey post-relicense; brew keeps redis)
        redis-service:      { description: "Enable and start the Redis server (systemd / runit)." requires: redis  install: [ { via: service  when: "debian"  unit: redis-server }
                                                          { via: service  when: "redhat or arch"  unit: valkey }
                                                          { via: service  when: "void or void_musl"  unit: redis } ] }
        // nginx — HTTP server / reverse proxy. In-repo on every distro (EL ships it in AppStream, no
        // EPEL needed). The -service enables+starts the systemd unit (like the db-servers).
        nginx:         { attrs: [ daemon web FOSS permissive ] description: "nginx — a high-performance HTTP server and reverse proxy." install: [ { via: native }  { via: brew  name: nginx } ] }
        nginx-service: { description: "Enable and start the nginx web server (systemd / runit)." requires: nginx  install: [ { via: service  unit: nginx } ] }
        // MongoDB: removed from distro repos over its SSPL license, so it installs from MongoDB's
        // OWN vendor repos (apt keyed per family with a hardcoded codename, dnf on EL) + the AUR
        // binary on Arch. MongoDB ships no Fedora/openSUSE/Amazon repo -> those decline. Version-
        // pathed (8.0) — bump the repo path + key on a major MongoDB bump.
        mongodb: { attrs: [ daemon source-available FOSSish ] description: "MongoDB Community Server — a document (NoSQL) database (`mongod`)."
            install: [
                { via: native  when: "ubuntu"  name: mongodb-org   // MongoDB's official apt repo (Ubuntu). $CODENAME is resolved on the target (Pop!_OS -> its Ubuntu base codename), so this works on any release MongoDB publishes for — not just one hardcoded suite.
                  pubkey-url: "https://www.mongodb.org/static/pgp/server-8.0.asc"  pubkey-path: /usr/share/keyrings/mongodb-server-8.0.asc
                  source-line: "deb [signed-by=/usr/share/keyrings/mongodb-server-8.0.asc] https://repo.mongodb.org/apt/ubuntu $CODENAME/mongodb-org/8.0 multiverse"
                  source-path: /etc/apt/sources.list.d/mongodb-org-8.0.list }
                { via: native  when: "debian"  name: mongodb-org   // MongoDB's official apt repo (Debian); $CODENAME resolved on the target
                  pubkey-url: "https://www.mongodb.org/static/pgp/server-8.0.asc"  pubkey-path: /usr/share/keyrings/mongodb-server-8.0.asc
                  source-line: "deb [signed-by=/usr/share/keyrings/mongodb-server-8.0.asc] https://repo.mongodb.org/apt/debian $CODENAME/mongodb-org/8.0 main"
                  source-path: /etc/apt/sources.list.d/mongodb-org-8.0.list }
                { via: native  when: "rhel"  name: mongodb-org   // MongoDB's official dnf repo (EL only; no Fedora repo)
                  pubkey-url: "https://www.mongodb.org/static/pgp/server-8.0.asc"
                  repo-id: mongodb-org-8.0  repo-name: "MongoDB Repository"
                  repo-url: "https://repo.mongodb.org/yum/redhat/$releasever/mongodb-org/8.0/x86_64/" }
                { via: aur  name: mongodb-bin } ]   // AUR (prebuilt)
        }
        mongodb-service: { description: "Enable and start the MongoDB server (systemd / runit)." requires: mongodb  install: [ { via: service  unit: mongod } ] }

        // --- science & math ---
        gnuplot:    { attrs: [ CLI app FOSS ] suggests: gnuplot-dotfiles  description: "gnuplot — command-driven plotting for data and functions." install: [ { via: native  repo-component: universe }  { via: brew  name: gnuplot } ] }
        jupyterlab: { attrs: [ web app FOSS permissive ] description: "JupyterLab — notebooks and IDE for data science." install: [ { via: pipx  name: jupyterlab  version: { pypi: jupyterlab } }  { via: brew  name: jupyterlab } ] }        // `jupyter-lab` on PATH
        paraview:   { attrs: [ GUI app FOSS permissive ] description: "ParaView — large-scale scientific data visualization." install: [ { via: native  when: "(debian or redhat or arch or opensuse) and not amzn"  repo-component: universe }  { via: flatpak  hub: flathub  app: org.paraview.ParaView } ] }
        maxima:     { attrs: [ CLI app FOSS copyleft ] suggests: maxima-dotfiles  description: "Maxima — a computer algebra system for symbolic math." install: [ { via: native  when: "(debian or redhat or arch or opensuse) and not amzn"  repo-component: universe }  { via: native  when: "fedora_atomic or void or void_musl" }  { via: brew  name: maxima } ] }   // brew formula `maxima`
        wxmaxima:   { attrs: [ GUI app FOSS copyleft ] description: "wxMaxima — a GUI front end for the Maxima CAS." install: [ { via: native  when: "(debian or redhat) and not amzn"  repo-component: universe }  { via: flatpak  hub: flathub  app: io.github.wxmaxima_developers.wxMaxima } ] }   // native: debian/redhat (Arch AUR only); flatpak covers the rest
        pari:       { attrs: [ CLI app FOSS copyleft ] description: "PARI/GP — computer algebra for number theory." install: [ { via: native  when: "not amzn"   repo-component: universe  name: { apt: pari-gp  dnf: pari-gp  pacman: pari  zypper: pari-gp  default: pari } }  { via: brew  name: pari } ] }
        gap:        { attrs: [ CLI FOSS copyleft ] description: "GAP — a system for computational discrete algebra (group theory)." install: [ { via: native  when: "(debian or redhat or arch or opensuse) and not amzn"  repo-component: universe }  { via: native  when: "fedora_atomic or void or void_musl" } ] }   // brew formula `gap`
        sagemath:   { attrs: [ CLI web app FOSS copyleft ] description: "SageMath — an open-source mathematics software system." install: [ { via: native  when: "debian or arch or void or void_musl"  repo-component: universe } ] }      // Fedora: COPR/conda only

        // LaTeX (TeX Live) — the recommended subset vs the full multi-GB distribution.
        texlive:      { attrs: [ CLI FOSS permissive ] description: "TeX Live — the TeX/LaTeX typesetting distribution." install: [ { via: native  when: "debian or redhat or arch or void or void_musl"  name: { xbps: texlive-most apt: texlive-latex-recommended  dnf: texlive-scheme-medium  pacman: texlive-latexrecommended }  }  { via: native  when: "fedora_atomic"  name: texlive }  { via: brew  name: texlive } ] }   // brew formula `texlive`
        texlive-full: { attrs: [ CLI FOSS permissive ] description: "TeX Live (full) — the complete TeX/LaTeX distribution." install: [ { via: native  when: "debian or redhat or arch or void or void_musl"  name: { apt: texlive-full  dnf: texlive-scheme-full  pacman: texlive-meta } } ] }

        // Miniforge — a conda env manager (the right home for the numpy/scipy/pandas stack).
        miniforge: { attrs: [ CLI FOSS permissive ] suggests: miniforge-glue  description: "Miniforge — a minimal conda installer (conda-forge default)."
            requires: curl
            install: [ { via: script
                         install-cmd:   'curl -fsSL "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-$(uname -m).sh" -o /tmp/mf.sh && bash /tmp/mf.sh -b -p "$HOME/miniforge3" && rm -f /tmp/mf.sh'
                         version-cmd:   '"$HOME/miniforge3/bin/conda" --version'
                         version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                         uninstall-cmd: 'rm -rf "$HOME/miniforge3"'
                         location:      '~/miniforge3/bin' } ]
        }

        arduino: { attrs: [ GUI app electron FOSS copyleft ] description: "Arduino IDE — program Arduino microcontrollers."
            suggests: arduino-glue
            install: [ { via: appImage  name: "Arduino IDE"
                         version: { github: arduino/arduino-ide  asset: "arduino-ide_*_Linux_64bit.AppImage" }
                         url: "https://github.com/arduino/arduino-ide/releases/download/$VERSION/arduino-ide_$VERSION_Linux_64bit.AppImage"
                         path: ~/apps/arduino-ide.appimage }
                       { via: flatpak  hub: flathub  app: cc.arduino.IDE2 } ]
        }
        arduino-glue: { description: "Arduino config, linked into place."
            install: [ { via: glue  requires: shell-glue  glue: arduino } ]
        }

        // --- parts: composition (a component that IS several others, no unit of its own) ---
        // Distro-specific vulkan building blocks — only pulled as `parts` of vulkan-runtime on
        // their own family, so `when:`-gated (installing one directly on the wrong distro fails).
        libvulkan1:            { attrs: [ lib FOSS permissive ] description: "Vulkan loader runtime (libvulkan)." install: [ { via: native  when: "debian" } ] }
        vulkan-loader:         { attrs: [ lib FOSS permissive ] description: "Vulkan loader — the Vulkan ICD loader runtime." install: [ { via: native  when: "redhat or void or void_musl" } ] }
        vulkan-icd-loader:     { attrs: [ lib FOSS permissive ] description: "Vulkan ICD loader (Arch's libvulkan)." install: [ { via: native  when: "arch" } ] }
        vulkan-radeon:         { attrs: [ driver FOSS permissive ] description: "Mesa Vulkan driver for AMD GPUs (RADV)." install: [ { via: native  name: { xbps: mesa-vulkan-radeon }  when: "arch or void or void_musl" } ] }
        vulkan-intel:          { attrs: [ driver FOSS permissive ] description: "Mesa Vulkan driver for Intel GPUs (ANV)." install: [ { via: native  name: { xbps: mesa-vulkan-intel }  when: "arch or void or void_musl" } ] }
        vulkan-swrast:         { attrs: [ driver FOSS permissive ] description: "Mesa software (CPU) Vulkan rasterizer (lavapipe)." install: [ { via: native  name: { xbps: mesa-vulkan-lavapipe }  when: "arch or void or void_musl" } ] }
        mesa-vulkan-drivers:   { attrs: [ driver FOSS permissive ] description: "Mesa Vulkan drivers — open-source Vulkan for Intel/AMD." install: [ { via: native  when: "debian or redhat" } ] }
        // vulkan-runtime = the loader + a GPU-agnostic driver, an ALL-OF set that reaches full green
        // on every family. On Debian/Fedora `mesa-vulkan-drivers` is ONE package bundling every Mesa
        // ICD (Intel+AMD+lavapipe), so it's a genuine all-of. On Arch those ICDs are SEPARATE packages
        // and are ALTERNATIVES (one per GPU) — listing them all here made vulkan-runtime permanently
        // "partly installed" on every real box (you only ever have your GPU's driver). So Arch pulls
        // only the loader + `vulkan-swrast` (lavapipe, the software ICD that works on any hardware);
        // the hardware drivers `vulkan-radeon` / `vulkan-intel` are standalone components you track
        // for your GPU. (An all-of union can't express "one-of" — that's the tell it was mismodeled.)
        vulkan-runtime: { attrs: [ lib runtime FOSS permissive ] description: "Vulkan runtime libraries."
            install: [
                { via: parts  when: "debian"  parts: [ libvulkan1, mesa-vulkan-drivers ] }
                { via: parts  when: "redhat"  parts: [ vulkan-loader, mesa-vulkan-drivers ] }  // fedora + EL
                { via: parts  when: "arch"    parts: [ vulkan-icd-loader, vulkan-swrast ] }    // + vulkan-radeon/intel per GPU
                { via: parts  when: "void or void_musl"  parts: [ vulkan-loader, vulkan-swrast ] }   // Void splits the ICDs like Arch
            ]
        }

        // --- tarball + composition: the vulkan SDK and the vulkan-dev bundle ---
        // vulkan-sdk is ONE component that is both a tarball unit AND an inline config
        // dotfile (dotfiles\vulkan-sdk), keyed by the component; the tarball driver
        // pulls curl. (Old: a [tarball\vulkan-sdk, dotfiles\vulkan-sdk] list bundle.)
        vulkan-sdk: { attrs: [ SDK FOSS permissive ] description: "Vulkan SDK — headers, tools, and validation layers."
            suggests: vulkan-sdk-glue
            install: [ { via: tarball  version: { static: 1.4.350.1 }  installDir: "$CONFIGSYS_SDK_DIR/vulkan"  requires: [ glibc, xz ]   // glibc-linked SDK
                         url: "https://sdk.lunarg.com/sdk/download/$VERSION/linux/vulkansdk-linux-$ARCH-$VERSION.tar.xz" } ]
        }
        vulkan-sdk-glue: { description: "Vulkan SDK env config, linked into place."
            install: [ { via: glue  requires: shell-glue
                         glue: vulkan-sdk } ]
        }
        // vulkan-dev X libs, per OS: Debian ships three; Fedora's libxcb-devel bundles
        // xinput+xinerama (+ xcb-util-cursor-devel); Arch's libxcb does likewise (+ xcb-util-cursor).
        libxcb-xinput0:        { attrs: [ lib FOSS permissive ] description: "libxcb XInput extension runtime library." install: [ { via: native  when: "debian"  repo-component: universe } ] }
        libxcb-xinerama0:      { attrs: [ lib FOSS permissive ] description: "libxcb Xinerama extension runtime library." install: [ { via: native  when: "debian"  repo-component: universe } ] }
        libxcb-cursor-dev:     { attrs: [ lib FOSS permissive ] description: "libxcb-cursor development headers." install: [ { via: native  when: "debian"  repo-component: universe } ] }
        libxcb-devel:          { attrs: [ lib FOSS permissive ] description: "libxcb development headers." install: [ { via: native  when: "redhat or void or void_musl" } ] }   // fedora + EL
        xcb-util-cursor-devel: { attrs: [ lib FOSS permissive ] description: "xcb-util-cursor development headers." install: [ { via: native  when: "redhat or void or void_musl" } ] }   // fedora + EL
        libxcb:                { attrs: [ lib FOSS permissive ] description: "libxcb — the X protocol C-language Binding (XCB) library (dev headers + libs)." install: [ { via: native  name: { apt: libxcb1-dev  dnf: libxcb-devel  apk: libxcb-dev  zypper: libxcb-devel  default: libxcb } } ] }
        xcb-util-cursor:       { attrs: [ lib FOSS permissive ] description: "xcb-util-cursor — XCB cursor management library." install: [ { via: native  when: "arch or void or void_musl" } ] }   // arch
        // vulkan-dev: a parts bundle composing the X libs, build tools, the SDK tarball,
        // and the vulkan runtime (itself a parts aggregator). One binding per OS family;
        // cpp-toolchain pulls the C/C++ compiler (portable across families).
        vulkan-dev: { attrs: [ lib FOSS permissive ] description: "Vulkan development headers and validation layers."
            install: [
                { via: parts  when: "debian"
                  parts: [ libxcb-xinput0, libxcb-xinerama0, libxcb-cursor-dev,
                           cpp-toolchain, make, vulkan-sdk, vulkan-runtime ] }
                { via: parts  when: "redhat"
                  parts: [ libxcb-devel, xcb-util-cursor-devel,
                           cpp-toolchain, make, vulkan-sdk, vulkan-runtime ] }
                { via: parts  when: "arch"
                  parts: [ libxcb, xcb-util-cursor,
                           cpp-toolchain, make, vulkan-sdk, vulkan-runtime ] }
                { via: parts  when: "void or void_musl"
                  parts: [ libxcb-devel, xcb-util-cursor-devel,
                           cpp-toolchain, make, vulkan-sdk, vulkan-runtime ] }
            ]
        }

        // --- github .deb where no repo has it, native package elsewhere (cpu-keyed asset) ---
        fastfetch: { attrs: [ CLI FOSS permissive ] suggests: fastfetch-dotfiles 
            description: "System info fetcher — the logo + specs banner (neofetch-style)."
            install: [
                // Debian/Ubuntu don't carry fastfetch in-repo (absent through 22.04/24.04/bookworm),
                // but upstream ships an official .deb — install THAT via the OS package tool. It's a
                // distinct, opt-in method from `native` (it doesn't ride `apt upgrade`); here it's the
                // debian-family default because there is no repo package to prefer. (Relax the bare
                // `native` gate below to a version bound once debian-family broadly ships it in-repo.)
                { via: native-pkg-file  when: "debian"
                  version: { github: fastfetch-cli/fastfetch }
                  asset: { x86_64: fastfetch-linux-amd64.deb  aarch64: fastfetch-linux-aarch64.deb } }
                { via: native  when: "rhel"  requires: epel }   // EL ships fastfetch in EPEL
                { via: native  when: "(not debian) and not amzn" }             // arch/fedora/suse/... carry it in-repo
                { via: brew  name: fastfetch }
            ]
        }

        // --- toolchain (portable, descriptive capabilities) ---
        // `cc` = a C compiler, `cxx` = a C++ compiler. Source-build components COMPOSE these
        // (requires: cxx, cmake, ninja, ...); `cxx requires: cc`, so C++ reuses the C toolchain.
        // One definition across every family — this replaces the old apt-named `build-essential`,
        // which was Debian-*package*-building essentials (it pulls dpkg-dev), not an app toolchain.
        // Alpine bundles the whole kit in `build-base` (pulls musl-dev headers); on Arch/Void the
        // `gcc` package bundles g++. `make`/`cmake`/`ninja` stay separate, composable build tools.
        // (Versioned/standard selection — requires: C++20, or gcc-15 by name — is a later layer;
        // for now cc/cxx are the system default compiler, which handles modern C++ on any current
        // distro.)
        c-toolchain: { attrs: [ CLI toolchain FOSS copyleft GNU ] description: "C toolchain (cc) — compiler and make for building C."
            provides: cc
            install: [
                { via: native  when: "alpine"  name: build-base }   // gcc + g++ + make + musl-dev
                { via: native  name: gcc }                          // else: gcc (pulls libc dev headers)
            ]
        }
        cpp-toolchain: { attrs: [ CLI toolchain FOSS copyleft GNU ] description: "C++ toolchain — compiler and make for building C++."
            provides: cxx
            requires: cc
            install: [
                { via: native  when: "alpine"  name: build-base }
                { via: native  when: "redhat or opensuse"  name: "gcc-c++" }
                { via: native  when: "debian"  name: "g++" }
                { via: native  name: gcc }   // default: gcc bundles g++ + the libc/C++ headers (arch, brew, void)
            ]
        }

        // --- C++ standard library (a separate capability from the compiler) ---
        // g++ BUNDLES its stdlib (libstdc++), so cpp-toolchain needs nothing extra. clang does NOT
        // ship a stdlib: on Linux it defaults to GCC's libstdc++, and can opt into LLVM's libc++ with
        // `-stdlib=libc++`. So clang `requires: [ cc, cxx-stdlib ]` — the gcc C toolchain (clang uses
        // gcc's crt*.o + libgcc on Linux regardless of stdlib) plus *a* C++ standard library, but NOT
        // the g++ compiler (EXCEPT on Debian — see the libstdc++ component: its default C++ dev
        // headers are only installable via g++). `cxx-stdlib` defaults to libstdc++ (below, non-opt-in); to build with
        // libc++ instead, install `libc++` and provider-pin `cxx-stdlib: libc++` (then pass
        // -stdlib=libc++ — configsys installs the library, your build selects it). The two stdlibs are
        // NOT ABI-compatible with each other; g++ can only use libstdc++, clang can use either.
        //
        // Compiler VERSION and library VERSION are chosen INDEPENDENTLY, and this is capability-
        // based (nothing here assumes apt or update-alternatives). Every versioned compiler
        // resolves `cxx-stdlib` to the SAME provider — the system's default libstdc++ unless you
        // pin otherwise — so e.g. clang-18 and clang-20 SHARE one standard library; installing a
        // newer clang does NOT bring a newer library. A compiler's `C++NN` labels (on the
        // gcc-NN/clang-NN components below) describe its FRONT-END language mode, not a guarantee
        // of library features — those track whatever `cxx-stdlib` resolved to. Sharing is
        // order-independent: the compiler and the stdlib pull the same library, whichever is
        // installed first. To move the LIBRARY forward, change that provider, not the compiler:
        // install/prefer a newer libstdc++ (whatever your package manager names it), or
        // provider-pin `cxx-stdlib: libc++`, whose version DOES track clang. (clang also pulls the
        // gcc C toolchain — `c-toolchain`, for crt/libgcc — but not the g++ compiler; that split is
        // the whole point of requiring `cxx-stdlib` rather than `cxx`. The one exception is Debian,
        // whose default libstdc++ dev headers ship only with g++ — pin cxx-stdlib: libc++ to skip it.)
        libstdc++: { attrs: [ lib FOSS GNU copyleft ] description: "GNU libstdc++ — the GCC C++ standard library runtime."                                  // GNU C++ stdlib (clang's default on Linux)
            provides: [ cxx-stdlib, libstdc++ ]
            install: [
                // On Debian `libstdc++-dev` is a VIRTUAL package — many libstdc++-N-dev providers,
                // no default candidate, so apt refuses to install it. The default C++ stdlib dev
                // headers ship WITH g++ (g++ -> g++-N -> libstdc++-N-dev, tracking the system's
                // default gcc), and there is no standalone "default libstdc++ dev" package. So here
                // (only on distros without a concrete package) satisfying `cxx-stdlib` DOES pull
                // g++. To keep clang off g++ on Debian, provider-pin `cxx-stdlib: libc++` (LLVM's
                // stdlib — no libstdc++/g++ at all).
                { via: native  when: "debian"  name: "g++" }
                { via: native  when: "alpine"  name: "g++" }        // Alpine also ships C++ headers via g++
                { via: native  when: "redhat or opensuse"  name: "libstdc++-devel" }   // concrete package
                { via: native  name: gcc }            // arch etc.: the C++ headers ship in the gcc package
            ]
        }
        libc++: { attrs: [ lib FOSS permissive ] description: "LLVM libc++ — the Clang C++ standard library runtime."                                     // LLVM C++ stdlib — opt-in; build with -stdlib=libc++
            provides: [ cxx-stdlib, libc++ ]
            standing: never-auto
            suggests: libc++abi                       // soft: the split ABI dev package (bundled on Alpine)
            install: [ { via: native  when: "not amzn"   name: { xbps: libcxx-devel apt: libc++-dev  dnf: libcxx-devel  zypper: libc++-devel
                                              pacman: libc++  apk: libc++-dev } } ]
        }
        libc++abi: { attrs: [ lib FOSS permissive ] description: "LLVM libc++abi — libc++'s low-level ABI support."                                  // LLVM libc++abi dev — a separate package except on Alpine
            install: [ { via: native  when: "(not alpine) and not amzn"  name: { xbps: libcxxabi-devel apt: libc++abi-dev  dnf: libcxxabi-devel
                                                                  zypper: libc++abi-devel  pacman: libc++abi } } ]
        }

        // software-properties-common is a software package in Ubuntu and Debian that provides
        // the add-apt-repository script. It allows users to easily manage independent software
        // sources and PPAs (Personal Package Archives) without manually editing the
        // /etc/apt/sources.list file.
        software-properties-common: { attrs: [ CLI FOSS copyleft ] description: "add-apt-repository and friends — manage APT repos." install: [ { via: native when: debian } ] }

        // gdb: base-repo native everywhere (apt main / dnf base / pacman extra; EL base, no
        // EPEL), plus its shell-startup dotfile.
        gdb: { attrs: [ CLI FOSS GNU copyleft ] description: "GNU Debugger — the standard C/C++/… debugger."
            suggests: gdb-dotfiles
            install: [ { via: native }  { via: brew  name: gdb } ]
        }
        gdb-dotfiles: { description: "GDB config (.gdbinit), linked into place."   // gdb reads ~/.gdbinit natively (no bash-dotfiles loader needed)
            install: [ { via: dotfiles  src: gdbinit  dst: ~/.gdbinit } ]
        }

        // --- AUR: packages built from PKGBUILD via makepkg -si (Arch only). The `aur`
        // driver pulls base-devel + git (the build toolchain); yay is the AUR helper
        // itself, prebuilt (-bin). Guarded to arch — the driver has no meaning elsewhere.
        base-devel: { attrs: [ CLI toolchain FOSS copyleft ] description: "Arch base-devel group — build tools for compiling packages." install: [ { via: native when: "arch or void or void_musl" } ] }
        yay: { attrs: [ CLI FOSS copyleft ] description: "yay — an AUR helper for Arch (pacman-like AUR installs)."
            install: [ { via: aur  name: yay-bin  version: { aur: yay-bin } } ]
        }

        // gcc-glue: the `update-alternatives --config gcc` alias dotfile (Debian only) —
        // required by the versioned gcc-NN toolchains so `gcc` points at the chosen one. (The plain
        // C/C++ compiler is now `c-toolchain`/`cpp-toolchain` above, which supersede the old `gcc`
        // and `gcc-cpp` components that only existed to feed `build-essential`.)
        gcc-glue: { attrs: [ CLI FOSS ] description: "Shell alias to switch the default gcc version (update-alternatives)."
            install: [ { via: glue  when: "debian"  requires: shell-glue
                         glue: gcc } ]
        }

        // --- versioned gcc. Three drivers, selected by OS/version:
        //   debian -> `gcc` (apt PPA + update-alternatives; needs cxx, s-p-c, the alias)
        //   fedora -> `gcc` (dnf compat packages gccNN; availability is per-release)
        //   EL     -> `gcc-toolset` (SCL under /opt/rh)
        // --- versioned gcc. Each also `provides:` the language-standard capabilities its compiler
        // supports (`cc`/`cxx` = a C/C++ compiler; C11/C17/C23 and "C++17"/"C++20"/... = a compiler
        // that accepts that `-std=`), so a build can `requires: "C++20"` (or `cc`, or pin `gcc-15`)
        // and get a compiler that satisfies it. All are `standing: never-auto`: they satisfy a plain
        // `requires: cxx` ONLY when explicitly wanted / provider-pinned — otherwise the unversioned
        // `cpp-toolchain` (the system default compiler) wins and there's no ambiguity. The provides
        // are capability LABELS (the `-std` mode exists + is substantially usable), easy to hand-tune
        // per real support; the newest standards (C++26) are the most likely to want adjusting.
        // Older lines (10/11/12) are useful as pinned HOST compilers for toolchains that reject a
        // too-new gcc — notably CUDA's nvcc (points nvcc at gcc-10), and OpenCV's CUDA-11 build
        // (requires: gcc-10) and Blender 4.3 (requires: gcc-11), both in their plugins. Availability
        // of a DOWNLEVEL (older-than-default) gcc, the shared story those consumers refer back to:
        //   debian/ubuntu -> parallel apt packages (ubuntu-toolchain-r PPA); additive, no rollback.
        //   rhel/EL       -> the gcc-toolset-NN SCL under /opt/rh; isolated from the system gcc.
        //   fedora/arch   -> NOT carried: their repos ship only the latest gcc, and no clean COPR/AUR
        //                    parallel gccNN lands at /usr/bin/gcc-NN. So a downlevel pin there is an
        //                    honest unmet-require at resolve/check time — not a rollback, not a
        //                    mid-build failure — until it's built from source. (fedora DOES carry the
        //                    near-default compat gccNN used by the `when: "fedora = NN"` bindings
        //                    below; that's a native package, not a downlevel side-install.)
        gcc-10: { attrs: [ toolchain FOSS GNU copyleft ] description: "GCC 10 — the GNU Compiler Collection, version 10."
            provides: [ cc, cxx, C11, C17, "C++17", "C++20" ]
            standing: never-auto
            install: [
                { via: gcc  when: "debian"  packages: [ gcc-10, g++-10 ]  slaves: [ g++ ]  ppa: ubuntu-toolchain-r/test
                  requires: software-properties-common  suggests: gcc-glue }
                { via: gcc-toolset  when: "rhel" }
            ]
        }
        gcc-11: { attrs: [ toolchain FOSS GNU copyleft ] description: "GCC 11 — the GNU Compiler Collection, version 11."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23" ]
            standing: never-auto
            install: [
                { via: gcc  when: "debian"  packages: [ gcc-11, g++-11 ]  slaves: [ g++ ]  ppa: ubuntu-toolchain-r/test
                  requires: software-properties-common  suggests: gcc-glue }
                { via: gcc-toolset  when: "rhel" }
                { via: brew  name: "gcc@11" }
            ]
        }
        gcc-12: { attrs: [ toolchain FOSS GNU copyleft ] description: "GCC 12 — the GNU Compiler Collection, version 12."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23" ]
            standing: never-auto
            install: [
                { via: gcc  when: "debian"  packages: [ gcc-12, g++-12 ]  slaves: [ g++ ]  ppa: ubuntu-toolchain-r/test
                  requires: software-properties-common  suggests: gcc-glue }
                { via: gcc-toolset  when: "rhel" }
                { via: brew  name: "gcc@12" }
            ]
        }
        gcc-13: { attrs: [ toolchain FOSS GNU copyleft ] description: "GCC 13 — the GNU Compiler Collection, version 13."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23" ]
            standing: never-auto
            install: [
                { via: gcc  when: "debian"  packages: [ gcc-13, g++-13 ]  slaves: [ g++ ]  ppa: ubuntu-toolchain-r/test
                  requires: software-properties-common  suggests: gcc-glue }
                { via: gcc  when: "fedora = 41"  packages: [ gcc13, gcc13-c++ ] }
                { via: gcc-toolset  when: "rhel" }
                { via: brew  name: "gcc@13" }
            ]
        }
        gcc-14: { attrs: [ toolchain FOSS GNU copyleft ] description: "GCC 14 — the GNU Compiler Collection, version 14."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23" ]
            standing: never-auto
            install: [
                { via: gcc  when: "debian"  packages: [ gcc-14, g++-14 ]  slaves: [ g++ ]  ppa: ubuntu-toolchain-r/test
                  requires: software-properties-common  suggests: gcc-glue }
                { via: gcc  when: "fedora = 42"  packages: [ gcc14, gcc14-c++ ] }
                { via: gcc-toolset  when: "rhel" }
                { via: brew  name: "gcc@14" }
            ]
        }
        gcc-15: { attrs: [ toolchain FOSS GNU copyleft ] description: "GCC 15 — the GNU Compiler Collection, version 15."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23", "C++26" ]
            standing: never-auto
            install: [
                { via: gcc  when: "debian"  packages: [ gcc-15, g++-15 ]  slaves: [ g++ ]  ppa: ubuntu-toolchain-r/test
                  requires: software-properties-common  suggests: gcc-glue }
                { via: gcc-toolset  when: "rhel" }
                { via: brew  name: "gcc@15" }
            ]
        }

        // --- versioned clang. `clang` driver = native PM + update-alternatives:
        //   debian -> apt.llvm.org + alternatives (curl for the key; + the alias)
        //   fedora -> dnf compat clangNN (per-release; the system clang covers the newest)
        //   EL     -> dnf compat clangNN from EPEL (requires epel)
        clang-glue: { attrs: [ CLI FOSS ] description: "Shell alias to switch the default clang version (update-alternatives)."             // the `update-alternatives --config clang` alias dotfile
            requires: shell-glue
            install: [ { via: glue  when: "debian"  glue: clang } ]
        }
        // clang ships no C++ stdlib and, on Linux, no C runtime of its own: it uses GCC's crt*.o +
        // libgcc (hence `requires: c-toolchain` — the gcc toolchain COMPONENT, not the g++ compiler)
        // and defaults to GCC's libstdc++ (hence `requires: cxx-stdlib`, which resolves to the
        // libstdc++ component; provider-pin it to libc++ to build with -stdlib=libc++). It requires
        // the c-toolchain *component* rather than the `cc` capability on purpose: clang itself
        // `provides: cc` (opt-in), so requiring the capability would let it self-satisfy and never
        // pull gcc. It provides a C/C++ compiler + the standard labels (opt-in, same rule as gcc-NN).
        clang-18: { attrs: [ CLI toolchain FOSS permissive ] description: "Clang/LLVM 18 — C/C++/Obj-C compiler, version 18."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23" ]
            standing: never-auto
            requires: [ c-toolchain, cxx-stdlib ]
            install: [
                { via: clang  when: "debian"  packages: [ clang-18 ]
                  requires: curl  suggests: clang-glue }
                { via: clang  when: "fedora"  packages: [ clang18 ] }
            ]
        }
        clang-19: { attrs: [ CLI toolchain FOSS permissive ] description: "Clang/LLVM 19 — C/C++/Obj-C compiler, version 19."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23" ]
            standing: never-auto
            requires: [ c-toolchain, cxx-stdlib ]
            install: [
                { via: clang  when: "debian"  packages: [ clang-19 ]
                  requires: curl  suggests: clang-glue }
                { via: clang  when: "fedora = 41"  packages: [ clang ] }      // system clang -> /usr/bin/clang-19
                { via: clang  when: "fedora = 42"  packages: [ clang19 ] }
                { via: clang  when: "rhel"  packages: [ clang19 ]  requires: epel }
            ]
        }
        clang-20: { attrs: [ CLI toolchain FOSS permissive ] description: "Clang/LLVM 20 — C/C++/Obj-C compiler, version 20."
            provides: [ cc, cxx, C11, C17, C23, "C++17", "C++20", "C++23", "C++26" ]
            standing: never-auto
            requires: [ c-toolchain, cxx-stdlib ]
            install: [
                { via: clang  when: "debian"  packages: [ clang-20 ]
                  requires: curl  suggests: clang-glue }
                { via: clang  when: "fedora = 42"  packages: [ clang ] }      // system clang -> /usr/bin/clang-20
                { via: clang  when: "rhel"  packages: [ clang20 ]  requires: epel }
            ]
        }

        // ===================== C/C++ libraries + GUI toolkits =====================
        // Dev packages (headers + libs). Native names are gated to the distros whose package name
        // is known-good; openSUSE / brew / others are extendable later (their split/renamed packages
        // need a per-manager name). folly + EASTL aren't packaged in the mainstream repos — they get
        // what IS available (Fedora / the AUR) and decline elsewhere (build from source there).
        boost: { attrs: [ lib FOSS permissive ] description: "Boost — peer-reviewed, portable C++ source libraries (dev)."
            install: [ { via: native  when: "debian or redhat or arch or alpine or void or void_musl"  repo-component: universe
                         name: { xbps: boost-devel apt: libboost-all-dev  dnf: boost-devel  pacman: boost  apk: boost-dev } } ]
        }
        abseil: { attrs: [ lib FOSS permissive ] description: "Abseil — Google's C++ common libraries (dev)."
            install: [ { via: native  when: "debian or redhat or arch or alpine or void or void_musl"  repo-component: universe
                         name: { xbps: abseil-cpp-devel apt: libabsl-dev  dnf: abseil-cpp-devel  pacman: abseil-cpp  apk: abseil-cpp-dev } } ]
        }
        folly: { attrs: [ lib FOSS permissive ] description: "Folly — Facebook's C++ utility library (dev)."
            install: [ { via: native  when: "fedora"  name: folly-devel }        // Fedora repos (not EL)
                       { via: aur  name: folly } ]             // Arch: AUR
        }
        eastl: { attrs: [ lib FOSS permissive ] description: "EASTL — Electronic Arts' STL implementation (dev)."
            install: [ { via: aur  name: eastl } ]                  // AUR only; vendor/source elsewhere
        }
        qt: { attrs: [ lib SDK FOSS FOSSish copyleft ] description: "Qt 6 — cross-platform C++ application framework (Qt Base, dev)."
            install: [ { via: native  when: "void or void_musl"  name: qt6-base-devel }  { via: native  when: "(debian or redhat or arch or alpine) and not amzn"  repo-component: universe
                         name: { apt: qt6-base-dev  dnf: qt6-qtbase-devel  pacman: qt6-base  apk: qt6-qtbase-dev } } ]
        }
        gtk: { attrs: [ lib FOSS copyleft ] description: "GTK 4 — the GTK GUI toolkit (dev)."
            install: [ { via: native  when: "debian or redhat or arch or alpine or void or void_musl"  repo-component: universe
                         name: { xbps: gtk4-devel apt: libgtk-4-dev  dnf: gtk4-devel  pacman: gtk4  apk: gtk4.0-dev } } ]
        }
        gtkmm: { attrs: [ lib FOSS copyleft ] description: "gtkmm — the C++ bindings for GTK (dev; GTK 4 where packaged, else GTK 3)."
            requires: gtk
            // gtkmm-4.0 isn't in the Ubuntu repos before 24.04 (nor Debian < 13) — fall back to the
            // GTK3 bindings there so it still resolves, rather than 404 on libgtkmm-4.0-dev.
            // 4.0 is the default across the debian subtree; the OLD releases that predate it
            // (ubuntu < 24.04, debian < 13) explicitly fall back to the GTK3 bindings. Written this
            // way so a derivative whose version isn't an ubuntu/debian number (elementary, …) still
            // gets 4.0 rather than dropping out.
            install: [ { via: native  when: "debian and not ((ubuntu < 24.04) or (debian < 13))"  repo-component: universe  name: { apt: libgtkmm-4.0-dev } }
                       { via: native  when: "(ubuntu < 24.04) or (debian < 13)"                    repo-component: universe  name: { apt: libgtkmm-3.0-dev } }
                       { via: native  when: "redhat and not amzn"  name: { dnf: gtkmm4.0-devel } }
                       { via: native  when: "arch or void or void_musl"  name: { xbps: gtkmm4-devel pacman: gtkmm-4.0 } } ]
        }

        // --- graphics dev SDKs (dev headers + libs) ---
        // OpenGL is a per-distro parts bundle (GL + GLU) — no single `opengl` package. No brew (macOS
        // ships GL as a deprecated system framework).
        opengl: { attrs: [ lib FOSS permissive ] description: "OpenGL development environment — GL + GLU headers and libraries."
            // `packages:` installs the whole set; `installed-name:` gives state-detection one member
            // to probe (there is no `opengl` package — apt now READS `packages:`, where before it
            // silently fell back to the component name and tried to install `opengl`).
            install: [ { via: native  when: "void or void_musl"  packages: [ MesaLib-devel, glu-devel ] }  { via: native  when: "debian"    packages: [ libgl1-mesa-dev, libglu1-mesa-dev ]  installed-name: libgl1-mesa-dev }
                       { via: native  when: "(redhat) and not amzn"    packages: [ mesa-libGL-devel, mesa-libGLU-devel ]  installed-name: mesa-libGL-devel }
                       { via: native  when: "arch"      packages: [ mesa, glu ]        installed-name: mesa }
                       { via: native  when: "alpine"    packages: [ mesa-dev, glu-dev ]  installed-name: mesa-dev }
                       { via: native  when: "opensuse"  packages: [ Mesa-libGL-devel, glu-devel ]  installed-name: Mesa-libGL-devel } ]
        }
        glfw: { attrs: [ lib FOSS permissive ] description: "GLFW — multi-platform OpenGL/Vulkan window & input library (dev)."
            install: [ { via: native  when: "void or void_musl"  name: glfw-devel }  { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"  repo-component: universe
                         name: { apt: libglfw3-dev  dnf: glfw-devel  pacman: glfw  apk: glfw-dev  zypper: glfw-devel  brew: glfw } } ]
        }
        glew: { attrs: [ lib FOSS permissive ] description: "GLEW — the OpenGL Extension Wrangler library (dev)."
            install: [ { via: native  when: "void or void_musl"  name: glew-devel }  { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"  repo-component: universe
                         name: { apt: libglew-dev  dnf: glew-devel  pacman: glew  apk: glew-dev  zypper: glew-devel  brew: glew } } ] }
        glm: { attrs: [ lib FOSS permissive ] description: "GLM — OpenGL Mathematics, a header-only C++ math library (dev)."
            install: [ { via: native  when: "void or void_musl" }  { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"  repo-component: universe
                         name: { apt: libglm-dev  dnf: glm-devel  pacman: glm  apk: glm-dev  zypper: glm-devel  brew: glm } } ] }
        libsecret: { attrs: [ lib FOSS copyleft ] description: "libsecret — the GNOME secret-service client library (dev)."
            install: [ { via: native  when: "void or void_musl"  name: libsecret-devel }  { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libsecret-1-dev  dnf: libsecret-devel  pacman: libsecret  apk: libsecret-dev  zypper: libsecret-devel  brew: libsecret } } ] }
        libgit2: { attrs: [ lib FOSS permissive ] description: "libgit2 — a portable C implementation of the Git core methods (dev)."
            install: [ { via: native  when: "void or void_musl"  name: libgit2-devel }  { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"  repo-component: universe
                         name: { apt: libgit2-dev  dnf: libgit2-devel  pacman: libgit2  apk: libgit2-dev  zypper: libgit2-devel  brew: libgit2 } } ] }
        dbus-dev: { attrs: [ lib FOSS ] description: "D-Bus development headers (libdbus-1)."
            install: [ { via: native  when: "void or void_musl"  name: dbus-devel }  { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libdbus-1-dev  dnf: dbus-devel  pacman: dbus  apk: dbus-dev  zypper: dbus-1-devel  brew: dbus } } ] }
        gtk3: { attrs: [ lib FOSS copyleft ] description: "GTK 3 — the GTK 3 GUI toolkit (dev; distinct from `gtk`, which is GTK 4)."
            install: [ { via: native  when: "void or void_musl"  name: gtk+3-devel }  { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"  repo-component: universe
                         name: { apt: libgtk-3-dev  dnf: gtk3-devel  pacman: gtk3  apk: "gtk+3.0-dev"  zypper: gtk3-devel  brew: "gtk+3" } } ] }
        // webkit2gtk (GTK3 / 4.1-soup3 generation) — the browser engine `surf` links against. Package
        // names drift hard across distros AND across ABI (4.0 vs 4.1); this targets the current 4.1.
        // NAMESWEEP PENDING.
        webkit2gtk: { attrs: [ lib FOSS copyleft ] description: "WebKitGTK — the GTK web-content engine (dev headers + libs; the surf/tabbed engine)."
            install: [ { via: native  when: "void or void_musl"  name: libwebkit2gtk41-devel }  { via: native  when: "(debian or redhat or arch or alpine or opensuse) and not amzn"  repo-component: universe
                         name: { apt: libwebkit2gtk-4.1-dev  dnf: webkit2gtk4.1-devel  pacman: webkit2gtk-4.1  apk: webkit2gtk-4.1-dev  zypper: webkitgtk4-devel  default: webkit2gtk } } ] }
        libxi: { attrs: [ lib FOSS permissive ] description: "libXi — X11 Input-extension client library (dev)."
            install: [ { via: native  when: "void or void_musl"  name: libXi-devel }  { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libxi-dev  dnf: libXi-devel  pacman: libxi  apk: libxi-dev  zypper: libXi-devel  brew: libxi } } ] }
        libxcursor: { attrs: [ lib FOSS permissive ] description: "libXcursor — X11 cursor-management library (dev)."
            install: [ { via: native  when: "void or void_musl"  name: libXcursor-devel }  { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libxcursor-dev  dnf: libXcursor-devel  pacman: libxcursor  apk: libxcursor-dev  zypper: libXcursor-devel  brew: libxcursor } } ] }
        libxrandr: { attrs: [ lib FOSS permissive ] description: "libXrandr — X11 RandR (resize/rotate) client library (dev)."
            install: [ { via: native  when: "void or void_musl"  name: libXrandr-devel }  { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libxrandr-dev  dnf: libXrandr-devel  pacman: libxrandr  apk: libxrandr-dev  zypper: libXrandr-devel  brew: libxrandr } } ] }
        libxxf86vm: { attrs: [ lib FOSS permissive ] description: "libXxf86vm — X11 XFree86-VidMode extension library (dev)."
            install: [ { via: native  when: "void or void_musl"  name: libXxf86vm-devel }  { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libxxf86vm-dev  dnf: libXxf86vm-devel  pacman: libxxf86vm  apk: libxxf86vm-dev  zypper: libXxf86vm-devel  brew: libxxf86vm } } ] }
        libdecor: { attrs: [ lib FOSS permissive ] description: "libdecor — client-side window decorations for Wayland (dev)."
            install: [ { via: native  when: "void or void_musl"  name: libdecor-devel }  { via: native  when: "(debian or redhat or arch or alpine or opensuse) and not amzn"
                         name: { apt: libdecor-0-dev  dnf: libdecor-devel  pacman: libdecor  apk: libdecor-dev  zypper: libdecor-devel } } ] }   // Wayland/Linux; not on brew
        nng: { attrs: [ lib FOSS permissive ] description: "nng — the nanomsg-next-gen lightweight messaging library (dev)."
            install: [ { via: native  when: "void or void_musl"  name: nng-devel }  { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: libnng-dev  dnf: nng-devel  pacman: nng  apk: nng-dev  zypper: nng-devel  brew: nng } } ] }
        unixodbc: { attrs: [ lib FOSS copyleft ] description: "unixODBC — the ODBC driver manager for Unix (dev)."
            install: [ { via: native  when: "void or void_musl"  name: unixodbc-devel }  { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"
                         name: { apt: unixodbc-dev  dnf: unixODBC-devel  pacman: unixodbc  apk: unixodbc-dev  zypper: unixODBC-devel  brew: unixodbc } } ] }
        egl: { attrs: [ lib FOSS permissive ] description: "EGL — the native-platform interface between OpenGL/GLES and the window system (dev)."
            install: [ { via: native  when: "void or void_musl"  name: libglvnd-devel }  { via: native  when: "(debian or redhat or arch or alpine or opensuse) and not amzn"
                         name: { apt: libegl-dev  dnf: mesa-libEGL-devel  pacman: mesa  apk: mesa-dev  zypper: Mesa-libEGL-devel } } ] }   // Linux graphics; not on brew
        wxwidgets: { attrs: [ lib FOSS FOSSish ] description: "wxWidgets (wxGTK) — a cross-platform C++ GUI toolkit (dev)."
            install: [ { via: native  when: "void or void_musl"  name: wxWidgets-gtk3-devel }  { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"  repo-component: universe
                         name: { apt: libwxgtk3.2-dev  dnf: wxGTK-devel  pacman: wxwidgets-gtk3  apk: wxwidgets-dev  zypper: "wxWidgets-3_2-devel"  brew: wxwidgets } } ] }   // apt name is release-specific (3.2 on 22.04+; older ships 3.0)
        opencascade: { attrs: [ lib FOSS copyleft ] description: "Open CASCADE Technology (OCCT) — a 3D CAD/CAM/CAE geometric modeling kernel (dev)."
            install: [ { via: native  when: "debian"    packages: [ libocct-foundation-dev, libocct-modeling-algorithms-dev, libocct-modeling-data-dev,
                             libocct-ocaf-dev, libocct-visualization-dev, libocct-data-exchange-dev ]  installed-name: libocct-foundation-dev }
                       { via: native  when: "fedora or void or void_musl"    name: { xbps: occt-devel  default: opencascade-devel } }
                       { via: native  when: "arch"      name: opencascade }
                       { via: native  when: "opensuse"  name: occt-devel } ] }   // not in EL base / alpine / brew
        // --- shared build-dep dev libraries (consolidated from the configsys-source plugin: source
        // recipes `requires:` these by name, so they live in core where any component can reach them).
        // Debian/Fedora/openSUSE split a -dev/-devel package; Arch (and the component-name `default:`)
        // don't split, so the base name carries headers. NAMESWEEP PENDING as repos roll. ---
        ncurses:  { attrs: [ lib FOSS permissive ] description: "ncurses — terminal text-UI / window library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libncurses-dev  dnf: ncurses-devel   apk: ncurses-dev   zypper: ncurses-devel } } ] }
        libevent: { attrs: [ lib FOSS permissive ] description: "libevent — asynchronous event-notification library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libevent-dev    dnf: libevent-devel  apk: libevent-dev  zypper: libevent-devel } } ] }
        libssl:   { attrs: [ lib FOSS permissive ] description: "libssl — the OpenSSL TLS/crypto DEV library (headers + libs; distinct from the `openssl` CLI)."
                    install: [ { via: native  name: { xbps: openssl-devel apt: libssl-dev      dnf: openssl-devel   pacman: openssl   apk: openssl-dev   zypper: libopenssl-devel   brew: "openssl@4" } } ] }   // Arch/brew ship headers in the main `openssl` package (no -dev split); brew's `openssl` is an alias of openssl@4
        zlib:     { attrs: [ lib FOSS permissive ] description: "zlib — the DEFLATE compression library (dev headers + libs)."
                    install: [ { via: native  name: { apt: zlib1g-dev      dnf: zlib-devel      apk: zlib-dev      zypper: zlib-devel } } ] }
        asio:     { attrs: [ lib FOSS permissive ] description: "Asio — cross-platform C++ async I/O + networking library (header library; dev package)."
                    install: [ { via: native  name: { apt: libasio-dev     dnf: asio-devel      apk: asio-dev      zypper: asio-devel } } ] }
        tinyxml2: { attrs: [ lib FOSS permissive ] description: "TinyXML-2 — a small, efficient C++ XML parser (dev headers + lib)."
                    install: [ { via: native  name: { apt: libtinyxml2-dev dnf: tinyxml2-devel  apk: tinyxml2-dev  zypper: tinyxml2-devel } } ] }
        fmt:      { attrs: [ lib FOSS permissive ] description: "{fmt} — modern, safe C++ text-formatting library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libfmt-dev      dnf: fmt-devel       apk: fmt-dev       zypper: fmt-devel } } ] }
        gflags:   { attrs: [ lib FOSS permissive ] description: "gflags — Google's C++ command-line flags library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libgflags-dev   dnf: gflags-devel    apk: gflags-dev    zypper: gflags-devel } } ] }
        glog:     { attrs: [ lib FOSS permissive ] description: "glog — Google's C++ application-logging library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libgoogle-glog-dev  dnf: glog-devel  pacman: google-glog  apk: glog-dev  zypper: glog-devel } } ] }
        double-conversion: { attrs: [ lib FOSS permissive ] description: "double-conversion — Google's fast, correct binary<->decimal float conversion library."
                    install: [ { via: native  name: { apt: libdouble-conversion-dev  dnf: double-conversion-devel  apk: double-conversion-dev  zypper: double-conversion-devel } } ] }
        snappy:   { attrs: [ lib FOSS permissive ] description: "Snappy — Google's fast (not maximal-ratio) compression library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libsnappy-dev   dnf: snappy-devel    apk: snappy-dev    zypper: snappy-devel } } ] }
        bzip2:    { attrs: [ lib FOSS permissive ] description: "bzip2 — the Burrows-Wheeler block-sorting compression library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libbz2-dev      dnf: bzip2-devel     apk: bzip2-dev     zypper: libbz2-devel } } ] }
        libzstd:  { attrs: [ lib FOSS permissive ] description: "libzstd — the Zstandard compression DEV library (headers + libs; distinct from the `zstd` CLI)."
                    install: [ { via: native  name: { apt: libzstd-dev     dnf: libzstd-devel   pacman: zstd  apk: zstd-dev  zypper: libzstd-devel } } ] }
        liblz4:   { attrs: [ lib FOSS permissive ] description: "liblz4 — the LZ4 fast-compression DEV library (headers + libs; distinct from the `lz4` CLI)."
                    install: [ { via: native  name: { apt: liblz4-dev      dnf: lz4-devel       pacman: lz4   apk: lz4-dev   zypper: liblz4-devel } } ] }
        libsodium: { attrs: [ lib FOSS permissive ] description: "libsodium — modern, misuse-resistant cryptography library (dev headers + libs)."
                     install: [ { via: native  name: { apt: libsodium-dev  dnf: libsodium-devel  apk: libsodium-dev  zypper: libsodium-devel } } ] }
        liburing:  { attrs: [ lib FOSS permissive ] description: "liburing — the io_uring asynchronous-I/O interface library (dev headers + libs)."
                     install: [ { via: native  name: { apt: liburing-dev   dnf: liburing-devel   apk: liburing-dev   zypper: liburing-devel } } ] }
        libaio:    { attrs: [ lib FOSS copyleft ] description: "libaio — the Linux kernel asynchronous-I/O (KAIO) library (dev headers + libs)."
                     install: [ { via: native  name: { apt: libaio-dev     dnf: libaio-devel     apk: libaio-dev     zypper: libaio-devel } } ] }
        libunwind: { attrs: [ lib FOSS permissive ] description: "libunwind — call-chain unwinding for stack backtraces (dev headers + libs)."
                     install: [ { via: native  name: { apt: libunwind-dev  dnf: libunwind-devel  apk: libunwind-dev  zypper: libunwind-devel } } ] }
        libdwarf:  { attrs: [ lib FOSS copyleft ] description: "libdwarf — read/write DWARF debug info, for symbolized stack traces (dev headers + libs)."
                     install: [ { via: native  when: "debian or redhat or opensuse or void or void_musl"  name: { xbps: libdwarf-devel apt: libdwarf-dev  dnf: libdwarf-devel  zypper: libdwarf-devel } } ] }
        libiberty: { attrs: [ lib FOSS GNU copyleft ] description: "libiberty — GNU utility routines (C++ symbol demangling, etc.) used for symbolization."
                     install: [ { via: native  when: "debian or void or void_musl"  name: { xbps: libiberty-devel  default: libiberty-dev } } ] }
        libcurl:  { attrs: [ lib FOSS permissive ] description: "libcurl — the multi-protocol URL-transfer DEV library (headers + libs)."
                    install: [ { via: native  name: { apt: libcurl4-openssl-dev  dnf: libcurl-devel  pacman: curl  apk: curl-dev  zypper: libcurl-devel } } ] }
        expat:    { attrs: [ lib FOSS permissive ] description: "Expat — a fast stream-oriented XML parser library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libexpat1-dev   dnf: expat-devel     pacman: expat  apk: expat-dev    zypper: libexpat-devel } } ] }
        sdl2-ttf:   { attrs: [ lib FOSS permissive ] description: "SDL2_ttf — TrueType font rendering for SDL2 (dev headers + libs)."
                      install: [ { via: native  name: { xbps: SDL2_ttf-devel apt: libsdl2-ttf-dev    dnf: SDL2_ttf-devel    pacman: sdl2_ttf    apk: sdl2_ttf-dev    zypper: SDL2_ttf-devel } } ] }
        sdl2-image: { attrs: [ lib FOSS permissive ] description: "SDL2_image — image-file loading for SDL2 (dev headers + libs)."
                      install: [ { via: native  name: { xbps: SDL2_image-devel apt: libsdl2-image-dev  dnf: SDL2_image-devel  pacman: sdl2_image  apk: sdl2_image-dev  zypper: SDL2_image-devel } } ] }
        gettext:  { attrs: [ CLI FOSS GNU copyleft ] description: "GNU gettext — internationalization message tools (msgfmt) and the libintl runtime."
                    install: [ { via: native  name: { apk: gettext-dev     zypper: gettext-tools } }  { via: brew  name: gettext } ] }
        libpcap:  { attrs: [ lib FOSS permissive ] description: "libpcap — the packet-capture library (nethogs needs it)."
                    install: [ { via: native  name: { apt: libpcap-dev     dnf: libpcap-devel   apk: libpcap-dev  zypper: libpcap-devel } } ] }
        sqlite:   { attrs: [ lib FOSS permissive ] description: "SQLite — the embedded SQL database engine DEV library (headers + libs)."
                    install: [ { via: native  name: { apt: libsqlite3-dev  dnf: sqlite-devel    pacman: sqlite  apk: sqlite-dev  zypper: sqlite3-devel } } ] }
        libmtp:   { attrs: [ lib FOSS copyleft ] description: "libMTP — Media Transfer Protocol library for phones/players (jmtpfs needs it)."
                    install: [ { via: native  name: { apt: libmtp-dev      dnf: libmtp-devel    apk: libmtp-dev   zypper: libmtp-devel } } ] }
        fuse:     { attrs: [ lib FOSS copyleft ] description: "FUSE 2 — Filesystem-in-Userspace library (jmtpfs needs it)."
                    install: [ { via: native  name: { apt: libfuse-dev     dnf: fuse-devel      pacman: fuse2   apk: fuse-dev    zypper: fuse-devel } } ] }
        libusb:   { attrs: [ lib FOSS copyleft ] description: "libusb — cross-platform userspace USB device-access library (dev headers + libs)."
                    install: [ { via: native  name: { apt: libusb-1.0-0-dev  dnf: libusb1-devel  pacman: libusb  apk: libusb-dev  zypper: libusb-1_0-devel } } ] }
        libmagic: { attrs: [ lib FOSS permissive ] description: "libmagic — the file-type detection library behind `file` (jmtpfs needs it)."
                    install: [ { via: native  name: { apt: libmagic-dev    dnf: file-devel      pacman: file    apk: file-dev    zypper: file-devel } } ] }
        libidn2:  { attrs: [ lib FOSS GNU copyleft ] description: "libidn2 — Internationalized Domain Names (IDNA2008) library (whois needs it)."
                    install: [ { via: native  name: { apt: libidn2-dev     dnf: libidn2-devel   apk: libidn2-dev  zypper: libidn2-devel } } ] }
        libx11:      { attrs: [ lib FOSS permissive ] description: "libX11 — the core X11 client library (dev headers + libs)."
                       install: [ { via: native  name: { xbps: libX11-devel apt: libx11-dev  dnf: libX11-devel  apk: libx11-dev  zypper: libX11-devel  default: libx11 } } ] }
        libxinerama: { attrs: [ lib FOSS permissive ] description: "libXinerama — the X11 multi-monitor (Xinerama) extension library (dev headers + libs)."
                       install: [ { via: native  name: { xbps: libXinerama-devel apt: libxinerama-dev  dnf: libXinerama-devel  apk: libxinerama-dev  zypper: libXinerama-devel  default: libxinerama } } ] }
        libxft:      { attrs: [ lib FOSS permissive ] description: "libXft — the X11 FreeType font-rendering library (dev headers + libs)."
                       install: [ { via: native  name: { xbps: libXft-devel apt: libxft-dev  dnf: libXft-devel  apk: libxft-dev  zypper: libXft-devel  default: libxft } } ] }
        libxext:     { attrs: [ lib FOSS permissive ] description: "libXext — the X11 common extensions library (dev headers + libs)."
                       install: [ { via: native  name: { xbps: libXext-devel apt: libxext-dev  dnf: libXext-devel  apk: libxext-dev  zypper: libXext-devel  default: libxext } } ] }
        libxtst:     { attrs: [ lib FOSS permissive ] description: "libXtst — the X11 Test/Record extension library (dev headers + libs)."
                       install: [ { via: native  name: { xbps: libXtst-devel apt: libxtst-dev  dnf: libXtst-devel  apk: libxtst-dev  zypper: libXtst-devel  default: libxtst } } ] }
        libxss:      { attrs: [ lib FOSS permissive ] description: "libXScrnSaver — the X11 screen-saver extension library (dev headers + libs)."
                       install: [ { via: native  name: { xbps: libXScrnSaver-devel apt: libxss-dev  dnf: libXScrnSaver-devel  apk: libxscrnsaver-dev  zypper: libXss-devel  pacman: libxss  default: libxss } } ] }
        libxfixes:   { attrs: [ lib FOSS permissive ] description: "libXfixes — the X11 XFIXES extension library (dev headers + libs)."
                       install: [ { via: native  name: { xbps: libXfixes-devel apt: libxfixes-dev  dnf: libXfixes-devel  apk: libxfixes-dev  zypper: libXfixes-devel  default: libxfixes } } ] }
        fontconfig-dev: { attrs: [ lib FOSS permissive ] description: "fontconfig development headers (font discovery/configuration)."
                       install: [ { via: native  name: { xbps: fontconfig-devel apt: libfontconfig-dev  dnf: fontconfig-devel  apk: fontconfig-dev  zypper: fontconfig-devel  default: fontconfig } } ] }   // pacman/brew ship headers in the main package
        openal-dev:  { attrs: [ lib FOSS copyleft ] description: "OpenAL Soft — the 3D positional audio API library (dev headers + libs)."
                       install: [ { via: native  when: "rhel"  name: openal-soft-devel  enable-repo: crb }   // EL: the -devel lives in CRB
                                  { via: native  when: "not rhel"  name: { xbps: libopenal-devel apt: libopenal-dev  dnf: openal-soft-devel  apk: openal-soft-dev  zypper: openal-soft-devel  brew: openal-soft  default: openal } } ] }
        freealut-dev: { attrs: [ lib FOSS copyleft ] description: "freealut — the OpenAL Utility Toolkit (ALUT) library (dev headers + libs)."
                       install: [ { via: native  when: "not (rhel or alpine)"  name: { xbps: freealut-devel apt: libalut-dev  dnf: freealut-devel  zypper: freealut-devel  default: freealut } } ] }   // not packaged on EL (even EPEL/CRB) or Alpine -> declines there
        libpng:      { attrs: [ lib FOSS permissive ] description: "libpng — the reference PNG image library (dev headers + libs)."
                       install: [ { via: native  name: { apt: libpng-dev  dnf: libpng-devel  apk: libpng-dev  zypper: libpng16-devel  default: libpng } } ] }
        libjpeg:     { attrs: [ lib FOSS permissive ] description: "libjpeg-turbo — the JPEG image codec library (dev headers + libs)."
                       install: [ { via: native  name: { apt: libjpeg-dev  dnf: libjpeg-turbo-devel  apk: libjpeg-turbo-dev  zypper: libjpeg8-devel  pacman: libjpeg-turbo  default: libjpeg-turbo } } ] }
        wayland:           { attrs: [ lib FOSS permissive ] description: "Wayland — the core Wayland client/server library + scanner (dev headers + libs)."
                             install: [ { via: native  name: { apt: libwayland-dev  dnf: wayland-devel  apk: wayland-dev  zypper: wayland-devel  default: wayland } } ] }
        wayland-protocols: { attrs: [ lib FOSS permissive ] description: "wayland-protocols — the standard Wayland protocol XML definitions."
                             install: [ { via: native  name: { apt: wayland-protocols  dnf: wayland-protocols-devel  apk: wayland-protocols  zypper: wayland-protocols-devel  default: wayland-protocols } } ] }
        wlroots:           { attrs: [ lib FOSS permissive ] description: "wlroots — the modular Wayland compositor library (dev headers + libs)."
                             install: [ { via: native  name: { apt: libwlroots-dev  dnf: wlroots-devel  apk: wlroots0.19-dev  zypper: wlroots-devel  pacman: wlroots0.20 } } ] }   // apk/pacman names are soname-versioned — bump when the distro moves wlroots
        libinput:          { attrs: [ lib FOSS permissive ] description: "libinput — the input-device handling library for Wayland/X (dev headers + libs)."
                             install: [ { via: native  name: { apt: libinput-dev  dnf: libinput-devel  apk: libinput-dev  zypper: libinput-devel  default: libinput } } ] }
        libxkbcommon:      { attrs: [ lib FOSS permissive ] description: "libxkbcommon — the keyboard keymap handling library (dev headers + libs)."
                             install: [ { via: native  name: { apt: libxkbcommon-dev  dnf: libxkbcommon-devel  apk: libxkbcommon-dev  zypper: libxkbcommon-devel  default: libxkbcommon } } ] }
        pixman:            { attrs: [ lib FOSS permissive ] description: "pixman — the low-level pixel-manipulation library (dev headers + libs)."
                             install: [ { via: native  name: { apt: libpixman-1-dev  dnf: pixman-devel  apk: pixman-dev  zypper: libpixman-1-0-devel  default: pixman } } ] }
        cairo:             { attrs: [ lib FOSS copyleft ] description: "cairo — the 2D vector-graphics rendering library (dev headers + libs)."
                             install: [ { via: native  name: { apt: libcairo2-dev  dnf: cairo-devel  apk: cairo-dev  zypper: cairo-devel  default: cairo } } ] }
        pango:             { attrs: [ lib FOSS copyleft ] description: "Pango — the text-layout and font-rendering library (dev headers + libs)."
                             install: [ { via: native  name: { apt: libpango1.0-dev  dnf: pango-devel  apk: pango-dev  zypper: pango-devel  default: pango } } ] }
        xcb-util:          { attrs: [ lib FOSS permissive ] description: "xcb-util — XCB utility libraries (atom/aux/event helpers; dev headers + libs)."
                             install: [ { via: native  name: { apt: libxcb-util-dev  dnf: xcb-util-devel  apk: xcb-util-dev  zypper: xcb-util-devel  default: xcb-util } } ] }
        // SDL2 (the common target). Arch dropped classic `sdl2` → `sdl2-compat` (SDL2 API on SDL3).
        sdl: { attrs: [ lib FOSS permissive ] description: "SDL2 — Simple DirectMedia Layer (video/audio/input), dev headers + libs."
            install: [ { via: native  when: "void or void_musl"  name: SDL2-devel }  { via: native  when: "(debian or redhat or arch or alpine or opensuse or fedora_atomic) and not amzn"  repo-component: universe
                         name: { apt: libsdl2-dev  dnf: SDL2-devel  pacman: sdl2-compat  apk: sdl2-dev  zypper: sdl2-compat-devel  brew: sdl2-compat } } ]
        }
        // SFML — note the major-version skew: 2.x on debian/fedora/alpine, 3.x on arch/brew (a
        // breaking API change). openSUSE package unconfirmed → omitted there.
        sfml: { attrs: [ lib FOSS permissive ] description: "SFML — Simple and Fast Multimedia Library (C++), dev headers + libs."
            install: [ { via: native  when: "void or void_musl"  name: SFML-devel }  { via: native  when: "(debian or redhat or arch or alpine or fedora_atomic) and not amzn"  repo-component: universe
                         name: { apt: libsfml-dev  dnf: SFML-devel  pacman: sfml  apk: sfml-dev  brew: sfml } } ]
        }


        // ---- dotfiles companions (bulk pass) ---------------------------------------
        // Config pointers (declare WHERE a tool reads its user config; ship no content --
        // `configsys dotfiles capture <name>` adopts an existing one) and shell-setup snippets
        // (PATH/alias/env for off-PATH installs). Each is soft-`suggests:`ed by its parent.
        aider-dotfiles: { description: "aider config, linked into place." install: [ { via: dotfiles  config: { src: aider.conf.yml  dst: ~/.aider.conf.yml } } ] }
        android-studio-glue: { description: "android-studio shell setup, linked into place." install: [ { via: glue  requires: shell-glue  glue: android-studio } ] }
        antigravity-glue: { description: "antigravity shell setup, linked into place." install: [ { via: glue  requires: shell-glue  glue: antigravity } ] }
        awscli-dotfiles: { description: "awscli config, linked into place." install: [ { via: dotfiles  config: { src: aws-config  dst: ~/.aws/config } } ] }
        bazelisk-glue: { description: "bazelisk shell setup, linked into place." install: [ { via: glue  requires: shell-glue  glue: bazelisk } ] }
        blender-dotfiles: { description: "blender config, linked into place." install: [ { via: dotfiles  config: { src: blender  dst: $XDG_CONFIG_HOME/blender } } ] }
        bottom-dotfiles: { description: "bottom config, linked into place." install: [ { via: dotfiles  config: { src: bottom  dst: $XDG_CONFIG_HOME/bottom } } ] }
        btop-dotfiles: { description: "btop config, linked into place." install: [ { via: dotfiles  config: { src: btop  dst: $XDG_CONFIG_HOME/btop } } ] }
        btop-glue: { description: "btop shell setup, linked into place." install: [ { via: glue  requires: shell-glue  glue: btop } ] }
