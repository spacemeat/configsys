// routes.hu — the capability/component routing data (see docs/routing-model.md and the
// routing section of CLAUDE.md). Loaded by configsys/routes.py; resolution in resolve.py.
{
    // OS layer: lineage (`using`) + which package manager is `native` + version scales.
    // `provides:` lists capabilities baseline in that environment (satisfied for free).
    os: {
        // `provides: python3` — the configsys bootstrap guarantees a system python3 (>=3.10) on every
        // supported OS, so a bare `requires: python3` is satisfied for free (nothing installed). A
        // VERSIONED need (`requires: { python3: ">=3.11" }`) isn't met by this unversioned baseline and
        // pulls a python3.X interpreter component instead.
        linux:   { provides: python3 }

        // The C library is an axis orthogonal to distro family: mainstream distros are glibc,
        // Alpine (and musl-Void) are musl. Prebuilt glibc binaries (most AppImages, many
        // tarballs) can't run under musl's loader. `glibc_linux` carries a `glibc` capability
        // that the glibc families inherit; drivers/bindings that fetch glibc artifacts
        // `requires: glibc`, so they cleanly decline on Alpine instead of installing a corpse.
        glibc_linux: { using: linux  provides: glibc }

        // Debian family (apt). A scale-root owns a version numbering. Pop shares Ubuntu's exact
        // numbers (Pop 22.04 IS Ubuntu 22.04), so it borrows Ubuntu's scale — no scale-root.
        // Mint and LMDE use their OWN numbers (Mint 21 = Ubuntu 22.04, different digits), so
        // each is its own scale-root — a versioned `ubuntu`/`debian` atom must NOT misfire on
        // them. Bare `ubuntu`/`debian` still match all of them (route inheritance by identity).
        debian:    { using: glibc_linux  native: apt   scale-root: true }
        ubuntu:    { using: debian    scale-root: true }
        pop_os!:   { using: ubuntu }
        elementary:{ using: ubuntu    scale-root: true }            // elementary OS (own numbering: 6/7/8); ships the Pantheon desktop
        linuxmint: { using: ubuntu    scale-root: true }            // Mint main (own numbering)
        zorin:     { using: ubuntu    scale-root: true }            // Zorin OS (own numbering; VERSION_ID is the major only: 17 = Ubuntu 22.04, 18 = 24.04)
        lmde:      { using: debian    scale-root: true }            // Mint Debian Edition (own numbering)
        kali:      { using: debian }                                // kali-rolling (Debian testing) — rolling, bare membership like tumbleweed
        pikaos:    { using: debian    scale-root: true }            // Debian-based gaming distro; own date numbering (26.MM.DD) so it's its own scale-root
        mx:        { using: debian    scale-root: true }            // MX Linux (ID=mx, ID_LIKE=debian); own numbering (MX-19/21/23/25 tracking Debian)
        avlinux:   { using: mx }                                    // AV Linux MX Edition — MX-based multimedia distro; tracks MX (if it keeps ID=mx the `mx` block already covers it)
        // Raspberry Pi OS. Bookworm+ rebranded os-release to ID=debian (indistinguishable from plain
        // Debian by ID alone), so it's detected by the /etc/rpi-issue marker every Pi image carries
        // (refine()). Legacy Raspbian (Bullseye-, ID=raspbian) aliases straight here in osdetect. Same
        // distro, renamed — one identity. Tracks Debian's version numbering, so no scale-root of its own.
        pios:      { using: debian  detect: { id: debian  marker: /etc/rpi-issue } }

        // RHEL family (dnf). The EL rebuilds share rhel's routes + version line; distinct
        // blocks (vs. one aliased `rhel`) buy them identity — `when: "rocky"`, correct display.
        redhat:    { using: glibc_linux  native: dnf }              // fedora + EL share dnf
        fedora:    { using: redhat    scale-root: true }            // fedora proper (YY release)
        nobara:    { using: fedora }                                // Fedora-based (Nobara N = Fedora N) — borrows fedora's scale, no own scale-root
        rhel:      { using: redhat    scale-root: true }            // EL scale-root (N release)
        rocky:     { using: rhel }
        scientific: { using: rhel }                                 // Scientific Linux (ID=scientific): Fermilab's EL rebuild, SL 7.9 = RHEL 7.9 (borrows EL's scale). EOL 2024-06 — identity only
        almalinux: { using: rhel }
        centos:    { using: rhel }                                  // CentOS Stream
        ol:        { using: rhel }                                  // Oracle Linux (os-release ID=ol) — EL rebuild, full dnf + its own EPEL pkg name
        amzn:      { using: redhat   scale-root: true }              // Amazon Linux 2023 (ID=amzn): Fedora-derived, own repos+version, NO EPEL

        // Fedora Atomic / uBlue (Silverblue, Kinoite, Sericea, Bazzite, Bluefin, Aurora …) —
        // immutable ostree desktops. Modeled as a distinct ENVIRONMENT, deliberately NOT under
        // `fedora`: brew is the CLI `native:` (uBlue ships it pre-configured), flatpak covers
        // apps (their existing bindings just work), and rpm-ostree is an explicit last-resort
        // layering driver (via: rpm-ostree). Hanging off glibc_linux — not redhat — keeps the
        // dnf-only bindings (EPEL / RPM Fusion / repo-component) from misfiring here; brew needs
        // none of them. `provides: flatpak` because flatpak is pre-installed, so an app's flatpak
        // dep is env-satisfied instead of trying to `brew install flatpak`. scale-root: it owns
        // its VERSION_ID (tracks Fedora) without inheriting fedora's dnf version line. osdetect
        // folds every variant (ID=fedora + atomic VARIANT_ID or the ostree marker) into this block.
        fedora_atomic: { using: glibc_linux  native: brew  provides: flatpak  scale-root: true }

        // KDE Linux (ID=kde-linux, aliased) — KDE's immutable, image-based distro (built from Arch
        // packages, but pacman is REMOVED from the image, so no `ID_LIKE=arch`). There is NO system
        // package manager: no `native:`, so `via: native` bindings aren't candidates here and
        // components fall through to Flatpak (preinstalled -> `provides: flatpak`) and userland
        // methods (brew, tarballs, `via: script` installers, cargo via rustup, go-install via the go
        // tarball; pipx through its brew formula, so PyPI CLIs route too — python3-pip stays native-only)
        // and distro-package-only components decline honestly. No
        // libfuse2 either (fuse3 only), so AppImages decline. VERSION_ID is a build timestamp
        // (YYYYMMDDHHMM): scale-root so no parent's versioned atom misreads it. Alpha. `provides:` =
        // tools in the image per its mkosi package lists (git, unzip, xz, flatpak; curl via git's
        // deps), so tarball/source methods' prerequisites are met without a package manager.
        kde_linux: { using: glibc_linux  provides: [ flatpak  curl  git  unzip  xz ]  scale-root: true }

        // Arch family (pacman). Rolling — no version scale; membership is by identity only.
        arch:        { using: glibc_linux  native: pacman }
        manjaro:     { using: arch }
        endeavouros: { using: arch }
        cachyos:     { using: arch }              // performance-tuned Arch (x86-64-v3/v4 repos); rolling
        garuda:      { using: arch }              // gaming-focused Arch; rolling
        omarchy:     { using: arch }              // DHH's opinionated Arch+Hyprland; rolling (inert if it keeps ID=arch, active if it rebrands ID=omarchy)

        // Alpine (apk). musl, NOT glibc — so it hangs off `linux`, not `glibc_linux`. glibc-only
        // fetch-a-binary bindings decline here (unroutable = a clean diagnostic); the optional
        // `gcompat` shim can re-enable them per-machine (see the gcompat component).
        alpine: { using: linux  native: apk }
        // Chimera Linux (ID=chimera) — an independent musl distro (LLVM, BSD userland, dinit; rolling,
        // no VERSION_ID). It uses apk-tools v3 but NOT Alpine's package names (`-devel` not `-dev`,
        // `python` not `python3`, …), so every `apk:` name in these routes would be wrong there: no
        // `native:` until Chimera-named `via: apk  when: "chimera"` bindings are verified (a name
        // sweep in the chimeralinux/chimera image). Until then PRACTICALLY NOTHING routes: chimera
        // `provides:` nothing beyond linux's python3, and the portable methods' prerequisites are
        // native-only here — tarball needs curl, flatpak/pipx/cargo need their tool (rust's rustup
        // script needs curl too) — so only dotfiles/glue and a few self-contained `via: script`
        // installers resolve. Under `linux`, not glibc_linux: glibc binaries decline.
        chimera: { using: linux }

        // Void Linux (xbps). Rolling — no version scale. Ships in TWO flavors differing only by C
        // library: `void` (glibc, under glibc_linux) and `void_musl` (under bare linux, like Alpine),
        // so glibc-only AppImages/tarballs work on one and cleanly decline on the other with no
        // per-component work. They're SIBLINGS (different libc parents), so a Void-wide gate is
        // `when: "void or void_musl"`. Both report ID=void; void_musl is told apart by the musl
        // loader (detect: marker). xbps package names are libc-agnostic: one `xbps:` name map serves
        // both. (Mirrored by the configsys-void plugin, kept as a worked example of an OS plugin.)
        void:      { using: glibc_linux  native: xbps }
        void_musl: { using: linux        native: xbps
                     detect: { id: void  marker: /lib/ld-musl-x86_64.so.1 } }

        // openSUSE / SUSE (zypper). glibc. One synthetic parent declares the driver; Leap is a
        // scale-root (versioned, 15.x) while Tumbleweed is rolling (bare membership, like arch)
        // — a clean demo of identity-vs-scale being orthogonal. Block names use `_` (the `when:`
        // DSL has no `-`); os-release's `opensuse-leap`/`-tumbleweed` alias in.
        opensuse:             { using: glibc_linux  native: zypper }
        opensuse_leap:        { using: opensuse  scale-root: true }
        opensuse_tumbleweed:  { using: opensuse }
    }

    // Driver config: dependencies inherent to a driver (its prerequisite tooling).
    drivers: {
        snap:        { standing: never-auto  requires: [ snapd-socket, snapd-snap-link ] }   // never-auto = valid + listed + pinnable, never the auto-default (native/flatpak win); a pin forces it. `requires` pulls in snapd + its socket + the /snap symlink, so a snap works on any distro where snapd is installable (a no-op on Ubuntu, which ships snapd). Where snapd has no method (openSUSE, Void, Alpine, atomic, Amazon Linux, …) those requires can't be met, so the snap driver isn't valid there and no snap method is offered (the derived driver gate). A user's primary plugin can add `flatpak: { standing: never-auto }` the same way.
        flatpak:     { requires: flatpak }
        appImage:    { requires: [ libfuse2, glibc ] }   // AppImages are glibc builds needing the FUSE2 runtime. A driver is valid only where its requires can be met (the derived gate), so AppImage methods aren't candidates on musl (alpine/chimera/void_musl: no glibc) or on the image-based fedora_atomic/kde_linux (no libfuse2 route) — `where` says why. On Alpine, `pins: { glibc: gcompat }` opts in to the best-effort shim and makes them valid.
        cargo:       { requires: cargo }              // a crate needs the cargo tool
        npm:         { requires: npm }                // a global CLI needs the npm tool (-> node)
        go-install:  { requires: go }                 // `go install` needs the go toolchain
        gem:         { requires: ruby }                // a gem needs ruby (gem ships with it)
        opam:        { requires: opam }                // an OCaml package needs the opam tool
        luarocks:    { requires: luarocks }            // a rock needs the luarocks tool (-> lua)
        cabal:       { requires: cabal }               // a hackage exe needs cabal (-> ghc)
        sdkman:      { requires: sdkman }              // a JVM SDK (scala/groovy/sbt/…) needs the sdkman tool
        brew:        { requires: homebrew  when: "glibc_linux" }   // a formula needs Homebrew itself (pre-installed on uBlue atomic images -> detected, not reinstalled). `when:` is a driver-wide VALIDITY gate: Linuxbrew bottles are glibc builds, so no brew method (nor a `via: native` reaching brew) is a candidate on musl (alpine/chimera/void_musl) — validity only, it adds no specificity. brew ranks just ahead of tarball in driver-preference.
        font: { requires: [ fontconfig, unzip ] }
        // pip / pipx on musl (Alpine): pip prefers a `musllinux` wheel and pure-Python wheels
        // install fine, but a C-extension package that ships ONLY `manylinux` (glibc) wheels
        // falls back to building from its sdist — which needs a toolchain (gcc, musl-dev,
        // python3-dev) + the package's own C headers. configsys does NOT model those build deps
        // (they're per-package and usually unneeded), so such a build surfaces pip's own
        // compiler error; add the toolchain to a profile if you hit it. No base pip/pipx
        // component is affected — this only concerns C-extension tools a user adds on Alpine.
        pip:         { requires: python3-pip }        // `pip install --user` needs pip
        pipx:        { requires: pipx }               // a PyPI CLI needs the pipx tool
        pyenv:       { requires: [ pyenv, python-build-deps ] }   // compile CPython: the tool + C build libs
        tarball:     { requires: curl }               // fetch the archive with curl
        source:      { requires: git }                // clone + build from a git checkout
        aur:         { requires: [ base-devel, git ]  when: "arch" }   // makepkg -si builds from a PKGBUILD. `when:` is a driver-wide VALIDITY gate: the AUR is Arch's user repository (Void has base-devel too, so the derived requires gate alone wouldn't exclude it). aur ranks right after native in driver-preference, so an aur binding needs no `when: "arch"` of its own — EXCEPT where another binding valid on Arch carries a narrower `when:` (a version-gated AppImage, a cpu-gated tarball), which would beat a bare aur binding on specificity before preference is consulted; there the aur binding keeps `when: "arch"`.
    }

    // Detected environment facts that `when:` can gate on (see docs/facets.md). General-purpose and
    // shared: a plugin that wants to gate a per-vendor variant on `when: "gpu:nvidia"` / `gpu:amd`
    // (e.g. the opencv plugin's CUDA-vs-HIP stacks) reuses this probe rather than redefining it.
    // Value precedence: a
    // `CONFIGSYS_FACET_gpu` env var, a `facets:` value in the user config, else this probe. Only
    // nvidia/amd are auto-detected (Intel iGPUs vs the compute-capable path are too ambiguous to
    // auto-pick — leave oneAPI opt-in). Override with `facets: { gpu: nvidia }` if the probe is wrong.
    facets: {
        gpu: { kind: categorical
               detect: 'lspci 2>/dev/null || { command -v nvidia-smi >/dev/null 2>&1 && echo NVIDIA; command -v rocminfo >/dev/null 2>&1 && echo "AMD/ATI"; }'
               match: { nvidia: "NVIDIA"  amd: "AMD/ATI" } }   // lspci (pciutils) preferred; falls back to the driver tools if absent (containers/minimal)
    }

    // Component layer: each is a capability + a list of context-selected bindings.
    components: {
        // --- core utilities (base tools; several are driver prerequisites) ---
        flatpak:    { attrs: [ CLI daemon FOSS copyleft ] description: "Flatpak — sandboxed app distribution and runtime." install: [ { via: native } ] }
        fontconfig: { attrs: [ lib FOSS permissive ] description: "fontconfig — font discovery and configuration library." install: [ { via: native } ] }
        unzip:      { attrs: [ CLI FOSS permissive ] description: "Extract ZIP archives." install: [ { via: native }  { via: brew  name: unzip } ] }
        xz:         { attrs: [ CLI FOSS permissive ] description: "XZ/LZMA compression — `tar` needs it to unpack a .tar.xz." install: [ { via: native  name: { apt: xz-utils  default: xz } }  { via: brew  name: xz } ] }   // on every desktop install, but NOT in minimal containers
        zip:        { attrs: [ CLI FOSS permissive ] description: "Create and update ZIP archives." install: [ { via: native }  { via: brew  name: zip } ] }
        curl:       { attrs: [ CLI FOSS permissive ] description: "Transfer data over HTTP(S) and more — the ubiquitous `curl`." install: [ { via: native } ] }
        wget:       { attrs: [ CLI FOSS GNU copyleft ] description: "Retrieve files over HTTP(S)/FTP — the GNU `wget` non-interactive downloader." install: [ { via: native }  { via: brew  name: wget } ] }
        openssl:    { attrs: [ CLI FOSS permissive ] description: "OpenSSL — the TLS/crypto toolkit CLI (the `openssl` command; its DEV library is the `libssl` component)." install: [ { via: native  name: { brew: "openssl@4" } }  { via: brew  name: "openssl@4" } ] }   // package `openssl` is the CLI everywhere (brew's `openssl` is now an alias of openssl@4)
        ghostscript: { attrs: [ CLI FOSS copyleft ] description: "Ghostscript (`gs`) — a PostScript and PDF interpreter/renderer." install: [ { via: native }  { via: brew  name: ghostscript } ] }
        git:        { attrs: [ CLI FOSS copyleft ] suggests: git-dotfiles  description: "Distributed version control — the `git` you already know." install: [ { via: native } ] }
        // Homebrew on Linux ("Linuxbrew") — the `brew` driver's tool (drivers.brew requires it), so
        // any brew method pulls it into the closure. Installed by the OFFICIAL installer into
        // /home/linuxbrew/.linuxbrew (it sudo-creates that prefix itself: `sudo -v` first warms the
        // credentials its NONINTERACTIVE `sudo -n` needs). glibc only — Linuxbrew's bottles are
        // glibc builds. uBlue atomic images (Bazzite/Bluefin/Aurora) ship brew pre-installed and
        // usually NOT on a non-login PATH, so the version probe also tries the standard prefix (and
        // a per-user ~/.linuxbrew) — a resident brew reads installed and is never reinstalled. On
        // fedora_atomic the installer's curl/git are image tools (curl/git route THROUGH brew there,
        // so requiring them would loop); elsewhere they are real requires (curl/git themselves get
        // no brew binding, so homebrew -> curl/git can never route back through brew). Installed
        // only when a brew method is chosen: fedora_atomic's native, or elsewhere on glibc where
        // brew is the best valid method (it ranks just ahead of tarball) or is pinned.
        homebrew: { attrs: [ CLI FOSS permissive ] description: "Homebrew on Linux — the `brew` package manager (prefix /home/linuxbrew/.linuxbrew)."
            install: [
                { via: script  when: "fedora_atomic"
                  install-cmd:   'sudo -v && NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'
                  version-cmd:   'for b in "$(command -v brew)" /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do [ -x "$b" ] && { "$b" --version; break; }; done'
                  version-re:    'Homebrew ([0-9][0-9.]*)'
                  version:       { github: Homebrew/brew }
                  upgrade-cmd:   'for b in "$(command -v brew)" /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do [ -x "$b" ] && { "$b" update; break; }; done'
                  uninstall-cmd: 'NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/uninstall.sh)"'
                  location:      /home/linuxbrew/.linuxbrew }
                { via: script  when: "glibc_linux and not fedora_atomic"  requires: [ curl, git ]
                  install-cmd:   'sudo -v && NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'
                  version-cmd:   'for b in "$(command -v brew)" /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do [ -x "$b" ] && { "$b" --version; break; }; done'
                  version-re:    'Homebrew ([0-9][0-9.]*)'
                  version:       { github: Homebrew/brew }
                  upgrade-cmd:   'for b in "$(command -v brew)" /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do [ -x "$b" ] && { "$b" update; break; }; done'
                  uninstall-cmd: 'NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/uninstall.sh)"'
                  location:      /home/linuxbrew/.linuxbrew } ] }
        git-lfs:    { attrs: [ CLI FOSS permissive ] requires: git  description: "Git Large File Storage (`git lfs`) — version large files via lightweight pointers." install: [ { via: native }  { via: brew  name: git-lfs } ] }   // `git-lfs` on every family
        // Other version-control systems (git is above). Package name == component name except:
        // subversion's CLI is `svn`; bazaar is now Breezy (`brz`); perforce ships `helix-cli` (`p4`).
        mercurial: { attrs: [ CLI FOSS copyleft ] suggests: mercurial-dotfiles  description: "Mercurial — a fast distributed version control system (`hg`)."
            install: [ { via: native  when: "not rhel"  repo-component: universe }   // uniform pkg `mercurial`
                       { via: native  when: "rhel"  requires: epel }
                       { via: pipx  name: mercurial  standing: never-auto }  { via: brew  name: mercurial } ] }       // Python; pinnable alt
        subversion: { attrs: [ CLI FOSS permissive ] description: "Apache Subversion — centralized version control (the `svn` CLI)."
            install: [ { via: native  repo-component: universe }  { via: brew  name: subversion } ] }                  // uniform pkg `subversion`
        cvs: { attrs: [ CLI FOSS GNU copyleft ] suggests: cvs-dotfiles  description: "CVS — the classic Concurrent Versions System."
            install: [ { via: native  when: "debian or fedora or arch or fedora_atomic or void or void_musl"  repo-component: universe }
                       { via: native  when: "rhel"  requires: epel }  { via: brew  name: cvs } ] }              // gone from stable-Alpine + openSUSE
        fossil: { attrs: [ CLI web FOSS permissive ] suggests: fossil-glue  description: "Fossil — a self-contained distributed SCM (wiki, tickets, web UI in one binary)."
            install: [ { via: native  when: "(not opensuse and not rhel) and not amzn"  repo-component: universe }
                       { via: native  when: "rhel"  requires: epel }
                       { via: tarball  when: "opensuse"  cpu-names: { x86_64: x64 }  installDir: "$CONFIGSYS_APP_DIR/fossil"  requires: glibc  // no openSUSE package; upstream static binary
                         version: { static: "2.28" }  url: "https://fossil-scm.org/home/uv/fossil-linux-x64-2.28.tar.gz"
                         latest-check: { url: "https://fossil-scm.org/home/uv/download.html"  regex: "x64-([0-9]+[.][0-9]+)[.]tar" } }  { via: brew  name: fossil } ] }   // `refresh` flags a newer fossil release
        perforce: { attrs: [ CLI daemon app proprietary freemium ] description: "Perforce Helix Core — the `p4` client and `p4d` server." standing: never-auto
            install: [   // Perforce's own package repo (no distro-native packages); codenames bump as they add releases
                { via: native  when: "ubuntu"  name: helix-cli
                  pubkey-url: "https://package.perforce.com/perforce.pubkey"  pubkey-path: /usr/share/keyrings/perforce.gpg
                  source-line: "deb [signed-by=/usr/share/keyrings/perforce.gpg] https://package.perforce.com/apt/ubuntu noble release"
                  source-path: /etc/apt/sources.list.d/perforce.list }
                { via: native  when: "redhat"  name: helix-cli
                  pubkey-url: "https://package.perforce.com/perforce.pubkey"
                  repo-id: perforce  repo-name: "Perforce"  repo-url: "https://package.perforce.com/yum/rhel/9/x86_64" }
                { via: aur  name: p4 } ] }
        bazaar: { attrs: [ CLI FOSS copyleft ] description: "Breezy — the maintained fork of GNU Bazaar (the `brz` CLI); reads Bazaar & Git."
            install: [ { via: native  when: "debian"  name: brz  repo-component: universe }   // `bzr` is a transitional dummy -> brz
                       { via: native  when: "fedora or arch or alpine or fedora_atomic"  name: breezy }
                       { via: pipx  name: breezy }  { via: brew  name: breezy } ] }   // no breezy in EL/EPEL or openSUSE -> pipx there; pinnable anywhere else too
        // FUSE2 runtime — the appImage driver requires it; native, name differs by manager. Not on
        // fedora_atomic: brew has no libfuse2 (and AppImages are NOT managed on atomic — see the
        // atomic advisory), so appImage methods decline there instead of `brew install libfuse2`.
        libfuse2: { attrs: [ lib FOSS copyleft ] description: "libfuse2 — the FUSE runtime many AppImages need."
            install: [ { via: native  when: "not fedora_atomic"  repo-component: universe  name: { xbps: fuse dnf: fuse-libs  pacman: fuse2  apk: fuse  default: libfuse2 } } ]
        }
        doas:       { attrs: [ CLI FOSS permissive ] description: "doas — a minimal, simpler sudo alternative." install: [ { via: native  when: "void or void_musl"  name: opendoas }  { via: apk  when: "alpine" } ] }   // Alpine's sudo (folded from the alpine plugin); Void packages OpenBSD's as opendoas
        xtools:     { attrs: [ CLI FOSS permissive ] description: "xtools — Void's opinionated XBPS helper scripts (`xi`, `xcheckrestart`, `xlocate`, …)." install: [ { via: native  when: "void or void_musl" } ] }   // Void-only

        // gcompat: Alpine's glibc-compat shim. It `provides: glibc`, so it can re-enable the
        // glibc-only methods (glibc tarballs, and the whole appImage driver, which requires glibc)
        // that otherwise decline on musl. It is
        // marked `never-auto` — NEVER auto-pulled to satisfy a `requires: glibc`, because the shim
        // is BEST-EFFORT: it maps many glibc binaries onto musl but not all (symbol-version
        // gaps, NSS, TLS quirks). Silently installing it, then maybe still failing to run the
        // binary, is exactly the surprise configsys avoids. So a musl box declines glibc
        // binaries by default; to gamble on the shim, opt in per-machine with a provider-pin:
        // pins: { glibc: gcompat }. (Picking gcompat also satisfies a tarball's binding-level
        // `requires: glibc`, but only the pin opens the appImage DRIVER — driver gates read pins.)
        gcompat: { attrs: [ lib FOSS permissive ] description: "gcompat — a glibc compatibility layer for musl (Alpine)."
            provides: glibc
            standing: never-auto
            install: [ { via: apk  when: "alpine" } ]
        }
        python3-pip: { attrs: [ CLI FOSS permissive ] suggests: python3-pip-glue  description: "pip — the Python package installer." install: [ { via: native  name: { pacman: python-pip  zypper: python313-pip  apk: py3-pip } } ] }

        // Python interpreters as VERSION-SCOPED providers of the `python3` capability. Install specific
        // versions side-by-side — each is a distinct `/usr/bin/python3.X` (or a pyenv build), so they
        // coexist as normal residents — and let a tool floor its interpreter with
        // `requires: { python3: ">=3.11" }` (the constraint selects/enables the matching version;
        // 3.13 is the default when several qualify). Two methods each: `native` for a fast binary
        // (Ubuntu's non-default versions come from the deadsnakes PPA; Fedora ships them directly), and
        // `pyenv` to COMPILE any version user-scope (newest/RCs, per-project via `.python-version`) —
        // pick the method with a binding-pin. NEVER repoints the system `python3` default (apt and
        // distro tools depend on it): select a version by calling `python3.X` or a venv built from it.
        // 3.10 / 3.11 / 3.12 / 3.14 are `never-auto` (constraint- or explicitly-selected); 3.13 is the modern
        // default (3.14 is stable but opt-in until the package ecosystem fully catches up to it).
        python3.10: { attrs: [ CLI runtime toolchain FOSS permissive ] description: "Python 3.10 interpreter (+ minimal, venv, dev headers) — configsys's minimum line; the system python on many LTS distros."
            standing: never-auto  provides: { python3: "3.10" }
            install: [
                { via: native  when: "debian"  packages: [ python3.10, python3.10-minimal, python3.10-venv, python3.10-dev ]
                  ppa: deadsnakes/ppa  requires: software-properties-common }   // deadsnakes carries 3.10 where it isn't the base version (e.g. 24.04); harmless where it is
                { via: native  when: "fedora or redhat"  packages: [ python3.10 ] }
                { via: pyenv  version: "3.10" }
            ]
        }
        python3.11: { attrs: [ CLI runtime toolchain FOSS permissive ] description: "Python 3.11 interpreter (+ venv, dev headers)."
            standing: never-auto  provides: { python3: "3.11" }
            install: [
                { via: native  when: "debian"  packages: [ python3.11, python3.11-venv, python3.11-dev ]
                  ppa: deadsnakes/ppa  requires: software-properties-common }
                { via: native  when: "fedora or redhat"  packages: [ python3.11 ] }
                { via: pyenv  version: "3.11" }
                { via: brew  name: "python@3.11" }
            ]
        }
        python3.12: { attrs: [ CLI runtime toolchain FOSS permissive ] description: "Python 3.12 interpreter (+ venv, dev headers)."
            standing: never-auto  provides: { python3: "3.12" }
            install: [
                { via: native  when: "debian"  packages: [ python3.12, python3.12-venv, python3.12-dev ]
                  ppa: deadsnakes/ppa  requires: software-properties-common }
                { via: native  when: "fedora or redhat"  packages: [ python3.12 ] }
                { via: pyenv  version: "3.12" }
                { via: brew  name: "python@3.12" }
            ]
        }
        python3.13: { attrs: [ CLI runtime toolchain FOSS permissive ] description: "Python 3.13 interpreter (+ venv, dev headers) — the modern default."
            provides: { python3: "3.13" }
            install: [
                { via: native  when: "debian"  packages: [ python3.13, python3.13-venv, python3.13-dev ]
                  ppa: deadsnakes/ppa  requires: software-properties-common }
                { via: native  when: "fedora or redhat"  packages: [ python3.13 ] }
                { via: pyenv  version: "3.13" }
                { via: brew  name: "python@3.13" }
            ]
        }
        python3.14: { attrs: [ CLI runtime toolchain FOSS permissive ] description: "Python 3.14 interpreter (+ venv, dev headers) — the newest stable line."
            standing: never-auto  provides: { python3: "3.14" }
            install: [
                { via: native  when: "debian"  packages: [ python3.14, python3.14-venv, python3.14-dev ]
                  ppa: deadsnakes/ppa  requires: software-properties-common }
                { via: native  when: "fedora or redhat"  packages: [ python3.14 ] }
                { via: pyenv  version: "3.14" }
                { via: brew  name: "python@3.14" }
            ]
        }
        cython: { attrs: [ CLI toolchain FOSS permissive ] description: "Cython — compile Python-like code to C extension modules."
            requires: [ python3, cpp-toolchain ]
            install: [ { via: native  name: { xbps: python3-Cython apt: cython3  dnf: python3-Cython  pacman: cython  zypper: python313-Cython  apk: cython } }  { via: brew  name: cython } ] }
        python3-dev: { attrs: [ lib FOSS permissive ] description: "CPython development headers (`Python.h`) for building C extension modules."
            install: [ { via: native  name: { xbps: python3-devel apt: python3-dev  dnf: python3-devel  pacman: python  apk: python3-dev  zypper: python313-devel  brew: "python@3.15" } } ] }   // zypper: openSUSE ships version-scoped python devel (no bare python3-devel); bump on the distro's default-python move. brew: the real formula, not the `python` alias — bump when Homebrew's default python moves
        numpy: { attrs: [ lib FOSS permissive ] description: "NumPy — the fundamental array-computing package for Python."
            install: [ { via: native  when: "not opensuse"  name: { xbps: python3-numpy apt: python3-numpy  dnf: python3-numpy  pacman: python-numpy  apk: py3-numpy } }
                       { via: pip  name: numpy } ] }   // openSUSE ships only version-scoped python3XY-numpy (churns) — let pip cover it
        pytest: { attrs: [ CLI FOSS permissive ] description: "pytest — the Python testing framework (`pytest`)."
            install: [ { via: native  when: "not opensuse"  name: { xbps: python3-pytest apt: python3-pytest  dnf: python3-pytest  pacman: python-pytest  apk: py3-pytest } }
                       { via: pip  name: pytest }  { via: brew  name: pytest } ] }   // openSUSE ships only version-scoped python3XY-pytest (churns) — let pip cover it
        wxpython: { attrs: [ lib GUI FOSS FOSSish ] description: "wxPython (Phoenix) — Python bindings for the wxWidgets GUI toolkit."
            install: [ { via: native  when: "not opensuse"  name: { xbps: wxPython apt: python3-wxgtk4.0  dnf: python3-wxpython4  pacman: python-wxpython  apk: py3-wxpython } }
                       { via: pip  name: wxpython } ] }   // openSUSE ships only version-scoped python3XY-wxPython (churns) — let pip cover it

        // pyenv itself + the C libraries it needs to COMPILE CPython — the `via: pyenv` method's deps
        // (see drivers.pyenv). pyenv installs user-scope under ~/.pyenv via its official installer.
        pyenv: { attrs: [ CLI FOSS permissive ] suggests: pyenv-glue  description: "pyenv — build & switch Python versions from source, user-scope."
            requires: curl
            install: [ { via: script
                install-cmd:   'curl -fsSL https://pyenv.run | bash'
                version-cmd:   '"$HOME/.pyenv/bin/pyenv" --version 2>/dev/null'
                version-re:    '([0-9][0-9.]*)'
                uninstall-cmd: 'rm -rf "$HOME/.pyenv"' }  { via: brew  name: pyenv } ] }
        // uv — Astral's very fast Python package/project manager (a single Rust binary). Native
        // where packaged (arch; brew on atomic); pipx is the universal default elsewhere; the github
        // tarball and cargo are pinnable alternates. NOT in the debian/ubuntu repos.
        uv: { attrs: [ CLI FOSS permissive ] suggests: uv-glue  description: "uv — Astral's very fast Python package & project manager (Rust)."
            install: [
                { via: native   when: "arch or void or void_musl" }                     // pacman: uv
                { via: native   when: "fedora_atomic" }            // brew formula `uv`
                { via: pipx     name: uv }                         // universal (prebuilt wheels)
                { via: tarball  cpu-names: { x86_64: x86_64  aarch64: aarch64 }  installDir: "$CONFIGSYS_APP_DIR/uv"  requires: glibc  standing: never-auto
                  version: { github: astral-sh/uv  strip-v: true  asset: "uv-$ARCH-unknown-linux-gnu.tar.gz" } }
                { via: cargo    name: uv  standing: never-auto  version: { crates: uv } }   // `cargo install uv`; never-auto so it's offered/pinnable but doesn't tie with pipx
                { via: brew  name: uv }
            ]
        }
        python-build-deps: { attrs: [ lib FOSS ] description: "System libraries pyenv needs to compile CPython (ssl/zlib/ffi/…)."
            standing: never-auto
            install: [
                { via: native  when: "void or void_musl"  packages: [ base-devel, openssl-devel, zlib-devel, bzip2-devel, readline-devel, sqlite-devel, tk-devel, libffi-devel, liblzma-devel ] }   // Void's -devel split; base-devel = the C toolchain meta
                { via: native  when: "debian"  packages: [ build-essential, libssl-dev, zlib1g-dev, libbz2-dev,
                    libreadline-dev, libsqlite3-dev, libncursesw5-dev, xz-utils, tk-dev, libffi-dev, liblzma-dev ]  installed-name: build-essential }
                { via: native  when: "(fedora or redhat) and not amzn"  packages: [ gcc, make, zlib-devel, bzip2-devel,
                    readline-devel, sqlite-devel, openssl-devel, tk-devel, libffi-devel, xz-devel ] }
                { via: native  when: "arch"  packages: [ base-devel, openssl, zlib, xz, tk ] }   // pyenv's documented Arch build env (Arch bundles headers, no -dev split). Keep `base-devel` — it's a META-package now (not a group, since 2023-02), so `pacman -Q` detects it exactly AND it tracks new build-tool members on upgrade; expanding it to concrete members would silently miss future additions.
            ] }
        // EL keeps these in EPEL, base repos everywhere else — same two-binding shape as btop.
        // `repo-component: universe` is the apt archive area (read only by apt; ignored on dnf/pacman).
        ripgrep: { suggests: ripgrep-glue  attrs: [ CLI  FOSS  permissive ]  description: "Fast recursive regex search (`rg`) — grep, but much quicker."
                   install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"   repo-component: universe }
                              { via: tarball  cpu-names: { x86_64: x86_64  aarch64: aarch64 }  installDir: "$CONFIGSYS_APP_DIR/ripgrep"  version: { github: BurntSushi/ripgrep  asset: "ripgrep-*-$ARCH-unknown-linux-musl.tar.gz" } }
                              { via: cargo  name: ripgrep  version: { crates: ripgrep } }  { via: brew  name: ripgrep } ] }   // prebuilt musl binary (rg in a versioned subdir); `cargo install ripgrep` as a pinnable alt
        fzf:     { attrs: [ CLI FOSS permissive ] suggests: fzf-glue  description: "Fuzzy finder — interactive filtering for files, history, anything piped in."
                   install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"   repo-component: universe }
                              { via: tarball  cpu-names: { x86_64: amd64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/fzf"  version: { github: junegunn/fzf  strip-v: true  asset: "fzf-*-linux_$ARCH.tar.gz" } }  { via: brew  name: fzf } ] }
        // television: a Rust fuzzy finder; the binary is `tv`. In Arch's official extra repo and a
        // brew formula (atomic); not in Debian/Fedora/openSUSE base repos -> cargo crate `television`
        // (installs `tv`) is the universal fallback everywhere else.
        television: { attrs: [ CLI TUI FOSS permissive ] suggests: television-dotfiles
                      description: "Television (`tv`) — a very fast, portable, hackable fuzzy finder TUI (Rust)."
                      install: [ { via: native  when: "arch or fedora_atomic" }
                                 { via: cargo  name: television  version: { crates: television } }  { via: brew  name: television } ] }
        television-dotfiles: { description: "Television config + cable channels, linked into place." install: [ { via: dotfiles  config: { src: television  dst: $XDG_CONFIG_HOME/television } } ] }
        xclip:   { attrs: [ CLI FOSS copyleft ] description: "xclip — command-line access to the X clipboard." suggests: xclip-glue
                   install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"   repo-component: universe }  { via: brew  name: xclip } ] }
        xclip-glue: { description: "xclip helper config, linked into place." install: [ { via: glue  requires: shell-glue  glue: xclip } ] }
        xsel:    { attrs: [ CLI FOSS permissive ] description: "xsel — command-line access to the X11 clipboard/PRIMARY selection."
                   install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"  repo-component: universe }  { via: brew  name: xsel } ] }   // EL via EPEL
        // wl-clipboard: Wayland clipboard; the binaries are `wl-copy`/`wl-paste` (no `wl-clipboard`).
        wl-clipboard: { attrs: [ CLI FOSS copyleft ] description: "wl-clipboard — copy/paste for Wayland (`wl-copy`/`wl-paste`)."
                   install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"  repo-component: universe }  { via: brew  name: wl-clipboard } ] }   // EL via EPEL
        // Xephyr — a nested X server (5 different package names; binary is always `Xephyr`;
        // openSUSE bundles it in xorg-x11-server-extra).
        xephyr: { attrs: [ GUI FOSS permissive ] description: "Xephyr — a nested X server (run an X session inside a window; `Xephyr`)."
                  install: [ { via: native  repo-component: universe  when: "not (fedora_atomic or amzn)"
                              name: { xbps: xorg-server-xephyr apt: xserver-xephyr  dnf: xorg-x11-server-Xephyr  pacman: xorg-server-xephyr  apk: xorg-server-xephyr  zypper: xorg-x11-server-extra } } ] }

        // --- more CLI utilities (modern + classic) ---
        zoxide: { attrs: [ CLI FOSS permissive ] suggests: zoxide-glue  description: "zoxide — a smarter `cd` that jumps by frecency to your most-used dirs (`z`)."
                  install: [ { via: native  repo-component: universe  when: "not (rhel or amzn)" }
                             { via: native  when: "rhel"  requires: epel }
                             // cargo everywhere (crate `zoxide`): the sole method on Amazon (no EPEL),
                             // and a pinnable path to a CURRENT zoxide on an old-distro apt — Ubuntu/Pop
                             // 22.04 ships 0.4.3, whose PROMPT_COMMAND hook returns 0 unconditionally
                             // (clobbers $? for a status-in-prompt); modern zoxide preserves $?.
                             { via: cargo   name: zoxide  version: { crates: zoxide } }  { via: brew  name: zoxide } ] }   // native (incl. brew) is the default; pin `zoxide cargo` for a newer build (crates: -> a "latest" from crates.io)
        zoxide-glue: { description: "zoxide shell init (adds the `z`/`zi` commands), linked into place." install: [ { via: glue  requires: shell-glue  glue: zoxide } ] }
        fd: { attrs: [ CLI FOSS permissive ] suggests: fd-glue  description: "fd — a fast, friendly `find` alternative (`fd`; Debian/Ubuntu install it as `fdfind`)."
              install: [ { via: native  repo-component: universe  when: "not (rhel or amzn)"  name: { apt: fd-find  dnf: fd-find  default: fd } }
                         { via: native  when: "rhel"  requires: epel  name: fd-find }
                         { via: cargo   name: fd-find  version: { crates: fd-find } }  { via: brew  name: fd } ] }   // cargo crate is `fd-find` (pinnable anywhere native isn't preferred); the Debian/Ubuntu pkg installs `fdfind` -> the glue aliases it to `fd`
        fd-glue: { description: "fd alias (fdfind->fd on Debian/Ubuntu), linked into place." install: [ { via: glue  requires: shell-glue  glue: fd } ] }
        pastel: { attrs: [ CLI FOSS permissive ] description: "pastel — generate, analyze, convert and manipulate colors from the command line."
                  install: [ { via: native  when: "arch or alpine or opensuse or fedora_atomic or void or void_musl" }
                             { via: cargo   name: pastel  version: { crates: pastel } }  { via: brew  name: pastel } ] }   // only arch/alpine/openSUSE(+brew) carry it in-repo (Debian/Fedora are sid/rawhide-only); cargo elsewhere
        dysk: { attrs: [ CLI FOSS permissive ] description: "dysk — a `df` alternative: mounted filesystems + usage in a clear table (formerly `lfs`)."
                install: [ { via: native  when: "arch or alpine or opensuse or fedora_atomic" }
                           { via: cargo   name: dysk  version: { crates: dysk } }  { via: brew  name: dysk } ] }   // Debian only has it in sid, Fedora/EL not at all -> cargo there
        stow: { attrs: [ CLI FOSS GNU copyleft ] description: "GNU Stow — a symlink farm manager for keeping dotfiles/packages tidy (`stow`)."
                install: [ { via: native  repo-component: universe  when: "not (rhel or amzn)" }
                           { via: native  when: "rhel"  requires: epel }  { via: brew  name: stow } ] }   // EL: EPEL-only; Alpine: community repo
        rsync: { attrs: [ CLI FOSS copyleft ] description: "rsync — fast incremental file transfer and synchronization." install: [ { via: native }  { via: brew  name: rsync } ] }   // core package on every family
        tree:  { attrs: [ CLI FOSS GNU copyleft ] description: "tree — list a directory as an indented tree." install: [ { via: native }  { via: brew  name: tree } ] }   // `tree` on every family
        eza:   { attrs: [ CLI FOSS copyleft ] suggests: eza-dotfiles  description: "eza — a modern, colorful `ls` replacement (the maintained fork of exa)."
                 install: [ { via: native  when: "void or void_musl" }  { via: native  when: "(fedora or arch or opensuse or alpine or fedora_atomic) and not amzn" }
                            { via: native  when: "(ubuntu >= 24.04) or (debian >= 13)"  repo-component: universe }   // only newer Debian/Ubuntu carry eza
                            { via: tarball  when: "not alpine"  installDir: "$CONFIGSYS_APP_DIR/eza"  requires: glibc
                              version: { github: eza-community/eza  strip-v: true  asset: "eza_$ARCH-unknown-linux-gnu.tar.gz" } }   // EUPL; older Debian/Ubuntu + EL/amzn -> tarball
                            { via: cargo  name: eza  version: { crates: eza } }  { via: brew  name: eza } ] }   // cargo as the universal build / pinnable alt
        eza-dotfiles: { description: "eza theme/config, linked into place." install: [ { via: dotfiles  config: { src: eza  dst: $XDG_CONFIG_HOME/eza } } ] }
        figlet: { attrs: [ CLI FOSS permissive ] description: "FIGlet — render text as large ASCII-art banners (`figlet`)."
                  install: [ { via: native  when: "not (rhel or amzn)" }
                             { via: native  when: "rhel"  requires: epel }  { via: brew  name: figlet } ] }   // EL via EPEL
        // --- terminal eye-candy / toys + a couple of terminal CLIs ---
        cbonsai:    { attrs: [ CLI FOSS GNU copyleft ] description: "cbonsai — a random bonsai-tree generator that draws in your terminal." install: [ { via: native  when: "fedora or alpine or opensuse or fedora_atomic or void or void_musl" }  { via: aur  name: cbonsai }  { via: brew  name: cbonsai } ] }   // GPL; Arch has it only in the AUR; not in Debian/EL repos -> declines there
        cmatrix:    { attrs: [ CLI FOSS GNU copyleft ] description: "cmatrix — the Matrix digital-rain screen effect for the terminal." install: [ { via: native }  { via: brew  name: cmatrix } ] }   // packaged on every family
        neo:        { attrs: [ TUI FOSS GNU copyleft ] description: "neo — Matrix-style digital rain in the terminal (`neo`; a modern cmatrix)."
                      install: [ { via: native  when: "(ubuntu >= 24.04) or (debian >= 12) or (elementary >= 8) or (linuxmint >= 22) or (lmde >= 6) or (mx >= 23) or (zorin >= 18) or pikaos or kali or fedora"  repo-component: universe  name: { apt: neo-cli  default: neo } }
                                 { via: aur  name: neo-matrix } ] }   // st3w/neo: Debian 12+/Ubuntu 24.04+ (neo-cli), Fedora; AUR on Arch; source-only elsewhere
        // pipes.sh: a self-contained bash script. Packaged only in the AUR; everywhere else install it
        // the upstream way (`make install`) into ~/.local — a single script + its manpage, no build.
        // The AUR binding wins on Arch by specificity; the unconditional script covers every other OS.
        pipes:      { attrs: [ CLI FOSS permissive ] description: "pipes.sh — the animated terminal pipes screensaver (`pipes.sh`)."
            install: [ { via: aur  name: pipes.sh }
                       { via: script  requires: [ git, make ]
                         install-cmd:   'tmp=$(mktemp -d) && git clone --depth 1 https://github.com/pipeseroni/pipes.sh "$tmp" && make -C "$tmp" install PREFIX="$HOME/.local" && rm -rf "$tmp"'
                         version-cmd:   'pipes.sh -v 2>/dev/null'
                         version-re:    '([0-9][0-9.]*)'
                         version:       { github: pipeseroni/pipes.sh  strip-v: true }
                         uninstall-cmd: 'rm -f "$HOME/.local/bin/pipes.sh" "$HOME/.local/share/man/man6/pipes.sh.6"'
                         location:      "~/.local/bin/pipes.sh" }  { via: brew  name: pipes-sh } ] }
        asciiquarium: { attrs: [ CLI FOSS GNU copyleft ] description: "Asciiquarium — an animated ASCII-art aquarium for the terminal." install: [ { via: native  when: "fedora and not amzn" }  { via: native  when: "rhel"  requires: epel }  { via: native  when: "arch or fedora_atomic or void or void_musl" }  { via: brew  name: asciiquarium } ] }   // dropped from Debian/Ubuntu repos; Fedora native, EL via EPEL, Arch [extra] (promoted from the AUR), brew on atomic (pulls perl Term::Animation, absent from Alpine/openSUSE)
        lolcat:     { attrs: [ CLI FOSS permissive ] description: "lolcat — rainbow-colorize any piped output (`lolcat`)." install: [ { via: native  when: "(debian or fedora or arch) and not amzn"  repo-component: universe }  { via: gem  name: lolcat }  { via: brew  name: lolcat } ] }   // the original is a Ruby gem -> gem covers openSUSE/Alpine/atomic + is pinnable anywhere
        asciinema:  { attrs: [ CLI FOSS GNU copyleft ] description: "asciinema — record and replay terminal sessions as lightweight casts (`asciinema rec`)." install: [ { via: native  repo-component: universe }  { via: pipx  name: asciinema }  { via: brew  name: asciinema } ] }   // native everywhere; pipx is the universal fallback + pinnable alt
        jrnl:       { attrs: [ CLI FOSS GNU copyleft ] suggests: jrnl-dotfiles  description: "jrnl — a plain-text, optionally-encrypted command-line journal (`jrnl`)." install: [ { via: pipx  name: jrnl }  { via: native  when: "fedora_atomic" }  { via: brew  name: jrnl } ] }   // Python app -> pipx everywhere; brew `jrnl` on atomic
        newsboat:   { attrs: [ TUI FOSS permissive ] suggests: newsboat-dotfiles  description: "Newsboat — an RSS/Atom feed reader for the terminal."
                      install: [ { via: native  when: "not ((ubuntu >= 24.04) and (ubuntu < 25.04))"  repo-component: universe }   // Rust; packaged on every family (no installable crate) — EXCEPT Ubuntu 24.x (dropped from noble; back in 25.04)
                                 { via: snap  name: newsboat  standing: never-auto }  { via: brew  name: newsboat } ] }   // the maintainer's snap: never-auto, so brew is the default where native isn't valid (24.x); pin the snap to use it
        lynx:  { attrs: [ CLI app FOSS copyleft ] description: "Lynx — the classic text-mode web browser."
                 install: [ { via: native  repo-component: universe  when: "not (rhel or amzn)" }
                            { via: native  when: "rhel"  requires: epel }  { via: brew  name: lynx } ] }   // EL: EPEL
        pass:  { attrs: [ CLI FOSS copyleft ] description: "pass — the standard unix password manager (a GPG-encrypted store, `pass`)."
                 install: [ { via: native  repo-component: universe  when: "not (rhel or amzn)"  name: { zypper: password-store  default: pass } }
                            { via: native  when: "rhel"  requires: epel }  { via: brew  name: pass } ] }   // openSUSE pkg is `password-store` (binary still `pass`); EL via EPEL
        gnupg: { attrs: [ CLI FOSS GNU copyleft ] description: "GnuPG (`gpg`) — OpenPGP encryption and signing." install: [ { via: native  name: { dnf: gnupg2  zypper: gpg2  default: gnupg } }  { via: brew  name: gnupg } ] }   // dnf=gnupg2, zypper=gpg2, else gnupg; binary `gpg`
        gh:    { attrs: [ CLI FOSS permissive account cloud ] description: "GitHub CLI — drive GitHub from the terminal (`gh`)."
                 install: [ { via: native  repo-component: universe  when: "not (rhel or opensuse or amzn)"  name: { xbps: github-cli pacman: github-cli  apk: github-cli  default: gh } }
                            { via: native-pkg-file  when: "rhel or opensuse or amzn"  version: { github: cli/cli }  asset: { rpm: { x86_64: "gh_*_linux_amd64.rpm" } } }  { via: brew  name: gh } ] }   // in-repo on debian/ubuntu(universe)/fedora/arch(github-cli)/alpine(github-cli)/brew; upstream .rpm for EL/openSUSE
        doppler: { attrs: [ CLI FOSS permissive account cloud ] description: "Doppler CLI — sync secrets and config across environments (`doppler`)."
                   install: [ { via: native-pkg-file  when: "debian"  version: { github: DopplerHQ/cli }  asset: { deb: { x86_64: "doppler_*_linux_amd64.deb" } } }
                              { via: native-pkg-file  when: "redhat or opensuse"  version: { github: DopplerHQ/cli }  asset: { rpm: { x86_64: "doppler_*_linux_amd64.rpm" } } }
                              { via: aur  name: doppler-cli-bin }  { via: brew  name: doppler } ] }   // not in distro repos; upstream ships .deb/.rpm; AUR pkg is `doppler-cli-bin`
        // bat: `cat` clone w/ highlighting. Debian/Ubuntu install the binary as `batcat` (name clash) ->
        // the glue aliases it to `bat`. EL via EPEL; amzn has neither -> cargo (crate is `bat`).
        bat: { attrs: [ CLI FOSS permissive ] suggests: bat-glue  description: "bat — a `cat` clone with syntax highlighting and git integration (Debian/Ubuntu install it as `batcat`)."
               install: [ { via: native  repo-component: universe  when: "not (rhel or amzn)" }
                          { via: native  when: "rhel"  requires: epel }
                          { via: cargo   name: bat  version: { crates: bat } }  { via: brew  name: bat } ] }
        bat-glue: { description: "bat alias (batcat->bat on Debian/Ubuntu), linked into place." install: [ { via: glue  requires: shell-glue  glue: bat } ] }
        // lm-sensors: hardware health (temps/voltages/fans). Package name drifts three ways; the binary
        // is always `sensors` (+ `sensors-detect`). In EL/Fedora base (no EPEL needed).
        lm-sensors: { attrs: [ CLI FOSS copyleft ] description: "lm-sensors — read hardware health sensors: temps, voltages, fans (`sensors`, `sensors-detect`)."
                      install: [ { via: native  when: "not fedora_atomic"  name: { xbps: lm_sensors dnf: lm_sensors  pacman: lm_sensors  zypper: sensors  default: lm-sensors } } ] }   // OS package only: brew does ship an lm-sensors formula, but sensors-detect loads kernel modules (system integration), so it isn't offered
        // lsblk: lists block devices; part of util-linux (essential/preinstalled on glibc distros).
        // Alpine splits it out as its own `lsblk` package (over busybox's limited applet).
        lsblk: { attrs: [ CLI FOSS copyleft ] description: "lsblk — list block devices as a tree (part of util-linux)."
                 install: [ { via: native  name: { apk: lsblk  default: util-linux } } ] }
        // needrestart: a Perl tool wired into apt/dnf; native only. In Debian/Ubuntu (main; Ubuntu
        // ships it by default) + Fedora, EL via EPEL, Arch via AUR. Not in openSUSE (its native check
        // is `zypper ps`) or Alpine (OpenRC); those + atomic decline.
        needrestart: { attrs: [ CLI FOSS GNU copyleft ]
            description: "needrestart — after an upgrade, reports (and can restart) services still running outdated libraries, and flags an outdated kernel."
            install: [ { via: native  when: "debian or fedora" }
                       { via: native  when: "rhel"  requires: epel }
                       { via: aur  } ] }
        // chafa: render images/animations in the terminal (ANSI/sixel/kitty). EL via EPEL.
        chafa: { attrs: [ CLI FOSS copyleft ] description: "chafa — display images (and gifs) in the terminal as ANSI/sixel/kitty graphics."
                 install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"  repo-component: universe }  { via: brew  name: chafa } ] }
        // pywal16 — maintained fork of pywal: generate & apply a 16-color scheme from an image. PyPI
        // only, isolated as a CLI via pipx. The binary is `wal` (not `pywal16`).
        pywal16: { attrs: [ CLI FOSS permissive ] description: "pywal16 — generate and apply 16-color schemes from an image (the `wal` command; maintained pywal fork)."
            // pywal16 >= 3.8.15 needs python >= 3.11; Debian-family ships an older system python, so
            // pin the venv to python3.13 there (pulled in as a dep) to reach current. Other families
            // default to a new-enough python already. (Same shape as mitmproxy.)
            install: [ { via: pipx  when: "debian"  name: pywal16  python: "/usr/bin/python3.13"  requires: python3.13 }
                       { via: pipx  when: "not debian"  name: pywal16 } ] }
        // fff: minimal Bash file manager. Upstream archived (dylanaraps) -> Debian/Ubuntu ship an old
        // 1.1 and Arch's AUR has 2.2; a `via: source` build (pure Bash `make install`) in the
        // configsys-source plugin covers Fedora/openSUSE/Alpine/EL.
        // fff is a single self-contained bash script; upstream is archived and it isn't packaged in
        // any apt/dnf/zypper repo — fetch the script straight from GitHub to ~/.local/bin (on PATH).
        fff: { attrs: [ TUI FOSS permissive legacy ] description: "fff — a fast, minimal terminal file manager written in Bash (`fff`)."
               install: [ { via: native  when: "void or void_musl" }  { via: script  when: "not arch"  requires: curl
                            install-cmd:   'mkdir -p "$HOME/.local/bin" && curl -fsSL https://raw.githubusercontent.com/dylanaraps/fff/master/fff -o "$HOME/.local/bin/fff" && chmod +x "$HOME/.local/bin/fff"'
                            version-cmd:   '"$HOME/.local/bin/fff" -v 2>/dev/null'
                            version-re:    '([0-9][0-9.]*)'
                            uninstall-cmd: 'rm -f "$HOME/.local/bin/fff"'
                            location:      '~/.local/bin/fff' }
                          { via: aur  name: fff } ] }

        // btop lives in EPEL on EL (needs epel enabled), base repos everywhere else.
        // Two native bindings: the EL one adds `requires: epel`; both are dnf\btop.
        btop: { attrs: [ TUI app FOSS permissive ] suggests: [ btop-dotfiles  btop-glue ] 
            description: "System-resource monitor — CPU/mem/net/disk in a colorful TUI."
            install: [
                { via: native  when: "rhel"  requires: epel }
                { via: native  when: "not amzn"   repo-component: universe }
                { via: tarball  cpu-names: { x86_64: x86_64  aarch64: aarch64 }  installDir: "$CONFIGSYS_APP_DIR/btop"  version: { github: aristocratos/btop  strip-v: true  asset: "btop-$ARCH-unknown-linux-musl.tar.gz" } }   // prebuilt musl binary (btop/bin/btop)
                { via: brew  name: btop }
            ]
        }
        // TMOG ("Task Manager OG", Dave Plummer): a closed-source Qt 6 GUI task manager (free edition; Pro is
        // paid). Not on GitHub — downloads from tmog.org, version scraped from its download links. glibc
        // >= 2.35 + libstdc++ 12; the .deb also needs system Qt >= 6.4 (Ubuntu 24.04+/Debian 12+), the
        // AppImage bundles Qt. Its only network call is an update check.
        tmog: { attrs: [ GUI app proprietary freeware freemium ] description: "TMOG — Task Manager OG, a classic Windows-style GUI task manager / system monitor (`tmog-task-manager`)."
            install: [ { via: aur  when: "arch"  name: tmog-bin }   // `when: "arch"`: keeps it ahead of the AppImage, whose version gate lists arch
                       { via: native-pkg-file  when: "(ubuntu >= 24.04) or (debian >= 12) or (elementary >= 8) or (linuxmint >= 22) or (lmde >= 6) or (mx >= 23) or (zorin >= 18) or pikaos or kali"  name: taskmanagerog  cpu-names: { x86_64: amd64  aarch64: arm64 }
                         version: { url: "https://tmog.org/"  regex: "TaskManagerOG-([0-9]+[.][0-9]+[.][0-9]+)-x86_64[.]AppImage" }
                         url: "https://tmog.org/rtm/downloads/TaskManagerOG-$VERSION-$ARCH.deb" }
                       { via: appImage  when: "arch or void or fedora or (rhel >= 10) or opensuse_tumbleweed or (opensuse_leap >= 16) or (ubuntu >= 22.04) or (debian >= 12) or (elementary >= 7) or (linuxmint >= 21) or (lmde >= 6) or (mx >= 23) or (zorin >= 17) or pikaos or kali"  cpu-names: { x86_64: x86_64  aarch64: aarch64 }  name: TMOG  scope: user
                         version: { url: "https://tmog.org/"  regex: "TaskManagerOG-([0-9]+[.][0-9]+[.][0-9]+)-x86_64[.]AppImage" }
                         url: "https://tmog.org/rtm/downloads/TaskManagerOG-$VERSION-$ARCH.AppImage"  path: ~/apps/tmog.appimage } ] }
        htop: { attrs: [ TUI app FOSS copyleft ] description: "Interactive process viewer — a colorful, friendlier top."
            suggests: htop-dotfiles
            install: [
                { via: native  when: "rhel"  requires: epel }   // EL ships htop in EPEL, like btop
                { via: native  repo-component: universe }
                { via: brew  name: htop }
            ]
        }
        htop-dotfiles: { description: "htop config, linked into place."
            install: [ { via: dotfiles  config: { src: htop  dst: $XDG_CONFIG_HOME/htop } } ]
        }

        // bottom (`btm`): Rust system monitor. Native `bottom` only where packaged (Arch, openSUSE,
        // Alpine, Homebrew); NOT in Debian/Ubuntu (upstream ships a .deb) nor Fedora/EL — name-sweep
        // confirmed the apt+dnf gaps — so cargo builds it on the whole debian + redhat families.
        bottom: { attrs: [ TUI app FOSS permissive ] suggests: bottom-dotfiles 
            description: "Cross-platform system monitor (`btm`) — CPU/mem/net/process/disk in a TUI."
            install: [
                { via: native  when: "not (redhat or debian)" }
                { via: cargo  name: bottom  version: { crates: bottom } }   // builds `btm`; covers Debian/Ubuntu + Fedora/EL
                { via: brew  name: bottom }
            ]
        }

        // --- extra system/process monitors ---
        atop: { attrs: [ TUI FOSS copyleft ] description: "atop — advanced system and process monitor with logging."
            install: [ { via: native  when: "debian or fedora or arch or opensuse or alpine or amzn or void or void_musl" }
                       { via: native  when: "rhel"  requires: epel }  { via: brew  name: atop } ] }   // EPEL on EL
        // iozone — filesystem I/O benchmark. apt package is `iozone3`; Arch via AUR. Free to use but
        // not OSI-licensed (source-available). NAMESWEEP PENDING (name varies).
        iozone: { attrs: [ CLI source-available ] description: "IOzone — filesystem I/O benchmark (sequential/random read & write across sizes)."
            install: [ { via: native  when: "debian or fedora"  name: { apt: iozone3  default: iozone } }
                       { via: aur  name: iozone } ] }   // not in openSUSE repos
        // --- benchmarks (disk / CPU / memory / GPU + a suite). Most are in-repo everywhere (EL via
        // EPEL); the graphics ones need a working GL/Vulkan stack at runtime. ---
        fio: { attrs: [ CLI FOSS GNU copyleft ] description: "fio — the Flexible I/O tester: the standard storage benchmark (Jens Axboe)."
            install: [ { via: native }  { via: brew  name: fio } ] }
        ioping: { attrs: [ CLI FOSS copyleft ] description: "ioping — measure disk I/O latency (like `ping`, for storage)."
            install: [ { via: native  when: "rhel"  requires: epel }
                       { via: native  when: "not rhel" }  { via: brew  name: ioping } ] }
        bonnie++: { attrs: [ CLI FOSS GNU copyleft ] description: "bonnie++ — a classic hard-drive and filesystem throughput benchmark."
            install: [ { via: native  when: "debian or fedora or arch or opensuse or void or void_musl" }
                       { via: native  when: "rhel"  requires: epel }  { via: brew  name: "bonnie++" } ] }   // Arch: [extra] (promoted from the AUR)
        sysbench: { attrs: [ CLI FOSS GNU copyleft ] description: "sysbench — a scriptable multi-threaded CPU / memory / threads / DB benchmark."
            install: [ { via: native  when: "rhel"  requires: epel }
                       { via: native  when: "not rhel" }  { via: brew  name: sysbench } ] }
        stress-ng: { attrs: [ CLI FOSS GNU copyleft ] description: "stress-ng — stress-test a system many ways and report per-stressor metrics (successor to `stress`)."
            install: [ { via: native  when: "rhel"  requires: epel }
                       { via: native  when: "not rhel" }  { via: brew  name: stress-ng } ] }
        // hyperfine — Rust; native in the newer repos, cargo covers EL/openSUSE/Amazon.
        hyperfine: { attrs: [ CLI FOSS permissive ] description: "hyperfine — a command-line benchmarking tool with statistics and warmup (`hyperfine`)."
            install: [ { via: native  when: "(debian or fedora or arch or alpine) and not amzn"  repo-component: universe }
                       { via: native  when: "fedora_atomic or void or void_musl" }        // brew formula `hyperfine`
                       { via: cargo   name: hyperfine  requires: cargo  version: { crates: hyperfine } }  { via: brew  name: hyperfine } ] }
        mbw: { attrs: [ CLI FOSS permissive ] description: "mbw — a simple memory-bandwidth (memcpy) benchmark."
            install: [ { via: native  when: "debian" }
                       { via: native  when: "fedora_atomic" }        // brew formula `mbw`
                       { via: aur  }  { via: brew  name: mbw } ] }   // niche: Debian/brew/AUR; declines elsewhere
        glmark2: { attrs: [ GUI FOSS GNU copyleft ] description: "glmark2 — an OpenGL (ES) 2.0 rendering benchmark."
            install: [ { via: native  when: "rhel"  requires: epel }
                       { via: native  when: "not rhel and not alpine"  repo-component: universe } ] }   // not packaged on alpine
        vkmark: { attrs: [ GUI FOSS GNU copyleft ] description: "vkmark — an extensible Vulkan benchmark with configurable scenes."
            install: [ { via: native  when: "debian or fedora or arch or opensuse" } ] }   // needs a Vulkan driver at runtime; not packaged on alpine/atomic/amzn
        // Phoronix Test Suite — the big automated benchmark orchestrator. Only hard dep is PHP (CLI +
        // DOM). In-repo on most distros (EL via EPEL, Arch via AUR); Amazon/atomic decline.
        phoronix-test-suite: { attrs: [ CLI app FOSS GNU copyleft ] description: "Phoronix Test Suite — automated cross-platform benchmarking/orchestration (`phoronix-test-suite`)." requires: php
            install: [ { via: native  when: "void or void_musl" }  { via: native  when: "(fedora or opensuse) and not amzn" }   // absent from Ubuntu 24.04 & Alpine repos; Debian-family/alpine build from upstream instead
                       { via: native  when: "rhel"  requires: epel }
                       { via: aur  }  { via: brew  name: phoronix-test-suite } ] }
        // --- HTTP load / throughput testers (peers of jmeter; grouped here as perf tools) ---
        // k6 — native on Arch/Alpine + brew; Grafana's own apt/dnf repos on debian/redhat.
        k6: { attrs: [ CLI FOSS copyleft ] description: "Grafana k6 — a modern load-testing tool scripted in JavaScript (`k6`)."
            install: [ { via: aur  name: k6 }     // not in extra/community anymore; AUR: k6
                       { via: native  when: "fedora_atomic" }      // brew formula `k6`
                       { via: native  when: "debian"  name: k6     // Grafana's official apt repo
                         pubkey-url: "https://dl.k6.io/key.gpg"  pubkey-path: /usr/share/keyrings/k6.asc
                         source-line: "deb [signed-by=/usr/share/keyrings/k6.asc] https://dl.k6.io/deb stable main"
                         source-path: /etc/apt/sources.list.d/k6.list }
                       { via: native  when: "redhat"  name: k6     // Grafana's official dnf repo (covers Fedora/EL/Amazon)
                         pubkey-url: "https://dl.k6.io/key.gpg"
                         repo-id: k6  repo-name: "k6"  repo-url: "https://dl.k6.io/rpm" }  { via: brew  name: k6 } ] }
        hey: { attrs: [ CLI FOSS permissive ] description: "hey — a tiny HTTP load generator (`hey`)."
            install: [ { via: native  when: "fedora_atomic or void or void_musl" }      // brew formula `hey`
                       { via: go-install  name: "github.com/rakyll/hey"  requires: go }  { via: brew  name: hey } ] }
        wrk: { attrs: [ CLI FOSS permissive ] description: "wrk — a modern, multithreaded HTTP benchmarking tool."
            install: [ { via: native  when: "alpine or opensuse or void or void_musl" }
                       { via: native  when: "fedora_atomic" }      // brew formula `wrk`
                       { via: aur  name: wrk }  { via: brew  name: wrk } ] }   // debian/EL/Fedora: not packaged -> build wg/wrk from source
        vegeta: { attrs: [ CLI FOSS permissive ] description: "Vegeta — a versatile HTTP load-testing tool driven by a constant request rate (`vegeta`)."
            install: [ { via: native  when: "arch or fedora_atomic or void or void_musl" }      // Arch [extra] (promoted from the AUR); brew formula `vegeta` on atomic
                       { via: tarball  when: "not (arch or fedora_atomic)"  cpu-names: { x86_64: amd64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/vegeta"
                         version: { github: tsenart/vegeta  strip-v: true  asset: "vegeta_*_linux_$ARCH.tar.gz" } }  { via: brew  name: vegeta } ] }

        // --- proprietary cross-platform benchmarks (best-effort) ---
        // Geekbench 6 — free to run, uploads results to geekbench.com by default. Flathub is the clean
        // universal method; a CLI tarball (cdn.geekbench.com, version scraped from the download page)
        // and the AUR package are alternatives. Binary `geekbench6`.
        geekbench: { attrs: [ CLI GUI proprietary freeware online ] description: "Geekbench 6 — Primate Labs' cross-platform CPU & GPU benchmark (`geekbench6`; uploads results online)."
            install: [ { via: flatpak  hub: flathub  app: com.geekbench.Geekbench6 }
                       { via: aur  name: geekbench }
                       { via: tarball  when: "not arch"  installDir: "$CONFIGSYS_APP_DIR/geekbench"  requires: [ glibc, curl ]
                         version: { url: "https://www.geekbench.com/download/linux/"  regex: "Geekbench-([0-9.]+)-Linux" }
                         url: "https://cdn.geekbench.com/Geekbench-$VERSION-Linux.tar.gz" } ] }
        // UNIGINE GPU benchmarks — proprietary, ~1.5GB self-extracting .run installers. The only
        // packaged route is the AUR (known-flaky PKGBUILDs); elsewhere it's a manual download from
        // unigine.com, so they decline honestly off Arch (the `swift` shape). Superposition is
        // current; Heaven/Valley are the widely-used classics.
        unigine-superposition: { attrs: [ GUI game proprietary freeware ] description: "UNIGINE Superposition — a heavy GPU / VRAM stress benchmark (proprietary)."
            install: [ { via: aur  name: unigine-superposition } ] }
        unigine-heaven: { attrs: [ GUI game proprietary freeware ] description: "UNIGINE Heaven — the classic tessellation-heavy GPU benchmark (proprietary)."
            install: [ { via: aur  name: unigine-heaven } ] }
        unigine-valley: { attrs: [ GUI game proprietary freeware ] description: "UNIGINE Valley — the classic forested-valley GPU benchmark (proprietary)."
            install: [ { via: aur  name: unigine-valley } ] }
        iotop: { attrs: [ TUI FOSS copyleft ] description: "iotop — a per-process disk I/O monitor."
            install: [ { via: native  when: "fedora or void or void_musl"  name: iotop-c }   // Fedora dropped the Python `iotop` for the C rewrite `iotop-c`
                       { via: native  when: "debian or rhel or arch or opensuse or alpine or amzn"  name: iotop } ] }
        s-tui: { attrs: [ TUI app FOSS copyleft ] description: "s-tui — a terminal UI for CPU frequency/temperature/power and stress testing."
            install: [ { via: native  when: "debian or fedora or arch or opensuse or alpine" }
                       { via: pipx  name: s-tui } ] }   // Python app; pipx covers EL/Amazon/atomic (not in EPEL)
        glances: { attrs: [ TUI FOSS copyleft ] suggests: glances-dotfiles  description: "Glances — a cross-platform curses system monitor (`glances`)."
            install: [ { via: native  when: "debian or fedora or arch or alpine or void or void_musl" }
                       { via: native  when: "rhel"  requires: epel }
                       { via: pipx  name: glances }  { via: brew  name: glances } ] }   // Python; pipx covers openSUSE/Amazon/atomic
        glances-dotfiles: { description: "glances config, linked into place." install: [ { via: dotfiles  config: { src: glances  dst: $XDG_CONFIG_HOME/glances } } ] }
        nvtop: { attrs: [ TUI FOSS copyleft ] description: "nvtop — a GPU process monitor for NVIDIA/AMD/Intel (an `htop` for GPUs)."
            install: [ { via: native  when: "debian or fedora or arch or opensuse or void or void_musl"  repo-component: universe }
                       { via: native  when: "rhel"  requires: epel } ] }   // not in Alpine/Amazon base
        /* sysdig is not bheaving with my kernel--need to investigate
        sysdig: { description: "sysdig — system exploration and troubleshooting (ships `sysdig` + the `csysdig` curses UI)."
            install: [ { via: native  when: "debian or arch or opensuse"  repo-component: universe } ] }   // Fedora/EL only via the upstream Falco repo (not modeled); absent from Alpine/Amazon
        */
        dstat: { attrs: [ CLI FOSS copyleft ] description: "dstat — versatile system resource statistics (deprecated upstream; Arch/openSUSE ship the `dool` fork, binary `dool`)."
            install: [ { via: native  when: "debian or void or void_musl"  name: dstat }
                       { via: native  when: "arch or opensuse"  name: dool } ] }   // dropped from Fedora/EL/Alpine; the dool fork replaces it on Arch/openSUSE

        // ncdu: NCurses disk-usage analyzer. Packaged as `ncdu` in every base repo (EL via EPEL,
        // Ubuntu universe — the htop/btop pattern).
        ncdu: { attrs: [ TUI FOSS permissive ]
            description: "NCurses disk-usage analyzer — find what's eating your disk (`ncdu`)."
            install: [
                { via: native  when: "rhel"  requires: epel }
                { via: native  when: "not amzn"   repo-component: universe }
                { via: brew  name: ncdu }
            ]
        }

        // duf: a colorful, friendlier `df` (Go). Native where packaged (Debian 12+/Ubuntu universe,
        // Fedora, Arch, openSUSE, Homebrew); NOT in Alpine's repos and no EL package, so `go install`
        // builds it there (name-sweep confirmed the apk gap).
        duf: { attrs: [ CLI FOSS permissive ]
            description: "Disk Usage/Free — a colorful, friendlier `df` (`duf`)."
            install: [
                { via: native  when: "(not (rhel or alpine)) and not amzn"  repo-component: universe }
                { via: go-install  name: "github.com/muesli/duf" }   // builds `duf`; covers EL + Alpine
                { via: brew  name: duf }
            ]
        }

        configsys-glue: { description: "configsys's own shell integration, linked into place."
            install: [
                // 00- prefix: the ~/.bash.d loader sources files in lexical order, so this runs
                // FIRST and its CONFIGSYS_*_DIR exports are available to every other snippet.
                { via: glue  requires: shell-glue  glue: 00-configsys }
            ]
        }

        // --- shells & terminal multiplexers ---
        // tmux/zsh/fish are packaged under the same name in every distro's base repos.
        tmux: { attrs: [ CLI FOSS permissive ] description: "Terminal multiplexer — split panes and detachable sessions."
                suggests: tmux-dotfiles
                install: [ { via: native }  { via: brew  name: tmux } ] }
        tmux-dotfiles: { description: "tmux config, linked into place."
                install: [ { via: dotfiles  config: { src: tmux  dst: $XDG_CONFIG_HOME/tmux } } ] }
        // sesh: a smart tmux session manager (Go). AUR `sesh-bin` on Arch, brew on atomic; a static
        // Go release tarball runs everywhere else (incl. musl/Alpine) — not in the distro base repos.
        sesh: { attrs: [ CLI FOSS permissive ] suggests: sesh-dotfiles
                description: "sesh — a smart tmux session manager: fuzzy-pick, create and switch sessions by zoxide frecency / git repo."
                install: [ { via: aur  name: sesh-bin }
                           { via: native  when: "fedora_atomic" }
                           { via: tarball  cpu-names: { x86_64: x86_64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/sesh"
                             version: { github: joshmedeski/sesh  strip-v: true  asset: "sesh_Linux_$ARCH.tar.gz" } }  { via: brew  name: sesh } ] }
        sesh-dotfiles: { description: "sesh config (sesh.toml), linked into place." install: [ { via: dotfiles  config: { src: sesh  dst: $XDG_CONFIG_HOME/sesh } } ] }
        // gum: Charm's toolkit for glamorous shell scripts (Go). Native in Fedora, Arch, Alpine (and
        // EL via EPEL), brew on atomic; Charm's official apt repo on Debian/Ubuntu; a static Go
        // release tarball covers the rest (openSUSE, Amazon Linux).
        gum: { attrs: [ CLI TUI FOSS permissive ]
               description: "gum — Charm's toolkit for glamorous shell scripts (interactive prompts, spinners, filtering, styling)."
               install: [ { via: native  when: "fedora or arch or alpine or void or void_musl" }
                          { via: native  when: "rhel"  requires: epel }
                          { via: native  when: "fedora_atomic" }
                          { via: native  when: "debian"  name: gum   // Charm's official apt repo
                            pubkey-url: "https://repo.charm.sh/apt/gpg.key"
                            pubkey-path: /usr/share/keyrings/charm.asc   // Charm ships an ARMORED key -> .asc (apt reads armored via signed-by; a .gpg-named armored file fails "not signed")
                            source-line: "deb [signed-by=/usr/share/keyrings/charm.asc] https://repo.charm.sh/apt/ * *"
                            source-path: /etc/apt/sources.list.d/charm.list }
                          { via: tarball  cpu-names: { x86_64: x86_64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/gum"
                            version: { github: charmbracelet/gum  strip-v: true  asset: "gum_*_Linux_$ARCH.tar.gz" } }  { via: brew  name: gum } ] }
        zsh:  { attrs: [ CLI FOSS permissive ] suggests: [ zsh-dotfiles, shell-glue ]  description: "Z shell — a powerful interactive shell." install: [ { via: native }  { via: brew  name: zsh } ] }
        fish: { attrs: [ CLI FOSS copyleft ] suggests: [ fish-dotfiles, shell-glue, bass ]  description: "Friendly interactive shell — smart autosuggestions out of the box." install: [ { via: native  name: { xbps: fish-shell }  when: "not amzn"  }  { via: brew  name: fish } ] }
        // bass: a fish plugin (two files into ~/.config/fish/functions/) that runs bash utilities and
        // sources bash env scripts from fish, importing the resulting env. The bridge for fish glue
        // whose tool only ships a BASH env script (sdkman/vulkan-sdk/gnustep) — those snippets call it
        // guarded by `type -q bass`, so it's optional. Needs python3 (baseline) for its __bass.py helper.
        bass: { attrs: [ CLI FOSS permissive ]  requires: [ fish, curl ]
            description: "bass — use bash utilities and source bash env scripts from within fish (imports env)."
            install: [ { via: script
                install-cmd:   'mkdir -p "$HOME/.config/fish/functions" && for _f in bass.fish __bass.py; do curl -fsSL "https://raw.githubusercontent.com/edc/bass/master/functions/$_f" -o "$HOME/.config/fish/functions/$_f"; done'
                version-cmd:   'test -f "$HOME/.config/fish/functions/bass.fish" && echo installed'
                version-re:    '(installed)'
                uninstall-cmd: 'rm -f "$HOME/.config/fish/functions/bass.fish" "$HOME/.config/fish/functions/__bass.py"' } ] }
        // nushell isn't in Debian/Ubuntu/Fedora base repos; native where it is (Arch, Homebrew),
        // else the upstream glibc release tarball (ships `nu` + its plugins).
        // No nushell-dotfiles: nushell is a GESTALT/inline glue shell (like elvish) — its config.nu
        // carries the dynamically-regenerated glue block, so it must be glue-owned and can't be a
        // dotfile capture (capturing freezes the block). Nushell can't dynamically source a dir of
        // snippets: it parses the whole program up front, so `source` needs a parse-time-constant
        // path — no conf.d loop is possible. So the block INLINES the snippets. (See the glue driver.)
        nushell: { attrs: [ CLI FOSS permissive ] suggests: [ nushell-glue ]
            description: "A shell whose pipelines carry structured data, not just text (`nu`)."
            install: [
                { via: native  when: "arch or void or void_musl" }
                { via: native  when: "fedora_atomic" }              // brew formula `nushell`
                { via: tarball  when: "not alpine"  cpu-names: { x86_64: x86_64  aarch64: aarch64 }  installDir: "$CONFIGSYS_APP_DIR/nushell"  requires: glibc
                  version: { github: nushell/nushell  strip-v: true  asset: "nu-*-$ARCH-unknown-linux-gnu.tar.gz" } }
                { via: tarball  when: "alpine"  cpu-names: { x86_64: x86_64  aarch64: aarch64 }  installDir: "$CONFIGSYS_APP_DIR/nushell"   // musl build for Alpine (the gnu one needs glibc)
                  version: { github: nushell/nushell  strip-v: true  asset: "nu-*-$ARCH-unknown-linux-musl.tar.gz" } }
                { via: cargo  name: nu  version: { crates: nu } }                            // `cargo install nu` (the crate is `nu`)
                { via: brew  name: nushell }   // brew `nu` is a different language
            ]
        }
        // elvish: an expressive language + interactive shell (Go, static binary). Native in
        // Debian/Fedora/Arch/Alpine/openSUSE and brew; the upstream static release tarball covers
        // EL/Amazon (and runs on musl too). Onboarded as a first-class glue shell (see the glue driver).
        elvish: { attrs: [ CLI FOSS permissive ] suggests: [ shell-glue, elvish-glue ]
            description: "Elvish — an expressive programming language and a versatile interactive shell (`elvish`)."
            install: [
                { via: native  when: "not (rhel or amzn or opensuse)" }   // not in openSUSE (zypper) -> tarball
                // elvish ships binaries via dl.elv.sh, NOT GitHub release assets (those are empty) --
                // so a direct url (elvish-v<version>.tar.gz), version discovered from the github tags.
                // Static Go build -> one binary runs on glibc AND musl, so no alpine split. (x86_64.)
                { via: tarball  cpu-names: { x86_64: amd64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/elvish"
                  version: { github: elves/elvish  strip-v: true }
                  url: "https://dl.elv.sh/linux-$ARCH/elvish-v$VERSION.tar.gz" }
                { via: brew  name: elvish }
            ] }
        // No elvish-dotfiles: elvish's rc.elv IS the glue gestalt block (dynamically regenerated on
        // every (de)activation), so it must be GLUE-OWNED and can't be a dotfile capture (capturing
        // freezes the block). Elvish is glue-only, like bash (which likewise has no bash-dotfiles).
        // elvish-glue puts the tarball-installed elvish on PATH (from bash/zsh/fish) so `elvish`
        // execs AND `which elvish` detects it as an installed shell (which is what makes its OWN glue
        // appear). A shell must be on PATH, not aliased. No-op where elvish is native on PATH.
        elvish-glue: { description: "elvish PATH setup (tarball binary), linked into place." install: [ { via: glue  requires: shell-glue  glue: elvish } ] }

        // zellij: Rust terminal workspace/multiplexer. Native on Arch/Fedora + brew; the upstream
        // musl static tarball covers Debian/Ubuntu/openSUSE/EL/Alpine (one binary, runs everywhere);
        // cargo is a pinnable build-from-crate alternate. (native on more distros -> broaden after a name-sweep.)
        zellij: { attrs: [ CLI TUI FOSS permissive ] suggests: [ zellij-dotfiles, zellij-glue ]
            description: "Zellij — a terminal workspace & multiplexer with batteries included."
            install: [
                { via: native  when: "arch or void or void_musl" }                        // Fedora is COPR-only -> tarball covers it
                { via: native  when: "fedora_atomic" }               // brew formula `zellij`
                { via: tarball  cpu-names: { x86_64: x86_64  aarch64: aarch64 }  installDir: "$CONFIGSYS_APP_DIR/zellij"   // musl static -> covers everything else, incl. Alpine
                  version: { github: zellij-org/zellij  strip-v: true  asset: "zellij-$ARCH-unknown-linux-musl.tar.gz" } }
                { via: cargo  name: zellij  standing: never-auto  version: { crates: zellij } }
                { via: brew  name: zellij }
            ] }
        // Terminal multiplexers for AI-agent workflows. Both ship STATIC release binaries (herdr: musl; tuios:
        // CGO-off Go), so the tarball runs everywhere incl. musl; brew formulas on atomic; AUR on Arch.
        herdr: { attrs: [ TUI app FOSS permissive ] suggests: [ herdr-dotfiles  herdr-glue ]
            description: "herdr — a terminal multiplexer built for AI coding agents (persistent panes, agent state, socket API)."
            install: [ { via: native  when: "fedora_atomic" }
                       { via: aur  name: herdr-bin }
                       { via: tarball  archive: none  binary: herdr  cpu-names: { x86_64: x86_64  aarch64: aarch64 }  installDir: "$CONFIGSYS_APP_DIR/herdr"
                         version: { github: herdrdev/herdr  strip-v: true  asset: "herdr-linux-$ARCH" } }  { via: brew  name: herdr } ] }   // the crates.io `herdr` is a stale unrelated 0.1.0 — not used
        herdr-glue: { description: "herdr PATH alias (tarball binary), linked into place." install: [ { via: glue  requires: shell-glue  glue: herdr } ] }
        herdr-dotfiles: { description: "herdr config (config.toml), linked into place." install: [ { via: dotfiles  config: { src: herdr  dst: $XDG_CONFIG_HOME/herdr } } ] }
        tuios: { attrs: [ TUI app FOSS permissive ] suggests: [ tuios-dotfiles  tuios-glue ]
            description: "tuios — a terminal window manager: tiling panes, workspaces, persistent sessions (`tuios`)."
            install: [ { via: native  when: "fedora_atomic" }
                       { via: aur  name: tuios-bin }
                       { via: tarball  cpu-names: { x86_64: x86_64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/tuios"
                         version: { github: Gaurav-Gosain/tuios  strip-v: true  asset: "tuios_*_Linux_$ARCH.tar.gz" } }
                       { via: go-install  name: "github.com/Gaurav-Gosain/tuios/cmd/tuios"  requires: [ { go: ">=1.26.6" } ]  standing: never-auto }  { via: brew  name: tuios } ] }   // Alpine testing's 0.6.0 is stale -> tarball there
        tuios-glue: { description: "tuios PATH alias (tarball binary), linked into place." install: [ { via: glue  requires: shell-glue  glue: tuios } ] }
        tuios-dotfiles: { description: "tuios config (config.toml, config.d/, plugins/), linked into place." install: [ { via: dotfiles  config: { src: tuios  dst: $XDG_CONFIG_HOME/tuios } } ] }
        zellij-dotfiles: { description: "Zellij config, linked into place."
            install: [ { via: dotfiles  config: { src: zellij  dst: $XDG_CONFIG_HOME/zellij } } ] }
        // zellij-glue aliases the tarball binary ($CONFIGSYS_APP_DIR/zellij/zellij) onto PATH — the
        // tarball is the resolved method on Debian/Ubuntu/Pop/openSUSE/EL, where nothing else puts it
        // there. No-op where zellij is native (arch/brew) and already on PATH.
        zellij-glue: { description: "zellij PATH alias (tarball binary), linked into place."
            install: [ { via: glue  requires: shell-glue  glue: zellij } ] }

        // atuin: magical shell history (Rust). Native on Arch/Fedora + brew; cargo is the reliable
        // universal fallback everywhere else (openSUSE/EL/Alpine/Debian-older). Shell integration
        // (Up-arrow / Ctrl-R) is enabled via its glue snippet. (broaden native after a name-sweep.)
        atuin: { attrs: [ CLI FOSS permissive ] suggests: [ atuin-glue ]
            description: "Atuin — magical shell history: SQLite-backed, searchable, syncable (`atuin`)."
            install: [
                { via: native  when: "arch or fedora or void or void_musl" }
                { via: native  when: "fedora_atomic" }               // brew formula `atuin`
                { via: cargo   name: atuin  version: { crates: atuin } }                          // build-from-crate; covers the rest
                { via: brew  name: atuin }
            ] }
        atuin-glue: { description: "atuin shell init (Up-arrow / Ctrl-R history search), linked into place."
            install: [ { via: glue  requires: shell-glue  glue: atuin } ] }

        // tuxedo: a fast todo.txt TUI (Rust). NOT on crates.io (so no `cargo install`); brew on
        // atomic. Upstream ships ONLY a gnu tarball (no musl), and the current build needs glibc >= 2.39
        // — so the tarball is gated to the OS versions that ship it (rolling distros + Ubuntu 24.04 /
        // Debian 13 / Fedora 40+); on older glibc (Pop/Ubuntu 22.04, Debian <=12, EL, openSUSE Leap) it
        // has no working method and DECLINES honestly rather than install a binary that won't run.
        tuxedo: { attrs: [ CLI TUI FOSS permissive ] suggests: tuxedo-glue
            description: "tuxedo — a fast, keyboard-driven terminal UI for todo.txt (`tuxedo`)."
            install: [
                { via: native  when: "fedora_atomic" }               // brew formula `tuxedo`
                { via: tarball  when: "arch or (fedora >= 40) or opensuse_tumbleweed or (ubuntu >= 24.04) or (debian >= 13) or void"
                  installDir: "$CONFIGSYS_APP_DIR/tuxedo"  requires: glibc   // gnu build; glibc >= 2.39 (see note above)
                  version: { github: webstonehq/tuxedo  strip-v: true  asset: "tuxedo-*-$ARCH-unknown-linux-gnu.tar.gz" } }
                { via: brew  name: tuxedo }
            ] }
        // tuxedo-glue aliases the tarball binary (nested tuxedo-<ver>-<triple>/tuxedo) onto PATH; no-op
        // where tuxedo is native (brew) and already on PATH.
        tuxedo-glue: { description: "tuxedo PATH alias (tarball binary), linked into place."
            install: [ { via: glue  requires: shell-glue  glue: tuxedo } ] }

        // leaf: a terminal Markdown previewer with a GUI-like experience (Rust). Not in distro repos;
        // the crate is `leaf-markdown-viewer` (the binary is `leaf`), so cargo covers every OS.
        leaf: { attrs: [ CLI TUI FOSS permissive ]
            description: "leaf — a terminal Markdown previewer with a GUI-like experience (`leaf`)."
            install: [ { via: cargo  name: leaf-markdown-viewer  version: { crates: leaf-markdown-viewer } }  { via: brew  name: leaf-markdown-viewer } ] }   // brew leaf-markdown-viewer (brew's `leaf` is a different project)

        // ghgrab: a TUI to browse & cherry-pick files/release-assets from GitHub/GitLab/Codeberg/
        // Gitea/Forgejo without cloning (Rust). Not in distro repos -> cargo everywhere (crate `ghgrab`).
        ghgrab: { attrs: [ CLI TUI FOSS permissive ]
            description: "ghgrab — download individual files, folders or release assets from git forges without cloning (`ghgrab`)."
            install: [ { via: cargo  name: ghgrab  version: { crates: ghgrab } } ] }

        // lazyrsync: a friendly TUI for rsync — reusable profiles, dry-run diffs, live progress (Rust).
        // Drives the real rsync (hard requires it). AUR on Arch, brew on atomic, cargo elsewhere.
        lazyrsync: { attrs: [ CLI TUI FOSS permissive ]  requires: rsync
            description: "lazyrsync — a friendly terminal UI for rsync: profiles, dry-run diffs, live progress, even over SSH (`lazyrsync`)."
            install: [
                { via: aur  name: lazyrsync }
                { via: native  when: "fedora_atomic" }               // brew formula `lazyrsync`
                { via: cargo   name: lazyrsync  version: { crates: lazyrsync } }                      // build-from-crate; covers the rest
                { via: brew  name: lazyrsync }
            ] }

        // kew: an immersive terminal music player (C). Native on Debian/Arch/openSUSE + brew; NOT in
        // Fedora dnf (name-sweep confirmed) and upstream ships no Linux release binary, so it declines
        // on Fedora/EL/Alpine (no method there).
        kew: { attrs: [ TUI app FOSS GPL ]  suggests: kew-dotfiles
            description: "kew — a fast, immersive terminal music player (`kew`)."
            install: [ { via: native  when: "debian or arch or opensuse or void or void_musl" }   // not in Fedora dnf; no Linux release binary -> declines on Fedora/EL/Alpine
                       { via: native  when: "fedora_atomic" }  { via: brew  name: kew } ] }    // brew formula `kew` (Linux)
        // cliamp: a Winamp-style terminal music player (Go). Not in distro repos: the upstream raw binary
        // (glibc >= 2.34; links libasound — present on any desktop), AUR on Arch. No `go install`: its v2
        // tags lack a /v2 module path, so the Go proxy only serves the stale v1.63. Optional ffmpeg / yt-dlp widen codecs/sources.
        cliamp: { attrs: [ TUI app FOSS permissive ] suggests: [ cliamp-dotfiles  cliamp-glue ]
            description: "cliamp — a Winamp-inspired terminal music player (local files, radio, streaming services)."
            install: [ { via: aur  name: cliamp-bin }
                       { via: tarball  archive: none  binary: cliamp  cpu-names: { x86_64: amd64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/cliamp"  requires: glibc
                         version: { github: bjarneo/cliamp  strip-v: true  asset: "cliamp-linux-$ARCH" } } ] }
        cliamp-glue: { description: "cliamp PATH alias (tarball binary), linked into place." install: [ { via: glue  requires: shell-glue  glue: cliamp } ] }
        cliamp-dotfiles: { description: "cliamp config (config.toml, radios.toml, plugins), linked into place." install: [ { via: dotfiles  config: { src: cliamp  dst: $XDG_CONFIG_HOME/cliamp } } ] }
        kew-dotfiles: { description: "kew config, linked into place."
            install: [ { via: dotfiles  config: { src: kew  dst: $XDG_CONFIG_HOME/kew } } ] }

        // rclone: sync/manage files across 70+ cloud storage providers. Packaged natively in every
        // base repo (apt/dnf/pacman/zypper/apk) and brew — no fallback needed. Its config holds
        // credentials, so no -dotfiles companion (never reposit secrets).
        rclone: { attrs: [ CLI FOSS permissive online ]
            description: "rclone — rsync for cloud storage: sync & manage files across 70+ providers (`rclone`)."
            install: [ { via: native }  { via: brew  name: rclone } ] }

        // --- terminal emulators & TUI file managers ---
        // kitty: GPU-accelerated terminal emulator, packaged natively across every base repo
        // (apt/dnf/pacman/zypper/apk all carry `kitty`).
        kitty: { attrs: [ GUI app FOSS copyleft ] suggests: kitty-dotfiles  description: "Fast, GPU-accelerated terminal emulator." install: [ { via: native  when: "not amzn"  } ] }
        // ghostty: Zig terminal emulator. The only official native package among our managers is
        // Arch's (openSUSE dropped it over Zig-version churn, Fedora is COPR-only, Debian is
        // community-only, and it's absent from Alpine's community repo — name sweep confirmed) — so
        // native is gated to arch and everywhere else falls back to the community "universal"
        // AppImage (pkgforge-dev; glibc/fuse2, unpacked under ~/apps). Musl-only boxes (Alpine)
        // have no verified method, so ghostty simply declines there. The `asset` glob discovers the
        // real download URL from the GitHub API (no hand-templated url).
        ghostty: { attrs: [ GUI FOSS permissive ] suggests: [ ghostty-dotfiles  ghostty-glue ]  description: "Fast, native GPU-accelerated terminal emulator."
            install: [
                { via: native  when: "arch or void or void_musl" }
                { via: appImage  name: Ghostty  scope: user
                  version: { github: pkgforge-dev/ghostty-appimage  strip-v: true  asset: "Ghostty-*-$ARCH.AppImage" }
                  path: ~/apps/ghostty.appimage }
            ]
        }
        // alacritty: Rust GPU terminal. Native in the big-four repo families (Ubuntu universe /
        // Fedora / Arch / openSUSE); it's NOT in EPEL and has no Flathub app, so EL / Amazon /
        // atomic / musl-Alpine fall back to a crates.io build (needs the usual freetype/fontconfig
        // -dev libs + a windowing stack — best-effort).
        alacritty: { attrs: [ GUI app FOSS permissive ] suggests: alacritty-dotfiles  description: "Alacritty — a fast, GPU-accelerated terminal emulator."
            install: [
                { via: native  when: "debian or fedora or arch or opensuse or void or void_musl"  repo-component: universe }
                { via: cargo   name: alacritty  version: { crates: alacritty } } ]
        }
        alacritty-dotfiles: { description: "alacritty config, linked into place." install: [ { via: dotfiles  config: { src: alacritty  dst: $XDG_CONFIG_HOME/alacritty } } ] }
        // wezterm: GPU terminal + multiplexer. Official native on Arch + openSUSE; everywhere else
        // the Flathub flatpak (upstream marks no GitHub "latest" release — date-tagged pre-releases
        // only — so there's no clean .deb/.rpm pin to track).
        wezterm: { attrs: [ GUI app FOSS permissive ] suggests: wezterm-dotfiles  description: "WezTerm — a GPU-accelerated cross-platform terminal emulator + multiplexer (`wezterm`)."
            install: [
                { via: native   when: "arch or opensuse or void or void_musl" }
                { via: flatpak  hub: flathub  app: org.wezfurlong.wezterm } ]
        }
        wezterm-dotfiles: { description: "wezterm config, linked into place." install: [ { via: dotfiles  config: { src: wezterm  dst: $XDG_CONFIG_HOME/wezterm } } ] }
        // foot: a fast, lightweight Wayland-only terminal. Native across debian/ubuntu/fedora/arch/
        // alpine/openSUSE; no brew/EL package (and it needs a Wayland compositor at runtime).
        foot: { attrs: [ GUI FOSS permissive ] suggests: foot-dotfiles  description: "foot — a fast, lightweight Wayland terminal emulator (`foot`)."
            install: [ { via: native  repo-component: universe  when: "not (rhel or amzn or fedora_atomic)" } ] }
        foot-dotfiles: { description: "foot terminal config, linked into place." install: [ { via: dotfiles  config: { src: foot  dst: $XDG_CONFIG_HOME/foot } } ] }
        // grim/slurp/swaybg/wmenu — wlroots-only Wayland tools (won't run on X11 or GNOME/KDE Wayland).
        // Native on debian/ubuntu/fedora/arch/alpine/openSUSE; no EL/amzn/atomic (like `foot`).
        grim: { attrs: [ CLI FOSS permissive ] description: "grim — take screenshots on wlroots-based Wayland compositors."
                install: [ { via: native  repo-component: universe  when: "not (rhel or amzn or fedora_atomic)" } ] }
        slurp: { attrs: [ CLI FOSS permissive ] description: "slurp — select a region or point on a Wayland compositor (pipe into grim to crop a screenshot)."
                install: [ { via: native  repo-component: universe  when: "not (rhel or amzn or fedora_atomic)" } ] }
        swaybg: { attrs: [ CLI FOSS permissive ] description: "swaybg — set the wallpaper/background on wlroots Wayland compositors."
                install: [ { via: native  repo-component: universe  when: "not (rhel or amzn or fedora_atomic)" } ] }
        // wmenu: dmenu for Wayland (`wmenu`/`wmenu-run`) — broadly packaged (extra/community/main).
        wmenu: { attrs: [ GUI FOSS permissive ] description: "wmenu — a dmenu-style menu for Wayland (`wmenu`/`wmenu-run`)."
                install: [ { via: native  repo-component: universe  when: "not (rhel or amzn or fedora_atomic)" } ] }
        // wl-screenrec: GPU-accelerated (VAAPI) wlroots screen recorder. Real packaging only on
        // openSUSE Tumbleweed + Arch AUR; else a cargo build (needs recent Rust [edition 2024] and,
        // at build time, FFmpeg >=6 + libva + clang dev libs present).
        wl-screenrec: { attrs: [ CLI FOSS permissive ] description: "wl-screenrec — GPU-accelerated screen recorder for wlroots Wayland compositors."
                install: [ { via: native  when: "opensuse_tumbleweed" }
                           { via: aur  when: "arch" }   // `when: "arch"`: keeps it ahead of cargo, whose FFmpeg gate lists arch
                           // cargo builds ffmpeg-sys-next + drm bindings from source -> needs the FFmpeg/libdrm
                           // dev headers + pkg-config. It also requires FFmpeg >= 6 (uses the 5.1+ channel-layout
                           // + AVFrame.time_base + VAAPI APIs), so decline on releases that ship an older FFmpeg
                           // (Ubuntu/Pop < 24.04 = 4.4, Debian < 13 = 5.1) rather than attempt a build that
                           // fails on missing symbols. openSUSE Leap's ffmpeg dev libs come from Packman (not
                           // modeled) -> decline there too; Tumbleweed/Arch are covered natively/AUR above.
                           { via: cargo  when: "not ((ubuntu < 24.04) or (debian < 13))"  name: wl-screenrec  requires: [ cargo, ffmpeg-dev, libdrm-dev, pkg-config ]  version: { crates: wl-screenrec } } ] }   // FFmpeg>=6 API floor is real; the dev-lib requires: naturally decline cargo where the headers can't be had (e.g. atomic)
        // yazi: Rust TUI file manager. Native on Arch + Homebrew; upstream ships a real .deb, so on
        // Debian/Ubuntu (not in-repo) install that via the OS package tool — clean and on PATH.
        // Elsewhere (Fedora is COPR-only; openSUSE/Alpine/EL absent) the release zip lands under
        // ~/apps and its companion snippet aliases `yazi`.
        yazi: { attrs: [ TUI app FOSS permissive ]
            description: "Blazing-fast terminal file manager with image previews."
            suggests: yazi-glue
            install: [
                { via: native  when: "arch or void or void_musl" }
                { via: native  when: "fedora_atomic" }              // brew formula `yazi`
                // upstream's .deb is a glibc build needing libc6 >= 2.39, so it's gated to the OS
                // versions that ship it (Ubuntu 24.04 / Debian 13); older glibc (e.g. Pop/Ubuntu
                // 22.04) can't install OR run it -> fall through to the musl tarball below.
                { via: native-pkg-file  when: "(ubuntu >= 24.04) or (debian >= 13)"
                  version: { github: sxyazi/yazi }
                  asset: { x86_64: yazi-x86_64-unknown-linux-gnu.deb  aarch64: yazi-aarch64-unknown-linux-gnu.deb } }
                // the MUSL zip is a static binary — no libc6 floor — so it runs on any glibc (old
                // Debian/Ubuntu/Pop) AND on musl Alpine. The universal fallback (aliased by yazi.sh).
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/yazi"  requires: unzip
                  version: { github: sxyazi/yazi  asset: "yazi-$ARCH-unknown-linux-musl.zip" } }
                { via: brew  name: yazi }
            ]
        }
        yazi-glue: { description: "yazi config, linked into place."
            install: [ { via: glue  requires: shell-glue  glue: yazi } ]
        }
        // superfile (`spf`): Go TUI file manager. Native on Arch + Homebrew; elsewhere the GitHub
        // release tarball (its official install.sh sudo-installs and edits shell rc files — the
        // surprises configsys avoids — so we unpack userland under ~/apps and alias `spf`).
        superfile: { attrs: [ TUI app FOSS permissive ]
            description: "Modern terminal file manager (`spf`) with a pretty TUI."
            suggests: superfile-glue
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }              // brew formula `superfile`
                { via: tarball  cpu-names: { x86_64: amd64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/superfile"  requires: glibc
                  version: { github: yorukot/superfile  asset: "superfile-linux-*-$ARCH.tar.gz" } }
                { via: brew  name: superfile }
            ]
        }
        superfile-glue: { description: "superfile config, linked into place."
            install: [ { via: glue  requires: shell-glue  glue: superfile } ]
        }
        // ueberzugpp — draws images in the terminal (X11/Wayland/Sixel) so file managers like yazi
        // can show image previews. The maintained C++ fork of the archived Python `ueberzug`;
        // installs the `ueberzug` command. Only Arch packages it natively (extra); a `via: source`
        // build for the other distros lives in the configsys-source plugin.
        ueberzugpp: { attrs: [ CLI FOSS copyleft ] description: "ueberzugpp — display images inline in the terminal for previews (`ueberzug`); the maintained ueberzug fork."
            install: [ { via: native  when: "arch"  name: ueberzugpp } ] }

        // mc: Midnight Commander — packaged as `mc` in every base repo (EL via EPEL, like htop/btop).
        mc: { attrs: [ TUI app FOSS GNU copyleft ]
            description: "Midnight Commander — a two-pane TUI file manager (`mc`)."
            install: [
                { via: native  when: "rhel"  requires: epel }
                { via: native  repo-component: universe  name: { brew: midnight-commander } }
                { via: brew  name: midnight-commander }
            ]
        }

        // espeak: we install espeak-ng (the maintained fork; provides the `espeak` command),
        // packaged as `espeak-ng` everywhere (Debian/Ubuntu universe, Fedora, Arch, openSUSE,
        // Alpine, Homebrew; EL via EPEL).
        espeak: { attrs: [ CLI FOSS copyleft ]
            description: "espeak-ng — compact software speech synthesizer (`espeak`)."
            install: [
                { via: native  when: "rhel"  requires: epel  name: espeak-ng }
                { via: native  when: "amzn"  name: espeak }
                { via: native  repo-component: universe  name: espeak-ng }
                { via: brew  name: espeak-ng }   // the brew `espeak` formula is deprecated
            ]
        }

        // EPEL: a capability enabled by installing epel-release (only on EL). Anything
        // that `requires: epel` is a no-op off EL (nothing needs it) and pulls this in on EL.
        epel-release: { attrs: [ headless FOSS permissive ] description: "EPEL — Extra Packages for Enterprise Linux (an extra RHEL repo)."
            provides: epel
            // Oracle Linux ships EPEL under its own package name (oracle-epel-release-elN); the
            // narrower `when: ol` wins over the generic rhel binding by specificity. (el9 name —
            // an OL8 target would want oracle-epel-release-el8.)
            install: [ { via: native  when: "rhel" }
                       { via: native  when: "ol"  name: oracle-epel-release-el9 } ]
        }
        // Void's `nonfree` repo (non-free-licensed packages: nmap since its license change, unrar,
        // …). Like EPEL: a package that only ships there `requires: void-repo-nonfree`, which installs
        // the repo definition; xbps-install's -S then syncs it before the package installs.
        void-repo-nonfree: { attrs: [ plugin ] description: "Void Linux's nonfree repository (non-free-licensed packages)."
            install: [ { via: native  when: "void or void_musl" } ] }

        // pipx: the version-variant collapse. Native package where the repos have it;
        // a pip --user bootstrap on old Ubuntu/Debian; +EPEL on EL. Was a \pip family +
        // apt/dnf/pacman entries + two @version blocks + a rhel override — now three bindings.
        pipx: { attrs: [ CLI FOSS permissive ] suggests: pipx-glue  description: "Install and run Python CLI apps in isolated environments."
            install: [
                { via: pip     when: "(ubuntu < 23.04) or (debian < 12) or amzn"  name: pipx  version: { pypi: pipx } }
                { via: native  when: "rhel"  requires: epel  name: { pacman: python-pipx } }
                { via: native  name: { xbps: python3-pipx pacman: python-pipx  zypper: python313-pipx } }
                { via: brew  name: pipx }
            ]
        }

        // The Rust toolchain, explicit and directly usable (rustc + cargo). It `provides: cargo`,
        // so the cargo DRIVER's `requires: cargo` (a crate needs the cargo tool) is satisfied by
        // installing rust — there is no separate `cargo` component. Package names bring the WHOLE
        // toolchain: apt `rust-all` (metapkg: rustc+cargo+gdb+doc), Arch/Homebrew `rust` (bundles
        // cargo), and elsewhere `cargo` transitively pulls rustc (dnf/apk/zypper).
        rust: { attrs: [ CLI toolchain FOSS permissive ] suggests: rust-glue  description: "The Rust toolchain (cargo, rustc) — safe systems programming."
            provides: cargo
            install: [
                { via: native  repo-component: universe  name: { apt: rust-all  pacman: rust  brew: rust  default: cargo }  installed-name: { apt: cargo } }   // Ubuntu splits the toolchain: `rust-all` is a meta over cargo/rustc — read state from `cargo` (apt only: Arch's `rust` merely PROVIDES cargo, which `pacman -Q` doesn't resolve)
                // rustup: the official installer -> the LATEST STABLE toolchain, userland in
                // ~/.cargo (no sudo, on the standard ~/.cargo/bin PATH). For source builds that
                // need a newer cargo than the distro ships (the toolchain-floor case). Least-
                // preferred (via: script is last in driver-preference), so it NEVER wins by default
                // — native stays the default; pin `rust script` (or let a cargo>=X floor advise it).
                // Its available version is the current stable (read from the stable channel
                // manifest); `provides: { cargo }` is the floor it guarantees. `--no-modify-path`
                // keeps rustup from editing your shell rc (no surprises) — the SOURCE driver
                // prepends ~/.cargo/bin for builds, so a floor-pinned rust builds; for INTERACTIVE
                // use, put ~/.cargo/bin on PATH yourself (configsys ships no personal shell config).
                { via: script  requires: curl
                  provides: { cargo: ">=1.90" }      // rustup installs the CURRENT stable; keep this at a recent floor
                  version: { url: "https://static.rust-lang.org/dist/channel-rust-stable.toml"
                             regex: '\[pkg\.rust\]\s*\n\s*version = "([0-9]+\.[0-9]+\.[0-9]+)' }
                  install-cmd:   "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path"
                  version-cmd:   "$HOME/.cargo/bin/cargo --version"
                  version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                  uninstall-cmd: "$HOME/.cargo/bin/rustup self uninstall -y"
                  location:      "~/.cargo/bin" }
                { via: brew  name: rust }
            ]
        }

        // Lean 4 — functional language + interactive theorem prover. Installed through elan (the
        // rustup-style userland version manager): elan-init puts `lean`/`lake` under ~/.elan (no
        // sudo, no distro package needed anywhere). The glue snippet puts ~/.elan/bin on PATH.
        lean: { attrs: [ CLI toolchain FOSS permissive ]  suggests: lean-glue  requires: curl
            description: "Lean 4 — a functional language & interactive theorem prover (`lean`, `lake`), managed by elan."
            install: [ { via: script
                install-cmd:   'curl -fsSL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh | sh -s -- -y'
                version-cmd:   '"$HOME/.elan/bin/lean" --version 2>/dev/null'
                version-re:    '([0-9][0-9.]*)'
                uninstall-cmd: '"$HOME/.elan/bin/elan" self uninstall -y 2>/dev/null || rm -rf "$HOME/.elan"' }  { via: brew  name: elan-init } ] }   // brew elan-init installs elan; lean arrives on first use
        lean-glue: { description: "Lean/elan PATH setup (~/.elan/bin), linked into place."
            install: [ { via: glue  requires: shell-glue  glue: lean } ] }

        // Mojo — Modular's Python-superset systems language for AI/HPC. Upstream ships it through
        // pixi/conda (no configsys pixi driver) or PyPI; the `mojo` wheel bundles the compiler + LSP
        // + debugger, so pipx installs a working `mojo` CLI universally. The compiler is proprietary.
        mojo: { attrs: [ CLI toolchain proprietary ]
            description: "Mojo — Modular's Python-superset systems language for AI & high-performance computing (`mojo`)."
            install: [ { via: pipx  name: mojo } ] }

        // Node.js toolchain (node + npm), directly usable. It `provides: npm`, so the npm
        // DRIVER's `requires: npm` is met by installing node. One native binding brings both:
        // apt/Arch/Alpine `npm` transitively pulls nodejs; Fedora/openSUSE `nodejs` and
        // Homebrew `node` bundle npm.
        node: { attrs: [ runtime FOSS permissive ] suggests: node-glue  description: "Node.js — JavaScript runtime built on V8."
            provides: npm
            install: [ { via: native  repo-component: universe  name: { apt: npm  pacman: npm  apk: npm  brew: node  zypper: nodejs-default  default: nodejs } }
                       { via: snap  name: node  classic: true }  { via: brew  name: node } ]   // OpenJS-official snap (never-auto)
        }
        // Sample global npm CLIs (installed userland by default; see the npm driver). More can
        // be added the same way, or pulled per-user via a plugin layer.
        typescript: { attrs: [ CLI toolchain FOSS permissive ] description: "TypeScript — typed JavaScript, compiles to JS (`tsc`)." install: [ { via: npm  name: typescript }  { via: brew  name: typescript } ] }
        prettier:   { attrs: [ CLI FOSS permissive ] description: "Prettier — an opinionated code formatter for web languages." install: [ { via: npm  name: prettier }  { via: brew  name: prettier } ] }
        // Front-end package managers + Dart Sass — npm globals (userland, like the above). NOTE:
        // recent pnpm/sass want a modern Node (pnpm >=22); the distro's apt node can be too old —
        // use a version-managed node (nvm/fnm) if you hit a "requires Node vXX" error.
        pnpm:       { attrs: [ CLI FOSS permissive ] description: "pnpm — fast, disk-efficient Node package manager." install: [ { via: npm  name: pnpm }  { via: brew  name: pnpm } ] }
        yarn:       { attrs: [ CLI FOSS permissive ] description: "Yarn — a Node package manager." install: [ { via: npm  name: yarn }  { via: brew  name: yarn } ] }
        sass:       { attrs: [ CLI FOSS permissive ] description: "Sass — CSS with superpowers (the `sass` compiler)." install: [ { via: npm  name: sass }  { via: brew  name: dart-sass } ] }   // dart-sass = the npm `sass` package
        // elm: no distro packages it — the official prebuilt binary from elm/compiler releases is a
        // single gzipped glibc executable (archive: gz). Off-PATH under the app dir, so elm-glue
        // aliases it; declines on musl Alpine.
        elm: { attrs: [ CLI toolchain FOSS permissive ] suggests: elm-glue  description: "Elm — a functional language for reliable web frontends (compiles to JS)."
            install: [ { via: tarball  when: "not alpine"  cpu-names: { x86_64: x64 }  installDir: "$CONFIGSYS_APP_DIR/elm"  requires: glibc  archive: gz  binary: elm
                         version: { github: elm/compiler  asset: "elm-*-linux-x64.gz" } }  { via: brew  name: elm } ] }
        elm-glue: { description: "elm shell setup, linked into place." install: [ { via: glue  requires: shell-glue  glue: elm } ] }

        // Deno & Bun — alternative JS/TS runtimes. Native on Arch/Homebrew where packaged; else
        // the upstream github release ZIP (glibc-linked; the tarball driver unzips it). Both have
        // STABLE asset names (no version in the filename), so they use github's API-free
        // `releases/latest/download` URL — robust even when api.github.com is unreachable.
        deno: { attrs: [ CLI runtime FOSS permissive ] suggests: deno-glue  description: "Deno — secure JavaScript/TypeScript runtime with built-in tooling."
            install: [
                { via: native  when: "arch" }
                { via: native  when: "fedora_atomic" }             // brew formula `deno`
                { via: tarball  cpu-names: { x86_64: x86_64  aarch64: aarch64 }  installDir: "$CONFIGSYS_APP_DIR/deno"  requires: [ glibc, unzip ]  version: { static: latest }
                  url: "https://github.com/denoland/deno/releases/latest/download/deno-$ARCH-unknown-linux-gnu.zip" }  { via: brew  name: deno } ]
        }
        bun: { attrs: [ CLI runtime toolchain FOSS permissive ] suggests: bun-glue  description: "Bun — fast all-in-one JavaScript runtime, bundler, and package manager."
            install: [
                { via: native  when: "fedora_atomic" }             // brew formula `bun`
                { via: tarball  cpu-names: { x86_64: x64  aarch64: aarch64 }  installDir: "$CONFIGSYS_APP_DIR/bun"  requires: [ glibc, unzip ]  version: { static: latest }
                  url: "https://github.com/oven-sh/bun/releases/latest/download/bun-linux-$ARCH.zip" }  { via: brew  name: bun } ]
        }

        // Go toolchain, directly usable. Auto-provides the `go` capability the go-install
        // driver requires. Package names: apt `golang-go`, dnf `golang`, else `go`.
        go: { attrs: [ CLI toolchain FOSS permissive ] suggests: go-glue  description: "The Go programming language toolchain."
            install: [
                { via: native  name: { apt: golang-go  dnf: golang  default: go } }
                // the official Go toolchain tarball — latest stable, userland under
                // $CONFIGSYS_SDK_DIR/go (~/sdks/go by default; `strip: 1` drops the archive's `go/`
                // wrapper so `go` lands at .../go/bin). For source builds that need a newer Go than
                // the distro ships (lazygit/superfile floors). Least-preferred (native stays the
                // default; pin `go tarball`, or let a go>=X floor advise it). The source driver puts
                // ~/sdks/go/bin on PATH for builds; `provides: { go }` is the floor it guarantees.
                { via: tarball  cpu-names: { x86_64: amd64  aarch64: arm64 }  installDir: "$CONFIGSYS_SDK_DIR/go"  strip: 1  requires: [ glibc, curl ]
                  provides: { go: ">=1.21" }
                  version: { url: "https://go.dev/VERSION?m=text"  regex: "go([0-9.]+)" }
                  url: "https://go.dev/dl/go$VERSION.linux-$ARCH.tar.gz" }
                { via: brew  name: go }
            ]
        }
        // Sample `go install` tool (module path in `name:`; binary = its last segment).
        goimports: { attrs: [ CLI FOSS permissive ] description: "goimports — format Go code and fix imports."
            // goimports@latest's go.mod needs a modern toolchain to even parse (a distro go 1.18
            // fails "invalid go version"). Soft-floor go >=1.21: resolves with default go, and the
            // resident-floor check advises `upgrade go` / auto-tightens to the go tarball (>=1.21).
            install: [ { via: go-install  name: "golang.org/x/tools/cmd/goimports"  requires: [ { go: ">=1.21" } ] }  { via: brew  name: goimports } ] }

        // Ruby toolchain (ships gem + irb). Auto-provides `ruby` for the gem driver. apt
        // `ruby-full` bundles the dev headers gems' native extensions need; else `ruby`.
        ruby: { attrs: [ CLI runtime toolchain FOSS permissive ] suggests: ruby-glue  description: "The Ruby programming language."
            // apt installs the `ruby-full` meta (interpreter + dev + ri + tk), but the base `ruby`
            // package (pulled in as a dependency of other tools) provides a working interpreter WITHOUT
            // ruby-full — so read install-state from `ruby`, else a resident base Ruby reads uninstalled.
            install: [ { via: native  name: { apt: ruby-full  default: ruby }  installed-name: { apt: ruby } }  { via: brew  name: ruby } ]
        }
        // Sample gem (userland by default; see the gem driver).
        bundler: { attrs: [ CLI FOSS permissive ] description: "Bundler — manage Ruby gem dependencies (`bundle`)." install: [ { via: gem  name: bundler } ] }

        // PHP toolchain — the CLI interpreter + Composer (its project dependency manager). The bare
        // `php` package is the Apache/mod_php web stack on apt AND dnf, so the CLI package is
        // `php-cli` there; Arch/brew ship a plain `php`; Alpine is versioned-only (`php84`);
        // openSUSE uses `php8-cli`. Third-party repos (Surý on Debian/Ubuntu, Remi on Fedora/RHEL)
        // add non-default PHP versions — not modeled here; the distro default is enough.
        php: { attrs: [ CLI toolchain FOSS permissive ] description: "PHP — the PHP command-line interpreter (`php`)."
            install: [ { via: native  repo-component: universe
                         name: { apt: php-cli  dnf: php-cli  pacman: php  apk: php84  zypper: php8-cli  brew: php } }  { via: brew  name: php } ]
        }
        composer: { attrs: [ CLI FOSS permissive ] suggests: composer-glue  description: "Composer — PHP's per-project dependency manager." requires: php
            install: [ { via: native  when: "not rhel"  repo-component: universe  name: { zypper: php-composer2  default: composer } }
                       { via: native  when: "rhel"  requires: epel  name: composer }  { via: brew  name: composer } ]
        }

        // .NET SDK — build & run C#/F# apps. Native from the distro's OWN repos on arch (rolling),
        // ubuntu 22.04+, fedora, and alpine (no Microsoft feed needed). On debian/rhel/openSUSE the
        // upstream dotnet-install.sh lands a per-user SDK under ~/.dotnet (add it to PATH yourself);
        // the Canonical snap (classic) is a pinnable all-distro alternate. Distro packages are
        // per-major (8.0 = current LTS) — bump the channel/pkg as newer LTS lines land.
        dotnet: { attrs: [ CLI SDK toolchain FOSS permissive tele ] suggests: dotnet-glue  description: ".NET SDK — build & run .NET (C#/F#) apps (`dotnet`)."
            install: [
                { via: native  when: "arch"    name: dotnet-sdk }              // rolling latest
                { via: native  when: "ubuntu"  name: dotnet-sdk-8.0 }          // Canonical feed (22.04+)
                { via: native  when: "fedora"  name: dotnet-sdk-8.0 }          // Fedora's own repo
                { via: native  when: "alpine"  name: dotnet8-sdk }             // community
                { via: script  when: "debian or rhel or opensuse or void or void_musl"   // dotnet-install.sh: glibc + musl
                  install-cmd:   'curl -fsSL https://dot.net/v1/dotnet-install.sh | bash -s -- --channel 8.0'
                  version-cmd:   '"$HOME/.dotnet/dotnet" --version 2>/dev/null'
                  version-re:    '([0-9]+\.[0-9]+\.[0-9]+)'
                  uninstall-cmd: 'rm -rf "$HOME/.dotnet"'
                  location:      '~/.dotnet' }
                { via: snap  name: dotnet-sdk  classic: true }  { via: brew  name: dotnet } ]               // Canonical; pinnable all-distro
        }

        // --- native language toolchains (directly usable; ecosystem module drivers deferred) ---
        // JDK — VERSION-SCOPED providers of the `jdk` capability (the python3.X pattern for Java).
        // Every LTS line is reachable by a `jdk-NN` name. `jdk` is the canonical default: it holds
        // the OpenJDK 21 bindings and `provides: { jdk: 21 }` (not `never-auto`), so a bare `jdk` /
        // `requires: jdk` installs the current LTS default; `jdk-21` is a thin alias to it (so the
        // -NN naming is complete without a second jdk:21 provider — two would tie). `jdk-17`/`jdk-25`
        // are opt-in `never-auto` lines; a versioned `requires: { jdk: ">=25" }` selects/enables the
        // matching line. 17/21/25 are ALL LTS (the non-LTS interim releases aren't packaged here —
        // mark a future jdk-NN's description `(non-LTS)` if one is added). Native openjdk-N tracks the
        // latest patch. graalvm is GraalVM CE (native-image) via SDKMAN — another (never-auto) jdk:21
        // provider; the sdkman/graalvm components are the manual alt-distribution path.
        // On fedora_atomic brew is the native manager, but brew's openjdk@N formulae are keg-only (not
        // linked onto PATH), so the atomic route is a pinned SDKMAN Temurin build instead — also the
        // only route on the native-less kde_linux, and a pinnable alternative everywhere glibc.
        // To bump the default LTS: move the native bindings + `provides:` onto `jdk`, turn the OLD
        // default's `jdk-NN` alias into a real `never-auto` line, and repoint `jdk-NN` at the new line.
        jdk: { attrs: [ toolchain runtime FOSS copyleft ] description: "Java Development Kit — the current LTS default (OpenJDK 21)."
            provides: { jdk: 21 }
            install: [ { via: native  when: "not fedora_atomic"  name: { xbps: openjdk21 apt: openjdk-21-jdk  dnf: java-21-openjdk-devel  pacman: jdk21-openjdk  apk: openjdk21  zypper: java-21-openjdk-devel } }
                       { via: sdkman  name: java  version: "21.0.12+1.1-tem"  requires: glibc }   // Temurin; bump the SDKMAN id as releases roll
                       { via: native  when: "amzn"  name: java-21-amazon-corretto-devel } ] }   // Amazon ships Corretto, not OpenJDK
        jdk-17: { attrs: [ toolchain runtime FOSS copyleft ] description: "OpenJDK 17 — LTS (2021)." standing: never-auto  provides: { jdk: 17 }
            install: [ { via: native  when: "not fedora_atomic"  name: { xbps: openjdk17 apt: openjdk-17-jdk  dnf: java-17-openjdk-devel  pacman: jdk17-openjdk  apk: openjdk17  zypper: java-17-openjdk-devel } }
                       { via: sdkman  name: java  version: "17.0.20-tem"  requires: glibc }   // Temurin; bump the SDKMAN id as releases roll
                       { via: native  when: "amzn"  name: java-17-amazon-corretto-devel } ] }
        jdk-21: { attrs: [ toolchain runtime FOSS copyleft ] description: "OpenJDK 21 — LTS (2023); the current default (alias for `jdk`)." standing: never-auto
            install: [ { via: parts  parts: [ jdk ] } ] }
        jdk-25: { attrs: [ toolchain runtime FOSS copyleft ] description: "OpenJDK 25 — LTS (2025)." standing: never-auto  provides: { jdk: 25 }
            install: [ { via: native  when: "not fedora_atomic"  name: { xbps: openjdk25 apt: openjdk-25-jdk  dnf: java-25-openjdk-devel  pacman: jdk25-openjdk  apk: openjdk25  zypper: java-25-openjdk-devel } }
                       { via: sdkman  name: java  version: "25.0.4-tem"  requires: glibc }   // Temurin; bump the SDKMAN id as releases roll
                       { via: native  when: "amzn"  name: java-25-amazon-corretto-devel } ] }
        graalvm: { attrs: [ CLI runtime toolchain FOSS copyleft ] description: "GraalVM CE 21 — a JDK with native-image (ahead-of-time compilation), via SDKMAN."
            standing: never-auto  provides: { jdk: 21 }
            install: [ { via: sdkman  name: java  version: "21.0.2-graalce"   // bump the SDKMAN id as releases roll
                         latest-check: { github: graalvm/graalvm-ce-builds  tag-re: "jdk-([0-9][0-9.]*)" } } ] }   // `refresh` flags when a newer GraalVM ships
        // `java` / `openjdk` — searchable aliases for the default JDK (a parts-union of `jdk`, like
        // jdk-21). People reach for "java"; this routes it to OpenJDK 21 without a second jdk provider.
        java:    { attrs: [ toolchain runtime FOSS copyleft ] description: "Java — an alias for the default JDK (OpenJDK 21); see `jdk`/`jdk-NN` for specific versions."
            install: [ { via: parts  parts: [ jdk ] } ] }
        openjdk: { attrs: [ toolchain runtime FOSS copyleft ] description: "OpenJDK — an alias for the default JDK (OpenJDK 21); see `jdk`/`jdk-NN` for specific versions."
            install: [ { via: parts  parts: [ jdk ] } ] }
        // SDKMAN — a JVM SDK manager installed by its own shell script (the demonstrator for the
        // `script` driver: lifecycle commands declared as data, incl. a clean uninstall). `sdk`
        // is a shell function, so version-cmd sources the init script in the same shell.
        sdkman: { attrs: [ CLI FOSS permissive ] description: "SDKMAN! — manage parallel versions of JVM SDKs and tools."
            suggests: sdkman-glue
            install: [ { via: script
                         install-cmd: 'curl -s https://get.sdkman.io | bash'
                         version-cmd: 'source "$HOME/.sdkman/bin/sdkman-init.sh" && sdk version'
                         version-re: '([0-9]+\.[0-9]+\.[0-9]+)'
                         uninstall-cmd: 'rm -rf "$HOME/.sdkman"'
                         location: '~/.sdkman' } ]
        }
        sdkman-glue: { description: "SDKMAN shell init — sources sdkman-init.sh from ~/.bash.d so `sdk` + the selected SDKs are on PATH."
            install: [ { via: glue  requires: shell-glue  glue: sdkman } ] }

        // Kotlin compiler — native on Arch/Homebrew; else the github release ZIP. Needs a JVM to
        // run (requires jdk) and unzip to unpack. (SDKMAN is the other path — via the script driver.)
        kotlin: { attrs: [ toolchain FOSS permissive ] suggests: kotlin-glue  description: "Kotlin — modern JVM language, Android's default."
            install: [
                { via: native  when: "arch" }                      // pacman: kotlin
                { via: native  when: "fedora_atomic" }             // brew formula `kotlin`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/kotlin"  requires: [ jdk, unzip ]
                  version: { github: JetBrains/kotlin  strip-v: true  asset: "kotlin-compiler-*.zip" }
                  url: "https://github.com/JetBrains/kotlin/releases/download/v$VERSION/kotlin-compiler-$VERSION.zip" }  { via: brew  name: kotlin } ]
        }
        // OCaml compiler (opam driver deferred).
        ocaml: { attrs: [ CLI toolchain FOSS copyleft ] description: "OCaml — pragmatic functional language with a fast native compiler." install: [ { via: native  repo-component: universe }  { via: brew  name: ocaml } ] }
        // Lua interpreter (luarocks deferred). Some distros suffix the package with the version.
        lua:   { attrs: [ CLI toolchain runtime FOSS permissive ] description: "The Lua programming language — small, embeddable scripting." install: [ { via: native  repo-component: universe  name: { apt: lua5.4  apk: lua5.4  zypper: lua54  default: lua } }  { via: brew  name: lua } ] }
        // Tcl/Tk — the Tool Command Language interpreter (`tclsh`) + its Tk GUI toolkit (`wish`).
        // Native everywhere (uniform `tcl`/`tk`); Homebrew ships both in one `tcl-tk` formula.
        tcl: { attrs: [ toolchain runtime CLI FOSS permissive ] description: "Tcl — the Tool Command Language interpreter (`tclsh`)."
            install: [ { via: native  repo-component: universe  name: { brew: tcl-tk } }  { via: brew  name: tcl-tk } ] }
        tk:  { attrs: [ lib FOSS permissive ] description: "Tk — the Tcl GUI toolkit (`wish`) and widget library." requires: tcl
            install: [ { via: native  repo-component: universe  name: { brew: tcl-tk } } ] }

        // --- more languages. GCC front-ends (gfortran/gnat/d-via-gdc) whose package name varies
        // per manager; niche/compiled langs via github release or an official repo. ---
        gfortran: { attrs: [ toolchain FOSS GNU copyleft ] description: "GNU Fortran — the GCC Fortran compiler (`gfortran`)."
            install: [ { via: native  name: { xbps: gcc-fortran dnf: gcc-gfortran  pacman: gcc-fortran  zypper: gcc-fortran  brew: gcc  default: gfortran } }  { via: brew  name: gcc } ] }   // brew bundles gfortran in `gcc`
        gnat: { attrs: [ CLI toolchain FOSS GNU copyleft ] description: "GNAT — the GCC Ada compiler."
            install: [ { via: native  when: "(not fedora_atomic) and not amzn"  name: { xbps: gcc-ada dnf: gcc-gnat  pacman: gcc-ada  apk: gcc-gnat  zypper: gcc-ada  default: gnat } } ] }   // no brew Ada front-end
        gnucobol: { attrs: [ CLI toolchain FOSS GNU copyleft ] description: "GnuCOBOL — a COBOL compiler (`cobc`)."
            install: [ { via: native  when: "(not arch) and not amzn"  name: gnucobol }   // `gnucobol` on apt/dnf/zypper/apk
                       { via: aur  name: gnucobol }  { via: brew  name: gnucobol } ] }   // AUR-only on Arch
        // Objective-C: the GNU ObjC compiler frontend + libobjc runtime (compile via `gcc -x
        // objective-c` or clang; no `objc` binary). apt calls it gobjc, everyone else gcc-objc;
        // Alpine's musl gcc and Amazon's base repo don't package it -> they decline.
        objective-c: { attrs: [ toolchain FOSS GNU copyleft ] description: "Objective-C — the GNU Objective-C compiler frontend + libobjc runtime."
            install: [ { via: native  when: "not (alpine or amzn or fedora_atomic)"  name: { apt: gobjc  default: gcc-objc } } ] }   // no gcc-objc brew formula on atomic (layer/toolbox instead)
        // GNUstep: the open-source Cocoa/OpenStep framework for Objective-C — needs the ObjC
        // compiler, so requires: objective-c. Debian/Ubuntu ship the full dev meta (gnustep-devel =
        // make+base+gui+back); Fedora/Arch/openSUSE package only Foundation + the build system (no
        // AppKit GUI in their base repos — that's AUR on Arch). gnustep-glue sources the build
        // environment. Declines where objective-c does (Alpine/Amazon/atomic).
        gnustep: { attrs: [ lib FOSS GNU copyleft ] suggests: gnustep-glue  requires: objective-c
            description: "GNUstep — open-source Cocoa/OpenStep framework for Objective-C (Foundation + AppKit)."
            install: [
                { via: native  when: "void or void_musl"  packages: [ gnustep-make, gnustep-base-devel, gnustep-gui-devel, gnustep-back ] }   // Void packages the whole stack incl. AppKit (gui + back)
                { via: native  when: "debian"    packages: [ gnustep-devel ]  installed-name: gnustep-devel }   // dev meta: make + base + gui + back; read state from it (the meta name isn't a package)
                { via: native  when: "fedora"    packages: [ gnustep-make, gnustep-base-devel ] }      // Foundation + build system (no AppKit in Fedora repos)
                { via: native  when: "arch"      packages: [ gnustep-make, gnustep-base ] }            // official base (gnustep-gui is AUR-only)
                { via: native  when: "opensuse"  packages: [ gnustep-make, gnustep-base-devel ] } ]
        }
        gnustep-glue: { description: "gnustep shell setup, linked into place." install: [ { via: glue  requires: shell-glue  glue: gnustep } ] }
        d: { attrs: [ CLI toolchain FOSS permissive ] description: "The D programming language (a D compiler — LDC / GDC / DMD per distro)."
            install: [ { via: native  when: "fedora or arch or alpine or fedora_atomic or void or void_musl"  name: ldc }   // LLVM D compiler
                       { via: native  when: "debian"  name: gdc }        // GCC D front-end (ldc is sid-only on debian)
                       { via: native  when: "opensuse"  name: dmd }  { via: brew  name: ldc } ] }   // LDC (the brew dmd formula is disabled)
        crystal: { attrs: [ CLI toolchain FOSS permissive ] description: "Crystal — a Ruby-like, LLVM-backed compiled language."
            install: [ { via: native  when: "arch or alpine or fedora_atomic" }   // pacman/apk/brew `crystal`
                       { via: script  when: "debian or redhat"           // official installer: adds the crystal repo + installs the package
                         install-cmd:   'curl -fsSL https://crystal-lang.org/install.sh | sudo bash'
                         version-cmd:   'crystal --version 2>/dev/null'
                         version-re:    '([0-9][0-9.]*)'
                         uninstall-cmd: 'sudo apt-get remove -y crystal 2>/dev/null || sudo dnf remove -y crystal 2>/dev/null'
                         location:      'crystal (dist.crystal-lang.org repo)' }  { via: brew  name: crystal } ] }
        dart: { attrs: [ CLI toolchain SDK FOSS permissive ] suggests: dart-glue  description: "Dart — Google's language & SDK for apps and Flutter."
            install: [ { via: native  when: "arch" }                     // pacman: dart (extra)
                       { via: native  when: "fedora_atomic"  name: dart-sdk }   // brew dart-sdk
                       { via: native  when: "debian"  name: dart          // Google's official apt repo (single `stable` suite — codename-independent)
                         pubkey-url: "https://dl-ssl.google.com/linux/linux_signing_key.pub"  pubkey-path: /usr/share/keyrings/dart.gpg
                         source-line: "deb [signed-by=/usr/share/keyrings/dart.gpg arch=amd64] https://storage.googleapis.com/download.dartlang.org/linux/debian stable main"
                         source-path: /etc/apt/sources.list.d/dart.list }  { via: brew  name: dart-sdk } ] }
        // Flutter SDK — Google's cross-platform UI toolkit. snap (classic) on Ubuntu, AUR on Arch, and
        // the official Google tarball elsewhere (version tracked via flutter/flutter's git tags; the
        // tag-re picks stable X.Y.Z and skips the -pre betas). strip:1 lands `flutter` under bin/.
        flutter: { attrs: [ CLI SDK toolchain FOSS permissive ] description: "Flutter — Google's cross-platform UI SDK (the `flutter` tool)."
            install: [ { via: snap  when: "ubuntu"  name: flutter  classic: true }
                       { via: aur  name: flutter }
                       { via: tarball  when: "not (ubuntu or arch)"  installDir: "$CONFIGSYS_SDK_DIR/flutter"  strip: 1  requires: [ glibc, curl, xz ]
                         version: { github: flutter/flutter  tag-re: "([0-9]+[.][0-9]+[.][0-9]+)$" }
                         url: "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_$VERSION-stable.tar.xz" } ] }
        raku: { attrs: [ CLI runtime toolchain FOSS permissive ] description: "Raku (Rakudo) — the Raku language, formerly Perl 6."
            install: [ { via: native  when: "(not arch) and not amzn"  repo-component: universe  name: { brew: rakudo-star  default: rakudo } }
                       { via: aur  name: rakudo-star }  { via: brew  name: rakudo-star } ] }   // AUR-only on Arch
        v: { attrs: [ CLI toolchain FOSS permissive ] suggests: v-glue  description: "V — a simple, fast-compiling language (the `v` compiler)." requires: cc
            install: [ { via: native  when: "fedora_atomic"  name: vlang }   // brew vlang
                       { via: aur  name: vlang-bin }
                       { via: tarball  when: "not arch and not fedora_atomic"  installDir: "$CONFIGSYS_APP_DIR/v"  requires: [ glibc, unzip ]  version: { static: latest }
                         url: "https://github.com/vlang/v/releases/latest/download/v_linux.zip" }  { via: brew  name: vlang } ] }   // prebuilt zip
        gleam: { attrs: [ CLI toolchain FOSS permissive ] suggests: gleam-glue  description: "Gleam — a friendly, statically-typed language for the Erlang VM." requires: erlang
            install: [ { via: native  when: "arch or alpine or fedora_atomic or void or void_musl" }   // pacman/apk/brew gleam
                       { via: tarball  when: "not arch and not alpine and not fedora_atomic"  cpu-names: { x86_64: x86_64  aarch64: aarch64 }  installDir: "$CONFIGSYS_APP_DIR/gleam"  requires: glibc
                         version: { github: gleam-lang/gleam  strip-v: true  asset: "gleam-*-$ARCH-unknown-linux-musl.tar.gz" } }  { via: brew  name: gleam } ] }   // single static binary
        fennel: { attrs: [ CLI toolchain FOSS permissive ] description: "Fennel — a Lisp that compiles to Lua." requires: lua
            install: [ { via: native  when: "fedora or arch or alpine or fedora_atomic" }   // dnf/pacman/apk/brew fennel
                       { via: luarocks  name: fennel }  { via: brew  name: fennel } ] }
        // swift: no distro-native package (Linux install is swiftly/tarball, manual); Arch has an AUR
        // binary. Listed for arch; elsewhere it's an honest unroutable until we model swiftly.
        swift: { attrs: [ toolchain CLI FOSS permissive ] description: "Swift — the Swift language toolchain."
            install: [ { via: aur  name: swift-bin }  { via: brew  name: swift } ] }
        // C3 — a modern systems language evolving C (the `c3c` compiler). Arch packages it in [extra]
        // (as `c3c`); elsewhere the prebuilt upstream tarball (c3c + its stdlib under c3/).
        c3: { attrs: [ CLI toolchain FOSS permissive ] description: "C3 — a modern systems language evolving C (the `c3c` compiler)." requires: cc
            install: [ { via: native  when: "arch"  name: c3c }
                       { via: tarball  when: "not arch"  installDir: "$CONFIGSYS_APP_DIR/c3"  requires: glibc
                         version: { github: c3lang/c3c  strip-v: true  asset: "c3-linux.tar.gz" } }  { via: brew  name: c3c } ] }
        // Roc — a fast, friendly, functional language. PRE-1.0: only nightly builds exist (no stable
        // release), shipped as a rolling tarball. Binary `roc`.
        roc: { attrs: [ CLI toolchain FOSS permissive ] description: "Roc — a fast, friendly, functional language (nightly `roc`; pre-release)." requires: cc
            install: [ { via: tarball  cpu-names: { x86_64: x86_64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/roc"  requires: glibc  version: { static: nightly }
                         url: "https://github.com/roc-lang/roc/releases/download/nightly/roc_nightly-linux_$ARCH-latest.tar.gz" } ] }

        // JVM + Scheme langs. scala/clojure/groovy need a JDK. (No `via: sdkman` driver exists — sdkman
        // is only a component — so these use native / official installer scripts / snap, not sdkman.)
        clojure: { attrs: [ CLI runtime toolchain FOSS copyleft ] description: "Clojure — a Lisp dialect on the JVM (`clj`)." requires: jdk
            install: [ { via: native  when: "debian or arch or alpine or fedora_atomic or void or void_musl"  repo-component: universe }   // uniform `clojure`
                       { via: script  when: "fedora or rhel or opensuse"   // clojure.org's official linux-install.sh
                         install-cmd:   'curl -fsSL https://github.com/clojure/brew-install/releases/latest/download/linux-install.sh | sudo bash'
                         version-cmd:   'clojure --version 2>/dev/null'
                         version-re:    '([0-9][0-9.]*)'
                         uninstall-cmd: 'sudo rm -rf /usr/local/bin/clj /usr/local/bin/clojure /usr/local/lib/clojure'
                         location:      '/usr/local/lib/clojure' }  { via: brew  name: clojure } ] }
        groovy: { attrs: [ CLI runtime toolchain FOSS permissive ] description: "Apache Groovy — a dynamic language for the JVM." requires: jdk
            install: [ { via: sdkman }   // current Groovy 5, any distro (the clean default)
                       { via: native  when: "arch or debian or fedora_atomic"  standing: never-auto  repo-component: universe }  { via: brew  name: groovy } ] }   // pacman/apt/brew (older); pinnable
        scala: { attrs: [ CLI runtime toolchain FOSS permissive ] description: "Scala — an object-functional language on the JVM." requires: jdk
            install: [ { via: sdkman }   // current Scala 3, any distro (SDKMAN — native is ancient on debian, AUR-only on arch)
                       { via: native  when: "fedora_atomic"  standing: never-auto }   // brew scala (pinnable alt)
                       { via: aur  name: scala  standing: never-auto }  { via: brew  name: scala } ] }
        sbt: { attrs: [ CLI FOSS permissive ] description: "sbt — the interactive build tool for Scala." requires: jdk
            install: [ { via: sdkman }  { via: brew  name: sbt } ] }
        leiningen: { attrs: [ CLI FOSS copyleft ] description: "Leiningen — build automation for Clojure (`lein`)." requires: jdk
            install: [ { via: sdkman }  { via: brew  name: leiningen } ] }
        // More JVM-ecosystem tools via SDKMAN (all need a JDK; `sdk install <name>`, any distro). Build
        // tools, framework CLIs, run/scripting, data engines, DB/quality/release, profiling. (SDKMAN
        // has more — grails/vertx/helidon/tomcat/jetty/hadoop/kscript/… — add the same way if wanted.)
        mvnd:       { attrs: [ CLI daemon FOSS permissive ] description: "Maven Daemon (mvnd) — a faster Maven with a resident build daemon." requires: jdk  install: [ { via: sdkman } ] }
        ant:        { attrs: [ CLI FOSS permissive ] description: "Apache Ant — the classic XML-driven Java build tool." requires: jdk  install: [ { via: sdkman }  { via: brew  name: ant } ] }
        springboot: { attrs: [ CLI FOSS permissive ] description: "Spring Boot CLI — scaffold and run Spring Boot applications." requires: jdk  install: [ { via: sdkman } ] }
        quarkus:    { attrs: [ CLI SDK FOSS permissive ] description: "Quarkus CLI — tooling for the Quarkus Java framework." requires: jdk  install: [ { via: sdkman } ] }
        micronaut:  { attrs: [ CLI SDK FOSS permissive ] description: "Micronaut CLI (`mn`) — build Micronaut microservices." requires: jdk  install: [ { via: sdkman }  { via: brew  name: micronaut } ] }
        jbang:      { attrs: [ CLI FOSS permissive ] description: "JBang — run Java/JVM scripts with no project setup." requires: jdk  install: [ { via: sdkman }  { via: brew  name: jbang } ] }
        scalacli:   { attrs: [ CLI toolchain FOSS permissive ] description: "Scala CLI — the modern all-in-one Scala runner and tooling." requires: jdk  install: [ { via: sdkman }  { via: brew  name: scala-cli } ] }
        // coursier isn't an SDKMAN candidate; upstream ships the `cs` launcher as a gzipped native
        // binary on GitHub (per-arch) — fetch + decompress it to ~/.local/bin (on PATH).
        coursier:   { attrs: [ CLI FOSS permissive ] suggests: coursier-glue  description: "Coursier (`cs`) — the JVM artifact fetcher and application installer." requires: jdk
            install: [ { via: script  requires: [ curl, jdk ]
                         install-cmd:   'mkdir -p "$HOME/.local/bin" && A="$(uname -m)"; case "$A" in aarch64|arm64) F=cs-aarch64-pc-linux.gz ;; *) F=cs-x86_64-pc-linux.gz ;; esac; curl -fL "https://github.com/coursier/coursier/releases/latest/download/$F" | gzip -d > "$HOME/.local/bin/cs" && chmod +x "$HOME/.local/bin/cs"'
                         version-cmd:   '"$HOME/.local/bin/cs" version 2>/dev/null'
                         version-re:    '([0-9][0-9.]*)'
                         uninstall-cmd: 'rm -f "$HOME/.local/bin/cs"'
                         location:      '~/.local/bin/cs' }  { via: brew  name: coursier } ] }
        liquibase:  { attrs: [ CLI FOSSish permissive freemium ] description: "Liquibase — database schema change management and migrations." requires: jdk  install: [ { via: sdkman }  { via: brew  name: liquibase } ] }
        detekt:     { attrs: [ CLI FOSS permissive ] description: "detekt — static code analysis for Kotlin." requires: jdk  install: [ { via: sdkman }  { via: brew  name: detekt } ] }
        jreleaser:  { attrs: [ CLI FOSS permissive ] description: "JReleaser — release automation for JVM (and other) projects." requires: jdk  install: [ { via: sdkman }  { via: brew  name: jreleaser } ] }
        visualvm:   { attrs: [ GUI app FOSS copyleft ] description: "VisualVM — a visual JVM profiler and monitor." requires: jdk  install: [ { via: sdkman } ] }
        jmc:        { attrs: [ GUI app FOSS permissive ] description: "JDK Mission Control — JVM profiling and diagnostics (JFR)." requires: jdk  install: [ { via: sdkman } ] }
        jmeter:     { attrs: [ GUI app FOSS permissive ] description: "Apache JMeter — load and performance testing." requires: jdk  install: [ { via: sdkman }  { via: brew  name: jmeter } ] }
        racket: { attrs: [ CLI GUI runtime toolchain FOSS permissive ] description: "Racket — a full-spectrum Scheme/Lisp language (ships DrRacket)."
            install: [ { via: native  when: "void or void_musl" }  { via: native  when: "(debian or redhat or arch or alpine) and not amzn"  repo-component: universe } ] }   // uniform `racket` (brew ships a macOS cask, not a formula)
        guile: { attrs: [ CLI runtime toolchain FOSS GNU copyleft ] description: "GNU Guile — the GNU Scheme interpreter."
            install: [ { via: native  when: "not amzn"   repo-component: universe  name: { apt: guile-3.0  dnf: guile30  default: guile } }  { via: brew  name: guile } ] }   // versioned name on debian/fedora
        // Haskell — the GHC compiler. Native (distro ghc) is the default; ghcup is the escape hatch
        // for a MODERN GHC when the distro's is too old to build a recent Hackage package (hlint).
        // GHC's installer configures against the system C toolchain + GMP/libffi/ncurses headers
        // (ghcup's documented "system requirements"); without them ghcup's `./configure` fails
        // (GHCup-00841). Required by the ghcup method below — same shape as python-build-deps.
        ghc-build-deps: { attrs: [ lib FOSS ] description: "System libraries ghcup needs to install GHC (C toolchain, gmp, libffi, ncurses)."
            standing: never-auto
            install: [
                { via: native  when: "void or void_musl"  packages: [ base-devel, gmp-devel, libffi-devel, ncurses-devel ] }
                { via: native  when: "debian"  packages: [ build-essential, libffi-dev, libgmp-dev, libncurses-dev, pkg-config ]  installed-name: libgmp-dev }
                { via: native  when: "(fedora or redhat) and not amzn"  packages: [ gcc, gcc-c++, make, gmp-devel, libffi-devel, ncurses-devel, pkgconf-pkg-config ] }
                { via: native  when: "arch"  packages: [ base-devel, gmp, libffi, ncurses ] }
            ] }
        haskell: { attrs: [ CLI toolchain FOSS permissive ] description: "Haskell toolchain (GHC) — pure functional programming."
            install: [
                { via: native  when: "not amzn"   repo-component: universe  name: { default: ghc } }
                // ghcup — the official Haskell toolchain installer; pulls a modern GHC (+cabal) into
                // ~/.ghcup/bin. never-auto (distro ghc stays the default); a `haskell >= X` floor
                // (hlint) advises pinning here, or `pin set haskell haskell` picks it. `provides` is
                // the floor it guarantees. The cabal driver prepends ~/.ghcup/bin so a ghcup toolchain
                // is used for cabal builds when present. Non-interactive; any rc-write ghcup's
                // installer makes is caught + staged by the shell-writes guard.
                { via: script  when: "not amzn"  standing: never-auto  requires: [ curl, ghc-build-deps ]
                  provides: { haskell: ">=9.10" }     // ghcup's RECOMMENDED GHC (9.10.3 as of 2026-09)
                  install-cmd:   'export BOOTSTRAP_HASKELL_NONINTERACTIVE=1 BOOTSTRAP_HASKELL_INSTALL_NO_STACK=1 ; curl --proto "=https" --tlsv1.2 -fsSL https://get-ghcup.haskell.org | sh'
                  version-cmd:   '"$HOME/.ghcup/bin/ghc" --numeric-version 2>/dev/null'
                  // latest = the GHC ghcup RECOMMENDS (what it installs by default — deliberately
                  // behind the bleeding-edge release for ecosystem compatibility). Needs ghcup on
                  // disk, so it's blank until this method is installed (there's no clean offline
                  // source for ghcup's recommended version).
                  latest-cmd:    '"$HOME/.ghcup/bin/ghcup" list -t ghc -r 2>/dev/null | grep -m1 recommended | cut -d" " -f2'
                  uninstall-cmd: '"$HOME/.ghcup/bin/ghcup" nuke >/dev/null 2>&1 || rm -rf "$HOME/.ghcup"'
                  location:      '~/.ghcup' }  { via: brew  name: ghc } ] }
        // Erlang/OTP + Elixir (elixir pulls erlang, but erlang is nameable on its own).
        erlang: { attrs: [ CLI runtime toolchain FOSS permissive ] description: "Erlang/OTP — battle-tested concurrent, fault-tolerant runtime." install: [ { via: native  when: "(debian or redhat or arch or opensuse) and not amzn"  repo-component: universe }  { via: native  when: "fedora_atomic or void or void_musl" }  { via: brew  name: erlang } ] }   // brew formula `erlang`
        elixir: { attrs: [ CLI toolchain runtime FOSS permissive ] description: "Elixir — functional, concurrent language on the Erlang VM." install: [ { via: native  when: "not amzn"   repo-component: universe }  { via: brew  name: elixir } ] }
        // Nim compiler (nimble ships alongside).
        nim:   { attrs: [ toolchain FOSS permissive ] suggests: nim-glue  description: "Nim — expressive, statically-typed compiled systems language."
            // packaged on arch/opensuse/alpine (alpine = musl build) and brew; NOT in the ubuntu/
            // debian/fedora repos, so those pull the official nim-lang.org prebuilt (glibc x64).
            install: [ { via: native  when: "arch or opensuse or alpine or void or void_musl" }
                       { via: native  when: "fedora_atomic" }
                       { via: tarball  when: "debian or (redhat and not amzn)"  installDir: "$CONFIGSYS_APP_DIR/nim"  requires: [ glibc, xz ]
                         version: { url: "https://nim-lang.org/install_unix.html"  regex: "nim-([0-9]+\.[0-9]+\.[0-9]+)-linux_x64" }
                         url: "https://nim-lang.org/download/nim-$VERSION-linux_x64.tar.xz" }  { via: brew  name: nim } ] }

        // R (statistics) and GNU Octave (numerical computing) — native everywhere.
        r:      { attrs: [ CLI runtime toolchain FOSS copyleft ] suggests: r-dotfiles  description: "R — language and environment for statistical computing." install: [ { via: native  repo-component: universe  name: { xbps: R apt: r-base  dnf: R  pacman: r  zypper: R-base  apk: R  brew: r } }  { via: brew  name: r } ] }
        octave: { attrs: [ CLI GUI app FOSS GNU copyleft ] suggests: octave-dotfiles  description: "GNU Octave — numerical computing, largely MATLAB-compatible." install: [ { via: native  when: "not amzn"   repo-component: universe }  { via: flatpak  hub: flathub  app: org.octave.Octave }  { via: brew  name: octave } ] }
        // Common Lisp: SBCL (the compiler) + Quicklisp (the library manager, bootstrapped by its
        // own lisp script and wired into the SBCL init file).
        sbcl: { attrs: [ CLI toolchain FOSS permissive ] description: "Steel Bank Common Lisp — a fast Common Lisp compiler." install: [ { via: native  when: "not amzn"   repo-component: universe }  { via: brew  name: sbcl } ] }
        quicklisp: { attrs: [ CLI FOSS permissive ] description: "Quicklisp — a library manager for Common Lisp."
            requires: sbcl
            install: [ { via: script
                         install-cmd:   'curl -fsSL https://beta.quicklisp.org/quicklisp.lisp -o /tmp/quicklisp.lisp && yes "" | sbcl --non-interactive --load /tmp/quicklisp.lisp --eval "(quicklisp-quickstart:install)" --eval "(ql:add-to-init-file)" --eval "(quit)" && rm -f /tmp/quicklisp.lisp'
                         version-cmd:   'test -d "$HOME/quicklisp" && echo present'
                         uninstall-cmd: 'rm -rf "$HOME/quicklisp"'
                         location:      '~/quicklisp' } ]
        }

        // --- ecosystem module tools + a sample module each (validated in a podman run) ---
        // opam (OCaml package manager). NOTE: `opam install` needs a one-time `opam init` on a
        // fresh system — the opam driver is validated against opam 2.1.5's CLI, but first use on
        // an uninitialized machine may need `opam init` (tracked; see docs/done/expansion-plan.md).
        opam:  { attrs: [ CLI FOSS copyleft ] suggests: opam-glue  description: "opam — the OCaml package manager." install: [ { via: native  when: "not amzn"  repo-component: universe }  { via: brew  name: opam } ] }
        dune:  { attrs: [ CLI FOSS permissive ] description: "Dune — the build system for OCaml projects." install: [ { via: opam  name: dune }  { via: brew  name: dune } ] }
        // luarocks (Lua package manager; the native package pulls lua) + a sample rock
        // (dkjson is pure-Lua with no C deps, so it installs without lua headers).
        luarocks: { attrs: [ CLI FOSS permissive ] suggests: luarocks-glue  description: "LuaRocks — package manager for Lua modules." install: [ { via: native  when: "not amzn"  repo-component: universe  name: { zypper: lua54-luarocks  default: luarocks } }  { via: brew  name: luarocks } ] }
        dkjson:   { attrs: [ lib FOSS permissive ] description: "dkjson — a pure-Lua JSON encode/decode library." install: [ { via: luarocks  name: dkjson } ] }
        // cabal (Haskell build tool; needs ghc to build) + a sample executable.
        cabal: { attrs: [ CLI FOSS permissive ] suggests: cabal-glue  description: "Cabal — Haskell's build system and package manager." requires: haskell
                 install: [ { via: native  when: "not amzn"   repo-component: universe  name: { apk: cabal  default: cabal-install } }
                            // ghcup's cabal (its RECOMMENDED release) into ~/.ghcup/bin, which the cabal driver
                            // prepends. For a distro cabal too old for today's Hackage: cabal-install < 3.10.2
                            // can't verify Hackage's rotated root keys ("root.json does not have enough
                            // signatures") — Ubuntu 24.04 ships 3.8.1. A `cabal >= 3.10.2` floor (hlint) advises
                            // pinning here. MINIMAL bootstrap = ghcup alone (no GHC); never-auto.
                            { via: script  when: "not amzn"  standing: never-auto  requires: curl
                              provides: { cabal: ">=3.10.2" }
                              install-cmd:   'export BOOTSTRAP_HASKELL_NONINTERACTIVE=1 BOOTSTRAP_HASKELL_MINIMAL=1 ; [ -x "$HOME/.ghcup/bin/ghcup" ] || curl --proto "=https" --tlsv1.2 -fsSL https://get-ghcup.haskell.org | sh ; "$HOME/.ghcup/bin/ghcup" install cabal recommended --set'
                              version-cmd:   '"$HOME/.ghcup/bin/cabal" --numeric-version 2>/dev/null'
                              latest-cmd:    '"$HOME/.ghcup/bin/ghcup" list -t cabal -r 2>/dev/null | grep -m1 recommended | cut -d" " -f2'
                              uninstall-cmd: '"$HOME/.ghcup/bin/ghcup" rm cabal "$("$HOME/.ghcup/bin/cabal" --numeric-version)"'
                              location:      '~/.ghcup/bin/cabal' }  { via: brew  name: cabal-install } ] }
        // hlint's recent releases need a modern GHC to build from Hackage; the distro ghc is often
        // too old. The `haskell >= 9.8` floor advises pinning haskell -> ghcup (auto under
        // `auto-tighten`), and the cabal driver then builds with the ghcup toolchain.
        hlint: { attrs: [ CLI FOSS permissive ] description: "HLint — suggests improvements to Haskell code." requires: [ { haskell: ">=9.8" } { cabal: ">=3.10.2" } ]   // hlint 3.10 is built for GHC 9.8-9.12 (an older GHC only reaches 3.8, reading outdated forever); older cabal can't verify Hackage's root keys
                 install: [ { via: cabal  name: hlint  version: { hackage: hlint } }  { via: brew  name: hlint } ] }

        // Zig — native on Arch/Homebrew; elsewhere the upstream tarball. zig's Linux build is
        // statically linked (runs on glibc AND musl), so no glibc requirement. Its prebuilt
        // binaries live on ziglang.org (not github assets), so github supplies only the VERSION
        // and a url template builds the download.
        zig: { attrs: [ CLI toolchain FOSS permissive ] suggests: zig-glue  description: "Zig — simple, fast systems language and C/C++ toolchain."
            install: [
                { via: native  when: "arch or void or void_musl" }
                { via: native  when: "fedora_atomic" }             // brew formula `zig`
                { via: tarball  installDir: "$CONFIGSYS_APP_DIR/zig"  requires: xz   // a .tar.xz
                  version: { github: ziglang/zig  strip-v: true }
                  // zig 0.14+ swapped the tarball name to zig-<arch>-linux-<ver> (was zig-linux-<arch>-<ver>)
                  url: "https://ziglang.org/download/$VERSION/zig-$ARCH-linux-$VERSION.tar.xz" }
                { via: brew  name: zig }
            ]
        }
        // Julia — official binaries live on the julialang S3 (not github releases), so a pinned
        // version + the S3 tarball URL (glibc build; path carries both the X.Y dir and full
        // version, so bump both on update). Native on Arch/Homebrew where packaged.
        julia: { attrs: [ CLI toolchain runtime FOSS permissive ] suggests: julia-glue  description: "Julia — high-performance language for scientific computing."
            install: [
                { via: native  when: "arch" }                      // pacman: julia
                { via: native  when: "fedora_atomic" }             // brew formula `julia`
                { via: tarball  cpu-names: { x86_64: x86_64 }  installDir: "$CONFIGSYS_APP_DIR/julia"  requires: glibc  version: { static: 1.12.6 }
                  url: "https://julialang-s3.julialang.org/bin/linux/x64/1.12/julia-1.12.6-linux-x86_64.tar.gz" }  { via: brew  name: julia } ]
        }
        // Odin — upstream github release tarball (glibc-linked, so it declines on musl).
        odin: { attrs: [ CLI toolchain FOSS permissive ] suggests: odin-glue  description: "Odin — data-oriented systems programming language."
            install: [
                { via: native  when: "fedora_atomic" }             // brew formula `odin`
                { via: tarball  cpu-names: { x86_64: amd64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/odin"  requires: glibc
                  version: { github: odin-lang/Odin  asset: "odin-linux-$ARCH-*.tar.gz" }
                  url: "https://github.com/odin-lang/Odin/releases/download/$VERSION/odin-linux-$ARCH-$VERSION.tar.gz" }
                { via: brew  name: odin }
            ]
        }

        // --- web browsers ---
        // Firefox is native (in every base repo; openSUSE calls it MozillaFirefox) with the Flathub
        // Flatpak (org.mozilla.firefox) offered as a uniform alternative everywhere — native stays
        // the default where the distro packages it, flatpak wins on atomic (brew has no firefox).
        // Chrome/Brave/Opera/Vivaldi/Edge aren't in any base distro repo, so each wires in its
        // vendor's own apt + dnf repo (native, the default there) with the Flathub Flatpak kept as a
        // uniform candidate everywhere (and the default on openSUSE/atomic, which have no vendor repo
        // set up here). Arch: AUR (google-chrome/brave-bin/opera/microsoft-edge-stable-bin) except
        // vivaldi, which is in the official `extra` repo. Flathub Chrome/Edge are community-maintained.
        firefox: { attrs: [ GUI web app FOSS copyleft tele ] description: "Mozilla Firefox — the open-source web browser." install: [ { via: flatpak  hub: flathub  app: org.mozilla.firefox }
                              { via: native  when: "not fedora_atomic"  repo-component: universe  name: { zypper: MozillaFirefox  default: firefox } }
                              { via: snap  name: firefox } ] }
        // LibreWolf — a privacy-hardened Firefox fork (no telemetry). Its own apt repo (Debian/Ubuntu,
        // suite by $CODENAME) and rpm repo (Fedora + EL, distro-agnostic baseurl); Arch [extra] (was
        // AUR `librewolf-bin`); Flathub everywhere (default on openSUSE/atomic, a candidate everywhere else).
        librewolf: { attrs: [ GUI web app FOSS copyleft ] description: "LibreWolf — a privacy-hardened fork of Firefox (telemetry stripped, sane defaults)."
            install: [
                { via: native  when: "debian"  name: librewolf   // LibreWolf's official apt repo
                  pubkey-url: "https://deb.librewolf.net/keyring.gpg"
                  pubkey-path: /usr/share/keyrings/librewolf.asc
                  source-line: "deb [arch=amd64 signed-by=/usr/share/keyrings/librewolf.asc] https://deb.librewolf.net $CODENAME main"
                  source-path: /etc/apt/sources.list.d/librewolf.list }
                { via: native  when: "redhat"  name: librewolf   // LibreWolf's official rpm repo (Fedora + EL)
                  pubkey-url: "https://rpm.librewolf.net/pubkey.gpg"
                  repo-id: librewolf  repo-name: "LibreWolf Software Repository"
                  repo-url: "https://rpm.librewolf.net" }
                { via: native  when: "arch" }   // Arch [extra]
                { via: flatpak  hub: flathub  app: io.gitlab.librewolf-community } ]
        }
        chromium: { attrs: [ GUI app FOSS permissive ] description: "Chromium — the open-source browser upstream of Chrome." install: [ { via: native  when: "void or void_musl" }  { via: native  when: "((debian or redhat or arch or opensuse) and not ubuntu) and not amzn"  name: { default: chromium } }  { via: snap  name: chromium }  { via: flatpak  hub: flathub  app: org.chromium.Chromium } ] }   // Ubuntu ships chromium ONLY as the (Canonical-official) snap — its apt `chromium-browser` is a snap shim; ubuntu excluded from native so the snap is the sole real method there. Flathub flatpak offered everywhere (+ the only method on atomic).
        chrome:  { attrs: [ GUI app proprietary freeware tele patent ] description: "Google Chrome — Google's web browser."
            install: [
                { via: native  when: "debian"  name: google-chrome-stable   // Google's official apt repo
                  pubkey-url: "https://dl.google.com/linux/linux_signing_key.pub"
                  pubkey-path: /usr/share/keyrings/google-chrome.asc
                  source-line: "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.asc] https://dl.google.com/linux/chrome/deb/ stable main"
                  source-path: /etc/apt/sources.list.d/google-chrome.list }
                { via: native  when: "redhat"  name: google-chrome-stable   // Google's official dnf repo
                  pubkey-url: "https://dl.google.com/linux/linux_signing_key.pub"
                  repo-id: google-chrome  repo-name: "Google Chrome"
                  repo-url: "https://dl.google.com/linux/chrome/rpm/stable/x86_64" }
                { via: aur  name: google-chrome }             // AUR
                { via: flatpak  hub: flathub  app: com.google.Chrome } ]    // Flathub — default on openSUSE/atomic, a candidate everywhere
        }
        brave:   { attrs: [ GUI app FOSS permissive tele ] description: "Brave — a privacy-focused Chromium browser with built-in ad-blocking."
            install: [
                { via: native  when: "debian"  name: brave-browser   // Brave's official apt repo
                  pubkey-url: "https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg"
                  pubkey-path: /usr/share/keyrings/brave-browser-archive-keyring.gpg
                  source-line: "deb [arch=amd64 signed-by=/usr/share/keyrings/brave-browser-archive-keyring.gpg] https://brave-browser-apt-release.s3.brave.com/ stable main"
                  source-path: /etc/apt/sources.list.d/brave-browser-release.list }
                { via: native  when: "redhat"  name: brave-browser   // Brave's official dnf repo
                  pubkey-url: "https://brave-browser-rpm-release.s3.brave.com/brave-core.asc"
                  repo-id: brave-browser  repo-name: "Brave Browser"
                  repo-url: "https://brave-browser-rpm-release.s3.brave.com/x86_64/" }
                { via: aur  name: brave-bin }
                { via: flatpak  hub: flathub  app: com.brave.Browser } ]
        }
        opera:   { attrs: [ GUI app proprietary freeware tele ads ] description: "Opera — a feature-rich Chromium browser."
            install: [
                { via: native  when: "debian"  name: opera-stable   // Opera's official apt repo
                  pubkey-url: "https://deb.opera.com/archive.key"
                  pubkey-path: /usr/share/keyrings/opera.asc
                  source-line: "deb [signed-by=/usr/share/keyrings/opera.asc] https://deb.opera.com/opera-stable/ stable non-free"
                  source-path: /etc/apt/sources.list.d/opera-stable.list }
                { via: native  when: "redhat"  name: opera-stable   // Opera's official dnf repo
                  pubkey-url: "https://rpm.opera.com/rpmrepo.key"
                  repo-id: opera  repo-name: "Opera"
                  repo-url: "https://rpm.opera.com/rpm" }
                { via: aur  name: opera }
                { via: flatpak  hub: flathub  app: com.opera.Opera } ]
        }
        vivaldi: { attrs: [ GUI app proprietary freeware tele ] description: "Vivaldi — a highly customizable Chromium browser."
            install: [
                { via: native  when: "debian"  name: vivaldi-stable   // Vivaldi's official apt repo
                  pubkey-url: "https://repo.vivaldi.com/archive/linux_signing_key.pub"
                  pubkey-path: /usr/share/keyrings/vivaldi-browser.asc
                  source-line: "deb [signed-by=/usr/share/keyrings/vivaldi-browser.asc] https://repo.vivaldi.com/archive/deb/ stable main"
                  source-path: /etc/apt/sources.list.d/vivaldi.list }
                { via: native  when: "redhat"  name: vivaldi-stable   // Vivaldi's official dnf repo
                  pubkey-url: "https://repo.vivaldi.com/archive/linux_signing_key.pub"
                  repo-id: vivaldi  repo-name: "Vivaldi"
                  repo-url: "https://repo.vivaldi.com/archive/rpm/x86_64" }
                { via: native  when: "arch"  name: vivaldi }   // in Arch's official extra repo
                { via: flatpak  hub: flathub  app: com.vivaldi.Vivaldi } ]
        }
        edge:    { attrs: [ GUI app proprietary freeware tele ] description: "Microsoft Edge — a Chromium-based browser."
            install: [
                { via: native  when: "debian"  name: microsoft-edge-stable   // Microsoft's official apt repo
                  pubkey-url: "https://packages.microsoft.com/keys/microsoft.asc"
                  pubkey-path: /usr/share/keyrings/microsoft-edge.asc
                  source-line: "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft-edge.asc] https://packages.microsoft.com/repos/edge stable main"
                  source-path: /etc/apt/sources.list.d/microsoft-edge.list }
                { via: native  when: "redhat"  name: microsoft-edge-stable   // Microsoft's official dnf repo
                  pubkey-url: "https://packages.microsoft.com/keys/microsoft.asc"
                  repo-id: microsoft-edge  repo-name: "Microsoft Edge"
                  repo-url: "https://packages.microsoft.com/yumrepos/edge" }
                { via: aur  name: microsoft-edge-stable-bin }
                { via: flatpak  hub: flathub  app: com.microsoft.Edge } ]
        }
        // Tor — the daemon itself (`tor`); routes traffic through onion circuits. In-repo nearly
        // everywhere; EL has it in EPEL. (Distinct from tor-browser below, the bundled GUI.)
        tor: { attrs: [ CLI daemon FOSS permissive ]
            description: "Tor — the anonymizing overlay-network daemon (`tor`)."
            install: [
                { via: native  when: "rhel"  requires: epel }       // EL ships tor in EPEL
                { via: native  repo-component: universe }            // Debian/Ubuntu(universe)/Fedora/Arch/openSUSE/Alpine/brew
                { via: brew  name: tor }
            ] }
        // Tor Browser via torbrowser-launcher (the official downloader/verifier). Native where
        // packaged (Debian/Ubuntu universe, Fedora, openSUSE), AUR `tor-browser-bin` on Arch, and
        // Flathub everywhere (self-contained — the only method on atomic/musl).
        tor-browser: { attrs: [ GUI app FOSS permissive ]
            description: "Tor Browser — anonymized browsing over the Tor network."
            install: [
                { via: native  when: "debian or fedora or opensuse or void"  repo-component: universe  name: torbrowser-launcher }
                { via: aur  name: tor-browser-bin }
                { via: flatpak  hub: flathub  app: org.torproject.torbrowser-launcher } ]
        }
        // Password managers (Bitwarden). bitwarden = the desktop app (official pacman/zypper pkg;
        // flatpak everywhere incl. atomic; official snap on ubuntu — no apt/dnf repo pkg exists).
        bitwarden: { attrs: [ GUI app electron FOSS copyleft account cloud freemium ] description: "Bitwarden — the desktop password-manager app."
                     install: [ { via: native  when: "arch or opensuse" }
                                { via: flatpak  hub: flathub  app: com.bitwarden.desktop }
                                { via: snap  when: "ubuntu"  name: bitwarden } ] }
        // vaultwarden = a lightweight self-hosted Bitwarden-compatible SERVER. Officially packaged
        // only on arch/fedora/alpine; elsewhere it's run as a container (no core install method) so
        // it declines honestly there.
        vaultwarden: { attrs: [ daemon web FOSS copyleft ] description: "Vaultwarden — a lightweight self-hosted Bitwarden-compatible server (Rust)."
                       install: [ { via: native  when: "arch or fedora or alpine or void or void_musl" } ] }

        // ===================== network + web-dev tooling =====================
        // iproute2 — `ip`/`ss`/`tc`. Native everywhere; EL's dnf calls the package `iproute`.
        iproute2:   { attrs: [ CLI FOSS copyleft ] description: "iproute2 — modern Linux networking tools (`ip`, `ss`)." install: [ { via: native  name: { dnf: iproute  default: iproute2 } } ] }
        bridge-utils: { attrs: [ CLI FOSS GNU copyleft legacy ] description: "bridge-utils (`brctl`) — legacy Ethernet-bridge admin (superseded by iproute2's `ip`)." install: [ { via: native  when: "not fedora_atomic and not arch" } ] }   // Linux-only; not on brew; dropped from Arch repos (iproute2 replaces it)
        dosfstools: { attrs: [ CLI FOSS GNU copyleft ] description: "dosfstools — create and check FAT filesystems (`mkfs.fat`, `fsck.fat`)." install: [ { via: native  when: "not fedora_atomic" }  { via: brew  name: dosfstools } ] }   // Linux-only; not on brew
        // Capture & probe — native CLI staples. Name maps only where distros diverge; the
        // rest carry the same package name everywhere.
        wireshark:  { attrs: [ GUI app FOSS copyleft ] description: "Wireshark — a GUI network protocol analyzer." install: [ { via: native  when: "not fedora_atomic"  name: { pacman: wireshark-qt }
                                   debconf: "wireshark-common wireshark-common/install-setuid boolean true" }
                                 { via: flatpak  hub: flathub  app: org.wireshark.Wireshark } ] }   // GUI analyzer; Arch splits the GUI into wireshark-qt. debconf preseed enables non-root capture on Debian (apt reads it; dnf/pacman ignore it & set dumpcap's caps in-package). Pair with wireshark-group. Flatpak offered everywhere (analyzing .pcap files is zero-config; LIVE capture needs its bundled setuid dumpcap + wireshark-group, like native) — and it's the ONLY GUI on atomic (Linux brew has no wireshark cask, just the CLI formula).
        wireshark-group: { description: "Add your user to the wireshark group (non-root capture)."   // opt-in: non-root capture. usermod -aG wireshark $YOU; needs the group the package creates (hence requires). On Fedora/Arch the package pre-sets dumpcap's file caps, so group membership alone enables capture. On Debian/Ubuntu dumpcap is NOT setcap'd by a non-interactive install — group membership is necessary but not sufficient there (see the wireshark story). Mirrors docker-group.
            requires: wireshark
            install: [ { via: group  name: wireshark } ]
        }
        tshark:     { attrs: [ CLI FOSS copyleft ] description: "TShark — Wireshark's command-line capture/analysis." install: [ { via: native  name: { xbps: wireshark dnf: wireshark-cli  pacman: wireshark-cli  zypper: wireshark  brew: wireshark } }  { via: brew  name: wireshark } ] }   // CLI capture; ships as wireshark-cli on dnf/pacman, tshark on apt; brew's `wireshark` formula is the CLI-only build (tshark/dumpcap — the GUI is a mac-only cask)
        tcpdump:    { attrs: [ CLI FOSS permissive ] description: "tcpdump — command-line packet capture and analysis." install: [ { via: native }  { via: brew  name: tcpdump } ] }
        nmap:       { attrs: [ CLI FOSS copyleft ] description: "Nmap — a network scanner and security probe." install: [ { via: native  when: "void or void_musl"  requires: void-repo-nonfree }  { via: native }  { via: brew  name: nmap } ] }
        openssh-server: { attrs: [ daemon FOSS permissive ] description: "OpenSSH server (`sshd`) — the remote-login daemon." install: [ { via: native  when: "not fedora_atomic"  name: { xbps: openssh pacman: openssh  zypper: openssh  default: openssh-server } } ] }   // pacman/zypper ship server+client in `openssh`
        patch:      { attrs: [ CLI FOSS GNU copyleft ] description: "GNU patch — apply a diff/patch file to source." install: [ { via: native  name: { brew: gpatch  default: patch } }  { via: brew  name: gpatch } ] }
        debhelper:  { attrs: [ CLI FOSS copyleft ] description: "debhelper — the Debian package build-helper tools (`dh`)." install: [ { via: native  when: "debian" } ] }   // Debian packaging tooling; Debian-only
        dh-make:    { attrs: [ CLI FOSS copyleft ] description: "dh-make — generates a Debian source-package skeleton (a `debian/` dir) from an upstream tarball." install: [ { via: native  when: "debian" } ] }   // Debian packaging tooling; Debian-only
        libvirt-clients: { attrs: [ CLI FOSS copyleft ] description: "libvirt client tools (`virsh`) — manage virtualization hosts and guests." install: [ { via: native  when: "not fedora_atomic"  name: { xbps: libvirt apt: libvirt-clients  dnf: libvirt-client  pacman: libvirt  apk: libvirt-client  zypper: libvirt-client } } ] }
        pulseaudio-utils: { attrs: [ CLI FOSS copyleft ] description: "PulseAudio utilities (`pactl`, `paplay`) — inspect and drive the audio server." install: [ { via: native  when: "not fedora_atomic"  name: { pacman: libpulse  default: pulseaudio-utils } } ] }   // pacman ships pactl in libpulse
        mtr:        { attrs: [ CLI TUI FOSS copyleft ] description: "Live network diagnostic — ping + traceroute in one display."
                      install: [ { via: native }  { via: brew  name: mtr } ] }
        // Mosh — a robust remote shell over UDP that survives roaming and connection drops. One
        // package ships both the `mosh` client and `mosh-server` (there is no separate server pkg).
        mosh:       { attrs: [ CLI FOSS GNU copyleft ] description: "Mosh — a remote terminal over UDP that survives roaming and network drops (`mosh` + `mosh-server`)."
                      install: [ { via: native  when: "rhel"  requires: epel }
                                 { via: native  when: "not rhel"  repo-component: universe }  { via: brew  name: mosh } ] }
        traceroute: { attrs: [ CLI FOSS copyleft ] description: "Trace the network path to a host, hop by hop." install: [ { via: native  when: "not fedora_atomic" } ] }   // no `traceroute` brew formula (Homebrew has mtr/tcptraceroute instead); macOS ships it in base — so decline on brew-native atomic rather than fail
        iperf3:     { attrs: [ CLI FOSS permissive ] description: "iperf3 — measure network throughput between two hosts." install: [ { via: native  name: { zypper: iperf  default: iperf3 } }  { via: brew  name: iperf3 } ] }   // brew `iperf` is iperf2
        socat:      { attrs: [ CLI FOSS copyleft ] description: "Multipurpose socket relay — bidirectional data between two endpoints." install: [ { via: native }  { via: brew  name: socat } ] }
        ethtool:    { attrs: [ CLI FOSS copyleft ] description: "ethtool — query and control NIC driver/hardware settings." install: [ { via: native } ] }
        whois:      { attrs: [ CLI FOSS copyleft ] description: "Domain/IP registration lookup (`whois`)." install: [ { via: native }  { via: brew  name: whois } ] }
        netcat:     { attrs: [ CLI FOSS ] description: "TCP/UDP swiss-army knife (`nc`) — connect, listen, pipe raw sockets." install: [ { via: native  name: { xbps: openbsd-netcat dnf: nmap-ncat  pacman: openbsd-netcat  brew: netcat  default: netcat-openbsd } } ] }   // the BSD nc; Fedora ships it as nmap-ncat, Arch as openbsd-netcat; brew has only GNU `netcat` (same `nc` role, GNU flags)
        // --- easy end-to-end file/terminal sharing ---
        croc:       { attrs: [ CLI FOSS permissive ] description: "croc — securely send files/folders between any two machines with a shared code phrase." install: [ { via: native  when: "arch or alpine or void or void_musl" }  { via: native  when: "fedora_atomic" }  { via: tarball  cpu-names: { x86_64: 64bit  aarch64: ARM64 }  installDir: "$CONFIGSYS_APP_DIR/croc"  version: { github: schollz/croc  strip-v: true  asset: "croc_v*_Linux-$ARCH.tar.gz" } }  { via: brew  name: croc } ] }   // static Go binary -> tarball runs everywhere (incl. musl); brew on atomic; not in Debian/Fedora/EL/openSUSE repos
        wormhole:   { attrs: [ CLI FOSS permissive ] description: "magic-wormhole — get things from one computer to another safely (`wormhole send`/`receive`)." install: [ { via: native  when: "debian or arch or fedora_atomic or void or void_musl"  name: magic-wormhole  repo-component: universe }  { via: pipx  name: magic-wormhole }  { via: brew  name: magic-wormhole } ] }   // the binary is `wormhole`; in-repo on Debian/Ubuntu + Arch + brew (atomic) (removed from Fedora 37+, not in openSUSE's default repos, absent on Alpine) -> pipx is the universal fallback
        ttyd:       { attrs: [ CLI web FOSS permissive ] description: "ttyd — share your terminal over the web (a browser-based terminal, `ttyd`)." install: [ { via: native  repo-component: universe }  { via: native  when: "fedora_atomic" }  { via: brew  name: ttyd } ] }   // C; packaged widely (Debian bookworm+, Fedora, Arch, Alpine, openSUSE) + brew on atomic
        dig:        { attrs: [ CLI FOSS permissive ] description: "DNS lookup tool (`dig`) — query records and troubleshoot resolution." install: [ { via: native  name: { apt: dnsutils  dnf: bind-utils  pacman: bind  apk: bind-tools  zypper: bind-utils  brew: bind  default: bind-utils } }  { via: brew  name: bind } ] }   // dig/nslookup; apt `dnsutils` is the transitional metapkg (resolves on old + new), Arch/Homebrew ship the tools in `bind`

        // Traffic monitors — live per-interface/-process bandwidth. In EPEL on EL, base repos
        // elsewhere (the same two-binding shape as btop).
        iftop:   { attrs: [ TUI FOSS copyleft ] description: "iftop — a live per-connection bandwidth monitor." install: [ { via: native  when: "rhel"  requires: epel } { via: native }  { via: brew  name: iftop } ] }
        nethogs: { attrs: [ TUI FOSS copyleft ] description: "NetHogs — a per-process network bandwidth monitor." install: [ { via: native  when: "rhel"  requires: epel } { via: native }  { via: brew  name: nethogs } ] }
        nload:   { attrs: [ TUI FOSS copyleft ] description: "nload — a console real-time network traffic monitor." install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"  }  { via: brew  name: nload } ] }
        // gping: ping with a live graph (Rust). Native where packaged (Arch, Alpine, Homebrew, and
        // Debian>=13/Ubuntu>=23.10); Fedora is COPR-only and older Debian/Ubuntu/openSUSE/EL lack
        // it, so cargo builds it there.
        gping:   { attrs: [ CLI TUI FOSS permissive ] description: "Ping, but with a live graph (`gping`)."
                   install: [ { via: native  when: "void or void_musl" }  { via: native  when: "arch or alpine or fedora_atomic or (ubuntu >= 23.10) or (debian >= 13)" }
                              { via: cargo  name: gping  version: { crates: gping } }  { via: brew  name: gping } ] }
        vnstat:  { attrs: [ CLI daemon FOSS copyleft ] description: "vnStat — a network traffic logger and stats tool." install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"  }  { via: brew  name: vnstat } ] }
        bmon:    { attrs: [ TUI FOSS permissive ] description: "bmon — a bandwidth monitor and rate estimator (per-interface)." install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "debian or fedora or arch or opensuse or alpine or amzn or void or void_musl" }  { via: brew  name: bmon } ] }
        wavemon: { attrs: [ TUI FOSS copyleft ] description: "wavemon — an ncurses monitor for wireless network devices." install: [ { via: native  when: "debian or fedora or arch or opensuse or alpine or void or void_musl"  repo-component: universe }  { via: brew  name: wavemon } ] }   // Ubuntu universe; not in EPEL/Amazon/atomic
        // Rust hardware/audio TUIs — native only where packaged (arch/alpine/openSUSE, +debian/fedora
        // for wiremix); cargo builds them everywhere else.
        impala:  { attrs: [ TUI FOSS copyleft ] description: "impala — a TUI to manage Wi‑Fi networks (uses the `iwd` daemon)."
                   install: [ { via: native  when: "arch or alpine or opensuse or void or void_musl" }
                              { via: cargo   name: impala  version: { crates: impala } } ] }
        bluetui: { attrs: [ TUI app FOSS permissive ] description: "bluetui — a TUI to manage Bluetooth devices (uses BlueZ)."
                   install: [ { via: native  when: "arch or opensuse or void or void_musl" }
                              { via: cargo   name: bluetui  version: { crates: bluetui } } ] }   // native on arch/opensuse/alpine(impala only); cargo covers the rest and is pinnable anywhere
        wiremix: { attrs: [ TUI app FOSS permissive ] description: "wiremix — a TUI audio mixer for PipeWire."
                   install: [ { via: native  when: "fedora or arch or opensuse or void or void_musl" }
                              // cargo builds libspa-sys from source -> needs the PipeWire dev headers + pkg-config
                              // (absent on immutable atomic, so decline there rather than source-build on it)
                              { via: cargo   name: wiremix  requires: [ cargo, pipewire-dev, pkg-config ]  version: { crates: wiremix } } ] }   // pipewire-dev requires: naturally declines cargo where the headers are absent (e.g. atomic)   // Debian/Alpine don't carry it in-repo -> cargo there
        // dnspeep: watch the DNS queries your machine makes. Not distro-packaged nor on crates.io —
        // upstream's glibc release tarball is a single `dnspeep` binary (dnspeep-glue PATHs it);
        // declines on musl Alpine. Runs as root (libpcap).
        dnspeep: { attrs: [ CLI FOSS permissive ] suggests: dnspeep-glue  description: "dnspeep — spy on the DNS queries your computer makes (needs root)."
            install: [ { via: tarball  when: "not alpine"  installDir: "$CONFIGSYS_APP_DIR/dnspeep"  requires: glibc
                         version: { github: jvns/dnspeep  strip-v: true  asset: "dnspeep-linux.tar.gz" } } ] }   // asset lives INSIDE version: (the tarball driver reads version.asset)
        dnspeep-glue: { description: "dnspeep shell setup, linked into place." install: [ { via: glue  requires: shell-glue  glue: dnspeep } ] }

        // Web/HTTP dev — httpie + jq native (httpie via EPEL on EL); yq/mitmproxy isolated via
        // pipx; xh/websocat are Rust crates.
        httpie:    { attrs: [ CLI FOSS permissive ] suggests: httpie-dotfiles  description: "Human-friendly HTTP client (`http`) — a nicer curl for APIs." install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"  }  { via: brew  name: httpie } ] }   // the `http`/`https` CLI
        jq:        { attrs: [ CLI FOSS permissive ] suggests: jq-glue  description: "Command-line JSON processor — query and transform JSON."
                     install: [ { via: native }
                                { via: tarball  cpu-names: { x86_64: amd64  aarch64: arm64 }  archive: none  binary: jq  installDir: "$CONFIGSYS_APP_DIR/jq"  version: { github: jqlang/jq  asset: "jq-linux-$ARCH" } }  { via: brew  name: jq } ] }   // upstream ships a raw static binary
        yq:        { attrs: [ CLI FOSS permissive ] description: "YAML/JSON/XML processor — jq, but for YAML." requires: jq                                                                    // the jq-family yq (yq/xq/tomlq) — shells out to jq at runtime; NOT mikefarah's Go yq
                     install: [ { via: pipx  name: yq  version: { pypi: yq } }  { via: brew  name: python-yq } ] }   // brew python-yq = this jq-wrapping yq (brew's `yq` is mikefarah's Go yq)
        // mitmproxy 12+ needs Python >=3.12, but a pipx venv built on an OLD system python (Pop
        // 22.04 / Debian 11-12 ship 3.10-3.11) silently caps upgrades at the last compatible release
        // (11.x). On debian, build the venv with deadsnakes' python3.13 — the FULL path /usr/bin/
        // python3.13 (not the bare name, which PATH may resolve to a uv/pyenv-managed build that
        // breaks pipx venv creation). The other distros (Fedora/Arch/atomic/…) already ship 3.12+, so
        // plain pipx uses the system python (and python3.13 doesn't even resolve on atomic — pyenv
        // needs build deps absent there).
        mitmproxy: { attrs: [ CLI TUI FOSS permissive ] description: "Interactive HTTPS proxy — intercept, inspect, and replay traffic." install: [ { via: pipx  when: "debian"  name: mitmproxy  standing: 1  python: "/usr/bin/python3.13"  requires: python3.13  version: { pypi: mitmproxy } }  { via: pipx  when: "not debian"  name: mitmproxy  standing: 1  version: { pypi: mitmproxy } }  { via: flatpak  hub: flathub  app: org.mitmproxy.mitmproxy } ] }   // pipx (official PyPI) stays the default; the Flathub build is an offered option
        xh:        { attrs: [ CLI FOSS permissive ] suggests: xh-glue  description: "Fast HTTPie-compatible HTTP client (`xh`), written in Rust." install: [ { via: cargo  name: xh  version: { crates: xh } }  { via: tarball  cpu-names: { x86_64: x86_64  aarch64: aarch64 }  installDir: "$CONFIGSYS_APP_DIR/xh"  version: { github: ducaale/xh  asset: "xh-*-$ARCH-unknown-linux-musl.tar.gz" } }  { via: brew  name: xh } ] }                // prebuilt musl binary is the default over building from source
        websocat:  { attrs: [ CLI FOSS permissive ] suggests: websocat-glue  description: "netcat for WebSockets — connect, pipe, and script ws:// endpoints." install: [ { via: cargo  name: websocat  version: { crates: websocat } }  { via: tarball  cpu-names: { x86_64: x86_64  aarch64: aarch64 }  archive: none  binary: websocat  installDir: "$CONFIGSYS_APP_DIR/websocat"  version: { github: vi/websocat  asset: "websocat.$ARCH-unknown-linux-musl" } }  { via: brew  name: websocat } ] }   // prebuilt musl binary default

        // GUI API clients — Flatpak from Flathub, like chrome (all community-maintained, current).
        postman:  { attrs: [ GUI app electron proprietary account cloud freemium ] description: "Postman — a GUI for building and testing APIs." install: [ { via: flatpak  hub: flathub  app: com.getpostman.Postman }  { via: snap  name: postman } ] }
        insomnia: { attrs: [ GUI app FOSS permissive electron account ] description: "Insomnia — an open-source API client and design tool." install: [ { via: flatpak  hub: flathub  app: rest.insomnia.Insomnia }  { via: native-pkg-file  when: "debian or redhat"  version: { github: Kong/insomnia  tag-re: "core@([0-9][0-9.]*)" }  asset: { deb: { x86_64: "Insomnia.Core-*.deb" }  rpm: { x86_64: "Insomnia.Core-*.rpm" } } } ] }   // monorepo: tag-re scopes to core@ tags (ignoring inso@/lib@); prerelease core@ betas are skipped so it doesn't read perpetually-outdated vs the latest STABLE .deb
        bruno:    { attrs: [ GUI app electron FOSS permissive freemium ] description: "Bruno — a fast, git-friendly, offline-first API client." install: [ { via: flatpak  hub: flathub  app: com.usebruno.Bruno }  { via: native-pkg-file  when: "debian or redhat"  version: { github: usebruno/bruno  strip-v: true }  asset: { deb: { x86_64: "bruno_*_amd64_linux.deb" }  rpm: { x86_64: "bruno_*_x86_64_linux.rpm" } } } ] }   // upstream .deb (amd64)/.rpm (x86_64 token differs)
        tree-sitter-cli: { attrs: [ CLI FOSS permissive ] suggests: tree-sitter-cli-glue  description: "tree-sitter CLI — build and test tree-sitter grammars."
            install: [ { via: cargo  name: tree-sitter-cli  standing: 1  version: { crates: tree-sitter-cli }   // kept the default (some want it built from source, without the prebuilt-binary apparatus)
                         requires: { cargo: ">=1.90" } }   // current releases' MSRV (0.27: rustc 1.90); an older distro rust (24.04: 1.75) -> advises rustup, or pin the tarball
                       { via: tarball  cpu-names: { x86_64: x64  aarch64: arm64 }  archive: gz  binary: tree-sitter  installDir: "$CONFIGSYS_APP_DIR/tree-sitter"  version: { github: tree-sitter/tree-sitter  asset: "tree-sitter-linux-$ARCH.gz" } }  { via: brew  name: tree-sitter-cli } ]   // upstream ships a plain-gzipped single binary
        }
        mononoki-nerd: { attrs: [ font FOSS permissive ] description: "Mononoki Nerd Font — a clean monospace coding font with icons."
            install: [ { via: font  name: Mononoki          // -> requires fontconfig + unzip
                         version: { github: ryanoasis/nerd-fonts  asset: "Mononoki.zip" }
                         url: "https://github.com/ryanoasis/nerd-fonts/releases/download/$VERSION/Mononoki.zip" } ]
        }

        // when:-varying: native on Pop (the NVIDIA rig), flatpak elsewhere
        // Steam — native wherever it's packaged (needs 32-bit: apt i386 multiarch via foreign-arch,
        // Arch multilib enabled once by the user, Fedora RPM Fusion nonfree); Flathub is the universal
        // fallback (the only method on Alpine[musl]/atomic/EL). Pop keeps its known-good `steam:i386`
        // binding (wins over the general ubuntu one by specificity).
        steam: { attrs: [ GUI app proprietary account cloud online ] description: "Steam — Valve's game store and launcher."
            install: [
                { via: native   when: "pop_os!"  name: "steam:i386"  foreign-arch: i386 }
                { via: native   when: "ubuntu"  name: steam-installer  repo-component: multiverse  foreign-arch: i386 }
                { via: native   when: "debian and not ubuntu"  name: steam-installer  repo-component: non-free  foreign-arch: i386 }
                { via: native   when: "arch"  name: steam }                      // multilib (user enables it once)
                { via: native   when: "fedora"  name: steam  requires: rpmfusion-nonfree }   // RPM Fusion nonfree; EL/alpine/atomic -> flatpak
                { via: native   when: "opensuse"  name: steam }
                { via: flatpak  hub: flathub  app: com.valvesoftware.Steam }
            ]
        }

        // Wine — Windows compatibility layer. Distro-native everywhere; debian/ubuntu need i386
        // multiarch (handled by foreign-arch), Arch needs the `multilib` repo enabled (user does that
        // once). WineHQ's own repo ships newer builds — not modeled (per-codename); the distro Wine
        // is a fine default. winetricks fetches runtime DLLs/fonts into a prefix.
        wine: { attrs: [ GUI runtime FOSS copyleft ] description: "Wine — run Windows applications on Linux."
            install: [ { via: native  when: "debian or void or void_musl"  foreign-arch: i386 }
                       { via: native  when: "rhel"  requires: epel }   // wine ships in EPEL
                       { via: native  when: "fedora or arch or alpine or opensuse" } ] }
        winetricks: { attrs: [ CLI FOSS copyleft ] description: "winetricks — fetch runtime DLLs/fonts and tweak Wine prefixes." requires: wine
            install: [ { via: native  when: "rhel"  requires: epel }   // EPEL8+
                       { via: native  when: "debian or fedora or arch or opensuse or void or void_musl"  repo-component: universe }  { via: brew  name: winetricks } ] }   // not in Alpine's repos
        // Proton tooling. Proton itself is SELF-CONTAINED (bundles its own Wine + DXVK/VKD3D + a Steam
        // runtime) and is installed BY Steam (Steam Play) — not a package, and independent of the
        // system `wine` above. What you install by hand is the community tooling: ProtonUp-Qt (the GUI
        // that fetches GE-Proton and other custom compat tools into ~/.steam/…/compatibilitytools.d)
        // and protontricks (winetricks for Proton game prefixes). No `requires: wine` — both are for
        // Steam's Proton stack, which carries its own Wine.
        protonup-qt: { attrs: [ GUI app FOSS copyleft ] description: "ProtonUp-Qt — a GUI to install & manage GE-Proton and other Steam/Wine compatibility tools."
            install: [ { via: flatpak  hub: flathub  app: net.davidotek.pupgui2 }
                       { via: aur  name: protonup-qt } ] }
        protontricks: { attrs: [ CLI GUI app FOSS copyleft ] description: "protontricks — winetricks for Steam Proton game prefixes."
            install: [ { via: native  when: "arch or void or void_musl" }  { via: flatpak  hub: flathub  app: com.github.Matoking.protontricks }
                       { via: pipx  name: protontricks  standing: never-auto } ] }

        // --- apps: native everywhere. A clean-config tool manages its ~/.config as a
        // dir-dotfile (content in dotfiles/<name>/ symlinked to $XDG_CONFIG_HOME/<name>, like
        // neovim). The dotfiles are `suggests:` (soft) so the app installs before dotfiles/<name>/
        // has your content. Apps with a FAT ~/.config (profile + cache/state) only `suggests:`
        // their dotfiles for now — pending a dir-vs-specific-files call.
        podman: { attrs: [ CLI FOSS permissive ] description: "Podman — daemonless, rootless container engine (docker-compatible)."
            suggests: podman-dotfiles
            install: [ { via: native  when: "not amzn"   repo-component: universe } ]   // apt universe / dnf (EL AppStream) / pacman
        }
        podman-dotfiles: { description: "Podman config, linked into place."   // ~/.config/containers — shared by podman / buildah / skopeo
            install: [ { via: dotfiles  config: { src: containers  dst: $XDG_CONFIG_HOME/containers } } ]
        }

        libreoffice: { attrs: [ GUI app FOSS permissive copyleft ] description: "LibreOffice — the open-source office suite."   // fat ~/.config/libreoffice (profile + cache) — dotfiles pending
            suggests: libreoffice-dotfiles
            install: [ { via: flatpak  hub: flathub  app: org.libreoffice.LibreOffice }   // uniform option everywhere; the only method on atomic (brew's libreoffice is a mac-only cask)
                       // install the `libreoffice` meta but DETECT via libreoffice-core: Debian/Ubuntu/
                       // Pop commonly ship the suite as the parts (-core/-calc/…) WITHOUT the meta, so
                       // probing the meta falsely reports "missing". libreoffice-core is present
                       // whenever any LibreOffice is. Fedora splits the suite the same way (Workstation
                       // ships -core/-writer/… without the meta). Keyed per manager: pacman installs
                       // libreoffice-fresh, which is itself what's present; zypper's `libreoffice` IS
                       // the core; apk/xbps (no -core package) probe the meta they install.
                       { via: native  when: "(not fedora_atomic) and not amzn"  repo-component: universe
                         name: { pacman: libreoffice-fresh }  installed-name: { apt: libreoffice-core  dnf: libreoffice-core } } ]
        }

        // kicad: native where it's packaged, Flathub (org.kicad.KiCad) where it isn't. It's in
        // NO EL9 repo (base/EPEL/CRB/RPM Fusion, verified on rockylinux:9), so native is guarded
        // `not rhel` and the flatpak binding catches EL (and is a per-machine `pin` away anywhere
        // the distro package is too old). A from-source build is the configsys-kicad plugin's
        // `kicad-build` override, the way blender-build overrides native blender.
        kicad: { attrs: [ GUI app FOSS copyleft ] description: "KiCad — electronics design (schematics and PCB layout)."   // fat-ish config — dotfiles pending
            suggests: kicad-dotfiles
            install: [ { via: flatpak  when: fedora_atomic  hub: flathub  app: org.kicad.KiCad }   // atomic: more specific than `not rhel` so flatpak wins over brew (mac-only cask)
                       { via: native   when: "(not rhel) and not amzn"  repo-component: universe }
                       { via: flatpak  hub: flathub  app: org.kicad.KiCad } ]
        }

        // blender: the easy default is the native package (the editor). A from-source build
        // (to get a `bpy` module matching your editor) is a personal override that lives in a
        // user layer, the way a Pop-only native Steam does. Fat versioned config
        // (~/.config/blender/<ver>) — dotfiles deferred. On EL it's in EPEL; base repos elsewhere.
        blender: { attrs: [ GUI app FOSS copyleft ] description: "Blender — 3D modeling, animation, and rendering suite."
            suggests: blender-dotfiles
            install: [ { via: flatpak  hub: flathub  app: org.blender.Blender }   // uniform option everywhere; the only method on atomic (brew's blender is a mac-only cask)
                       { via: native  when: "rhel"  requires: epel }
                       { via: native  when: "(not fedora_atomic) and not amzn"  repo-component: universe }
                       { via: snap  name: blender  classic: true } ]   // Blender-official snap (never-auto)
        }

        // GPU compute toolchains + NVIDIA infra. General-purpose — used well beyond Blender/OpenCV —
        // so they live in base. NVIDIA CUDA is a VERSION-SCOPED capability: cuda-toolkit-11 and -12
        // each `provides: { cuda-toolkit: N }`, so a consumer can select by version —
        // `requires: { cuda-toolkit: ">=12" }` (cudnn-9) picks 12, `"<12"` (cudnn-8) picks 11 (the
        // constraint ENABLES the opt-in -11). A version-agnostic consumer (`requires: cuda-toolkit`,
        // e.g. a source-build Blender's Cycles backends) takes the DEFAULT — cuda-toolkit-12; -11 is
        // `opt-in` so it never becomes the generic default, but it's still adopted when it's the one
        // actually installed (the detection tier) or named/constrained. The -12 toolkit + versioned
        // cuDNNs ride NVIDIA's network repo (cuda-repo) — real GPU work wants the vendor repo, not the
        // lagging distro one; -11 stays the low-friction distro package for the older CUDA-11 line.
        // Convenience aliases to the current default line (CUDA 12 / cuDNN 9) so `cuda`/`cudnn`
        // just work installed by name or in a profile. Pure `via: parts` aggregators (no unit of
        // their own); they deliberately do NOT provide the cuda-toolkit capability — dependants
        // (blender, opencv, …) keep requiring the VERSIONED cuda-toolkit/cuDNN capability directly,
        // untouched. cudnn already pulls cuda-toolkit-12 via its versioned requires. Bump the part
        // when the default line moves.
        cuda:  { attrs: [ SDK toolchain proprietary freeware ] description: "NVIDIA CUDA Toolkit — alias for the current default line (CUDA 12)."  install: [ { via: parts  parts: [ cuda-toolkit-12 ] } ] }
        cudnn: { attrs: [ lib proprietary freeware ] description: "NVIDIA cuDNN — alias for the current default line (cuDNN 9)."          install: [ { via: parts  parts: [ cudnn-9 ] } ] }
        cuda-toolkit-11: { attrs: [ SDK toolchain proprietary freeware ] description: "NVIDIA CUDA Toolkit 11 — GPU compute compiler and libraries (distro package)."
            standing: never-auto  provides: { cuda-toolkit: 11 }
            install: [ { via: native  when: "debian or redhat or arch"  name: { apt: nvidia-cuda-toolkit  dnf: cuda  pacman: cuda } } ]   // only these package a distro CUDA; no CUDA in Alpine/openSUSE base
        }
        cuda-toolkit-12: { attrs: [ SDK toolchain proprietary freeware ] description: "NVIDIA CUDA Toolkit 12 (from NVIDIA's CUDA repo)."
            provides: { cuda-toolkit: 12 }
            install: [
                { via: native  when: "arch"  name: cuda }              // Arch: rolling latest (12.x)
                { via: script  when: "debian"  requires: cuda-repo
                  install-cmd:   'sudo apt-get install -y cuda-toolkit-12-6 && sudo ldconfig'
                  version-cmd:   "dpkg-query -W -f='${Version}' cuda-toolkit-12-6 2>/dev/null"
                  latest-cmd:    'apt-cache policy cuda-toolkit-12-6 2>/dev/null | grep Candidate'
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo apt-get remove -y cuda-toolkit-12-6 && sudo ldconfig'
                  location:      'cuda-toolkit-12-6 (apt)' }
                { via: script  when: "redhat"  requires: cuda-repo
                  install-cmd:   'sudo dnf install -y cuda-toolkit-12-6 && sudo ldconfig'
                  version-cmd:   'rpm -q --qf %{VERSION} cuda-toolkit-12-6 2>/dev/null'
                  latest-cmd:    "dnf -q repoquery --qf '%{version}' cuda-toolkit-12-6 2>/dev/null | tail -1"
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo dnf remove -y cuda-toolkit-12-6'
                  location:      'cuda-toolkit-12-6 (dnf)' }
            ]
        }
        // CUDA 12.8 — a VERSIONED CUDA-12 point release, side by side with cuda-toolkit-12's 12.6
        // (NVIDIA's packages install under /usr/local/cuda-12.X and coexist). never-auto: nothing
        // defaults to it; a consumer's `cuda-toolkit: ">=12.8"` floor selects it. First needed by
        // Blender 5.x (its release CUDA; 12.6's nvcc rejects gcc-14 as the host compiler — "gcc
        // versions later than 13 are not supported" — and can't target sm_120).
        cuda-toolkit-12.8: { attrs: [ SDK toolchain proprietary freeware ] description: "NVIDIA CUDA Toolkit 12.8 (from NVIDIA's CUDA repo; installs beside other 12.x)."
            standing: never-auto  provides: { cuda-toolkit: 12.8 }
            install: [
                { via: script  when: "debian"  requires: cuda-repo
                  install-cmd:   'sudo apt-get install -y cuda-toolkit-12-8 && sudo ldconfig'
                  version-cmd:   "dpkg-query -W -f='${Version}' cuda-toolkit-12-8 2>/dev/null"
                  latest-cmd:    'apt-cache policy cuda-toolkit-12-8 2>/dev/null | grep Candidate'
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo apt-get remove -y cuda-toolkit-12-8 && sudo ldconfig'
                  location:      '/usr/local/cuda-12.8' }
                { via: script  when: "redhat"  requires: cuda-repo
                  install-cmd:   'sudo dnf install -y cuda-toolkit-12-8 && sudo ldconfig'
                  version-cmd:   'rpm -q --qf %{VERSION} cuda-toolkit-12-8 2>/dev/null'
                  latest-cmd:    "dnf -q repoquery --qf '%{version}' cuda-toolkit-12-8 2>/dev/null | tail -1"
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo dnf remove -y cuda-toolkit-12-8'
                  location:      '/usr/local/cuda-12.8' }
            ]
        }
        // cuda-repo — set up NVIDIA's CUDA network repo (the apt/dnf source cuDNN & CUDA come from).
        // `via: script` because the URL is distro-codename-specific; derived from /etc/os-release
        // (UBUNTU_CODENAME covers ubuntu derivatives). Not needed on Arch (official repos).
        cuda-repo: { attrs: [ headless proprietary freeware ]
            description: "NVIDIA CUDA network repo (apt/dnf) — the source cuDNN & CUDA packages come from."
            install: [
                { via: script  when: "debian"
                  install-cmd:   'set -e; . /etc/os-release; if [ -n "${UBUNTU_CODENAME:-}" ]; then case "$UBUNTU_CODENAME" in focal) SEG=ubuntu2004;; jammy) SEG=ubuntu2204;; noble) SEG=ubuntu2404;; *) SEG=ubuntu2204;; esac; elif [ "$ID" = debian ]; then SEG="debian${VERSION_ID%%.*}"; else SEG="${ID}$(echo "$VERSION_ID" | tr -d .)"; fi; A="$(uname -m)"; if [ "$A" = aarch64 ]; then A=sbsa; else A=x86_64; fi; T="$(mktemp -d)"; curl -fSL "https://developer.download.nvidia.com/compute/cuda/repos/$SEG/$A/cuda-keyring_1.1-1_all.deb" -o "$T/k.deb"; sudo dpkg -i "$T/k.deb"; sudo apt-get update; rm -rf "$T"'
                  version-cmd:   "dpkg-query -W -f='${Version}' cuda-keyring 2>/dev/null"
                  latest-cmd:    'apt-cache policy cuda-keyring 2>/dev/null | grep Candidate'
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo apt-get remove -y cuda-keyring'
                  location:      '/etc/apt/sources.list.d/cuda-*.list (+ cuda-keyring)' }
                { via: script  when: "redhat"
                  install-cmd:   'set -e; . /etc/os-release; case "$ID" in fedora) SEG="fedora$VERSION_ID";; *) SEG="rhel${VERSION_ID%%.*}";; esac; A="$(uname -m)"; if [ "$A" = aarch64 ]; then A=sbsa; else A=x86_64; fi; sudo dnf config-manager --add-repo "https://developer.download.nvidia.com/compute/cuda/repos/$SEG/$A/cuda-$SEG.repo"; sudo dnf -q clean expire-cache'
                  version-cmd:   'ls /etc/yum.repos.d/cuda-*.repo >/dev/null 2>&1 && echo present'
                  version-re:    '(present)'
                  uninstall-cmd: 'sudo rm -f /etc/yum.repos.d/cuda-*.repo'
                  location:      '/etc/yum.repos.d/cuda-*.repo' }
            ]
        }
        // cuDNN, versioned — DNN primitives, useful well beyond OpenCV (any CUDA ML build). Each is an
        // EXPLICIT, self-consistent choice a stack requires (never auto-detected at install). debian/
        // redhat use `via: script` = install the dev package AND run ldconfig (NVIDIA's libcudnn
        // packages skip the ldconfig trigger, so the runtime .so isn't cached). `requires: cuda-repo`
        // adds NVIDIA's source. Arch ships one rolling `cudnn` (currently 9.x) — attached to cudnn-9.
        cudnn-8: { attrs: [ lib proprietary freeware ]
            description: "NVIDIA cuDNN 8 — DNN primitives for the CUDA 11 line."
            requires: { cuda-toolkit: "<12" }
            install: [
                { via: script  when: "debian"  requires: cuda-repo
                  install-cmd:   'sudo apt-get install -y libcudnn8-dev && sudo ldconfig'
                  version-cmd:   "dpkg-query -W -f='${Version}' libcudnn8-dev 2>/dev/null"
                  latest-cmd:    'apt-cache policy libcudnn8-dev 2>/dev/null | grep Candidate'
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo apt-get remove -y libcudnn8-dev && sudo ldconfig'
                  location:      'libcudnn8-dev (apt) + ldconfig cache' }
                { via: script  when: "redhat"  requires: cuda-repo
                  install-cmd:   'sudo dnf install -y libcudnn8-devel && sudo ldconfig'
                  version-cmd:   'rpm -q --qf %{VERSION} libcudnn8-devel 2>/dev/null'
                  latest-cmd:    "dnf -q repoquery --qf '%{version}' libcudnn8-devel 2>/dev/null | tail -1"
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo dnf remove -y libcudnn8-devel && sudo ldconfig'
                  location:      'libcudnn8-devel (dnf) + ldconfig cache' }
            ]
        }
        cudnn-9: { attrs: [ lib proprietary freeware ]
            description: "NVIDIA cuDNN 9 — DNN primitives for the CUDA 12 line."
            requires: { cuda-toolkit: ">=12" }
            install: [
                { via: native  when: "arch"  name: cudnn }             // Arch's rolling cudnn (9.x); pacman runs ldconfig
                { via: script  when: "debian"  requires: cuda-repo
                  install-cmd:   'sudo apt-get install -y libcudnn9-dev-cuda-12 && sudo ldconfig'
                  version-cmd:   "dpkg-query -W -f='${Version}' libcudnn9-dev-cuda-12 2>/dev/null"
                  latest-cmd:    'apt-cache policy libcudnn9-dev-cuda-12 2>/dev/null | grep Candidate'
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo apt-get remove -y libcudnn9-dev-cuda-12 && sudo ldconfig'
                  location:      'libcudnn9-dev-cuda-12 (apt) + ldconfig cache' }
                { via: script  when: "redhat"  requires: cuda-repo
                  install-cmd:   'sudo dnf install -y libcudnn9-devel-cuda-12 && sudo ldconfig'
                  version-cmd:   'rpm -q --qf %{VERSION} libcudnn9-devel-cuda-12 2>/dev/null'
                  latest-cmd:    "dnf -q repoquery --qf '%{version}' libcudnn9-devel-cuda-12 2>/dev/null | tail -1"
                  version-re:    '([0-9][0-9.+-]*)'
                  uninstall-cmd: 'sudo dnf remove -y libcudnn9-devel-cuda-12 && sudo ldconfig'
                  location:      'libcudnn9-devel-cuda-12 (dnf) + ldconfig cache' }
            ]
        }
        rocm-hip: { attrs: [ SDK driver FOSS permissive ] description: "AMD ROCm/HIP — GPU compute toolkit for AMD hardware."
            install: [ { via: native  when: "not amzn and not void and not void_musl"   name: { apt: rocm-hip-sdk  dnf: rocm-hip  pacman: rocm-hip-sdk } } ]   // Void doesn't package ROCm
        }
        // MIOpen: AMD's deep-learning primitive library on ROCm/HIP — the true cuDNN analog for AMD
        // (as cuDNN needs CUDA, MIOpen needs ROCm), so it hard-requires rocm-hip. Fedora ships it in
        // base (`miopen`), Arch as `miopen-hip`; Debian/Ubuntu pull it from AMD's ROCm repo
        // (`miopen-hip-dev`, vendor repo — allowlisted like rocm-hip itself).
        miopen: { attrs: [ lib FOSS permissive ] description: "AMD MIOpen — deep-learning primitives for ROCm/HIP (AMD's cuDNN)."
            requires: rocm-hip
            install: [ { via: native  when: "debian or fedora or arch"  name: { apt: miopen-hip-dev  dnf: miopen  pacman: miopen-hip } } ]
        }
        // oneDNN (aka DNNL): Intel's deep-learning primitive library. UNLIKE cuDNN/MIOpen it is a
        // PORTABLE library (CPU + Intel/other GPU backends) shipped standalone in ordinary distro
        // repos — it needs neither a vendor repo nor the oneAPI Base Toolkit, so no hard toolkit
        // edge. Pair it with intel-oneapi-basekit yourself when building for Intel-GPU targets.
        onednn: { attrs: [ lib FOSS permissive ] description: "oneDNN (DNNL) — Intel's deep-learning primitives library (portable; Intel's cuDNN)."
            install: [ { via: native  when: "debian or fedora or arch or opensuse"  repo-component: universe
                         name: { apt: libdnnl-dev  dnf: onednn-devel  pacman: onednn  zypper: onednn-devel } } ]
        }
        intel-oneapi-basekit: { attrs: [ SDK toolchain proprietary freeware ] description: "Intel oneAPI Base Toolkit — compute compilers and libraries."
            install: [ { via: native  when: "arch"  name: intel-oneapi-basekit }      // in [extra]
                       { via: native  when: "debian"  name: intel-basekit              // Intel's own apt repo (not in any distro's)
                         pubkey-url: "https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB"
                         pubkey-path: /usr/share/keyrings/oneapi-archive-keyring.asc   // an ARMORED key -> .asc
                         source-line: "deb [signed-by=/usr/share/keyrings/oneapi-archive-keyring.asc] https://apt.repos.intel.com/oneapi all main"
                         source-path: /etc/apt/sources.list.d/oneAPI.list }
                       { via: native  when: "redhat"  name: intel-basekit              // Intel's own dnf repo
                         pubkey-url: "https://yum.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB"
                         repo-id: oneAPI  repo-name: "Intel oneAPI"  repo-url: "https://yum.repos.intel.com/oneapi" } ]
        }

        // OpenCV — computer-vision library, split by face: the C++ dev library and the Python
        // (cv2) bindings. The distro packages here are CPU-only; a CUDA-accelerated build is an
        // opt-in `via: source` method (requires the `cuda-toolkit` capability) added by configsys-source
        // — `configsys pin set opencv source` to get it.
        opencv: { attrs: [ lib FOSS permissive ] description: "OpenCV computer-vision library — C++ headers and libraries (dev)."
            install: [ { via: native  when: "(debian or redhat or opensuse or arch or alpine) and not amzn"  repo-component: universe
                         name: { apt: libopencv-dev  dnf: opencv-devel  zypper: opencv-devel  pacman: opencv  apk: opencv-dev } }
                       { via: native  when: "fedora_atomic or void or void_musl"  name: opencv } ]   // brew formula `opencv`
        }
        opencv-python: { attrs: [ lib FOSS permissive ] description: "OpenCV Python bindings (the `cv2` module)."
            install: [ { via: native  when: "(debian or redhat or opensuse or arch or alpine) and not amzn"  repo-component: universe
                         name: { apt: python3-opencv  dnf: python3-opencv  zypper: python313-opencv  pacman: opencv  apk: py3-opencv } } ]
        }

        // docker: "the engine, working" = the package + its daemon enabled. Post-install is just
        // composition — docker-service is an ordinary component ordered after docker-engine via
        // `requires:` (which also avoids the package<->service dependency cycle a single unit
        // would create). Passwordless docker (group membership) is a security opt-in: add
        // `docker-group` to your profile alongside `docker`. RHEL steers you to podman — use that
        // there. Config lives in ~/.docker, so no dotfiles.
        docker: { attrs: [ CLI FOSS permissive ] description: "Docker — build and run containers (`docker` CLI)."
            install: [ { via: parts  parts: [ docker-engine, docker-service ] } ]
        }
        docker-engine: { attrs: [ daemon FOSS permissive ] description: "Docker Engine — the container runtime daemon."
            install: [ { via: native  repo-component: universe  name: { xbps: docker dnf: moby-engine  pacman: docker  zypper: docker  apk: docker  default: docker.io } }
                       { via: native  when: "amzn"  name: docker } ]
        }
        docker-service: { description: "Enable and start the Docker daemon (systemd / runit)."
            requires: docker-engine
            install: [ { via: service  unit: docker } ]
        }
        docker-group: { description: "Add your user to the `docker` group (non-root docker access)."   // opt-in: passwordless docker (usermod -aG docker $YOU). Needs the group the engine creates.
            requires: docker-engine
            install: [ { via: group  name: docker } ]
        }

        // --- snapd: the daemon behind `via: snap`. The snap DRIVER `requires` the two setup
        // components below (see drivers:), so pinning a snap on a non-Ubuntu distro installs snapd,
        // enables its socket, and creates the /snap symlink classic snaps need. On Ubuntu it's all
        // preinstalled, so these resolve as already-satisfied (no action). openSUSE/Alpine/Void have
        // no snapd binding here (snapd needs a community repo / isn't supported), so the snap driver
        // can't work there and isn't offered at all; flatpak/native cover those apps.
        snapd: { attrs: [ daemon FOSS copyleft ] description: "snapd — the daemon that installs and runs snap packages."
            install: [ { via: native  when: "(debian or redhat) and not amzn"  name: snapd }   // apt / dnf snapd
                       { via: aur  name: snapd } ]              // Arch: AUR
        }
        snapd-socket: { attrs: [ daemon FOSS copyleft ] description: "Enable snapd's systemd socket (so snaps can install/run)."
            requires: snapd
            install: [ { via: service  unit: snapd.socket } ]
        }
        snapd-snap-link: { attrs: [ headless FOSS copyleft ] description: "The /snap symlink classic-confinement snaps need (snapd stores snaps under /var/lib/snapd/snap)."
            requires: snapd
            install: [ { via: script
              install-cmd:   "test -e /snap || sudo ln -s /var/lib/snapd/snap /snap"   // Ubuntu already has /snap -> no-op; Fedora/Arch need the link
              version-cmd:   "test -e /snap && echo present"
              version-re:    "(present)"
              uninstall-cmd: "test -L /snap && sudo rm -f /snap || true"
              location:      "/snap" } ]
        }

        // --- virtualization: QEMU/KVM + libvirt + virt-manager, and VirtualBox ---
        qemu:    { attrs: [ CLI app FOSS copyleft ] description: "QEMU — machine emulator and virtualizer." install: [ { via: native  when: "not amzn"   name: { apt: qemu-system-x86  dnf: qemu-kvm  pacman: qemu-base  default: qemu } }  { via: brew  name: qemu } ] }
        libvirt: { attrs: [ daemon lib FOSS copyleft ] description: "libvirt — virtualization management API and daemon." install: [ { via: native  when: "not amzn"   name: { apt: libvirt-daemon-system  default: libvirt } } ] }
        libvirt-service: { description: "Enable and start the libvirt daemon (systemd / runit)." requires: libvirt  install: [ { via: service  unit: libvirtd  runit: [ libvirtd, virtlockd, virtlogd ] } ] }
        // virt-manager pulls the whole stack (hypervisor + daemon) so it's usable out of the box.
        virt-manager: { attrs: [ GUI app FOSS copyleft ] description: "Virtual Machine Manager — a GUI for libvirt/KVM."
            requires: [ qemu, libvirt, libvirt-service ]
            install: [ { via: native  when: "not amzn"  }
                       { via: flatpak  hub: flathub  app: org.virt_manager.virt-manager } ]   // talks to the host libvirt socket (requires: still pull the host stack)
        }
        // VirtualBox needs a kernel module (vboxdrv, built via DKMS; Secure Boot requires signing
        // it — configsys can't do that part). apt: multiverse; Fedora: RPM Fusion; Arch/openSUSE: base.
        virtualbox: { attrs: [ GUI app FOSSish copyleft ] description: "VirtualBox — Oracle's desktop virtualizer."
            install: [
                { via: native  when: "redhat"  requires: rpmfusion  name: VirtualBox }
                { via: native  name: { xbps: virtualbox-ose }  when: "debian or arch or opensuse or void"  repo-component: multiverse } ]
        }

        // --- compression suites ---
        // gzip/bzip2/xz are on every base system already; these are the ones worth adding.
        zstd:  { attrs: [ CLI lib FOSS permissive ] description: "Zstandard — fast, high-ratio compression (`zstd`)." install: [ { via: native }  { via: brew  name: zstd } ] }
        lz4:   { attrs: [ CLI lib FOSS permissive ] description: "LZ4 — extremely fast compression (`lz4`)." install: [ { via: native }  { via: brew  name: lz4 } ] }
        p7zip: { attrs: [ CLI FOSS copyleft ] description: "7-Zip for Unix (`7z`/`7zz`) — high-ratio archiver, many formats." install: [ { via: native  name: { apt: p7zip-full  pacman: 7zip  zypper: 7zip  apk: 7zip  default: p7zip } }  { via: native  when: "ubuntu >= 22.04 or debian >= 12"  name: 7zip }  { via: native  when: "fedora_atomic"  name: sevenzip }  { via: brew  name: sevenzip } ] }   // modern Debian/Ubuntu ship the actively-maintained `7zip` (`7zz`); it wins over the legacy p7zip-full by specificity. brew's current formula is `sevenzip` (p7zip is the legacy 17.06 fork)
        // unrar is nonfree (patent-encumbered): apt multiverse, Fedora RPM Fusion, Arch base.
        unrar: { attrs: [ CLI freeware ] description: "Extract RAR archives."
            install: [
                { via: native  when: "void or void_musl"  requires: void-repo-nonfree }
                { via: native  when: "redhat"  requires: rpmfusion }
                { via: native  when: "debian"  repo-component: multiverse }
                { via: native  when: "arch" } ]
        }
        // rar (proprietary RARLAB) CREATES rar archives (unrar only extracts). Not in Fedora/
        // RPM Fusion or openSUSE main, and Arch carries it only in the AUR — so it's native only
        // on Debian (multiverse), AUR on Arch, and the official rarlab tarball everywhere else
        // (glibc; the tar unpacks a rar/ dir holding the rar + unrar binaries). Declines on musl
        // Alpine. suggests rar-glue to put the tarball binary on PATH.
        rar: { attrs: [ CLI proprietary paid ] description: "Create and extract RAR archives (proprietary RARLAB `rar`)."
            suggests: rar-glue
            install: [
                { via: native  when: "debian"  repo-component: multiverse }
                { via: aur  }
                { via: tarball  when: "not (debian or arch or alpine)"  cpu-names: { x86_64: x64 }  installDir: "$CONFIGSYS_APP_DIR/rar"  requires: glibc
                  version: { static: "7.23" }  url: "https://www.rarlab.com/rar/rarlinux-x64-723.tar.gz"
                  latest-check: { url: "https://www.rarlab.com/download.htm"  regex: "rarlinux-x64-([0-9]+)[.]tar" } }
            ]
        }
        rar-glue: { description: "rar shell setup, linked into place." install: [ { via: glue  requires: shell-glue  glue: rar } ] }
        // (The `compression` grouping is a PROFILE, not a parts component: nothing depends on it and
        // it's not OS-conditional, so the profile degrades gracefully — a part that's unroutable here,
        // e.g. unrar on musl/atomic, is skipped rather than failing the whole set. See config.hu.)

        // --- audio/video codecs (gstreamer names verified across all five families) ---
        // The `codecs` / `codecs-restricted` BUNDLES are user-facing profiles (in config.hu), not
        // parts-components — their pieces (ffmpeg, the gstreamer plugin sets) are ordinary components
        // you can track, pin, and version individually. The patent-encumbered "ugly"/libav set is the
        // separate `codecs-restricted` profile, off by default.
        gst-good: { attrs: [ lib plugin FOSS copyleft ] description: "GStreamer good plugins — well-supported, license-clean codecs." install: [ { via: native  when: "debian or redhat or arch or opensuse or alpine or void or void_musl"  name: { xbps: gst-plugins-good1 apt: gstreamer1.0-plugins-good  dnf: gstreamer1-plugins-good      pacman: gst-plugins-good  zypper: gstreamer-plugins-good  apk: gst-plugins-good } } ] }
        gst-bad:  { attrs: [ lib plugin FOSS copyleft ] description: "GStreamer bad plugins — less-mature but useful codecs." install: [ { via: native  when: "debian or redhat or arch or opensuse or alpine or void or void_musl"  name: { xbps: gst-plugins-bad1 apt: gstreamer1.0-plugins-bad   dnf: gstreamer1-plugins-bad-free  pacman: gst-plugins-bad   zypper: gstreamer-plugins-bad   apk: gst-plugins-bad } } ] }
        // Restricted/nonfree codecs — patent-encumbered, opt-in. Fedora needs RPM Fusion; openSUSE's
        // full ugly/libav codecs come from Packman (the name resolves in OSS; Packman isn't modeled).
        gst-ugly:  { attrs: [ lib plugin FOSS copyleft patent ] description: "GStreamer ugly plugins — good code, patent-encumbered codecs." install: [
                       { via: native  when: "redhat"  requires: rpmfusion  name: gstreamer1-plugins-ugly }
                       { via: native  when: "debian or void or void_musl"  repo-component: multiverse  name: { xbps: gst-plugins-ugly1  default: gstreamer1.0-plugins-ugly } }
                       { via: native  when: "arch or opensuse or alpine"  name: { pacman: gst-plugins-ugly  zypper: gstreamer-plugins-ugly  apk: gst-plugins-ugly } } ] }
        gst-libav: { attrs: [ lib plugin FOSS copyleft patent ] description: "GStreamer libav plugin — FFmpeg-backed codecs." install: [
                       { via: native  when: "redhat"  requires: rpmfusion  name: gstreamer1-plugin-libav }
                       { via: native  when: "debian or void or void_musl"  repo-component: universe  name: { xbps: gst-libav  default: gstreamer1.0-libav } }
                       { via: native  when: "arch or opensuse or alpine"  name: { pacman: gst-libav  zypper: gstreamer-plugins-libav  apk: gst-libav } } ] }
        libavcodec-extra: { attrs: [ lib FOSS copyleft patent ] description: "Extra (nonfree) FFmpeg codecs." install: [ { via: native  when: "debian"  repo-component: universe } ] }

        // discord / slack: flatpak everywhere (no uniform native path — Fedora has none), and
        // their config is sandboxed under ~/.var/app and holds auth tokens, so no dotfiles.
        discord: { attrs: [ GUI app proprietary electron account cloud online tele freemium ] description: "Discord — voice, video, and text chat." install: [ { via: flatpak  hub: flathub  app: com.discordapp.Discord }  { via: snap  name: discord }
                             { via: native-pkg-file  when: "debian"  name: discord  standing: never-auto  url: "https://discord.com/api/download?platform=linux&format=deb" } ] }   // Discord's official .deb (rolling; the URL 302-redirects to the latest — no version API, so latest reads as unknown, never a false "outdated"). `standing: never-auto` so the debian gate doesn't make it beat the universal flatpak by specificity — the sandboxed flatpak stays the default; the .deb is a pinnable option.
        slack:   { attrs: [ GUI app proprietary electron account cloud online tele freemium ] description: "Slack — team messaging and collaboration."
            install: [
                { via: native  when: "debian"  name: slack-desktop   // Slack's official packagecloud apt repo (jessie-pinned upstream; serves current builds)
                  pubkey-url: "https://packagecloud.io/slacktechnologies/slack/gpgkey"
                  pubkey-path: /usr/share/keyrings/slack.asc
                  source-line: "deb [signed-by=/usr/share/keyrings/slack.asc] https://packagecloud.io/slacktechnologies/slack/debian/ jessie main"
                  source-path: /etc/apt/sources.list.d/slack.list }
                { via: native  when: "redhat"  name: slack   // Slack's official packagecloud dnf repo (rpm package is `slack`)
                  pubkey-url: "https://packagecloud.io/slacktechnologies/slack/gpgkey"
                  repo-id: slack  repo-name: "Slack"
                  repo-url: "https://packagecloud.io/slacktechnologies/slack/fedora/21/x86_64" }
                { via: aur  name: slack-desktop }
                { via: flatpak  hub: flathub  app: com.slack.Slack }
                { via: snap  name: slack } ]
        }
        // Signal Desktop. Signal's own apt repo is amd64-only (one `xenial` suite serves every
        // release); Arch packages it in [extra]; Flathub everywhere else (Fedora/openSUSE/Alpine/
        // atomic/aarch64 — community-packaged, not by Signal), with a community AppImage alongside. The snap is also community-built
        // (Snapcrafters) -> never-auto so it doesn't tie with flatpak. No dotfiles: ~/.config/Signal
        // holds the account keys + encrypted message DB.
        signal:  { attrs: [ GUI app FOSS copyleft electron account online ] description: "Signal Desktop — end-to-end encrypted messaging (`signal-desktop`), linked to your phone's Signal account."
            install: [
                { via: native  when: "debian and cpu: x86_64"  name: signal-desktop   // Signal's official apt repo
                  pubkey-url: "https://updates.signal.org/desktop/apt/keys.asc"
                  pubkey-path: /usr/share/keyrings/signal-desktop-keyring.asc   // an ARMORED key -> .asc
                  source-line: "deb [arch=amd64 signed-by=/usr/share/keyrings/signal-desktop-keyring.asc] https://updates.signal.org/desktop/apt xenial main"
                  source-path: /etc/apt/sources.list.d/signal-desktop.list }
                { via: native  when: "arch"  name: signal-desktop }   // [extra]
                { via: flatpak  hub: flathub  app: org.signal.Signal }
                // community AppImage (karo-solutions — rebuilt from each Signal release within a day,
                // x86_64 + aarch64); the appImage driver isn't valid on musl. Signal itself ships no
                // AppImage. flatpak outranks it by driver-preference, so it's a pinnable alternative
                // (`configsys pin set signal appImage`).
                { via: appImage  name: Signal  scope: user
                  version: { github: karo-solutions/Signal-Desktop-AppImage  strip-v: true  asset: "Signal-v*-$ARCH.AppImage" }
                  path: ~/apps/signal.appimage }
                { via: snap  name: signal-desktop  standing: never-auto } ]
        }
        // signal-cli — Signal from the command line / as a JSON-RPC or D-Bus daemon (for scripts and
        // bots). Not in any distro's official repos. Default everywhere (Arch included): upstream's
        // GraalVM NATIVE build — one self-contained binary, no Java. The AUR package (builds the JVM
        // variant, needs JRE 25) is the Arch alternative. Both bundle libsignal for x86_64 glibc only,
        // so aarch64 / musl Alpine decline. Glue puts it on PATH. No dotfiles: ~/.local/share/signal-cli
        // holds the account keys.
        signal-cli: { attrs: [ CLI daemon FOSS copyleft account online ] suggests: signal-cli-glue
            description: "signal-cli — send and receive Signal messages from the command line, or run it as a JSON-RPC/D-Bus daemon."
            install: [
                { via: aur  when: "arch"  name: signal-cli }   // `when: "arch"`: keeps it ahead of the tarball's `cpu:` clause on Arch
                { via: tarball  when: "cpu: x86_64 and not alpine"  installDir: "$CONFIGSYS_APP_DIR/signal-cli"  requires: glibc
                  version: { github: AsamK/signal-cli  strip-v: true  asset: "signal-cli-*-Linux-native.tar.gz" } }  { via: brew  name: signal-cli } ]
        }
        signal-cli-glue: { description: "signal-cli on PATH (tarball installs)."
            install: [ { via: glue  requires: shell-glue  glue: signal-cli } ]
        }

        // --- media & creative apps -------------------------------------------------
        // Flatpak-preferred: the Flathub builds are current and not hobbled by the sandbox for
        // these. gimp/krita also take a native binding on Alpine — musl, where a native apk
        // package beats pulling a glibc flatpak runtime (and both are in Alpine's community
        // repo). Elsewhere, and for the others, a native default is a per-machine `pin` away.
        gimp: { attrs: [ GUI app FOSS GNU copyleft ] description: "GIMP — a raster image editor."
            install: [ { via: native   when: "alpine" }
                       { via: flatpak  hub: flathub  app: org.gimp.GIMP } ]
        }
        krita: { attrs: [ GUI app FOSS copyleft GNU ] description: "Krita — a digital painting studio."
            install: [ { via: native   when: "debian or fedora or arch or opensuse or alpine or void or void_musl"  repo-component: universe }
                       { via: flatpak  hub: flathub  app: org.kde.krita } ]
        }
        ardour: { attrs: [ GUI app FOSS copyleft ] description: "Ardour — a professional digital audio workstation (DAW)." install: [ { via: native  when: "debian or arch or opensuse or void or void_musl"  repo-component: universe }  { via: flatpak  hub: flathub  app: org.ardour.Ardour } ] }
        lmms:   { attrs: [ GUI app FOSS copyleft ] description: "LMMS — a music production studio (synths, sequencing, loops)." install: [ { via: native  when: "debian or fedora or arch or opensuse or void or void_musl"  repo-component: universe }  { via: flatpak  hub: flathub  app: io.lmms.LMMS } ] }
        // Audacity — the Muse-Group telemetry proposal (2021) was walked back and never shipped; no
        // networked telemetry in released builds. EL via EPEL; flatpak is the universal/atomic method.
        audacity: { attrs: [ GUI app FOSS copyleft ] description: "Audacity — a multi-track audio recorder and editor."
            install: [ { via: native  when: "void or void_musl" }  { via: native  when: "rhel"  requires: epel }
                       { via: native  when: "(debian or fedora or arch or opensuse or alpine) and not amzn"  repo-component: universe }
                       { via: flatpak  hub: flathub  app: org.audacityteam.Audacity } ] }
        // playerctl — control any MPRIS media player (play/pause/next, read metadata). EL via EPEL.
        playerctl: { attrs: [ CLI FOSS copyleft ] description: "playerctl — control MPRIS media players from the CLI (play/pause/next, metadata)."
            install: [ { via: native  when: "rhel"  requires: epel } { via: native  when: "not amzn"  repo-component: universe } ] }
        // mpd-mpris — exposes MPD over MPRIS so playerctl / desktop media keys drive it. Native on
        // Arch (extra) + Alpine (community); a Go build elsewhere. (Ships a systemd user service.)
        mpd-mpris: { attrs: [ CLI daemon FOSS permissive ] description: "mpd-mpris — bridge MPD to the MPRIS2 D-Bus interface (control MPD with `playerctl`)."
            install: [ { via: native  when: "arch or alpine" }
                       { via: go-install  name: "github.com/natsukagami/mpd-mpris/cmd/mpd-mpris"  requires: go } ] }

        // --- digital-art tools (Flathub, matching gimp/krita/ardour above — uniform across distros) ---
        inkscape:   { attrs: [ GUI app FOSS copyleft ] description: "Inkscape — a vector graphics editor (SVG)." install: [ { via: native  when: "debian or fedora or arch or opensuse or void or void_musl"  repo-component: universe }  { via: native  when: "rhel"  requires: epel }  { via: flatpak  hub: flathub  app: org.inkscape.Inkscape } ] }
        darktable:  { attrs: [ GUI app FOSS copyleft ] description: "darktable — RAW photo workflow and non-destructive editing." install: [ { via: native  when: "debian or fedora or arch or opensuse or void or void_musl"  repo-component: universe }  { via: native  when: "rhel"  requires: epel }  { via: flatpak  hub: flathub  app: org.darktable.Darktable } ] }
        freecad:    { attrs: [ GUI app FOSS copyleft ] description: "FreeCAD — a parametric 3D CAD modeler." install: [ { via: native  when: "debian or arch or opensuse or void or void_musl"  repo-component: universe }  { via: flatpak  hub: flathub  app: org.freecad.FreeCAD }  { via: appImage  cpu-names: { x86_64: x86_64  aarch64: aarch64 }  name: FreeCAD  scope: user  version: { github: FreeCAD/FreeCAD  asset: "FreeCAD_*-Linux-$ARCH-*.AppImage" }  path: ~/apps/freecad.appimage } ] }   // native on debian/arch/opensuse; Fedora/EL lack it -> flatpak/appImage. asset glob absorbs the bundled-python (pyXYZ) token
        openscad:   { attrs: [ GUI app FOSS copyleft ] description: "OpenSCAD — the programmer's solid 3D CAD modeller." install: [ { via: native  when: "debian or fedora or arch or opensuse or void or void_musl"  repo-component: universe }  { via: native  when: "rhel"  requires: epel }  { via: flatpak  hub: flathub  app: org.openscad.OpenSCAD } ] }
        godot:      { attrs: [ GUI app FOSS permissive ] description: "Godot — an open-source 2D/3D game engine." install: [ { via: flatpak  hub: flathub  app: org.godotengine.Godot }  { via: tarball  cpu-names: { x86_64: x86_64  aarch64: arm64 }  installDir: "$CONFIGSYS_APP_DIR/godot"  requires: unzip  version: { github: godotengine/godot  tag-re: "([0-9][0-9.]*)"  asset: "Godot_v*-stable_linux.$ARCH.zip" } } ] }   // flatpak stays default; the zip holds a single `Godot_v<ver>_linux.x86_64` exe (no clean rename for zip)
        // Godot editor version/project MANAGERS (the FOSS counterpart to Unity Hub) — each downloads and
        // manages its OWN editor builds in its own store, so they complement the direct `godot` component
        // (which configsys installs/versions/locks) rather than replacing it; they don't adopt it.
        godots:     { attrs: [ GUI CLI app FOSS permissive online ] description: "Godots — a Godot editor version & project manager (UI mirrors Godot's own project manager; also scriptable via CLI)."
            install: [ { via: flatpak  hub: flathub  app: io.github.MakovWait.Godots }
                       { via: aur  name: godots-bin }
                       { via: tarball  installDir: "$CONFIGSYS_APP_DIR/godots"  requires: unzip
                         version: { github: MakovWait/godots  tag-re: "([0-9][0-9.]*)"  asset: "LinuxX11.zip" } } ] }   // flatpak default; the zip is a self-contained Godot export (`Godots.x86_64`, no clean rename)
        godl:       { attrs: [ GUI CLI app FOSS permissive online ] description: "godl — a Qt-based Godot editor version manager (rich CLI; bindings that travel with a project in VCS)."
            install: [ { via: flatpak  hub: flathub  app: io.github.sockeye_d.godl }
                       { via: aur  name: godl } ] }   // Qt/.NET app -> flatpak bundles the runtime (the bare linux zip needs Qt6/.NET present); AUR builds it on Arch
        scribus:    { attrs: [ GUI app FOSS copyleft ] description: "Scribus — open-source desktop publishing (DTP)." install: [ { via: native  when: "debian or fedora or arch or opensuse or void or void_musl"  repo-component: universe }  { via: native  when: "rhel"  requires: epel }  { via: flatpak  hub: flathub  app: net.scribus.Scribus } ] }
        digikam:    { attrs: [ GUI app FOSS copyleft ] description: "digiKam — photo management and RAW editing." install: [ { via: native  when: "debian or fedora or arch or opensuse or void or void_musl"  repo-component: universe }  { via: native  when: "rhel"  requires: epel }  { via: flatpak  hub: flathub  app: org.kde.digikam } ] }

        // --- digital-asset management (photo / media libraries) — the dam-tools profile ---
        // Distro-packaged GTK/KDE managers go native where packaged, Flathub as the universal / EL /
        // atomic method. The upstream-only apps (lap, allusion, mediachips, video-hub-app) ship
        // AppImages (+ AUR on Arch); their x86_64-only builds carry `cpu-names: { x86_64: … }`.
        kphotoalbum: { attrs: [ GUI app FOSS GNU copyleft ] description: "KPhotoAlbum — KDE's keyword/category photo indexer and viewer."
            install: [ { via: native  when: "debian or fedora or arch or opensuse or alpine"  repo-component: universe }
                       { via: flatpak  hub: flathub  app: org.kde.kphotoalbum }
                       { via: snap  name: kphotoalbum } ] }   // not in EPEL/Void/brew -> flatpak there; KDE's own snap is pinnable
        gthumb:     { attrs: [ GUI app FOSS GNU copyleft ] description: "gThumb — GNOME's image viewer, browser and organizer."
            install: [ { via: native  when: "debian or fedora or arch or opensuse or alpine or void or void_musl"  repo-component: universe }
                       { via: native  when: "rhel < 10"  requires: epel }
                       { via: flatpak  hub: flathub  app: org.gnome.gThumb } ] }   // EPEL 8/9 carry it, EPEL 10 doesn't (-> flatpak)
        rawtherapee: { attrs: [ GUI CLI app FOSS GNU copyleft ] suggests: rawtherapee-dotfiles
            description: "RawTherapee — a non-destructive RAW photo developer (`rawtherapee`, `rawtherapee-cli`)."
            install: [ { via: native  when: "debian or fedora or arch or opensuse or alpine or void or void_musl"  repo-component: universe }
                       { via: flatpak  hub: flathub  app: com.rawtherapee.RawTherapee }
                       { via: appImage  cpu-names: { x86_64: x86_64  aarch64: arm64 }  name: RawTherapee  scope: user
                         version: { github: RawTherapee/RawTherapee  asset: "RawTherapee_*_$ARCH_release.AppImage" }  path: ~/apps/rawtherapee.appimage } ] }   // not in EPEL -> flatpak; upstream AppImage pinnable (tags have no `v`)
        rawtherapee-dotfiles: { description: "RawTherapee options + processing profiles, linked into place." install: [ { via: dotfiles  config: { src: rawtherapee  dst: $XDG_CONFIG_HOME/RawTherapee } } ] }
        shotwell:   { attrs: [ GUI app FOSS GNU copyleft ] description: "Shotwell — GNOME's photo manager (import, organize, light edits)."
            install: [ { via: native  when: "debian or fedora or arch or opensuse or alpine or void or void_musl" }
                       { via: flatpak  hub: flathub  app: org.gnome.Shotwell }
                       { via: snap  name: shotwell } ] }   // Ubuntu main; not in EPEL/brew -> flatpak
        xnview-mp:  { attrs: [ GUI app proprietary freeware ] description: "XnView MP — a fast image browser, viewer and batch converter (`xnview`; free for private use)."
            install: [ { via: flatpak  hub: flathub  app: com.xnview.XnViewMP }
                       { via: aur  name: xnviewmp  standing: never-auto }
                       { via: native-pkg-file  when: "debian"  name: xnview  standing: never-auto  cpu-names: { x86_64: x64 }
                         version: { url: "https://www.xnview.com/en/xnview-mp/"  regex: "Version +([0-9]+[.][0-9]+(?:[.][0-9]+)?)" }
                         url: "https://download.xnview.com/XnViewMP-linux-x64.deb" }
                       { via: native-pkg-file  when: "redhat or opensuse"  name: xnview  standing: never-auto  cpu-names: { x86_64: x86_64 }
                         version: { url: "https://www.xnview.com/en/xnview-mp/"  regex: "Version +([0-9]+[.][0-9]+(?:[.][0-9]+)?)" }
                         url: "https://download.xnview.com/XnView_MP-linux.x86_64.rpm" } ] }   // proprietary: the sandboxed flatpak is the default; vendor .deb/.rpm (stable "latest" URLs, x86_64 — the ARM build is stale) + AUR are pinnable
        lap:        { attrs: [ GUI app FOSS GNU copyleft tele ] description: "Lap — an offline-first photo manager for large local libraries (`Lap`; local AI search, faces, dedupe)."
            install: [ { via: native-pkg-file  when: "(ubuntu >= 22.04) or (debian >= 12) or (elementary >= 7) or (linuxmint >= 21) or (lmde >= 6) or (mx >= 23) or (zorin >= 17) or pikaos or kali"
                         version: { github: julyx10/lap  strip-v: true }  asset: { x86_64: "Lap_*_amd64.deb"  aarch64: "Lap_*_arm64.deb" } }
                       { via: appImage  cpu-names: { x86_64: amd64  aarch64: aarch64 }  name: Lap  scope: user
                         version: { github: julyx10/lap  strip-v: true  asset: "Lap_*_$ARCH.AppImage" }  path: ~/apps/lap.appimage } ] }   // Tauri app, not in any distro; the .deb needs webkit2gtk-4.1 (Ubuntu 22.04+/Debian 12+). Aptabase usage stats are ON by default (tele)
        allusion:   { attrs: [ GUI app FOSS GNU copyleft electron ] description: "Allusion — a visual reference/image library for artists (the maintained RafaUC fork)."
            install: [ { via: aur  cpu-names: { x86_64: x86_64 }  name: allusion-appimage-rafauc }
                       { via: appImage  cpu-names: { x86_64: x86_64 }  name: Allusion  scope: user
                         version: { github: RafaUC/Allusion  strip-v: true  asset: "Allusion-*-ruc.AppImage" }  path: ~/apps/allusion.appimage } ] }   // upstream allusion-app is dormant since 2023; the fork keeps the same appId/config. x86_64 only
        mediachips: { attrs: [ GUI app FOSS GNU copyleft electron freemium ] description: 'MediaChips — a local media library (video/images/audio) with custom metadata "chips" and tags.'
            install: [ { via: aur  cpu-names: { x86_64: x86_64 }  name: mediachips-bin }
                       { via: appImage  cpu-names: { x86_64: x86_64 }  name: MediaChips  scope: user
                         version: { github: fupdec/MediaChips  strip-v: true  asset: "MediaChips.v*.Linux.AppImage" }  path: ~/apps/mediachips.appimage } ] }   // x86_64-only AppImage; an optional paid activation key exists (freemium)
        video-hub-app: { attrs: [ GUI app FOSS permissive electron paid ] description: "Video Hub App — browse/search/preview local video like YouTube (Linux build is the 2023 DEMO, 50 videos per hub)."
            install: [ { via: aur  cpu-names: { x86_64: x86_64 }  name: video-hub-app-bin }
                       { via: appImage  cpu-names: { x86_64: x86_64 }  name: VideoHubApp  scope: user  version: { static: "3.2.0" }
                         url: "https://github.com/whyboris/Video-Hub-App/releases/download/v3.2.0/Video.Hub.App.3.Demo-3.2.0.AppImage"  path: ~/apps/video-hub-app.appimage } ] }   // v3.3.0 dropped the Linux asset; the full version is a paid ($10) download — pinned to the last Linux demo

        // --- video editors (NLEs): native in the big repos + Flathub (universal / atomic / the gaps) ---
        kdenlive:   { attrs: [ GUI app FOSS copyleft ] description: "Kdenlive — KDE's multi-track non-linear video editor." install: [ { via: native  when: "debian or fedora or arch or opensuse or alpine or void or void_musl"  repo-component: universe }  { via: native  when: "rhel"  requires: epel }  { via: flatpak  hub: flathub  app: org.kde.kdenlive } ] }
        shotcut:    { attrs: [ GUI app FOSS copyleft ] description: "Shotcut — a cross-platform non-linear video editor." install: [ { via: native  when: "void or void_musl" }  { via: native  when: "(debian or fedora or arch or opensuse) and not amzn"  repo-component: universe }  { via: flatpak  hub: flathub  app: org.shotcut.Shotcut } ] }
        openshot:   { attrs: [ GUI app FOSS copyleft ] description: "OpenShot — an easy-to-use non-linear video editor (`openshot-qt`)." install: [ { via: native  when: "debian or fedora or opensuse"  name: { apt: openshot-qt  zypper: openshot-qt  default: openshot } }  { via: flatpak  hub: flathub  app: org.openshot.OpenShot } ] }
        flowblade:  { attrs: [ GUI app FOSS copyleft ] description: "Flowblade — a fast, multitrack non-linear video editor." install: [ { via: native  when: "debian or fedora"  repo-component: universe }  { via: flatpak  hub: flathub  app: io.github.jliljebl.Flowblade } ] }
        olive:      { attrs: [ GUI app FOSS copyleft ] description: "Olive — a non-linear video editor (alpha; development stalled since Dec 2024 — Flathub is still 0.1.2 from 2019)." install: [ { via: flatpak  hub: flathub  app: org.olivevideoeditor.Olive }  { via: appImage  cpu-names: { x86_64: x86_64 }  name: Olive  scope: user  version: { github: olive-editor/olive  asset: "Olive-*-linux-x86_64.AppImage" }  path: ~/apps/olive.appimage } ] }   // no stable distro packages; flatpak default, AppImage fallback

        // --- ArtCraft "Crafting Apps" (github.com/storytold, Oct 2026): clean-room Rust rebuilds of the
        // Adobe suite (+ Office, AutoCAD, Pro Tools), MIT/Apache-2.0, offline, no telemetry/account. ALPHA. Every release ships the
        // same Linux assets per app (x86_64 + aarch64 .deb/.rpm/AppImage/tar.gz; no musl build, no Flathub —
        // the attached .flatpak is a bundle file, which the flatpak driver doesn't install). Not in any
        // distro repo yet. All builds are glibc >= 2.35 (the .deb declares libc6 >= 2.35), so every
        // method is gated to the OS versions that ship it:
        //   - Ubuntu 22.04+ / Debian 12+ (and the own-numbered derivatives on those bases) -> upstream .deb
        //   - Fedora / EL10+ / Tumbleweed / Leap 16+ -> upstream .rpm (EL9, Amazon 2023, Leap 15 are
        //     glibc <= 2.34 -> decline honestly)
        //   - x86_64 Arch -> alerque's AUR package (current, built from source; the PKGBUILD is
        //     x86_64-only, so ARM Arch takes the AppImage). Its `when: "arch and cpu: x86_64"` is what
        //     keeps it ahead of the AppImage, whose version gate also lists arch (for ARM): a bare aur
        //     binding would lose to that narrower `when:` on specificity, before driver-preference.
        //   - Void-glibc -> the AppImage; musl (Alpine, void_musl, Chimera) and atomic decline (the
        //     appImage driver can't work there: no glibc / no libfuse2).
        // The AppImage binding names its menu entry by the app's desktop id (`desktop-id:`), which is
        // the Wayland app_id: the dock icon resolves, and apps whose AppImage self-integrates on
        // launch (photocraft's AppRun, effectcraft) share that one entry instead of duplicating it.
        // No -dotfiles companions (yet): settings layouts are still churning across these alphas, and
        // where they've settled, ~/.config/<app> mixes settings with logs/recovery/catalog state (a
        // whole-dir link would sweep those into the content store) while the settings files are written
        // atomically (write-temp + rename, which would replace a per-file symlink).
        photocraft: { attrs: [ GUI CLI app FOSS permissive ]
            description: "PhotoCraft — ArtCraft's open-source Photoshop alternative: a raster image editor with layers, masks, adjustment layers and PSD/PSB round-tripping (`photocraft`, `photocraft-cli`)."
            install: [ { via: native-pkg-file  when: "(ubuntu >= 22.04) or (debian >= 12) or (elementary >= 7) or (linuxmint >= 21) or (lmde >= 6) or (mx >= 23) or (zorin >= 17) or pikaos or kali"  version: { github: storytold/photocraft  strip-v: true }
                         asset: { x86_64: "photocraft-*-linux-x86_64.deb"  aarch64: "photocraft-*-linux-aarch64.deb" } }
                       { via: native-pkg-file  when: "fedora or (rhel >= 10) or opensuse_tumbleweed or (opensuse_leap >= 16)"  version: { github: storytold/photocraft  strip-v: true }
                         asset: { x86_64: "photocraft-*-linux-x86_64.rpm"  aarch64: "photocraft-*-linux-aarch64.rpm" } }
                       { via: aur  when: "arch and cpu: x86_64"  name: photocraft }
                       { via: appImage  when: "arch or void or fedora or (rhel >= 10) or opensuse_tumbleweed or (opensuse_leap >= 16) or (ubuntu >= 22.04) or (debian >= 12) or (elementary >= 7) or (linuxmint >= 21) or (lmde >= 6) or (mx >= 23) or (zorin >= 17) or pikaos or kali"  name: PhotoCraft  scope: user  desktop-id: ai.storyteller.photocraft
                         version: { github: storytold/photocraft  strip-v: true  asset: "photocraft-*-linux-$ARCH.AppImage" }  path: ~/apps/photocraft.appimage } ] }
        vectorcraft: { attrs: [ GUI CLI app FOSS permissive ]
            description: "VectorCraft — ArtCraft's open-source Illustrator alternative: a vector illustration editor (`vectorcraft`, `vectorcraft-cli`)."
            install: [ { via: native-pkg-file  when: "(ubuntu >= 22.04) or (debian >= 12) or (elementary >= 7) or (linuxmint >= 21) or (lmde >= 6) or (mx >= 23) or (zorin >= 17) or pikaos or kali"  version: { github: storytold/vectorcraft  strip-v: true }
                         asset: { x86_64: "vectorcraft-*-linux-x86_64.deb"  aarch64: "vectorcraft-*-linux-aarch64.deb" } }
                       { via: native-pkg-file  when: "fedora or (rhel >= 10) or opensuse_tumbleweed or (opensuse_leap >= 16)"  version: { github: storytold/vectorcraft  strip-v: true }
                         asset: { x86_64: "vectorcraft-*-linux-x86_64.rpm"  aarch64: "vectorcraft-*-linux-aarch64.rpm" } }
                       { via: aur  when: "arch and cpu: x86_64"  name: vectorcraft }
                       { via: appImage  when: "arch or void or fedora or (rhel >= 10) or opensuse_tumbleweed or (opensuse_leap >= 16) or (ubuntu >= 22.04) or (debian >= 12) or (elementary >= 7) or (linuxmint >= 21) or (lmde >= 6) or (mx >= 23) or (zorin >= 17) or pikaos or kali"  name: VectorCraft  scope: user  desktop-id: ai.storyteller.vectorcraft
                         version: { github: storytold/vectorcraft  strip-v: true  asset: "vectorcraft-*-linux-$ARCH.AppImage" }  path: ~/apps/vectorcraft.appimage } ] }
        lightcraft: { attrs: [ GUI CLI app FOSS permissive ]
            description: "LightCraft — ArtCraft's open-source Lightroom alternative: a local-first RAW photo catalog and non-destructive developer (`lightcraft`, `lightcraft-cli`)."
            install: [ { via: native-pkg-file  when: "(ubuntu >= 22.04) or (debian >= 12) or (elementary >= 7) or (linuxmint >= 21) or (lmde >= 6) or (mx >= 23) or (zorin >= 17) or pikaos or kali"  version: { github: storytold/lightcraft  strip-v: true }
                         asset: { x86_64: "lightcraft-*-linux-x86_64.deb"  aarch64: "lightcraft-*-linux-aarch64.deb" } }
                       { via: native-pkg-file  when: "fedora or (rhel >= 10) or opensuse_tumbleweed or (opensuse_leap >= 16)"  version: { github: storytold/lightcraft  strip-v: true }
                         asset: { x86_64: "lightcraft-*-linux-x86_64.rpm"  aarch64: "lightcraft-*-linux-aarch64.rpm" } }
                       { via: aur  when: "arch and cpu: x86_64"  name: lightcraft }
                       { via: appImage  when: "arch or void or fedora or (rhel >= 10) or opensuse_tumbleweed or (opensuse_leap >= 16) or (ubuntu >= 22.04) or (debian >= 12) or (elementary >= 7) or (linuxmint >= 21) or (lmde >= 6) or (mx >= 23) or (zorin >= 17) or pikaos or kali"  name: LightCraft  scope: user  desktop-id: ai.storyteller.lightcraft
                         version: { github: storytold/lightcraft  strip-v: true  asset: "lightcraft-*-linux-$ARCH.AppImage" }  path: ~/apps/lightcraft.appimage } ] }
        designcraft: { attrs: [ GUI CLI app FOSS permissive ]
            description: "DesignCraft — ArtCraft's open-source InDesign alternative: a page-layout / desktop-publishing app (`designcraft`, `designcraft-cli`)."
            install: [ { via: native-pkg-file  when: "(ubuntu >= 22.04) or (debian >= 12) or (elementary >= 7) or (linuxmint >= 21) or (lmde >= 6) or (mx >= 23) or (zorin >= 17) or pikaos or kali"  version: { github: storytold/designcraft  strip-v: true }
                         asset: { x86_64: "designcraft-*-linux-x86_64.deb"  aarch64: "designcraft-*-linux-aarch64.deb" } }
                       { via: native-pkg-file  when: "fedora or (rhel >= 10) or opensuse_tumbleweed or (opensuse_leap >= 16)"  version: { github: storytold/designcraft  strip-v: true }
                         asset: { x86_64: "designcraft-*-linux-x86_64.rpm"  aarch64: "designcraft-*-linux-aarch64.rpm" } }
                       { via: aur  when: "arch and cpu: x86_64"  name: designcraft }
                       { via: appImage  when: "arch or void or fedora or (rhel >= 10) or opensuse_tumbleweed or (opensuse_leap >= 16) or (ubuntu >= 22.04) or (debian >= 12) or (elementary >= 7) or (linuxmint >= 21) or (lmde >= 6) or (mx >= 23) or (zorin >= 17) or pikaos or kali"  name: DesignCraft  scope: user  desktop-id: ai.storyteller.designcraft
                         version: { github: storytold/designcraft  strip-v: true  asset: "designcraft-*-linux-$ARCH.AppImage" }  path: ~/apps/designcraft.appimage } ] }
